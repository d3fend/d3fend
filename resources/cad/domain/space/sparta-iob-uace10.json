            ],
            "data": {
                "label": "SPARTA IOB UACE-10",
                "sequence": "0",
                "user_properties": [
                    [
                        "rdfs:comment",
                        "Detection of an unusually high number of processed commands recorded in spacecraft logs, \nwhich may indicate a flooding attack using valid commands. Such a surge can overwhelm \nspacecraft processing capabilities, leading to resource exhaustion like CPU spikes, \nmemory depletion, and increased battery usage. Monitoring log entries can reveal if \nthe spacecraft is being flooded with valid but excessive commands, which could create \ndenial of service conditions by saturating system processing resources."
                    ]
                ]
            },
            "measured": {
                "width": 507,
                "height": 133
            },
            "selected": false,
            "dragging": false,
            "width": 507,
            "height": 133
        },
