            "data": {
                "label": "SDR Waveforms",
                "sequence": "0",
                "user_properties": [
                    [
                        "rdfs:comment",
                        "We define SDR waveforms as software implementations of the set of transformations\napplied to information to be transmitted and the corresponding set of transformations\nto convert received signals back to their information content.\n\n\nExample: a Software Communications Architecture (SCA) waveform application."
                    ]
                ]
            },
            "measured": {
