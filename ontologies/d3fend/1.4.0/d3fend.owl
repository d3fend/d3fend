        <contributor rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#DISA_FSO"/>
        <definition>The organization enforces requirements for remote connections to the information system.</definition>
        <rdfs:label>CCI-000066</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CCI-000067_v2022-04-05 -->

    <owl:NamedIndividual rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CCI-000067_v2022-04-05">
        <rdf:type rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CCIControl"/>
