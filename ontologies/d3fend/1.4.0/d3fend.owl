        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#FileMetadata"/>
        <definition>A sequence of bytes used to identify and validate specific header sections within a file.</definition>
        <rdfs:label>File Header Block Signature</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#FileIntegrityMonitoring -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#FileIntegrityMonitoring">
