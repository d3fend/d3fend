        <definition>Content Blocks may contain metadata specific to the block&apos;s content at the beginning.</definition>
        <rdfs:label>File Content Block Metadata</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#FileContentDecompressionChecking -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#FileContentDecompressionChecking">
