        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#Record"/>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#BootSector -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#BootSector">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#BootRecord"/>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#BootloaderAuthentication -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#BootloaderAuthentication">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#PlatformHardening"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#authenticates"/>
                <owl:someValuesFrom rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#BootLoader"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#BootstrapAggregating -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#BootstrapAggregating">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#ResamplingEnsemble"/>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#BroadcastDomainIsolation -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#BroadcastDomainIsolation">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#NetworkIsolation"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#filters"/>
                <owl:someValuesFrom rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#LocalAreaNetworkTraffic"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#Browser -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#Browser">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#UserApplication"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#may-contain"/>
                <owl:someValuesFrom rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#BrowserExtension"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#BrowserExtension -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#BrowserExtension">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#UserApplication"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#extends"/>
                <owl:someValuesFrom rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#Browser"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#BucketOfModels -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#BucketOfModels">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#EnsembleLearning"/>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#BuildTool -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#BuildTool">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#DeveloperApplication"/>
        <definition>A tool that automates the process of creating a software build and the associated processes including: compiling computer source code into binary code, packaging binary code, and running automated tests.</definition>
        <rdfs:label>Build Tool</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dbpedia.org/resource/Build_automation"/>
        <skos:altLabel>Build Automation Tool</skos:altLabel>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#BusMessage -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#BusMessage">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#DigitalMessage"/>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#BusMessageAuthentication -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#BusMessageAuthentication">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#MessageAuthentication"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#authenticates"/>
                <owl:someValuesFrom rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#BusMessage"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#BusNetwork -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#BusNetwork">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#Network"/>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#BusNetworkFrame -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#BusNetworkFrame">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#NetworkFrame"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#contained-by"/>
                <owl:someValuesFrom rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#BusNetworkTraffic"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#contains"/>
                <owl:someValuesFrom rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#BusMessage"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#BusNetworkNode -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#BusNetworkNode">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#Host"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#connected-to"/>
                <owl:someValuesFrom rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#BusNetwork"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#transmits"/>
                <owl:someValuesFrom rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#BusNetworkTraffic"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#BusNetworkTraffic -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#BusNetworkTraffic">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#DigitalInformationBearer"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#contains"/>
                <owl:someValuesFrom rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#BusNetworkFrame"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#BusinessCommunicationPlatformClient -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#BusinessCommunicationPlatformClient">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CollaborativeSoftware"/>
        <definition>Client software to enable the process of sharing information between employees within and outside a company.  Business communication encompasses topics such as marketing, brand management, customer relations, consumer behavior, advertising, public relations, corporate communication, community engagement, reputation management, interpersonal communication, employee engagement, and event management. It is closely related to the fields of professional communication and technical communication.</definition>
        <rdfs:isDefinedBy rdf:resource="http://dbpedia.org/resource/Business_communication"/>
        <rdfs:label>Business Communication Platform Client</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#ByteSequenceEmulation -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#ByteSequenceEmulation">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#NetworkTrafficAnalysis"/>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#C4.5 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#C4.5">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#DecisionTree"/>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#C5.0 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#C5.0">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#DecisionTree"/>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CACertificateFile -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CACertificateFile">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CertificateFile"/>
        <definition>A file containing a digital certificate issued by a certificate authority (CA).  Certificate authorities store, issue, and sign digital certificates used as part of the public key infrastructure.</definition>
        <rdfs:label>CA Certificate File</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dbpedia.org/resource/Certificate_authority"/>
        <rdfs:seeAlso rdf:resource="http://dbpedia.org/resource/Public_key_infrastructure"/>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CAPEC-663 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CAPEC-663">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CommonAttackPattern"/>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CAPECThing -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CAPECThing">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#ExternalThreatModelThing"/>
        <rdfs:label>CAPEC Thing</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CART -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CART">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#DecisionTree"/>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CCIControl -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CCIControl">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#ExternalControl"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#member-of"/>
                <owl:someValuesFrom rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#ControlCorrelationIdentifierCatalog"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#control-name"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#published"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>CCI Control</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1004 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1004">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-732"/>
        <cwe-id>CWE-1004</cwe-id>
        <definition>The product uses a cookie to store sensitive information, but the cookie is not marked with the HttpOnly flag.</definition>
        <rdfs:label>Sensitive Cookie Without &apos;HttpOnly&apos; Flag</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1007 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1007">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-451"/>
        <cwe-id>CWE-1007</cwe-id>
        <definition>The product displays information or identifiers to a user, but the display mechanism does not make it easy for the user to distinguish between visually similar or identical glyphs (homoglyphs), which may cause the user to misinterpret a glyph and perform an unintended, insecure action.</definition>
        <synonym>Homograph Attack</synonym>
        <rdfs:label>Insufficient Visual Distinction of Homoglyphs Presented to User</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-102 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-102">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1173"/>
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-694"/>
        <cwe-id>CWE-102</cwe-id>
        <definition>The product uses multiple validation forms with the same name, which might cause the Struts Validator to validate a form that the programmer does not expect.</definition>
        <rdfs:label>Struts: Duplicate Validation Forms</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1021 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1021">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-441"/>
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-451"/>
        <cwe-id>CWE-1021</cwe-id>
        <definition>The web application does not restrict or incorrectly restricts frame objects or UI layers that belong to another application or domain, which can lead to user confusion about which interface the user is interacting with.</definition>
        <synonym>Clickjacking</synonym>
        <synonym>Tapjacking</synonym>
        <synonym>UI Redress Attack</synonym>
        <rdfs:label>Improper Restriction of Rendered UI Layers or Frames</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1022 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1022">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-266"/>
        <cwe-id>CWE-1022</cwe-id>
        <definition>The web application produces links to untrusted external sites outside of its sphere of control, but it does not properly prevent the external site from modifying security-critical properties of the window.opener object, such as the location property.</definition>
        <synonym>tabnabbing</synonym>
        <rdfs:label>Use of Web Link to Untrusted Target with window.opener Access</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1023 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1023">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-697"/>
        <cwe-id>CWE-1023</cwe-id>
        <definition>The product performs a comparison between entities that must consider multiple factors or characteristics of each entity, but the comparison does not include one or more of these factors.</definition>
        <rdfs:label>Incomplete Comparison with Missing Factors</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1024 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1024">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-697"/>
        <cwe-id>CWE-1024</cwe-id>
        <definition>The product performs a comparison between two entities, but the entities are of different, incompatible types that cannot be guaranteed to provide correct results when they are directly compared.</definition>
        <rdfs:label>Comparison of Incompatible Types</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1025 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1025">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-697"/>
        <cwe-id>CWE-1025</cwe-id>
        <definition>The code performs a comparison between two entities, but the comparison examines the wrong factors or characteristics of the entities, which can lead to incorrect results and resultant weaknesses.</definition>
        <rdfs:label>Comparison Using Wrong Factors</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-103 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-103">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-573"/>
        <cwe-id>CWE-103</cwe-id>
        <definition>The product has a validator form that either does not define a validate() method, or defines a validate() method but does not call super.validate().</definition>
        <rdfs:label>Struts: Incomplete validate() Method Definition</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1037 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1037">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1038"/>
        <cwe-id>CWE-1037</cwe-id>
        <definition>The developer builds a security-critical protection mechanism into the software, but the processor optimizes the execution of the program such that the mechanism is removed or modified.</definition>
        <rdfs:label>Processor Optimization Removal or Modification of Security-critical Code</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1038 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1038">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-435"/>
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-758"/>
        <cwe-id>CWE-1038</cwe-id>
        <definition>The product uses a mechanism that automatically optimizes code, e.g. to improve a characteristic such as performance, but the optimizations can have an unintended side effect that might violate an intended security assumption.</definition>
        <rdfs:label>Insecure Automated Optimizations</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1039 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1039">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-693"/>
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-697"/>
        <cwe-id>CWE-1039</cwe-id>
        <definition>The product uses an automated mechanism such as machine learning to recognize complex data inputs (e.g. image or audio) as a particular concept or category, but it does not properly detect or handle inputs that have been modified or constructed in a way that causes the mechanism to detect a different, incorrect concept.</definition>
        <rdfs:label>Automated Recognition Mechanism with Inadequate Detection or Handling of Adversarial Input Perturbations</rdfs:label>
        <rdfs:label>Inadequate Detection or Handling of Adversarial Input Perturbations in Automated Recognition Mechanism</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-104 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-104">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-573"/>
        <cwe-id>CWE-104</cwe-id>
        <definition>If a form bean does not extend an ActionForm subclass of the Validator framework, it can expose the application to other weaknesses related to insufficient input validation.</definition>
        <rdfs:label>Struts: Form Bean Does Not Extend Validation Class</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1041 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1041">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-710"/>
        <cwe-id>CWE-1041</cwe-id>
        <definition>The product has multiple functions, methods, procedures, macros, etc. that contain the same code.</definition>
        <rdfs:label>Use of Redundant Code</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1042 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1042">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1176"/>
        <cwe-id>CWE-1042</cwe-id>
        <definition>The code contains a member element that is declared as static (but not final), in which its parent class element is not a singleton class - that is, a class element that can be used only once in the &apos;to&apos; association of a Create action.</definition>
        <rdfs:label>Static Member Data Element outside of a Singleton Class Element</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1043 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1043">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1093"/>
        <cwe-id>CWE-1043</cwe-id>
        <definition>The product uses a data element that has an excessively large number of sub-elements with non-primitive data types such as structures or aggregated objects.</definition>
        <rdfs:label>Data Element Aggregating an Excessively Large Number of Non-Primitive Elements</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1044 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1044">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-710"/>
        <cwe-id>CWE-1044</cwe-id>
        <definition>The product&apos;s architecture contains too many - or too few - horizontal layers.</definition>
        <rdfs:label>Architecture with Number of Horizontal Layers Outside of Expected Range</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1045 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1045">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1076"/>
        <cwe-id>CWE-1045</cwe-id>
        <definition>A parent class has a virtual destructor method, but the parent has a child class that does not have a virtual destructor.</definition>
        <rdfs:label>Parent Class with a Virtual Destructor and a Child Class without a Virtual Destructor</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1046 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1046">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1176"/>
        <cwe-id>CWE-1046</cwe-id>
        <definition>The product creates an immutable text string using string concatenation operations.</definition>
        <rdfs:label>Creation of Immutable Text Using String Concatenation</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1047 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1047">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1120"/>
        <cwe-id>CWE-1047</cwe-id>
        <definition>The product contains modules in which one module has references that cycle back to itself, i.e., there are circular dependencies.</definition>
        <rdfs:label>Modules with Circular Dependencies</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1048 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1048">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-710"/>
        <cwe-id>CWE-1048</cwe-id>
        <definition>The code contains callable control elements that contain an excessively large number of references to other application objects external to the context of the callable, i.e. a Fan-Out value that is excessively large.</definition>
        <rdfs:label>Invokable Control Element with Large Number of Outward Calls</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1049 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1049">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1176"/>
        <cwe-id>CWE-1049</cwe-id>
        <definition>The product performs a data query with a large number of joins and sub-queries on a large data table.</definition>
        <rdfs:label>Excessive Data Query Operations in a Large Data Table</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-105 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-105">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1173"/>
        <cwe-id>CWE-105</cwe-id>
        <definition>The product has a form field that is not validated by a corresponding validation form, which can introduce other weaknesses related to insufficient input validation.</definition>
        <rdfs:label>Struts: Form Field Without Validator</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1050 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1050">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-405"/>
        <cwe-id>CWE-1050</cwe-id>
        <definition>The product has a loop body or loop condition that contains a control element that directly or indirectly consumes platform resources, e.g. messaging, sessions, locks, or file descriptors.</definition>
        <rdfs:label>Excessive Platform Resource Consumption within a Loop</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1051 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1051">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1419"/>
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-665"/>
        <cwe-id>CWE-1051</cwe-id>
        <definition>The product initializes data using hard-coded values that act as network resource identifiers.</definition>
        <rdfs:label>Initialization with Hard-Coded Network Resource Configuration Data</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1052 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1052">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1419"/>
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-665"/>
        <cwe-id>CWE-1052</cwe-id>
        <definition>The product initializes a data element using a hard-coded literal that is not a simple integer or static constant element.</definition>
        <rdfs:label>Excessive Use of Hard-Coded Literals in Initialization</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1053 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1053">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1059"/>
        <cwe-id>CWE-1053</cwe-id>
        <definition>The product does not have documentation that represents how it is designed.</definition>
        <rdfs:label>Missing Documentation for Design</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1054 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1054">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1061"/>
        <cwe-id>CWE-1054</cwe-id>
        <definition>The code at one architectural layer invokes code that resides at a deeper layer than the adjacent layer, i.e., the invocation skips at least one layer, and the invoked code is not part of a vertical utility layer that can be referenced from any horizontal layer.</definition>
        <rdfs:label>Invocation of a Control Element at an Unnecessarily Deep Horizontal Layer</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1055 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1055">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1093"/>
        <cwe-id>CWE-1055</cwe-id>
        <definition>The product contains a class with inheritance from more than one concrete class.</definition>
        <rdfs:label>Multiple Inheritance from Concrete Classes</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1056 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1056">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1120"/>
        <cwe-id>CWE-1056</cwe-id>
        <definition>A named-callable or method control element has a signature that supports a variable (variadic) number of parameters or arguments.</definition>
        <rdfs:label>Invokable Control Element with Variadic Parameters</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1057 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1057">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1061"/>
        <cwe-id>CWE-1057</cwe-id>
        <definition>The product uses a dedicated, central data manager component as required by design, but it contains code that performs data-access operations that do not use this data manager.</definition>
        <rdfs:label>Data Access Operations Outside of Expected Data Manager Component</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1058 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1058">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-662"/>
        <cwe-id>CWE-1058</cwe-id>
        <definition>The code contains a function or method that operates in a multi-threaded environment but owns an unsafe non-final static storable or member data element.</definition>
        <rdfs:label>Invokable Control Element in Multi-Thread Context with non-Final Static Storable or Member Element</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1059 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1059">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-710"/>
        <cwe-id>CWE-1059</cwe-id>
        <definition>The product does not contain sufficient technical or engineering documentation (whether on paper or in electronic form) that contains descriptions of all the relevant software/hardware elements of the product, such as its usage, structure, architectural components, interfaces, design, implementation, configuration, operation, etc.</definition>
        <rdfs:label>Insufficient Technical Documentation</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-106 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-106">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1173"/>
        <cwe-id>CWE-106</cwe-id>
        <definition>When an application does not use an input validation framework such as the Struts Validator, there is a greater risk of introducing weaknesses related to insufficient input validation.</definition>
        <rdfs:label>Struts: Plug-in Framework not in Use</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1060 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1060">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1120"/>
        <cwe-id>CWE-1060</cwe-id>
        <definition>The product performs too many data queries without using efficient data processing functionality such as stored procedures.</definition>
        <rdfs:label>Excessive Number of Inefficient Server-Side Data Accesses</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1061 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1061">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-710"/>
        <cwe-id>CWE-1061</cwe-id>
        <definition>The product does not sufficiently hide the internal representation and implementation details of data or methods, which might allow external components or modules to modify data unexpectedly, invoke unexpected functionality, or introduce dependencies that the programmer did not intend.</definition>
        <rdfs:label>Insufficient Encapsulation</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1062 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1062">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1061"/>
        <cwe-id>CWE-1062</cwe-id>
        <definition>The code has a parent class that contains references to a child class, its methods, or its members.</definition>
        <rdfs:label>Parent Class with References to Child Class</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1063 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1063">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1176"/>
        <cwe-id>CWE-1063</cwe-id>
        <definition>A static code block creates an instance of a class.</definition>
        <rdfs:label>Creation of Class Instance within a Static Code Block</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1064 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1064">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1120"/>
        <cwe-id>CWE-1064</cwe-id>
        <definition>The product contains a function, subroutine, or method whose signature has an unnecessarily large number of parameters/arguments.</definition>
        <rdfs:label>Invokable Control Element with Signature Containing an Excessive Number of Parameters</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1065 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1065">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-710"/>
        <cwe-id>CWE-1065</cwe-id>
        <definition>The product uses deployed components from application servers, but it also uses low-level functions/methods for management of resources, instead of the API provided by the application server.</definition>
        <rdfs:label>Runtime Resource Management Control Element in a Component Built to Run on Application Servers</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1066 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1066">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-710"/>
        <cwe-id>CWE-1066</cwe-id>
        <definition>The product contains a serializable data element that does not have an associated serialization method.</definition>
        <rdfs:label>Missing Serialization Control Element</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1067 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1067">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1176"/>
        <cwe-id>CWE-1067</cwe-id>
        <definition>The product contains a data query against an SQL table or view that is configured in a way that does not utilize an index and may cause sequential searches to be performed.</definition>
        <rdfs:label>Excessive Execution of Sequential Searches of Data Resource</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1068 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1068">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-710"/>
        <cwe-id>CWE-1068</cwe-id>
        <definition>The implementation of the product is not consistent with the design as described within the relevant documentation.</definition>
        <rdfs:label>Inconsistency Between Implementation and Documented Design</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1069 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1069">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1071"/>
        <cwe-id>CWE-1069</cwe-id>
        <definition>An invokable code block contains an exception handling block that does not contain any code, i.e. is empty.</definition>
        <rdfs:label>Empty Exception Block</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-107 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-107">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1164"/>
        <cwe-id>CWE-107</cwe-id>
        <definition>An unused validation form indicates that validation logic is not up-to-date.</definition>
        <rdfs:label>Struts: Unused Validation Form</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1070 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1070">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1076"/>
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-710"/>
        <cwe-id>CWE-1070</cwe-id>
        <definition>The product contains a serializable, storable data element such as a field or member, but the data element contains member elements that are not serializable.</definition>
        <rdfs:label>Serializable Data Element Containing non-Serializable Item Elements</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1071 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1071">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1164"/>
        <cwe-id>CWE-1071</cwe-id>
        <definition>The source code contains a block that does not contain any code, i.e., the block is empty.</definition>
        <rdfs:label>Empty Code Block</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1072 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1072">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-405"/>
        <cwe-id>CWE-1072</cwe-id>
        <definition>The product accesses a data resource through a database without using a connection pooling capability.</definition>
        <rdfs:label>Data Resource Access without Use of Connection Pooling</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1073 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1073">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-405"/>
        <cwe-id>CWE-1073</cwe-id>
        <definition>The product contains a client with a function or method that contains a large number of data accesses/queries that are sent through a data manager, i.e., does not use efficient database capabilities.</definition>
        <rdfs:label>Non-SQL Invokable Control Element with Excessive Number of Data Resource Accesses</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1074 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1074">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1093"/>
        <cwe-id>CWE-1074</cwe-id>
        <definition>A class has an inheritance level that is too high, i.e., it has a large number of parent classes.</definition>
        <rdfs:label>Class with Excessively Deep Inheritance</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1075 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1075">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1120"/>
        <cwe-id>CWE-1075</cwe-id>
        <definition>The product performs unconditional control transfer (such as a &quot;goto&quot;) in code outside of a branching structure such as a switch block.</definition>
        <rdfs:label>Unconditional Control Flow Transfer outside of Switch Block</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1076 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1076">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-710"/>
        <cwe-id>CWE-1076</cwe-id>
        <definition>The product&apos;s architecture, source code, design, documentation, or other artifact does not follow required conventions.</definition>
        <rdfs:label>Insufficient Adherence to Expected Conventions</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1077 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1077">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-697"/>
        <cwe-id>CWE-1077</cwe-id>
        <definition>The code performs a comparison such as an equality test between two float (floating point) values, but it uses comparison operators that do not account for the possibility of loss of precision.</definition>
        <rdfs:label>Floating Point Comparison with Incorrect Operator</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1078 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1078">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1076"/>
        <cwe-id>CWE-1078</cwe-id>
        <definition>The source code does not follow desired style or formatting for indentation, white space, comments, etc.</definition>
        <rdfs:label>Inappropriate Source Code Style or Formatting</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1079 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1079">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1076"/>
        <cwe-id>CWE-1079</cwe-id>
        <definition>A parent class contains one or more child classes, but the parent class does not have a virtual destructor method.</definition>
        <rdfs:label>Parent Class without Virtual Destructor Method</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-108 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-108">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1173"/>
        <cwe-id>CWE-108</cwe-id>
        <definition>Every Action Form must have a corresponding validation form.</definition>
        <rdfs:label>Struts: Unvalidated Action Form</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1080 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1080">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1120"/>
        <cwe-id>CWE-1080</cwe-id>
        <definition>A source code file has too many lines of code.</definition>
        <rdfs:label>Source Code File with Excessive Number of Lines of Code</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1082 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1082">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1076"/>
        <cwe-id>CWE-1082</cwe-id>
        <definition>The code contains a class instance that calls the method or function to delete or destroy itself.</definition>
        <rdfs:label>Class Instance Self Destruction Control Element</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1083 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1083">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1061"/>
        <cwe-id>CWE-1083</cwe-id>
        <definition>The product is intended to manage data access through a particular data manager component such as a relational or non-SQL database, but it contains code that performs data access operations without using that component.</definition>
        <rdfs:label>Data Access from Outside Expected Data Manager Component</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1084 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1084">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-405"/>
        <cwe-id>CWE-1084</cwe-id>
        <definition>A function or method contains too many operations that utilize a data manager or file resource.</definition>
        <rdfs:label>Invokable Control Element with Excessive File or Data Access Operations</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1085 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1085">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1078"/>
        <cwe-id>CWE-1085</cwe-id>
        <definition>A function, method, procedure, etc. contains an excessive amount of code that has been commented out within its body.</definition>
        <rdfs:label>Invokable Control Element with Excessive Volume of Commented-out Code</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1086 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1086">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1093"/>
        <cwe-id>CWE-1086</cwe-id>
        <definition>A class contains an unnecessarily large number of children.</definition>
        <rdfs:label>Class with Excessive Number of Child Classes</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1087 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1087">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1076"/>
        <cwe-id>CWE-1087</cwe-id>
        <definition>A class contains a virtual method, but the method does not have an associated virtual destructor.</definition>
        <rdfs:label>Class with Virtual Method without a Virtual Destructor</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1088 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1088">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-821"/>
        <cwe-id>CWE-1088</cwe-id>
        <definition>The code has a synchronous call to a remote resource, but there is no timeout for the call, or the timeout is set to infinite.</definition>
        <rdfs:label>Synchronous Access of Remote Resource without Timeout</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1089 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1089">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-405"/>
        <cwe-id>CWE-1089</cwe-id>
        <definition>The product uses a large data table that contains an excessively large number of indices.</definition>
        <rdfs:label>Large Data Table with Excessive Number of Indices</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-109 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-109">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1173"/>
        <cwe-id>CWE-109</cwe-id>
        <definition>Automatic filtering via a Struts bean has been turned off, which disables the Struts Validator and custom validation logic. This exposes the application to other weaknesses related to insufficient input validation.</definition>
        <rdfs:label>Struts: Validator Turned Off</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1090 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1090">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1061"/>
        <cwe-id>CWE-1090</cwe-id>
        <definition>A method for a class performs an operation that directly accesses a member element from another class.</definition>
        <rdfs:label>Method Containing Access of a Member Element from Another Class</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1091 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1091">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1076"/>
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-772"/>
        <cwe-id>CWE-1091</cwe-id>
        <definition>The product contains a method that accesses an object but does not later invoke the element&apos;s associated finalize/destructor method.</definition>
        <rdfs:label>Use of Object without Invoking Destructor Method</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1092 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1092">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-710"/>
        <cwe-id>CWE-1092</cwe-id>
        <definition>The product uses the same control element across multiple architectural layers.</definition>
        <rdfs:label>Use of Same Invokable Control Element in Multiple Architectural Layers</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1093 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1093">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-710"/>
        <cwe-id>CWE-1093</cwe-id>
        <definition>The product uses an unnecessarily complex internal representation for its data structures or interrelationships between those structures.</definition>
        <rdfs:label>Excessively Complex Data Representation</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1094 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1094">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-405"/>
        <cwe-id>CWE-1094</cwe-id>
        <definition>The product contains an index range scan for a large data table, but the scan can cover a large number of rows.</definition>
        <rdfs:label>Excessive Index Range Scan for a Data Resource</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1095 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1095">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1120"/>
        <cwe-id>CWE-1095</cwe-id>
        <definition>The product uses a loop with a control flow condition based on a value that is updated within the body of the loop.</definition>
        <rdfs:label>Loop Condition Value Update within the Loop</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1096 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1096">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-820"/>
        <cwe-id>CWE-1096</cwe-id>
        <definition>The product implements a Singleton design pattern but does not use appropriate locking or other synchronization mechanism to ensure that the singleton class is only instantiated once.</definition>
        <rdfs:label>Singleton Class Instance Creation without Proper Locking or Synchronization</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1097 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1097">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1076"/>
        <cwe-id>CWE-1097</cwe-id>
        <definition>The product uses a storable data element that does not have all of the associated functions or methods that are necessary to support comparison.</definition>
        <rdfs:label>Persistent Storable Data Element without Associated Comparison Control Element</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1098 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1098">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1076"/>
        <cwe-id>CWE-1098</cwe-id>
        <definition>The code contains a data element with a pointer that does not have an associated copy or constructor method.</definition>
        <rdfs:label>Data Element containing Pointer Item without Proper Copy Control Element</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1099 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1099">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1078"/>
        <cwe-id>CWE-1099</cwe-id>
        <definition>The product&apos;s code, documentation, or other artifacts do not consistently use the same naming conventions for variables, callables, groups of related callables, I/O capabilities, data types, file names, or similar types of elements.</definition>
        <rdfs:label>Inconsistent Naming Conventions for Identifiers</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-11 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-11">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-489"/>
        <cwe-id>CWE-11</cwe-id>
        <definition>Debugging messages help attackers learn about the system and plan a form of attack.</definition>
        <rdfs:label>ASP.NET Misconfiguration: Creating Debug Binary</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-110 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-110">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1164"/>
        <cwe-id>CWE-110</cwe-id>
        <definition>Validation fields that do not appear in forms they are associated with indicate that the validation logic is out of date.</definition>
        <rdfs:label>Struts: Validator Without Form Field</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1100 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1100">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1061"/>
        <cwe-id>CWE-1100</cwe-id>
        <definition>The product or code does not isolate system-dependent functionality into separate standalone modules.</definition>
        <rdfs:label>Insufficient Isolation of System-Dependent Functions</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1101 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1101">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-710"/>
        <cwe-id>CWE-1101</cwe-id>
        <definition>The product uses automatically-generated code that cannot be executed without a specific runtime support component.</definition>
        <rdfs:label>Reliance on Runtime Component in Generated Code</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1102 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1102">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-758"/>
        <cwe-id>CWE-1102</cwe-id>
        <definition>The code uses a data representation that relies on low-level data representation or constructs that may vary across different processors, physical machines, OSes, or other physical components.</definition>
        <rdfs:label>Reliance on Machine-Dependent Data Representation</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1103 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1103">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-758"/>
        <cwe-id>CWE-1103</cwe-id>
        <definition>The product relies on third-party components that do not provide equivalent functionality across all desirable platforms.</definition>
        <rdfs:label>Use of Platform-Dependent Third Party Components</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1104 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1104">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1357"/>
        <cwe-id>CWE-1104</cwe-id>
        <definition>The product relies on third-party components that are not actively supported or maintained by the original developer or a trusted proxy for the original developer.</definition>
        <rdfs:label>Use of Unmaintained Third Party Components</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1105 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1105">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1061"/>
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-758"/>
        <cwe-id>CWE-1105</cwe-id>
        <definition>The product or code uses machine-dependent functionality, but it does not sufficiently encapsulate or isolate this functionality from the rest of the code.</definition>
        <rdfs:label>Insufficient Encapsulation of Machine-Dependent Functionality</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1106 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1106">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1078"/>
        <cwe-id>CWE-1106</cwe-id>
        <definition>The source code uses literal constants that may need to change or evolve over time, instead of using symbolic constants.</definition>
        <rdfs:label>Insufficient Use of Symbolic Constants</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1107 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1107">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1078"/>
        <cwe-id>CWE-1107</cwe-id>
        <definition>The source code uses symbolic constants, but it does not sufficiently place the definitions of these constants into a more centralized or isolated location.</definition>
        <rdfs:label>Insufficient Isolation of Symbolic Constant Definitions</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1108 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1108">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1076"/>
        <cwe-id>CWE-1108</cwe-id>
        <definition>The code is structured in a way that relies too much on using or setting global variables throughout various points in the code, instead of preserving the associated information in a narrower, more local context.</definition>
        <rdfs:label>Excessive Reliance on Global Variables</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1109 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1109">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1078"/>
        <cwe-id>CWE-1109</cwe-id>
        <definition>The code contains a callable, block, or other code element in which the same variable is used to control more than one unique task or store more than one instance of data.</definition>
        <rdfs:label>Use of Same Variable for Multiple Purposes</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-111 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-111">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-695"/>
        <cwe-id>CWE-111</cwe-id>
        <definition>When a Java application uses the Java Native Interface (JNI) to call code written in another programming language, it can expose the application to weaknesses in that code, even if those weaknesses cannot occur in Java.</definition>
        <rdfs:label>Direct Use of Unsafe JNI</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1110 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1110">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1059"/>
        <cwe-id>CWE-1110</cwe-id>
        <definition>The product&apos;s design documentation does not adequately describe control flow, data flow, system initialization, relationships between tasks, components, rationales, or other important aspects of the design.</definition>
        <rdfs:label>Incomplete Design Documentation</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1111 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1111">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1059"/>
        <cwe-id>CWE-1111</cwe-id>
        <definition>The product&apos;s documentation does not adequately define inputs, outputs, or system/software interfaces.</definition>
        <rdfs:label>Incomplete I/O Documentation</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1112 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1112">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1059"/>
        <cwe-id>CWE-1112</cwe-id>
        <definition>The document does not fully define all mechanisms that are used to control or influence how product-specific programs are executed.</definition>
        <rdfs:label>Incomplete Documentation of Program Execution</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1113 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1113">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1078"/>
        <cwe-id>CWE-1113</cwe-id>
        <definition>The source code uses comment styles or formats that are inconsistent or do not follow expected standards for the product.</definition>
        <rdfs:label>Inappropriate Comment Style</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1114 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1114">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1078"/>
        <cwe-id>CWE-1114</cwe-id>
        <definition>The source code contains whitespace that is inconsistent across the code or does not follow expected standards for the product.</definition>
        <rdfs:label>Inappropriate Whitespace Style</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1115 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1115">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1078"/>
        <cwe-id>CWE-1115</cwe-id>
        <definition>The source code contains elements such as source files that do not consistently provide a prologue or header that has been standardized for the project.</definition>
        <rdfs:label>Source Code Element without Standard Prologue</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1116 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1116">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1078"/>
        <cwe-id>CWE-1116</cwe-id>
        <definition>The source code contains comments that do not accurately describe or explain aspects of the portion of the code with which the comment is associated.</definition>
        <rdfs:label>Inaccurate Comments</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1117 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1117">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1078"/>
        <cwe-id>CWE-1117</cwe-id>
        <definition>The code contains a function or method whose signature and/or associated inline documentation does not sufficiently describe the callable&apos;s inputs, outputs, side effects, assumptions, or return codes.</definition>
        <rdfs:label>Callable with Insufficient Behavioral Summary</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1118 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1118">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1059"/>
        <cwe-id>CWE-1118</cwe-id>
        <definition>The documentation does not sufficiently describe the techniques that are used for error handling, exception processing, or similar mechanisms.</definition>
        <rdfs:label>Insufficient Documentation of Error Handling Techniques</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1119 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1119">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1120"/>
        <cwe-id>CWE-1119</cwe-id>
        <definition>The code uses too many unconditional branches (such as &quot;goto&quot;).</definition>
        <rdfs:label>Excessive Use of Unconditional Branching</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-112 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-112">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1286"/>
        <cwe-id>CWE-112</cwe-id>
        <definition>The product accepts XML from an untrusted source but does not validate the XML against the proper schema.</definition>
        <rdfs:label>Missing XML Validation</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1120 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1120">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-710"/>
        <cwe-id>CWE-1120</cwe-id>
        <definition>The code is too complex, as calculated using a well-defined, quantitative measure.</definition>
        <rdfs:label>Excessive Code Complexity</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1121 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1121">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1120"/>
        <cwe-id>CWE-1121</cwe-id>
        <definition>The code contains McCabe cyclomatic complexity that exceeds a desirable maximum.</definition>
        <rdfs:label>Excessive McCabe Cyclomatic Complexity</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1122 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1122">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1120"/>
        <cwe-id>CWE-1122</cwe-id>
        <definition>The code is structured in a way that a Halstead complexity measure exceeds a desirable maximum.</definition>
        <rdfs:label>Excessive Halstead Complexity</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1123 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1123">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1120"/>
        <cwe-id>CWE-1123</cwe-id>
        <definition>The product uses too much self-modifying code.</definition>
        <rdfs:label>Excessive Use of Self-Modifying Code</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1124 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1124">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1120"/>
        <cwe-id>CWE-1124</cwe-id>
        <definition>The code contains a callable or other code grouping in which the nesting / branching is too deep.</definition>
        <rdfs:label>Excessively Deep Nesting</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1125 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1125">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1120"/>
        <cwe-id>CWE-1125</cwe-id>
        <definition>The product has an attack surface whose quantitative measurement exceeds a desirable maximum.</definition>
        <rdfs:label>Excessive Attack Surface</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1126 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1126">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-710"/>
        <cwe-id>CWE-1126</cwe-id>
        <definition>The source code declares a variable in one scope, but the variable is only used within a narrower scope.</definition>
        <rdfs:label>Declaration of Variable with Unnecessarily Wide Scope</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1127 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1127">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-710"/>
        <cwe-id>CWE-1127</cwe-id>
        <definition>The code is compiled without sufficient warnings enabled, which may prevent the detection of subtle bugs or quality issues.</definition>
        <rdfs:label>Compilation with Insufficient Warnings or Errors</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-113 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-113">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-436"/>
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-93"/>
        <cwe-id>CWE-113</cwe-id>
        <definition>The product receives data from an HTTP agent/component (e.g., web server, proxy, browser, etc.), but it does not neutralize or incorrectly neutralizes CR and LF characters before the data is included in outgoing HTTP headers.</definition>
        <synonym>HTTP Request Splitting</synonym>
        <synonym>HTTP Response Splitting</synonym>
        <rdfs:label>Improper Neutralization of CRLF Sequences in HTTP Headers (&apos;HTTP Request/Response Splitting&apos;)</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-114 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-114">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-73"/>
        <cwe-id>CWE-114</cwe-id>
        <definition>Executing commands or loading libraries from an untrusted source or in an untrusted environment can cause an application to execute malicious commands (and payloads) on behalf of an attacker.</definition>
        <rdfs:label>Process Control</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-115 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-115">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-436"/>
        <cwe-id>CWE-115</cwe-id>
        <definition>The product misinterprets an input, whether from an attacker or another product, in a security-relevant fashion.</definition>
        <rdfs:label>Misinterpretation of Input</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-116 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-116">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-707"/>
        <cwe-id>CWE-116</cwe-id>
        <definition>The product prepares a structured message for communication with another component, but encoding or escaping of the data is either missing or done incorrectly. As a result, the intended structure of the message is not preserved.</definition>
        <synonym>Output Encoding</synonym>
        <synonym>Output Sanitization</synonym>
        <synonym>Output Validation</synonym>
        <rdfs:label>Improper Encoding or Escaping of Output</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1164 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1164">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-710"/>
        <cwe-id>CWE-1164</cwe-id>
        <definition>The product contains code that is not essential for execution, i.e. makes no state changes and has no side effects that alter data or control flow, such that removal of the code would have no impact to functionality or correctness.</definition>
        <rdfs:label>Irrelevant Code</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-117 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-117">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-116"/>
        <cwe-id>CWE-117</cwe-id>
        <definition>The product constructs a log message from external input, but it does not neutralize or incorrectly neutralizes special elements when the message is written to a log file.</definition>
        <synonym>Log forging</synonym>
        <rdfs:label>Improper Output Neutralization for Logs</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1173 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1173">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-20"/>
        <cwe-id>CWE-1173</cwe-id>
        <definition>The product does not use, or incorrectly uses, an input validation framework that is provided by the source language or an independent library.</definition>
        <rdfs:label>Improper Use of Validation Framework</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1174 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1174">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1173"/>
        <cwe-id>CWE-1174</cwe-id>
        <definition>The ASP.NET application does not use, or incorrectly uses, the model validation framework.</definition>
        <rdfs:label>ASP.NET Misconfiguration: Improper Model Validation</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1176 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1176">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-405"/>
        <cwe-id>CWE-1176</cwe-id>
        <definition>The product performs CPU computations using algorithms that are not as efficient as they could be for the needs of the developer, i.e., the computations can be optimized further.</definition>
        <rdfs:label>Inefficient CPU Computation</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1177 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1177">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-710"/>
        <cwe-id>CWE-1177</cwe-id>
        <definition>The product uses a function, library, or third party component that has been explicitly prohibited, whether by the developer or the customer.</definition>
        <rdfs:label>Use of Prohibited Code</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-118 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-118">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-664"/>
        <cwe-id>CWE-118</cwe-id>
        <definition>The product does not restrict or incorrectly restricts operations within the boundaries of a resource that is accessed using an index or pointer, such as memory or files.</definition>
        <rdfs:label>Incorrect Access of Indexable Resource (&apos;Range Error&apos;)</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1188 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1188">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1419"/>
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-665"/>
        <cwe-id>CWE-1188</cwe-id>
        <definition>The product initializes or sets a resource with a default that is intended to be changed by the administrator, but the default is not secure.</definition>
        <rdfs:label>Initialization of a Resource with an Insecure Default</rdfs:label>
        <rdfs:label>Insecure Default Initialization of Resource</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1189 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1189">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-653"/>
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-668"/>
        <cwe-id>CWE-1189</cwe-id>
        <definition>The System-On-a-Chip (SoC) does not properly isolate shared resources between trusted and untrusted agents.</definition>
        <rdfs:label>Improper Isolation of Shared Resources on System-on-a-Chip (SoC)</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-119 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-119">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-118"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#weakness-of"/>
                <owl:someValuesFrom rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#RawMemoryAccessFunction"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1190 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1190">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-696"/>
        <cwe-id>CWE-1190</cwe-id>
        <definition>The product enables a Direct Memory Access (DMA) capable device before the security configuration settings are established, which allows an attacker to extract data from or gain privileges on the product.</definition>
        <rdfs:label>DMA Device Enabled Too Early in Boot Phase</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1191 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1191">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-284"/>
        <cwe-id>CWE-1191</cwe-id>
        <definition>The chip does not implement or does not correctly perform access control to check whether users are authorized to access internal registers and test modes through the physical debug/test interface.</definition>
        <rdfs:label>On-Chip Debug and Test Interface With Improper Access Control</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1192 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1192">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-657"/>
        <cwe-id>CWE-1192</cwe-id>
        <definition>The System-on-Chip (SoC) does not have unique, immutable identifiers for each of its components.</definition>
        <rdfs:label>Improper Identifier for IP Block used in System-On-Chip (SOC)</rdfs:label>
        <rdfs:label>System-on-Chip (SoC) Using Components without Unique, Immutable Identifiers</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1193 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1193">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-696"/>
        <cwe-id>CWE-1193</cwe-id>
        <definition>The product enables components that contain untrusted firmware before memory and fabric access controls have been enabled.</definition>
        <rdfs:label>Power-On of Untrusted Execution Core Before Enabling Fabric Access Control</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-12 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-12">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-756"/>
        <cwe-id>CWE-12</cwe-id>
        <definition>An ASP .NET application must enable custom error pages in order to prevent attackers from mining information from the framework&apos;s built-in responses.</definition>
        <rdfs:label>ASP.NET Misconfiguration: Missing Custom Error Page</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-120 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-120">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-119"/>
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-787"/>
        <cwe-id>CWE-120</cwe-id>
        <definition>The product copies an input buffer to an output buffer without verifying that the size of the input buffer is less than the size of the output buffer, leading to a buffer overflow.</definition>
        <synonym>Classic Buffer Overflow</synonym>
        <synonym>Unbounded Transfer</synonym>
        <rdfs:label>Buffer Copy without Checking Size of Input (&apos;Classic Buffer Overflow&apos;)</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1204 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1204">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-330"/>
        <cwe-id>CWE-1204</cwe-id>
        <definition>The product uses a cryptographic primitive that uses an Initialization Vector (IV), but the product does not generate IVs that are sufficiently unpredictable or unique according to the expected cryptographic requirements for that primitive.</definition>
        <rdfs:label>Generation of Weak Initialization Vector (IV)</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1209 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1209">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-710"/>
        <cwe-id>CWE-1209</cwe-id>
        <definition>The reserved bits in a hardware design are not disabled prior to production. Typically, reserved bits are used for future capabilities and should not support any functional logic in the design. However, designers might covertly use these bits to debug or further develop new capabilities in production hardware. Adversaries with access to these bits will write to them in hopes of compromising hardware state.</definition>
        <rdfs:label>Failure to Disable Reserved Bits</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-121 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-121">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-787"/>
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-788"/>
        <cwe-id>CWE-121</cwe-id>
        <definition>A stack-based buffer overflow condition is a condition where the buffer being overwritten is allocated on the stack (i.e., is a local variable or, rarely, a parameter to a function).</definition>
        <synonym>Stack Overflow</synonym>
        <rdfs:label>Stack-based Buffer Overflow</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-122 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-122">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-787"/>
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-788"/>
        <cwe-id>CWE-122</cwe-id>
        <definition>A heap overflow condition is a buffer overflow, where the buffer that can be overwritten is allocated in the heap portion of memory, generally meaning that the buffer was allocated using a routine such as malloc().</definition>
        <rdfs:label>Heap-based Buffer Overflow</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1220 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1220">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-284"/>
        <cwe-id>CWE-1220</cwe-id>
        <definition>The product implements access controls via a policy or other feature with the intention to disable or restrict accesses (reads and/or writes) to assets in a system from untrusted agents. However, implemented access controls lack required granularity, which renders the control policy too broad because it allows accesses from unauthorized agents to the security-sensitive assets.</definition>
        <rdfs:label>Insufficient Granularity of Access Control</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1221 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1221">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1419"/>
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-665"/>
        <cwe-id>CWE-1221</cwe-id>
        <definition>Hardware description language code incorrectly defines register defaults or hardware Intellectual Property (IP) parameters to insecure values.</definition>
        <rdfs:label>Incorrect Register Defaults or Module Parameters</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1222 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1222">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1220"/>
        <cwe-id>CWE-1222</cwe-id>
        <definition>The product defines a large address region protected from modification by the same register lock control bit. This results in a conflict between the functional requirement that some addresses need to be writable by software during operation and the security requirement that the system configuration lock bit must be set during the boot process.</definition>
        <rdfs:label>Insufficient Granularity of Address Regions Protected by Register Locks</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1223 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1223">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-362"/>
        <cwe-id>CWE-1223</cwe-id>
        <definition>A write-once register in hardware design is programmable by an untrusted software component earlier than the trusted software component, resulting in a race condition issue.</definition>
        <rdfs:label>Race Condition for Write-Once Attributes</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1224 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1224">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-284"/>
        <cwe-id>CWE-1224</cwe-id>
        <definition>The hardware design control register &quot;sticky bits&quot; or write-once bit fields are improperly implemented, such that they can be reprogrammed by software.</definition>
        <rdfs:label>Improper Restriction of Write-Once Bit Fields</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1229 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1229">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-664"/>
        <cwe-id>CWE-1229</cwe-id>
        <definition>The product manages resources or behaves in a way that indirectly creates a new, distinct resource that can be used by attackers in violation of the intended policy.</definition>
        <rdfs:label>Creation of Emergent Resource</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-123 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-123">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-787"/>
        <cwe-id>CWE-123</cwe-id>
        <definition>Any condition where the attacker has the ability to write an arbitrary value to an arbitrary location, often as the result of a buffer overflow.</definition>
        <rdfs:label>Write-what-where Condition</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1230 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1230">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-285"/>
        <cwe-id>CWE-1230</cwe-id>
        <definition>The product prevents direct access to a resource containing sensitive information, but it does not sufficiently limit access to metadata that is derived from the original, sensitive information.</definition>
        <rdfs:label>Exposure of Sensitive Information Through Metadata</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1231 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1231">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-284"/>
        <cwe-id>CWE-1231</cwe-id>
        <definition>The product uses a trusted lock bit for restricting access to registers, address regions, or other resources, but the product does not prevent the value of the lock bit from being modified after it has been set.</definition>
        <rdfs:label>Improper Prevention of Lock Bit Modification</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1232 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1232">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-667"/>
        <cwe-id>CWE-1232</cwe-id>
        <definition>Register lock bit protection disables changes to system configuration once the bit is set. Some of the protected registers or lock bits become programmable after power state transitions (e.g., Entry and wake from low power sleep modes) causing the system configuration to be changeable.</definition>
        <rdfs:label>Improper Lock Behavior After Power State Transition</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1233 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1233">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-284"/>
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-667"/>
        <cwe-id>CWE-1233</cwe-id>
        <definition>The product uses a register lock bit protection mechanism, but it does not ensure that the lock bit prevents modification of system registers or controls that perform changes to important hardware system configuration.</definition>
        <rdfs:label>Security-Sensitive Hardware Controls with Missing Lock Bit Protection</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1234 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1234">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-667"/>
        <cwe-id>CWE-1234</cwe-id>
        <definition>System configuration protection may be bypassed during debug mode.</definition>
        <rdfs:label>Hardware Internal or Debug Modes Allow Override of Locks</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1235 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1235">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-400"/>
        <cwe-id>CWE-1235</cwe-id>
        <definition>The code uses boxed primitives, which may introduce inefficiencies into performance-critical operations.</definition>
        <rdfs:label>Incorrect Use of Autoboxing and Unboxing for Performance Critical Operations</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1236 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1236">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-74"/>
        <cwe-id>CWE-1236</cwe-id>
        <definition>The product saves user-provided information into a Comma-Separated Value (CSV) file, but it does not neutralize or incorrectly neutralizes special elements that could be interpreted as a command when the file is opened by a spreadsheet product.</definition>
        <synonym>CSV Injection</synonym>
        <synonym>Excel Macro Injection</synonym>
        <synonym>Formula Injection</synonym>
        <rdfs:label>Improper Neutralization of Formula Elements in a CSV File</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1239 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1239">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-226"/>
        <cwe-id>CWE-1239</cwe-id>
        <definition>The hardware product does not properly clear sensitive information from built-in registers when the user of the hardware block changes.</definition>
        <rdfs:label>Improper Zeroization of Hardware Register</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-124 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-124">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-786"/>
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-787"/>
        <cwe-id>CWE-124</cwe-id>
        <definition>The product writes to a buffer using an index or pointer that references a memory location prior to the beginning of the buffer.</definition>
        <synonym>buffer underrun</synonym>
        <rdfs:label>Buffer Underwrite (&apos;Buffer Underflow&apos;)</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1240 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1240">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-327"/>
        <cwe-id>CWE-1240</cwe-id>
        <definition>To fulfill the need for a cryptographic primitive, the product implements a cryptographic algorithm using a non-standard, unproven, or disallowed/non-compliant cryptographic implementation.</definition>
        <rdfs:label>Use of a Cryptographic Primitive with a Risky Implementation</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1241 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1241">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-330"/>
        <cwe-id>CWE-1241</cwe-id>
        <definition>The device uses an algorithm that is predictable and generates a pseudo-random number.</definition>
        <rdfs:label>Use of Predictable Algorithm in Random Number Generator</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1242 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1242">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-284"/>
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-912"/>
        <cwe-id>CWE-1242</cwe-id>
        <definition>The device includes chicken bits or undocumented features that can create entry points for unauthorized actors.</definition>
        <rdfs:label>Inclusion of Undocumented Features or Chicken Bits</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1243 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1243">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1263"/>
        <cwe-id>CWE-1243</cwe-id>
        <definition>Access to security-sensitive information stored in fuses is not limited during debug.</definition>
        <rdfs:label>Sensitive Non-Volatile Information Not Protected During Debug</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1244 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1244">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-863"/>
        <cwe-id>CWE-1244</cwe-id>
        <definition>The product uses physical debug or test interfaces with support for multiple access levels, but it assigns the wrong debug access level to an internal asset, providing unintended access to the asset from untrusted debug agents.</definition>
        <rdfs:label>Internal Asset Exposed to Unsafe Debug Access Level or State</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1245 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1245">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-684"/>
        <cwe-id>CWE-1245</cwe-id>
        <definition>Faulty finite state machines (FSMs) in the hardware logic allow an attacker to put the system in an undefined state, to cause a denial of service (DoS) or gain privileges on the victim&apos;s system.</definition>
        <rdfs:label>Improper Finite State Machines (FSMs) in Hardware Logic</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1246 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1246">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-400"/>
        <cwe-id>CWE-1246</cwe-id>
        <definition>The product does not implement or incorrectly implements wear leveling operations in limited-write non-volatile memories.</definition>
        <rdfs:label>Improper Write Handling in Limited-write Non-Volatile Memories</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1247 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1247">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1384"/>
        <cwe-id>CWE-1247</cwe-id>
        <definition>The device does not contain or contains incorrectly implemented circuitry or sensors to detect and mitigate voltage and clock glitches and protect sensitive information or software contained on the device.</definition>
        <rdfs:label>Improper Protection Against Voltage and Clock Glitches</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1248 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1248">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-693"/>
        <cwe-id>CWE-1248</cwe-id>
        <definition>The security-sensitive hardware module contains semiconductor defects.</definition>
        <rdfs:label>Semiconductor Defects in Hardware Logic with Security-Sensitive Implications</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1249 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1249">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1250"/>
        <cwe-id>CWE-1249</cwe-id>
        <definition>The product provides an application for administrators to manage parts of the underlying operating system, but the application does not accurately identify all of the relevant entities or resources that exist in the OS; that is, the application&apos;s model of the OS&apos;s state is inconsistent with the OS&apos;s actual state.</definition>
        <synonym>Ghost in the Shell</synonym>
        <rdfs:label>Application-Level Admin Tool with Inconsistent View of Underlying Operating System</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-125 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-125">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-119"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#weakness-of"/>
                <owl:someValuesFrom rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#RawMemoryAccessFunction"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1250 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1250">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-664"/>
        <cwe-id>CWE-1250</cwe-id>
        <definition>The product has or supports multiple distributed components or sub-systems that are each required to keep their own local copy of shared data - such as state or cache - but the product does not ensure that all local copies remain consistent with each other.</definition>
        <rdfs:label>Improper Preservation of Consistency Between Independent Representations of Shared State</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1251 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1251">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1250"/>
        <cwe-id>CWE-1251</cwe-id>
        <definition>The product&apos;s architecture mirrors regions without ensuring that their contents always stay in sync.</definition>
        <rdfs:label>Mirrored Regions with Different Values</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1252 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1252">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-284"/>
        <cwe-id>CWE-1252</cwe-id>
        <definition>The CPU is not configured to provide hardware support for exclusivity of write and execute operations on memory. This allows an attacker to execute data from all of memory.</definition>
        <rdfs:label>CPU Hardware Not Configured to Support Exclusivity of Write and Execute Operations</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1253 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1253">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-693"/>
        <cwe-id>CWE-1253</cwe-id>
        <definition>The logic level used to set a system to a secure state relies on a fuse being unblown. An attacker can set the system to an insecure state merely by blowing the fuse.</definition>
        <rdfs:label>Incorrect Selection of Fuse Values</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1254 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1254">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-208"/>
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-697"/>
        <cwe-id>CWE-1254</cwe-id>
        <definition>The product&apos;s comparison logic is performed over a series of steps rather than across the entire string in one operation. If there is a comparison logic failure on one of these steps, the operation may be vulnerable to a timing attack that can result in the interception of the process for nefarious purposes.</definition>
        <rdfs:label>Incorrect Comparison Logic Granularity</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1255 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1255">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1300"/>
        <cwe-id>CWE-1255</cwe-id>
        <definition>A device&apos;s real time power consumption may be monitored during security token evaluation and the information gleaned may be used to determine the value of the reference token.</definition>
        <rdfs:label>Comparison Logic is Vulnerable to Power Side-Channel Attacks</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1256 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1256">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-285"/>
        <cwe-id>CWE-1256</cwe-id>
        <definition>The product provides software-controllable device functionality for capabilities such as power and clock management, but it does not properly limit functionality that can lead to modification of hardware memory or register bits, or the ability to observe physical side channels.</definition>
        <rdfs:label>Improper Restriction of Software Interfaces to Hardware Features</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1257 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1257">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-284"/>
        <cwe-id>CWE-1257</cwe-id>
        <definition>Aliased or mirrored memory regions in hardware designs may have inconsistent read/write permissions enforced by the hardware. A possible result is that an untrusted agent is blocked from accessing a memory region but is not blocked from accessing the corresponding aliased memory region.</definition>
        <rdfs:label>Improper Access Control Applied to Mirrored or Aliased Memory Regions</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1258 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1258">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-200"/>
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-212"/>
        <cwe-id>CWE-1258</cwe-id>
        <definition>The hardware does not fully clear security-sensitive values, such as keys and intermediate values in cryptographic operations, when debug mode is entered.</definition>
        <rdfs:label>Exposure of Sensitive System Information Due to Uncleared Debug Information</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1259 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1259">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-284"/>
        <cwe-id>CWE-1259</cwe-id>
        <definition>The System-On-A-Chip (SoC) implements a Security Token mechanism to differentiate what actions are allowed or disallowed when a transaction originates from an entity. However, the Security Tokens are improperly protected.</definition>
        <rdfs:label>Improper Restriction of Security Token Assignment</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-126 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-126">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-125"/>
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-788"/>
        <cwe-id>CWE-126</cwe-id>
        <definition>The product reads from a buffer using buffer access mechanisms such as indexes or pointers that reference memory locations after the targeted buffer.</definition>
        <rdfs:label>Buffer Over-read</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1260 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1260">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-284"/>
        <cwe-id>CWE-1260</cwe-id>
        <definition>The product allows address regions to overlap, which can result in the bypassing of intended memory protection.</definition>
        <rdfs:label>Improper Handling of Overlap Between Protected Memory Ranges</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1261 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1261">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1384"/>
        <cwe-id>CWE-1261</cwe-id>
        <definition>The hardware logic does not effectively handle when single-event upsets (SEUs) occur.</definition>
        <rdfs:label>Improper Handling of Single Event Upsets</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1262 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1262">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-284"/>
        <cwe-id>CWE-1262</cwe-id>
        <definition>The product uses memory-mapped I/O registers that act as an interface to hardware functionality from software, but there is improper access control to those registers.</definition>
        <rdfs:label>Improper Access Control for Register Interface</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1263 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1263">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-284"/>
        <cwe-id>CWE-1263</cwe-id>
        <definition>The product is designed with access restricted to certain information, but it does not sufficiently protect against an unauthorized actor with physical access to these areas.</definition>
        <rdfs:label>Improper Physical Access Control</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1264 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1264">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-821"/>
        <cwe-id>CWE-1264</cwe-id>
        <definition>The hardware logic for error handling and security checks can incorrectly forward data before the security check is complete.</definition>
        <rdfs:label>Hardware Logic with Insecure De-Synchronization between Control and Data Channels</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1265 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1265">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-691"/>
        <cwe-id>CWE-1265</cwe-id>
        <definition>During execution of non-reentrant code, the product performs a call that unintentionally produces a nested invocation of the non-reentrant code.</definition>
        <rdfs:label>Unintended Reentrant Invocation of Non-reentrant Code Via Nested Calls</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1266 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1266">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-404"/>
        <cwe-id>CWE-1266</cwe-id>
        <definition>The product does not properly provide a capability for the product administrator to remove sensitive data at the time the product is decommissioned. A scrubbing capability could be missing, insufficient, or incorrect.</definition>
        <rdfs:label>Improper Scrubbing of Sensitive Data from Decommissioned Device</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1267 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1267">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-284"/>
        <cwe-id>CWE-1267</cwe-id>
        <definition>The product uses an obsolete encoding mechanism to implement access controls.</definition>
        <rdfs:label>Policy Uses Obsolete Encoding</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1268 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1268">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-284"/>
        <cwe-id>CWE-1268</cwe-id>
        <definition>The product&apos;s hardware-enforced access control for a particular resource improperly accounts for privilege discrepancies between control and write policies.</definition>
        <rdfs:label>Policy Privileges are not Assigned Consistently Between Control and Data Agents</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1269 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1269">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-693"/>
        <cwe-id>CWE-1269</cwe-id>
        <definition>The product released to market is released in pre-production or manufacturing configuration.</definition>
        <rdfs:label>Product Released in Non-Release Configuration</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-127 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-127">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-125"/>
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-786"/>
        <cwe-id>CWE-127</cwe-id>
        <definition>The product reads from a buffer using buffer access mechanisms such as indexes or pointers that reference memory locations prior to the targeted buffer.</definition>
        <rdfs:label>Buffer Under-read</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1270 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1270">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-284"/>
        <cwe-id>CWE-1270</cwe-id>
        <definition>The product implements a Security Token mechanism to differentiate what actions are allowed or disallowed when a transaction originates from an entity. However, the Security Tokens generated in the system are incorrect.</definition>
        <rdfs:label>Generation of Incorrect Security Tokens</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1271 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1271">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-909"/>
        <cwe-id>CWE-1271</cwe-id>
        <definition>Security-critical logic is not set to a known value on reset.</definition>
        <rdfs:label>Uninitialized Value on Reset for Registers Holding Security Settings</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1272 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1272">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-226"/>
        <cwe-id>CWE-1272</cwe-id>
        <definition>The product performs a power or debug state transition, but it does not clear sensitive information that should no longer be accessible due to changes to information access restrictions.</definition>
        <rdfs:label>Sensitive Information Uncleared Before Debug/Power State Transition</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1273 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1273">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-200"/>
        <cwe-id>CWE-1273</cwe-id>
        <definition>The credentials necessary for unlocking a device are shared across multiple parties and may expose sensitive information.</definition>
        <rdfs:label>Device Unlock Credential Sharing</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1274 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1274">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-284"/>
        <cwe-id>CWE-1274</cwe-id>
        <definition>The product conducts a secure-boot process that transfers bootloader code from Non-Volatile Memory (NVM) into Volatile Memory (VM), but it does not have sufficient access control or other protections for the Volatile Memory.</definition>
        <rdfs:label>Improper Access Control for Volatile Memory Containing Boot Code</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1275 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1275">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-923"/>
        <cwe-id>CWE-1275</cwe-id>
        <definition>The SameSite attribute for sensitive cookies is not set, or an insecure value is used.</definition>
        <rdfs:label>Sensitive Cookie with Improper SameSite Attribute</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1276 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1276">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-284"/>
        <cwe-id>CWE-1276</cwe-id>
        <definition>Signals between a hardware IP and the parent system design are incorrectly connected causing security risks.</definition>
        <rdfs:label>Hardware Child Block Incorrectly Connected to Parent System</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1277 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1277">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1329"/>
        <cwe-id>CWE-1277</cwe-id>
        <definition>The product does not provide its users with the ability to update or patch its firmware to address any vulnerabilities or weaknesses that may be present.</definition>
        <rdfs:label>Firmware Not Updateable</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1278 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1278">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-693"/>
        <cwe-id>CWE-1278</cwe-id>
        <definition>Information stored in hardware may be recovered by an attacker with the capability to capture and analyze images of the integrated circuit using techniques such as scanning electron microscopy.</definition>
        <rdfs:label>Missing Protection Against Hardware Reverse Engineering Using Integrated Circuit (IC) Imaging Techniques</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1279 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1279">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-665"/>
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-696"/>
        <cwe-id>CWE-1279</cwe-id>
        <definition>Performing cryptographic operations without ensuring that the supporting inputs are ready to supply valid data may compromise the cryptographic result.</definition>
        <rdfs:label>Cryptographic Operations are run Before Supporting Units are Ready</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-128 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-128">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-682"/>
        <cwe-id>CWE-128</cwe-id>
        <definition>Wrap around errors occur whenever a value is incremented past the maximum value for its type and therefore &quot;wraps around&quot; to a very small, negative, or undefined value.</definition>
        <rdfs:label>Wrap-around Error</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1280 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1280">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-284"/>
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-696"/>
        <cwe-id>CWE-1280</cwe-id>
        <definition>A product&apos;s hardware-based access control check occurs after the asset has been accessed.</definition>
        <rdfs:label>Access Control Check Implemented After Asset is Accessed</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1281 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1281">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-691"/>
        <cwe-id>CWE-1281</cwe-id>
        <definition>Specific combinations of processor instructions lead to undesirable behavior such as locking the processor until a hard reset performed.</definition>
        <rdfs:label>Sequence of Processor Instructions Leads to Unexpected Behavior</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1282 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1282">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-668"/>
        <cwe-id>CWE-1282</cwe-id>
        <definition>Immutable data, such as a first-stage bootloader, device identifiers, and &quot;write-once&quot; configuration settings are stored in writable memory that can be re-programmed or updated in the field.</definition>
        <rdfs:label>Assumed-Immutable Data is Stored in Writable Memory</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1283 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1283">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-284"/>
        <cwe-id>CWE-1283</cwe-id>
        <definition>The register contents used for attestation or measurement reporting data to verify boot flow are modifiable by an adversary.</definition>
        <rdfs:label>Mutable Attestation or Measurement Reporting Data</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1284 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1284">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-20"/>
        <cwe-id>CWE-1284</cwe-id>
        <definition>The product receives input that is expected to specify a quantity (such as size or length), but it does not validate or incorrectly validates that the quantity has the required properties.</definition>
        <rdfs:label>Improper Validation of Specified Quantity in Input</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1285 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1285">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-20"/>
        <cwe-id>CWE-1285</cwe-id>
        <definition>The product receives input that is expected to specify an index, position, or offset into an indexable resource such as a buffer or file, but it does not validate or incorrectly validates that the specified index/position/offset has the required properties.</definition>
        <rdfs:label>Improper Validation of Specified Index, Position, or Offset in Input</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1286 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1286">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-20"/>
        <cwe-id>CWE-1286</cwe-id>
        <definition>The product receives input that is expected to be well-formed - i.e., to comply with a certain syntax - but it does not validate or incorrectly validates that the input complies with the syntax.</definition>
        <rdfs:label>Improper Validation of Syntactic Correctness of Input</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1287 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1287">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-20"/>
        <cwe-id>CWE-1287</cwe-id>
        <definition>The product receives input that is expected to be of a certain type, but it does not validate or incorrectly validates that the input is actually of the expected type.</definition>
        <rdfs:label>Improper Validation of Specified Type of Input</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1288 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1288">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-20"/>
        <cwe-id>CWE-1288</cwe-id>
        <definition>The product receives a complex input with multiple elements or fields that must be consistent with each other, but it does not validate or incorrectly validates that the input is actually consistent.</definition>
        <rdfs:label>Improper Validation of Consistency within Input</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1289 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1289">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-20"/>
        <cwe-id>CWE-1289</cwe-id>
        <definition>The product receives an input value that is used as a resource identifier or other type of reference, but it does not validate or incorrectly validates that the input is equivalent to a potentially-unsafe value.</definition>
        <rdfs:label>Improper Validation of Unsafe Equivalence in Input</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-129 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-129">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1285"/>
        <cwe-id>CWE-129</cwe-id>
        <definition>The product uses untrusted input when calculating or using an array index, but the product does not validate or incorrectly validates the index to ensure the index references a valid position within the array.</definition>
        <synonym>array index underflow</synonym>
        <synonym>index-out-of-range</synonym>
        <synonym>out-of-bounds array index</synonym>
        <rdfs:label>Improper Validation of Array Index</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1290 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1290">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-284"/>
        <cwe-id>CWE-1290</cwe-id>
        <definition>The product implements a decoding mechanism to decode certain bus-transaction signals to security identifiers. If the decoding is implemented incorrectly, then untrusted agents can now gain unauthorized access to the asset.</definition>
        <rdfs:label>Incorrect Decoding of Security Identifiers</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1291 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1291">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-693"/>
        <cwe-id>CWE-1291</cwe-id>
        <definition>The same public key is used for signing both debug and production code.</definition>
        <rdfs:label>Public Key Re-Use for Signing both Debug and Production Code</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1292 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1292">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-284"/>
        <cwe-id>CWE-1292</cwe-id>
        <definition>The product implements a conversion mechanism to map certain bus-transaction signals to security identifiers. However, if the conversion is incorrectly implemented, untrusted agents can gain unauthorized access to the asset.</definition>
        <rdfs:label>Incorrect Conversion of Security Identifiers</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1293 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1293">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-345"/>
        <cwe-id>CWE-1293</cwe-id>
        <definition>The product relies on one source of data, preventing the ability to detect if an adversary has compromised a data source.</definition>
        <rdfs:label>Missing Source Correlation of Multiple Independent Data</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1294 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1294">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-284"/>
        <cwe-id>CWE-1294</cwe-id>
        <definition>The System-on-Chip (SoC) implements a Security Identifier mechanism to differentiate what actions are allowed or disallowed when a transaction originates from an entity. However, the Security Identifiers are not correctly implemented.</definition>
        <rdfs:label>Insecure Security Identifier Mechanism</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1295 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1295">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-200"/>
        <cwe-id>CWE-1295</cwe-id>
        <definition>The product fails to adequately prevent the revealing of unnecessary and potentially sensitive system information within debugging messages.</definition>
        <rdfs:label>Debug Messages Revealing Unnecessary Information</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1296 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1296">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-284"/>
        <cwe-id>CWE-1296</cwe-id>
        <definition>The product&apos;s debug components contain incorrect chaining or granularity of debug components.</definition>
        <rdfs:label>Incorrect Chaining or Granularity of Debug Components</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1297 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1297">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-285"/>
        <cwe-id>CWE-1297</cwe-id>
        <definition>The product does not adequately protect confidential information on the device from being accessed by Outsourced Semiconductor Assembly and Test (OSAT) vendors.</definition>
        <rdfs:label>Unprotected Confidential Information on Device is Accessible by OSAT Vendors</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1298 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1298">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-362"/>
        <cwe-id>CWE-1298</cwe-id>
        <definition>A race condition in the hardware logic results in undermining security guarantees of the system.</definition>
        <rdfs:label>Hardware Logic Contains Race Conditions</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1299 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1299">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-288"/>
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-420"/>
        <cwe-id>CWE-1299</cwe-id>
        <definition>The lack of protections on alternate paths to access control-protected assets (such as unprotected shadow registers and other external facing unguarded interfaces) allows an attacker to bypass existing protections to the asset that are only performed against the primary path.</definition>
        <rdfs:label>Missing Protection Mechanism for Alternate Hardware Interface</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-13 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-13">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-260"/>
        <cwe-id>CWE-13</cwe-id>
        <definition>Storing a plaintext password in a configuration file allows anyone who can read the file access to the password-protected resource making them an easy target for attackers.</definition>
        <rdfs:label>ASP.NET Misconfiguration: Password in Configuration File</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-130 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-130">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-240"/>
        <cwe-id>CWE-130</cwe-id>
        <definition>The product parses a formatted message or structure, but it does not handle or incorrectly handles a length field that is inconsistent with the actual length of the associated data.</definition>
        <synonym>length manipulation</synonym>
        <synonym>length tampering</synonym>
        <rdfs:label>Improper Handling of Length Parameter Inconsistency</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1300 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1300">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-203"/>
        <cwe-id>CWE-1300</cwe-id>
        <definition>The device does not contain sufficient protection mechanisms to prevent physical side channels from exposing sensitive information due to patterns in physically observable phenomena such as variations in power consumption, electromagnetic emissions (EME), or acoustic emissions.</definition>
        <rdfs:label>Improper Protection of Physical Side Channels</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1301 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1301">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-226"/>
        <cwe-id>CWE-1301</cwe-id>
        <definition>The product&apos;s data removal process does not completely delete all data and potentially sensitive information within hardware components.</definition>
        <rdfs:label>Insufficient or Incomplete Data Removal within Hardware Component</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1302 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1302">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1294"/>
        <cwe-id>CWE-1302</cwe-id>
        <definition>The product implements a security identifier mechanism to differentiate what actions are allowed or disallowed when a transaction originates from an entity. A transaction is sent without a security identifier.</definition>
        <rdfs:label>Missing Security Identifier</rdfs:label>
        <rdfs:label>Missing Source Identifier in Entity Transactions on a System-On-Chip (SOC)</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1303 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1303">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1189"/>
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-203"/>
        <cwe-id>CWE-1303</cwe-id>
        <definition>Hardware structures shared across execution contexts (e.g., caches and branch predictors) can violate the expected architecture isolation between contexts.</definition>
        <rdfs:label>Non-Transparent Sharing of Microarchitectural Resources</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1304 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1304">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-284"/>
        <cwe-id>CWE-1304</cwe-id>
        <definition>The product performs a power save/restore operation, but it does not ensure that the integrity of the configuration state is maintained and/or verified between the beginning and ending of the operation.</definition>
        <rdfs:label>Improperly Preserved Integrity of Hardware Configuration State During a Power Save/Restore Operation</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-131 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-131">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-682"/>
        <cwe-id>CWE-131</cwe-id>
        <definition>The product does not correctly calculate the size to be used when allocating a buffer, which could lead to a buffer overflow.</definition>
        <rdfs:label>Incorrect Calculation of Buffer Size</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1310 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1310">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1329"/>
        <cwe-id>CWE-1310</cwe-id>
        <definition>Missing an ability to patch ROM code may leave a System or System-on-Chip (SoC) in a vulnerable state.</definition>
        <rdfs:label>Missing Ability to Patch ROM Code</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1311 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1311">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-284"/>
        <cwe-id>CWE-1311</cwe-id>
        <definition>The bridge incorrectly translates security attributes from either trusted to untrusted or from untrusted to trusted when converting from one fabric protocol to another.</definition>
        <rdfs:label>Improper Translation of Security Attributes by Fabric Bridge</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1312 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1312">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-284"/>
        <cwe-id>CWE-1312</cwe-id>
        <definition>The firewall in an on-chip fabric protects the main addressed region, but it does not protect any mirrored memory or memory-mapped-IO (MMIO) regions.</definition>
        <rdfs:label>Missing Protection for Mirrored Regions in On-Chip Fabric Firewall</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1313 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1313">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-284"/>
        <cwe-id>CWE-1313</cwe-id>
        <definition>During runtime, the hardware allows for test or debug logic (feature) to be activated, which allows for changing the state of the hardware. This feature can alter the intended behavior of the system and allow for alteration and leakage of sensitive data by an adversary.</definition>
        <rdfs:label>Hardware Allows Activation of Test or Debug Logic at Runtime</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1314 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1314">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-862"/>
        <cwe-id>CWE-1314</cwe-id>
        <definition>The device does not write-protect the parametric data values for sensors that scale the sensor value, allowing untrusted software to manipulate the apparent result and potentially damage hardware or cause operational failure.</definition>
        <rdfs:label>Missing Write Protection for Parametric Data Values</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1315 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1315">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-284"/>
        <cwe-id>CWE-1315</cwe-id>
        <definition>The bus controller enables bits in the fabric end-point to allow responder devices to control transactions on the fabric.</definition>
        <rdfs:label>Improper Setting of Bus Controlling Capability in Fabric End-point</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1316 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1316">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-284"/>
        <cwe-id>CWE-1316</cwe-id>
        <definition>The address map of the on-chip fabric has protected and unprotected regions overlapping, allowing an attacker to bypass access control to the overlapping portion of the protected region.</definition>
        <rdfs:label>Fabric-Address Map Allows Programming of Unwarranted Overlaps of Protected and Unprotected Ranges</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1317 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1317">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-284"/>
        <cwe-id>CWE-1317</cwe-id>
        <definition>The product uses a fabric bridge for transactions between two Intellectual Property (IP) blocks, but the bridge does not properly perform the expected privilege, identity, or other access control checks between those IP blocks.</definition>
        <rdfs:label>Improper Access Control in Fabric Bridge</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1318 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1318">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-693"/>
        <cwe-id>CWE-1318</cwe-id>
        <definition>On-chip fabrics or buses either do not support or are not configured to support privilege separation or other security features, such as access control.</definition>
        <rdfs:label>Missing Support for Security Features in On-chip Fabrics or Buses</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1319 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1319">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-693"/>
        <cwe-id>CWE-1319</cwe-id>
        <definition>The device is susceptible to electromagnetic fault injection attacks, causing device internal information to be compromised or security mechanisms to be bypassed.</definition>
        <rdfs:label>Improper Protection against Electromagnetic Fault Injection (EM-FI)</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1320 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1320">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-284"/>
        <cwe-id>CWE-1320</cwe-id>
        <definition>Untrusted agents can disable alerts about signal conditions exceeding limits or the response mechanism that handles such alerts.</definition>
        <rdfs:label>Improper Protection for Outbound Error Messages and Alert Signals</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1321 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1321">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-915"/>
        <cwe-id>CWE-1321</cwe-id>
        <definition>The product receives input from an upstream component that specifies attributes that are to be initialized or updated in an object, but it does not properly control modifications of attributes of the object prototype.</definition>
        <rdfs:label>Improperly Controlled Modification of Object Prototype Attributes (&apos;Prototype Pollution&apos;)</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1322 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1322">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-834"/>
        <cwe-id>CWE-1322</cwe-id>
        <definition>The product uses a non-blocking model that relies on a single threaded process for features such as scalability, but it contains code that can block when it is invoked.</definition>
        <rdfs:label>Use of Blocking Code in Single-threaded, Non-blocking Context</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1323 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1323">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-284"/>
        <cwe-id>CWE-1323</cwe-id>
        <definition>Trace data collected from several sources on the System-on-Chip (SoC) is stored in unprotected locations or transported to untrusted agents.</definition>
        <rdfs:label>Improper Management of Sensitive Trace Data</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1325 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1325">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-770"/>
        <cwe-id>CWE-1325</cwe-id>
        <definition>The product manages a group of objects or resources and performs a separate memory allocation for each object, but it does not properly limit the total amount of memory that is consumed by all of the combined objects.</definition>
        <synonym>Stack Exhaustion</synonym>
        <rdfs:label>Improperly Controlled Sequential Memory Allocation</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1326 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1326">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-693"/>
        <cwe-id>CWE-1326</cwe-id>
        <definition>A missing immutable root of trust in the hardware results in the ability to bypass secure boot or execute untrusted or adversarial boot code.</definition>
        <rdfs:label>Missing Immutable Root of Trust in Hardware</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1327 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1327">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-668"/>
        <cwe-id>CWE-1327</cwe-id>
        <definition>The product assigns the address 0.0.0.0 for a database server, a cloud service/instance, or any computing resource that communicates remotely.</definition>
        <rdfs:label>Binding to an Unrestricted IP Address</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1328 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1328">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-285"/>
        <cwe-id>CWE-1328</cwe-id>
        <definition>Security-version number in hardware is mutable, resulting in the ability to downgrade (roll-back) the boot firmware to vulnerable code versions.</definition>
        <rdfs:label>Security Version Number Mutable to Older Versions</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1329 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1329">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1357"/>
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-664"/>
        <cwe-id>CWE-1329</cwe-id>
        <definition>The product contains a component that cannot be updated or patched in order to remove vulnerabilities or significant bugs.</definition>
        <rdfs:label>Reliance on Component That is Not Updateable</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1330 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1330">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1301"/>
        <cwe-id>CWE-1330</cwe-id>
        <definition>Confidential information stored in memory circuits is readable or recoverable after being cleared or erased.</definition>
        <rdfs:label>Remanent Data Readable after Memory Erase</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1331 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1331">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-653"/>
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-668"/>
        <cwe-id>CWE-1331</cwe-id>
        <definition>The Network On Chip (NoC) does not isolate or incorrectly isolates its on-chip-fabric and internal resources such that they are shared between trusted and untrusted agents, creating timing channels.</definition>
        <rdfs:label>Improper Isolation of Shared Resources in Network On Chip (NoC)</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1332 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1332">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1384"/>
        <cwe-id>CWE-1332</cwe-id>
        <definition>The device is missing or incorrectly implements circuitry or sensors that detect and mitigate the skipping of security-critical CPU instructions when they occur.</definition>
        <rdfs:label>Improper Handling of Faults that Lead to Instruction Skips</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1333 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1333">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-407"/>
        <cwe-id>CWE-1333</cwe-id>
        <definition>The product uses a regular expression with an inefficient, possibly exponential worst-case computational complexity that consumes excessive CPU cycles.</definition>
        <synonym>Catastrophic backtracking</synonym>
        <synonym>ReDoS</synonym>
        <synonym>Regular Expression Denial of Service</synonym>
        <rdfs:label>Inefficient Regular Expression Complexity</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1334 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1334">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-284"/>
        <cwe-id>CWE-1334</cwe-id>
        <definition>An unauthorized agent can inject errors into a redundant block to deprive the system of redundancy or put the system in a degraded operating mode.</definition>
        <rdfs:label>Unauthorized Error Injection Can Degrade Hardware Redundancy</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1335 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1335">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-682"/>
        <cwe-id>CWE-1335</cwe-id>
        <definition>An integer value is specified to be shifted by a negative amount or an amount greater than or equal to the number of bits contained in the value causing an unexpected or indeterminate result.</definition>
        <rdfs:label>Incorrect Bitwise Shift of Integer</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1336 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1336">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-94"/>
        <cwe-id>CWE-1336</cwe-id>
        <definition>The product uses a template engine to insert or process externally-influenced input, but it does not neutralize or incorrectly neutralizes special elements or syntax that can be interpreted as template expressions or other code directives when processed by the engine.</definition>
        <synonym>Client-Side Template Injection / CSTI</synonym>
        <synonym>Server-Side Template Injection / SSTI</synonym>
        <rdfs:label>Improper Neutralization of Special Elements Used in a Template Engine</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1338 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1338">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-693"/>
        <cwe-id>CWE-1338</cwe-id>
        <definition>A hardware device is missing or has inadequate protection features to prevent overheating.</definition>
        <rdfs:label>Improper Protections Against Hardware Overheating</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1339 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1339">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-682"/>
        <cwe-id>CWE-1339</cwe-id>
        <definition>The product processes a real number with an implementation in which the number&apos;s representation does not preserve required accuracy and precision in its fractional part, causing an incorrect result.</definition>
        <rdfs:label>Insufficient Precision or Accuracy of a Real Number</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-134 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-134">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-668"/>
        <cwe-id>CWE-134</cwe-id>
        <definition>The product uses a function that accepts a format string as an argument, but the format string originates from an external source.</definition>
        <rdfs:label>Use of Externally-Controlled Format String</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1341 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1341">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-675"/>
        <cwe-id>CWE-1341</cwe-id>
        <definition>The product attempts to close or release a resource or handle more than once, without any successful open between the close operations.</definition>
        <rdfs:label>Multiple Releases of Same Resource or Handle</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1342 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1342">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-226"/>
        <cwe-id>CWE-1342</cwe-id>
        <definition>The processor does not properly clear microarchitectural state after incorrect microcode assists or speculative execution, resulting in transient execution.</definition>
        <rdfs:label>Information Exposure through Microarchitectural State after Transient Execution</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-135 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-135">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-682"/>
        <cwe-id>CWE-135</cwe-id>
        <definition>The product does not correctly calculate the length of strings that can contain wide or multi-byte characters.</definition>
        <rdfs:label>Incorrect Calculation of Multi-Byte String Length</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1351 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1351">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1384"/>
        <cwe-id>CWE-1351</cwe-id>
        <definition>A hardware device, or the firmware running on it, is missing or has incorrect protection features to maintain goals of security primitives when the device is cooled below standard operating temperatures.</definition>
        <rdfs:label>Improper Handling of Hardware Behavior in Exceptionally Cold Environments</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1357 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1357">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-710"/>
        <cwe-id>CWE-1357</cwe-id>
        <definition>The product is built from multiple separate components, but it uses a component that is not sufficiently trusted to meet expectations for security, reliability, updateability, and maintainability.</definition>
        <rdfs:label>Reliance on Insufficiently Trustworthy Component</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-138 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-138">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-707"/>
        <cwe-id>CWE-138</cwe-id>
        <definition>The product receives input from an upstream component, but it does not neutralize or incorrectly neutralizes special elements that could be interpreted as control elements or syntactic markers when they are sent to a downstream component.</definition>
        <rdfs:label>Improper Neutralization of Special Elements</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1384 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1384">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-703"/>
        <cwe-id>CWE-1384</cwe-id>
        <definition>The product does not properly handle unexpected physical or environmental conditions that occur naturally or are artificially induced.</definition>
        <rdfs:label>Improper Handling of Physical or Environmental Conditions</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1385 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1385">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-346"/>
        <cwe-id>CWE-1385</cwe-id>
        <definition>The product uses a WebSocket, but it does not properly verify that the source of data or communication is valid.</definition>
        <synonym>Cross-Site WebSocket hijacking (CSWSH)</synonym>
        <rdfs:label>Missing Origin Validation in WebSockets</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1386 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1386">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-59"/>
        <cwe-id>CWE-1386</cwe-id>
        <definition>The product opens a file or directory, but it does not properly prevent the name from being associated with a junction or mount point to a destination that is outside of the intended control sphere.</definition>
        <rdfs:label>Insecure Operation on Windows Junction / Mount Point</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1389 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1389">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-704"/>
        <cwe-id>CWE-1389</cwe-id>
        <definition>The product parses numeric input assuming base 10 (decimal) values, but it does not account for inputs that use a different base number (radix).</definition>
        <rdfs:label>Incorrect Parsing of Numbers with Different Radices</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1390 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1390">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-287"/>
        <cwe-id>CWE-1390</cwe-id>
        <definition>The product uses an authentication mechanism to restrict access to specific users or identities, but the mechanism does not sufficiently prove that the claimed identity is correct.</definition>
        <rdfs:label>Weak Authentication</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1391 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1391">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1390"/>
        <cwe-id>CWE-1391</cwe-id>
        <definition>The product uses weak credentials (such as a default key or hard-coded password) that can be calculated, derived, reused, or guessed by an attacker.</definition>
        <rdfs:label>Use of Weak Credentials</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1392 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1392">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1391"/>
        <cwe-id>CWE-1392</cwe-id>
        <definition>The product uses default credentials (such as passwords or cryptographic keys) for potentially critical functionality.</definition>
        <rdfs:label>Use of Default Credentials</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1393 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1393">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1392"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#weakness-of"/>
                <owl:someValuesFrom rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#UserAccount"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1394 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1394">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1392"/>
        <cwe-id>CWE-1394</cwe-id>
        <definition>The product uses a default cryptographic key for potentially critical functionality.</definition>
        <rdfs:label>Use of Default Cryptographic Key</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1395 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1395">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-657"/>
        <cwe-id>CWE-1395</cwe-id>
        <definition>The product has a dependency on a third-party component that contains one or more known vulnerabilities.</definition>
        <rdfs:label>Dependency on Vulnerable Third-Party Component</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-14 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-14">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-733"/>
        <cwe-id>CWE-14</cwe-id>
        <definition>Sensitive memory is cleared according to the source code, but compiler optimizations leave the memory untouched when it is not read from again, aka &quot;dead store removal.&quot;</definition>
        <rdfs:label>Compiler Removal of Code to Clear Buffers</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-140 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-140">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-138"/>
        <cwe-id>CWE-140</cwe-id>
        <definition>The product does not neutralize or incorrectly neutralizes delimiters.</definition>
        <rdfs:label>Improper Neutralization of Delimiters</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-141 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-141">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-140"/>
        <cwe-id>CWE-141</cwe-id>
        <definition>The product receives input from an upstream component, but it does not neutralize or incorrectly neutralizes special elements that could be interpreted as parameter or argument delimiters when they are sent to a downstream component.</definition>
        <rdfs:label>Improper Neutralization of Parameter/Argument Delimiters</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1419 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1419">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-665"/>
        <cwe-id>CWE-1419</cwe-id>
        <definition>The product attempts to initialize a resource but does not correctly do so, which might leave the resource in an unexpected, incorrect, or insecure state when it is accessed.</definition>
        <rdfs:label>Incorrect Initialization of Resource</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-142 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-142">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-140"/>
        <cwe-id>CWE-142</cwe-id>
        <definition>The product receives input from an upstream component, but it does not neutralize or incorrectly neutralizes special elements that could be interpreted as value delimiters when they are sent to a downstream component.</definition>
        <rdfs:label>Improper Neutralization of Value Delimiters</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1420 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1420">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-669"/>
        <cwe-id>CWE-1420</cwe-id>
        <definition>A processor event or prediction may allow incorrect operations (or correct operations with incorrect data) to execute transiently, potentially exposing data over a covert channel.</definition>
        <rdfs:label>Exposure of Sensitive Information during Transient Execution</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1421 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1421">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1420"/>
        <cwe-id>CWE-1421</cwe-id>
        <definition>A processor event may allow transient operations to access architecturally restricted data (for example, in another address space) in a shared microarchitectural structure (for example, a CPU cache), potentially exposing the data over a covert channel.</definition>
        <rdfs:label>Exposure of Sensitive Information in Shared Microarchitectural Structures during Transient Execution</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1422 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1422">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1420"/>
        <cwe-id>CWE-1422</cwe-id>
        <definition>A processor event or prediction may allow incorrect or stale data to be forwarded to transient operations, potentially exposing data over a covert channel.</definition>
        <rdfs:label>Exposure of Sensitive Information caused by Incorrect Data Forwarding during Transient Execution</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1423 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1423">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1420"/>
        <cwe-id>CWE-1423</cwe-id>
        <definition>Shared microarchitectural predictor state may allow code to influence transient execution across a hardware boundary, potentially exposing data that is accessible beyond the boundary over a covert channel.</definition>
        <rdfs:label>Exposure of Sensitive Information caused by Shared Microarchitectural Predictor State that Influences Transient Execution</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1426 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1426">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-707"/>
        <cwe-id>CWE-1426</cwe-id>
        <definition>The product invokes a generative AI/ML component whose behaviors and outputs cannot be directly controlled, but the product does not validate or insufficiently validates the outputs to ensure that they align with the intended security, content, or privacy policy.</definition>
        <rdfs:label>Improper Validation of Generative AI Output</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1427 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1427">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-77"/>
        <cwe-id>CWE-1427</cwe-id>
        <definition>The product uses externally-provided data to build prompts provided to large language models (LLMs), but the way these prompts are constructed causes the LLM to fail to distinguish between user-supplied inputs and developer provided system directives.</definition>
        <synonym>prompt injection</synonym>
        <rdfs:label>Improper Neutralization of Input Used for LLM Prompting</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1428 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1428">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-319"/>
        <cwe-id>CWE-1428</cwe-id>
        <definition>The product provides or relies on use of HTTP communications when HTTPS is available.</definition>
        <rdfs:label>Reliance on HTTP instead of HTTPS</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1429 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1429">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-223"/>
        <cwe-id>CWE-1429</cwe-id>
        <definition>The product has a hardware interface that silently discards operations in situations for which feedback would be security-relevant, such as the timely detection of failures or attacks.</definition>
        <rdfs:label>Missing Security-Relevant Feedback for Unexecuted Operations in Hardware Interface</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-143 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-143">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-140"/>
        <cwe-id>CWE-143</cwe-id>
        <definition>The product receives input from an upstream component, but it does not neutralize or incorrectly neutralizes special elements that could be interpreted as record delimiters when they are sent to a downstream component.</definition>
        <rdfs:label>Improper Neutralization of Record Delimiters</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1431 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1431">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-200"/>
        <cwe-id>CWE-1431</cwe-id>
        <definition>The product uses a hardware module implementing a cryptographic algorithm that writes sensitive information about the intermediate state or results of its cryptographic operations via one of its output wires (typically the output port containing the final result).</definition>
        <rdfs:label>Driving Intermediate Cryptographic State/Results to Hardware Module Outputs</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-144 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-144">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-140"/>
        <cwe-id>CWE-144</cwe-id>
        <definition>The product receives input from an upstream component, but it does not neutralize or incorrectly neutralizes special elements that could be interpreted as line delimiters when they are sent to a downstream component.</definition>
        <rdfs:label>Improper Neutralization of Line Delimiters</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-145 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-145">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-140"/>
        <cwe-id>CWE-145</cwe-id>
        <definition>The product receives input from an upstream component, but it does not neutralize or incorrectly neutralizes special elements that could be interpreted as section delimiters when they are sent to a downstream component.</definition>
        <rdfs:label>Improper Neutralization of Section Delimiters</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-146 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-146">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-140"/>
        <cwe-id>CWE-146</cwe-id>
        <definition>The product receives input from an upstream component, but it does not neutralize or incorrectly neutralizes special elements that could be interpreted as expression or command delimiters when they are sent to a downstream component.</definition>
        <rdfs:label>Improper Neutralization of Expression/Command Delimiters</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-147 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-147">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-138"/>
        <cwe-id>CWE-147</cwe-id>
        <definition>The product receives input from an upstream component, but it does not neutralize or incorrectly neutralizes special elements that could be interpreted as input terminators when they are sent to a downstream component.</definition>
        <rdfs:label>Improper Neutralization of Input Terminators</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-148 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-148">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-138"/>
        <cwe-id>CWE-148</cwe-id>
        <definition>The product does not properly handle when a leading character or sequence (&quot;leader&quot;) is missing or malformed, or if multiple leaders are used when only one should be allowed.</definition>
        <rdfs:label>Improper Neutralization of Input Leaders</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-149 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-149">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-138"/>
        <cwe-id>CWE-149</cwe-id>
        <definition>Quotes injected into a product can be used to compromise a system. As data are parsed, an injected/absent/duplicate/malformed use of quotes may cause the process to take unexpected actions.</definition>
        <rdfs:label>Improper Neutralization of Quoting Syntax</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-15 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-15">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-610"/>
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-642"/>
        <cwe-id>CWE-15</cwe-id>
        <definition>One or more system settings or configuration elements can be externally controlled by a user.</definition>
        <rdfs:label>External Control of System or Configuration Setting</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-150 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-150">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-138"/>
        <cwe-id>CWE-150</cwe-id>
        <definition>The product receives input from an upstream component, but it does not neutralize or incorrectly neutralizes special elements that could be interpreted as escape, meta, or control character sequences when they are sent to a downstream component.</definition>
        <rdfs:label>Improper Neutralization of Escape, Meta, or Control Sequences</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-151 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-151">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-138"/>
        <cwe-id>CWE-151</cwe-id>
        <definition>The product receives input from an upstream component, but it does not neutralize or incorrectly neutralizes special elements that could be interpreted as comment delimiters when they are sent to a downstream component.</definition>
        <rdfs:label>Improper Neutralization of Comment Delimiters</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-152 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-152">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-138"/>
        <cwe-id>CWE-152</cwe-id>
        <definition>The product receives input from an upstream component, but it does not neutralize or incorrectly neutralizes special elements that could be interpreted as macro symbols when they are sent to a downstream component.</definition>
        <rdfs:label>Improper Neutralization of Macro Symbols</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-153 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-153">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-138"/>
        <cwe-id>CWE-153</cwe-id>
        <definition>The product receives input from an upstream component, but it does not neutralize or incorrectly neutralizes special elements that could be interpreted as substitution characters when they are sent to a downstream component.</definition>
        <rdfs:label>Improper Neutralization of Substitution Characters</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-154 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-154">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-138"/>
        <cwe-id>CWE-154</cwe-id>
        <definition>The product receives input from an upstream component, but it does not neutralize or incorrectly neutralizes special elements that could be interpreted as variable name delimiters when they are sent to a downstream component.</definition>
        <rdfs:label>Improper Neutralization of Variable Name Delimiters</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-155 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-155">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-138"/>
        <cwe-id>CWE-155</cwe-id>
        <definition>The product receives input from an upstream component, but it does not neutralize or incorrectly neutralizes special elements that could be interpreted as wildcards or matching symbols when they are sent to a downstream component.</definition>
        <rdfs:label>Improper Neutralization of Wildcards or Matching Symbols</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-156 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-156">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-138"/>
        <cwe-id>CWE-156</cwe-id>
        <definition>The product receives input from an upstream component, but it does not neutralize or incorrectly neutralizes special elements that could be interpreted as whitespace when they are sent to a downstream component.</definition>
        <synonym>White space</synonym>
        <rdfs:label>Improper Neutralization of Whitespace</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-157 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-157">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-138"/>
        <cwe-id>CWE-157</cwe-id>
        <definition>The product does not properly handle the characters that are used to mark the beginning and ending of a group of entities, such as parentheses, brackets, and braces.</definition>
        <rdfs:label>Failure to Sanitize Paired Delimiters</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-158 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-158">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-138"/>
        <cwe-id>CWE-158</cwe-id>
        <definition>The product receives input from an upstream component, but it does not neutralize or incorrectly neutralizes NUL characters or null bytes when they are sent to a downstream component.</definition>
        <rdfs:label>Improper Neutralization of Null Byte or NUL Character</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-159 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-159">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-138"/>
        <cwe-id>CWE-159</cwe-id>
        <definition>The product does not properly filter, remove, quote, or otherwise manage the invalid use of special elements in user-controlled input, which could cause adverse effect on its behavior and integrity.</definition>
        <rdfs:label>Improper Handling of Invalid Use of Special Elements</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-160 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-160">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-138"/>
        <cwe-id>CWE-160</cwe-id>
        <definition>The product receives input from an upstream component, but it does not neutralize or incorrectly neutralizes leading special elements that could be interpreted in unexpected ways when they are sent to a downstream component.</definition>
        <rdfs:label>Improper Neutralization of Leading Special Elements</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-161 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-161">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-160"/>
        <cwe-id>CWE-161</cwe-id>
        <definition>The product receives input from an upstream component, but it does not neutralize or incorrectly neutralizes multiple leading special elements that could be interpreted in unexpected ways when they are sent to a downstream component.</definition>
        <rdfs:label>Improper Neutralization of Multiple Leading Special Elements</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-162 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-162">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-138"/>
        <cwe-id>CWE-162</cwe-id>
        <definition>The product receives input from an upstream component, but it does not neutralize or incorrectly neutralizes trailing special elements that could be interpreted in unexpected ways when they are sent to a downstream component.</definition>
        <rdfs:label>Improper Neutralization of Trailing Special Elements</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-163 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-163">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-162"/>
        <cwe-id>CWE-163</cwe-id>
        <definition>The product receives input from an upstream component, but it does not neutralize or incorrectly neutralizes multiple trailing special elements that could be interpreted in unexpected ways when they are sent to a downstream component.</definition>
        <rdfs:label>Improper Neutralization of Multiple Trailing Special Elements</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-164 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-164">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-138"/>
        <cwe-id>CWE-164</cwe-id>
        <definition>The product receives input from an upstream component, but it does not neutralize or incorrectly neutralizes internal special elements that could be interpreted in unexpected ways when they are sent to a downstream component.</definition>
        <rdfs:label>Improper Neutralization of Internal Special Elements</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-165 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-165">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-164"/>
        <cwe-id>CWE-165</cwe-id>
        <definition>The product receives input from an upstream component, but it does not neutralize or incorrectly neutralizes multiple internal special elements that could be interpreted in unexpected ways when they are sent to a downstream component.</definition>
        <rdfs:label>Improper Neutralization of Multiple Internal Special Elements</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-166 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-166">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-159"/>
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-228"/>
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-703"/>
        <cwe-id>CWE-166</cwe-id>
        <definition>The product receives input from an upstream component, but it does not handle or incorrectly handles when an expected special element is missing.</definition>
        <rdfs:label>Improper Handling of Missing Special Element</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-167 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-167">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-159"/>
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-228"/>
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-703"/>
        <cwe-id>CWE-167</cwe-id>
        <definition>The product receives input from an upstream component, but it does not handle or incorrectly handles when an additional unexpected special element is provided.</definition>
        <rdfs:label>Improper Handling of Additional Special Element</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-168 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-168">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-159"/>
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-228"/>
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-703"/>
        <cwe-id>CWE-168</cwe-id>
        <definition>The product does not properly handle input in which an inconsistency exists between two or more special characters or reserved words.</definition>
        <rdfs:label>Improper Handling of Inconsistent Special Elements</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-170 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-170">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-707"/>
        <cwe-id>CWE-170</cwe-id>
        <definition>The product does not terminate or incorrectly terminates a string or array with a null character or equivalent terminator.</definition>
        <rdfs:label>Improper Null Termination</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-172 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-172">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-707"/>
        <cwe-id>CWE-172</cwe-id>
        <definition>The product does not properly encode or decode the data, resulting in unexpected values.</definition>
        <rdfs:label>Encoding Error</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-173 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-173">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-172"/>
        <cwe-id>CWE-173</cwe-id>
        <definition>The product does not properly handle when an input uses an alternate encoding that is valid for the control sphere to which the input is being sent.</definition>
        <rdfs:label>Improper Handling of Alternate Encoding</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-174 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-174">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-172"/>
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-675"/>
        <cwe-id>CWE-174</cwe-id>
        <definition>The product decodes the same input twice, which can limit the effectiveness of any protection mechanism that occurs in between the decoding operations.</definition>
        <rdfs:label>Double Decoding of the Same Data</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-175 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-175">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-172"/>
        <cwe-id>CWE-175</cwe-id>
        <definition>The product does not properly handle when the same input uses several different (mixed) encodings.</definition>
        <rdfs:label>Improper Handling of Mixed Encoding</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-176 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-176">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-172"/>
        <cwe-id>CWE-176</cwe-id>
        <definition>The product does not properly handle when an input contains Unicode encoding.</definition>
        <rdfs:label>Improper Handling of Unicode Encoding</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-177 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-177">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-172"/>
        <cwe-id>CWE-177</cwe-id>
        <definition>The product does not properly handle when all or part of an input has been URL encoded.</definition>
        <rdfs:label>Improper Handling of URL Encoding (Hex Encoding)</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-178 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-178">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-706"/>
        <cwe-id>CWE-178</cwe-id>
        <definition>The product does not properly account for differences in case sensitivity when accessing or determining the properties of a resource, leading to inconsistent results.</definition>
        <rdfs:label>Improper Handling of Case Sensitivity</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-179 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-179">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-20"/>
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-696"/>
        <cwe-id>CWE-179</cwe-id>
        <definition>The product validates input before applying protection mechanisms that modify the input, which could allow an attacker to bypass the validation via dangerous inputs that only arise after the modification.</definition>
        <rdfs:label>Incorrect Behavior Order: Early Validation</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-180 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-180">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-179"/>
        <cwe-id>CWE-180</cwe-id>
        <definition>The product validates input before it is canonicalized, which prevents the product from detecting data that becomes invalid after the canonicalization step.</definition>
        <rdfs:label>Incorrect Behavior Order: Validate Before Canonicalize</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-181 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-181">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-179"/>
        <cwe-id>CWE-181</cwe-id>
        <definition>The product validates data before it has been filtered, which prevents the product from detecting data that becomes invalid after the filtering step.</definition>
        <synonym>Validate-before-cleanse</synonym>
        <rdfs:label>Incorrect Behavior Order: Validate Before Filter</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-182 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-182">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-693"/>
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-707"/>
        <cwe-id>CWE-182</cwe-id>
        <definition>The product filters data in a way that causes it to be reduced or &quot;collapsed&quot; into an unsafe value that violates an expected security property.</definition>
        <rdfs:label>Collapse of Data into Unsafe Value</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-183 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-183">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-697"/>
        <cwe-id>CWE-183</cwe-id>
        <definition>The product implements a protection mechanism that relies on a list of inputs (or properties of inputs) that are explicitly allowed by policy because the inputs are assumed to be safe, but the list is too permissive - that is, it allows an input that is unsafe, leading to resultant weaknesses.</definition>
        <synonym>Allowlist / Allow List</synonym>
        <synonym>Safelist / Safe List</synonym>
        <synonym>Whitelist / White List</synonym>
        <rdfs:label>Permissive List of Allowed Inputs</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-184 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-184">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1023"/>
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-693"/>
        <cwe-id>CWE-184</cwe-id>
        <definition>The product implements a protection mechanism that relies on a list of inputs (or properties of inputs) that are not allowed by policy or otherwise require other action to neutralize before additional processing takes place, but the list is incomplete.</definition>
        <synonym>Blacklist / Black List</synonym>
        <synonym>Blocklist / Block List</synonym>
        <synonym>Denylist / Deny List</synonym>
        <rdfs:label>Incomplete List of Disallowed Inputs</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-185 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-185">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-697"/>
        <cwe-id>CWE-185</cwe-id>
        <definition>The product specifies a regular expression in a way that causes data to be improperly matched or compared.</definition>
        <rdfs:label>Incorrect Regular Expression</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-186 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-186">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-185"/>
        <cwe-id>CWE-186</cwe-id>
        <definition>A regular expression is overly restrictive, which prevents dangerous values from being detected.</definition>
        <rdfs:label>Overly Restrictive Regular Expression</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-187 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-187">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1023"/>
        <cwe-id>CWE-187</cwe-id>
        <definition>The product performs a comparison that only examines a portion of a factor before determining whether there is a match, such as a substring, leading to resultant weaknesses.</definition>
        <rdfs:label>Partial String Comparison</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-188 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-188">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1105"/>
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-435"/>
        <cwe-id>CWE-188</cwe-id>
        <definition>The product makes invalid assumptions about how protocol data or memory is organized at a lower level, resulting in unintended program behavior.</definition>
        <rdfs:label>Reliance on Data/Memory Layout</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-190 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-190">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-682"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#weakness-of"/>
                <owl:someValuesFrom rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#MathematicalFunction"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-191 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-191">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-682"/>
        <cwe-id>CWE-191</cwe-id>
        <definition>The product subtracts one value from another, such that the result is less than the minimum allowable integer value, which produces a value that is not equal to the correct result.</definition>
        <synonym>Integer underflow</synonym>
        <rdfs:label>Integer Underflow (Wrap or Wraparound)</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-192 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-192">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-681"/>
        <cwe-id>CWE-192</cwe-id>
        <definition>Integer coercion refers to a set of flaws pertaining to the type casting, extension, or truncation of primitive data types.</definition>
        <rdfs:label>Integer Coercion Error</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-193 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-193">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-682"/>
        <cwe-id>CWE-193</cwe-id>
        <definition>A product calculates or uses an incorrect maximum or minimum value that is 1 more, or 1 less, than the correct value.</definition>
        <synonym>off-by-five</synonym>
        <rdfs:label>Off-by-one Error</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-194 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-194">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-681"/>
        <cwe-id>CWE-194</cwe-id>
        <definition>The product performs an operation on a number that causes it to be sign extended when it is transformed into a larger data type. When the original number is negative, this can produce unexpected values that lead to resultant weaknesses.</definition>
        <rdfs:label>Unexpected Sign Extension</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-195 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-195">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-681"/>
        <cwe-id>CWE-195</cwe-id>
        <definition>The product uses a signed primitive and performs a cast to an unsigned primitive, which can produce an unexpected value if the value of the signed primitive can not be represented using an unsigned primitive.</definition>
        <rdfs:label>Signed to Unsigned Conversion Error</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-196 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-196">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-681"/>
        <cwe-id>CWE-196</cwe-id>
        <definition>The product uses an unsigned primitive and performs a cast to a signed primitive, which can produce an unexpected value if the value of the unsigned primitive can not be represented using a signed primitive.</definition>
        <rdfs:label>Unsigned to Signed Conversion Error</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-197 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-197">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-681"/>
        <cwe-id>CWE-197</cwe-id>
        <definition>Truncation errors occur when a primitive is cast to a primitive of a smaller size and data is lost in the conversion.</definition>
        <rdfs:label>Numeric Truncation Error</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-198 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-198">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-188"/>
        <cwe-id>CWE-198</cwe-id>
        <definition>The product receives input from an upstream component, but it does not account for byte ordering (e.g. big-endian and little-endian) when processing the input, causing an incorrect number or value to be used.</definition>
        <rdfs:label>Use of Incorrect Byte Ordering</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-20 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-20">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-707"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#weakness-of"/>
                <owl:someValuesFrom rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#UserInputFunction"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-200 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-200">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-668"/>
        <cwe-id>CWE-200</cwe-id>
        <definition>The product exposes sensitive information to an actor that is not explicitly authorized to have access to that information.</definition>
        <synonym>Information Disclosure</synonym>
        <synonym>Information Leak</synonym>
        <rdfs:label>Exposure of Sensitive Information to an Unauthorized Actor</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-201 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-201">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-200"/>
        <cwe-id>CWE-201</cwe-id>
        <definition>The code transmits data to another actor, but a portion of the data includes sensitive information that should not be accessible to that actor.</definition>
        <rdfs:label>Insertion of Sensitive Information Into Sent Data</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-202 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-202">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1230"/>
        <cwe-id>CWE-202</cwe-id>
        <definition>When trying to keep information confidential, an attacker can often infer some of the information by using statistics.</definition>
        <rdfs:label>Exposure of Sensitive Information Through Data Queries</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-203 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-203">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-200"/>
        <cwe-id>CWE-203</cwe-id>
        <definition>The product behaves differently or sends different responses under different circumstances in a way that is observable to an unauthorized actor, which exposes security-relevant information about the state of the product, such as whether a particular operation was successful or not.</definition>
        <synonym>Side Channel Attack</synonym>
        <rdfs:label>Observable Discrepancy</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-204 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-204">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-203"/>
        <cwe-id>CWE-204</cwe-id>
        <definition>The product provides different responses to incoming requests in a way that reveals internal state information to an unauthorized actor outside of the intended control sphere.</definition>
        <rdfs:label>Observable Response Discrepancy</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-205 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-205">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-203"/>
        <cwe-id>CWE-205</cwe-id>
        <definition>The product&apos;s behaviors indicate important differences that may be observed by unauthorized actors in a way that reveals (1) its internal state or decision process, or (2) differences from other products with equivalent functionality.</definition>
        <rdfs:label>Observable Behavioral Discrepancy</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-206 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-206">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-205"/>
        <cwe-id>CWE-206</cwe-id>
        <definition>The product performs multiple behaviors that are combined to produce a single result, but the individual behaviors are observable separately in a way that allows attackers to reveal internal state or internal decision points.</definition>
        <rdfs:label>Observable Internal Behavioral Discrepancy</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-207 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-207">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-205"/>
        <cwe-id>CWE-207</cwe-id>
        <definition>The product operates in an environment in which its existence or specific identity should not be known, but it behaves differently than other products with equivalent functionality, in a way that is observable to an attacker.</definition>
        <rdfs:label>Observable Behavioral Discrepancy With Equivalent Products</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-208 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-208">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-203"/>
        <cwe-id>CWE-208</cwe-id>
        <definition>Two separate operations in a product require different amounts of time to complete, in a way that is observable to an actor and reveals security-relevant information about the state of the product, such as whether a particular operation was successful or not.</definition>
        <rdfs:label>Observable Timing Discrepancy</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-209 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-209">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-200"/>
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-755"/>
        <cwe-id>CWE-209</cwe-id>
        <definition>The product generates an error message that includes sensitive information about its environment, users, or associated data.</definition>
        <rdfs:label>Generation of Error Message Containing Sensitive Information</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-210 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-210">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-209"/>
        <cwe-id>CWE-210</cwe-id>
        <definition>The product identifies an error condition and creates its own diagnostic or error messages that contain sensitive information.</definition>
        <rdfs:label>Self-generated Error Message Containing Sensitive Information</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-211 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-211">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-209"/>
        <cwe-id>CWE-211</cwe-id>
        <definition>The product performs an operation that triggers an external diagnostic or error message that is not directly generated or controlled by the product, such as an error generated by the programming language interpreter that a software application uses. The error can contain sensitive system information.</definition>
        <rdfs:label>Externally-Generated Error Message Containing Sensitive Information</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-212 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-212">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-669"/>
        <cwe-id>CWE-212</cwe-id>
        <definition>The product stores, transfers, or shares a resource that contains sensitive information, but it does not properly remove that information before the product makes the resource available to unauthorized actors.</definition>
        <rdfs:label>Improper Removal of Sensitive Information Before Storage or Transfer</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-213 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-213">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-200"/>
        <cwe-id>CWE-213</cwe-id>
        <definition>The product&apos;s intended functionality exposes information to certain actors in accordance with the developer&apos;s security policy, but this information is regarded as sensitive according to the intended security policies of other stakeholders such as the product&apos;s administrator, users, or others whose information is being processed.</definition>
        <rdfs:label>Exposure of Sensitive Information Due to Incompatible Policies</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-214 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-214">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-497"/>
        <cwe-id>CWE-214</cwe-id>
        <definition>A process is invoked with sensitive command-line arguments, environment variables, or other elements that can be seen by other processes on the operating system.</definition>
        <rdfs:label>Invocation of Process Using Visible Sensitive Information</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-215 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-215">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-200"/>
        <cwe-id>CWE-215</cwe-id>
        <definition>The product inserts sensitive information into debugging code, which could expose this information if the debugging code is not disabled in production.</definition>
        <rdfs:label>Insertion of Sensitive Information Into Debugging Code</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-219 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-219">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-552"/>
        <cwe-id>CWE-219</cwe-id>
        <definition>The product stores sensitive data under the web document root with insufficient access control, which might make it accessible to untrusted parties.</definition>
        <rdfs:label>Storage of File with Sensitive Data Under Web Root</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-22 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-22">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-668"/>
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-706"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#weakness-of"/>
                <owl:someValuesFrom rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#UserInputFunction"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-220 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-220">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-552"/>
        <cwe-id>CWE-220</cwe-id>
        <definition>The product stores sensitive data under the FTP server root with insufficient access control, which might make it accessible to untrusted parties.</definition>
        <rdfs:label>Storage of File With Sensitive Data Under FTP Root</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-221 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-221">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-664"/>
        <cwe-id>CWE-221</cwe-id>
        <definition>The product does not record, or improperly records, security-relevant information that leads to an incorrect decision or hampers later analysis.</definition>
        <rdfs:label>Information Loss or Omission</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-222 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-222">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-221"/>
        <cwe-id>CWE-222</cwe-id>
        <definition>The product truncates the display, recording, or processing of security-relevant information in a way that can obscure the source or nature of an attack.</definition>
        <rdfs:label>Truncation of Security-relevant Information</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-223 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-223">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-221"/>
        <cwe-id>CWE-223</cwe-id>
        <definition>The product does not record or display information that would be important for identifying the source or nature of an attack, or determining if an action is safe.</definition>
        <rdfs:label>Omission of Security-relevant Information</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-224 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-224">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-221"/>
        <cwe-id>CWE-224</cwe-id>
        <definition>The product records security-relevant information according to an alternate name of the affected entity, instead of the canonical name.</definition>
        <rdfs:label>Obscured Security-relevant Information by Alternate Name</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-226 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-226">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-212"/>
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-459"/>
        <cwe-id>CWE-226</cwe-id>
        <definition>The product releases a resource such as memory or a file so that it can be made available for reuse, but it does not clear or &quot;zeroize&quot; the information contained in the resource before the product performs a critical state transition or makes the resource available for reuse by other entities.</definition>
        <rdfs:label>Sensitive Information in Resource Not Removed Before Reuse</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-228 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-228">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-703"/>
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-707"/>
        <cwe-id>CWE-228</cwe-id>
        <definition>The product does not handle or incorrectly handles input that is not syntactically well-formed with respect to the associated specification.</definition>
        <rdfs:label>Improper Handling of Syntactically Invalid Structure</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-229 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-229">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-228"/>
        <cwe-id>CWE-229</cwe-id>
        <definition>The product does not properly handle when the expected number of values for parameters, fields, or arguments is not provided in input, or if those values are undefined.</definition>
        <rdfs:label>Improper Handling of Values</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-23 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-23">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-22"/>
        <cwe-id>CWE-23</cwe-id>
        <definition>The product uses external input to construct a pathname that should be within a restricted directory, but it does not properly neutralize sequences such as &quot;..&quot; that can resolve to a location that is outside of that directory.</definition>
        <synonym>Zip Slip</synonym>
        <rdfs:label>Relative Path Traversal</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-230 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-230">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-229"/>
        <cwe-id>CWE-230</cwe-id>
        <definition>The product does not handle or incorrectly handles when a parameter, field, or argument name is specified, but the associated value is missing, i.e. it is empty, blank, or null.</definition>
        <rdfs:label>Improper Handling of Missing Values</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-231 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-231">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-229"/>
        <cwe-id>CWE-231</cwe-id>
        <definition>The product does not handle or incorrectly handles when more values are provided than expected.</definition>
        <rdfs:label>Improper Handling of Extra Values</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-232 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-232">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-229"/>
        <cwe-id>CWE-232</cwe-id>
        <definition>The product does not handle or incorrectly handles when a value is not defined or supported for the associated parameter, field, or argument name.</definition>
        <rdfs:label>Improper Handling of Undefined Values</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-233 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-233">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-228"/>
        <cwe-id>CWE-233</cwe-id>
        <definition>The product does not properly handle when the expected number of parameters, fields, or arguments is not provided in input, or if those parameters are undefined.</definition>
        <rdfs:label>Improper Handling of Parameters</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-234 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-234">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-233"/>
        <cwe-id>CWE-234</cwe-id>
        <definition>If too few arguments are sent to a function, the function will still pop the expected number of arguments from the stack. Potentially, a variable number of arguments could be exhausted in a function as well.</definition>
        <rdfs:label>Failure to Handle Missing Parameter</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-235 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-235">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-233"/>
        <cwe-id>CWE-235</cwe-id>
        <definition>The product does not handle or incorrectly handles when the number of parameters, fields, or arguments with the same name exceeds the expected amount.</definition>
        <rdfs:label>Improper Handling of Extra Parameters</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-236 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-236">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-233"/>
        <cwe-id>CWE-236</cwe-id>
        <definition>The product does not handle or incorrectly handles when a particular parameter, field, or argument name is not defined or supported by the product.</definition>
        <rdfs:label>Improper Handling of Undefined Parameters</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-237 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-237">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-228"/>
        <cwe-id>CWE-237</cwe-id>
        <definition>The product does not handle or incorrectly handles inputs that are related to complex structures.</definition>
        <rdfs:label>Improper Handling of Structural Elements</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-238 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-238">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-237"/>
        <cwe-id>CWE-238</cwe-id>
        <definition>The product does not handle or incorrectly handles when a particular structural element is not completely specified.</definition>
        <rdfs:label>Improper Handling of Incomplete Structural Elements</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-239 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-239">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-237"/>
        <cwe-id>CWE-239</cwe-id>
        <definition>The product does not properly handle when a particular element is not completely specified.</definition>
        <rdfs:label>Failure to Handle Incomplete Element</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-24 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-24">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-23"/>
        <cwe-id>CWE-24</cwe-id>
        <definition>The product uses external input to construct a pathname that should be within a restricted directory, but it does not properly neutralize &quot;../&quot; sequences that can resolve to a location that is outside of that directory.</definition>
        <rdfs:label>Path Traversal: &apos;../filedir&apos;</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-240 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-240">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-237"/>
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-707"/>
        <cwe-id>CWE-240</cwe-id>
        <definition>The product does not handle or incorrectly handles when two or more structural elements should be consistent, but are not.</definition>
        <rdfs:label>Improper Handling of Inconsistent Structural Elements</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-241 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-241">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-228"/>
        <cwe-id>CWE-241</cwe-id>
        <definition>The product does not handle or incorrectly handles when a particular element is not the expected type, e.g. it expects a digit (0-9) but is provided with a letter (A-Z).</definition>
        <rdfs:label>Improper Handling of Unexpected Data Type</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-242 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-242">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1177"/>
        <cwe-id>CWE-242</cwe-id>
        <definition>The product calls a function that can never be guaranteed to work safely.</definition>
        <rdfs:label>Use of Inherently Dangerous Function</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-243 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-243">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-573"/>
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-669"/>
        <cwe-id>CWE-243</cwe-id>
        <definition>The product uses the chroot() system call to create a jail, but does not change the working directory afterward. This does not prevent access to files outside of the jail.</definition>
        <rdfs:label>Creation of chroot Jail Without Changing Working Directory</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-244 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-244">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-226"/>
        <cwe-id>CWE-244</cwe-id>
        <definition>Using realloc() to resize buffers that store sensitive information can leave the sensitive information exposed to attack, because it is not removed from memory.</definition>
        <rdfs:label>Improper Clearing of Heap Memory Before Release (&apos;Heap Inspection&apos;)</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-245 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-245">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-695"/>
        <cwe-id>CWE-245</cwe-id>
        <definition>The J2EE application directly manages connections, instead of using the container&apos;s connection management facilities.</definition>
        <rdfs:label>J2EE Bad Practices: Direct Management of Connections</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-246 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-246">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-695"/>
        <cwe-id>CWE-246</cwe-id>
        <definition>The J2EE application directly uses sockets instead of using framework method calls.</definition>
        <rdfs:label>J2EE Bad Practices: Direct Use of Sockets</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-248 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-248">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-703"/>
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-705"/>
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-755"/>
        <cwe-id>CWE-248</cwe-id>
        <definition>An exception is thrown from a function, but it is not caught.</definition>
        <rdfs:label>Uncaught Exception</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-25 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-25">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-23"/>
        <cwe-id>CWE-25</cwe-id>
        <definition>The product uses external input to construct a pathname that should be within a restricted directory, but it does not properly neutralize &quot;/../&quot; sequences that can resolve to a location that is outside of that directory.</definition>
        <rdfs:label>Path Traversal: &apos;/../filedir&apos;</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-250 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-250">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-269"/>
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-657"/>
        <cwe-id>CWE-250</cwe-id>
        <definition>The product performs an operation at a privilege level that is higher than the minimum level required, which creates new weaknesses or amplifies the consequences of other weaknesses.</definition>
        <rdfs:label>Execution with Unnecessary Privileges</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-252 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-252">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-754"/>
        <cwe-id>CWE-252</cwe-id>
        <definition>The product does not check the return value from a method or function, which can prevent it from detecting unexpected states and conditions.</definition>
        <rdfs:label>Unchecked Return Value</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-253 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-253">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-573"/>
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-754"/>
        <cwe-id>CWE-253</cwe-id>
        <definition>The product incorrectly checks a return value from a function, which prevents it from detecting errors or exceptional conditions.</definition>
        <rdfs:label>Incorrect Check of Function Return Value</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-256 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-256">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-522"/>
        <cwe-id>CWE-256</cwe-id>
        <definition>Storing a password in plaintext may result in a system compromise.</definition>
        <rdfs:label>Plaintext Storage of a Password</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-257 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-257">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-522"/>
        <cwe-id>CWE-257</cwe-id>
        <definition>The storage of passwords in a recoverable format makes them subject to password reuse attacks by malicious users. In fact, it should be noted that recoverable encrypted passwords provide no significant benefit over plaintext passwords since they are subject not only to reuse by malicious attackers but also by malicious insiders. If a system administrator can recover a password directly, or use a brute force search on the available information, the administrator can use the password on other accounts.</definition>
        <rdfs:label>Storing Passwords in a Recoverable Format</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-258 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-258">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-260"/>
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-521"/>
        <cwe-id>CWE-258</cwe-id>
        <definition>Using an empty string as a password is insecure.</definition>
        <rdfs:label>Empty Password in Configuration File</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-259 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-259">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-798"/>
        <cwe-id>CWE-259</cwe-id>
        <definition>The product contains a hard-coded password, which it uses for its own inbound authentication or for outbound communication to external components.</definition>
        <rdfs:label>Use of Hard-coded Password</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-26 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-26">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-23"/>
        <cwe-id>CWE-26</cwe-id>
        <definition>The product uses external input to construct a pathname that should be within a restricted directory, but it does not properly neutralize &quot;/dir/../filename&quot; sequences that can resolve to a location that is outside of that directory.</definition>
        <rdfs:label>Path Traversal: &apos;/dir/../filename&apos;</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-260 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-260">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-522"/>
        <cwe-id>CWE-260</cwe-id>
        <definition>The product stores a password in a configuration file that might be accessible to actors who do not know the password.</definition>
        <rdfs:label>Password in Configuration File</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-261 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-261">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-522"/>
        <cwe-id>CWE-261</cwe-id>
        <definition>Obscuring a password with a trivial encoding does not protect the password.</definition>
        <rdfs:label>Weak Encoding for Password</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-262 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-262">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1390"/>
        <cwe-id>CWE-262</cwe-id>
        <definition>The product does not have a mechanism in place for managing password aging.</definition>
        <rdfs:label>Not Using Password Aging</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-263 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-263">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1390"/>
        <cwe-id>CWE-263</cwe-id>
        <definition>The product supports password aging, but the expiration period is too long.</definition>
        <rdfs:label>Password Aging with Long Expiration</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-266 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-266">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-269"/>
        <cwe-id>CWE-266</cwe-id>
        <definition>A product incorrectly assigns a privilege to a particular actor, creating an unintended sphere of control for that actor.</definition>
        <rdfs:label>Incorrect Privilege Assignment</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-267 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-267">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-269"/>
        <cwe-id>CWE-267</cwe-id>
        <definition>A particular privilege, role, capability, or right can be used to perform unsafe actions that were not intended, even when it is assigned to the correct entity.</definition>
        <rdfs:label>Privilege Defined With Unsafe Actions</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-268 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-268">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-269"/>
        <cwe-id>CWE-268</cwe-id>
        <definition>Two distinct privileges, roles, capabilities, or rights can be combined in a way that allows an entity to perform unsafe actions that would not be allowed without that combination.</definition>
        <rdfs:label>Privilege Chaining</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-269 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-269">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-284"/>
        <cwe-id>CWE-269</cwe-id>
        <definition>The product does not properly assign, modify, track, or check privileges for an actor, creating an unintended sphere of control for that actor.</definition>
        <rdfs:label>Improper Privilege Management</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-27 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-27">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-23"/>
        <cwe-id>CWE-27</cwe-id>
        <definition>The product uses external input to construct a pathname that should be within a restricted directory, but it does not properly neutralize multiple internal &quot;../&quot; sequences that can resolve to a location that is outside of that directory.</definition>
        <rdfs:label>Path Traversal: &apos;dir/../../filename&apos;</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-270 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-270">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-269"/>
        <cwe-id>CWE-270</cwe-id>
        <definition>The product does not properly manage privileges while it is switching between different contexts that have different privileges or spheres of control.</definition>
        <rdfs:label>Privilege Context Switching Error</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-271 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-271">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-269"/>
        <cwe-id>CWE-271</cwe-id>
        <definition>The product does not drop privileges before passing control of a resource to an actor that does not have those privileges.</definition>
        <rdfs:label>Privilege Dropping / Lowering Errors</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-272 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-272">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-271"/>
        <cwe-id>CWE-272</cwe-id>
        <definition>The elevated privilege level required to perform operations such as chroot() should be dropped immediately after the operation is performed.</definition>
        <rdfs:label>Least Privilege Violation</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-273 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-273">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-271"/>
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-754"/>
        <cwe-id>CWE-273</cwe-id>
        <definition>The product attempts to drop privileges but does not check or incorrectly checks to see if the drop succeeded.</definition>
        <rdfs:label>Improper Check for Dropped Privileges</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-274 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-274">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-269"/>
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-755"/>
        <cwe-id>CWE-274</cwe-id>
        <definition>The product does not handle or incorrectly handles when it has insufficient privileges to perform an operation, leading to resultant weaknesses.</definition>
        <rdfs:label>Improper Handling of Insufficient Privileges</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-276 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-276">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-732"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#weakness-of"/>
                <owl:someValuesFrom rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#ApplicationInstaller"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-277 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-277">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-732"/>
        <cwe-id>CWE-277</cwe-id>
        <definition>A product defines a set of insecure permissions that are inherited by objects that are created by the program.</definition>
        <rdfs:label>Insecure Inherited Permissions</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-278 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-278">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-732"/>
        <cwe-id>CWE-278</cwe-id>
        <definition>A product inherits a set of insecure permissions for an object, e.g. when copying from an archive file, without user awareness or involvement.</definition>
        <rdfs:label>Insecure Preserved Inherited Permissions</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-279 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-279">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-732"/>
        <cwe-id>CWE-279</cwe-id>
        <definition>While it is executing, the product sets the permissions of an object in a way that violates the intended permissions that have been specified by the user.</definition>
        <rdfs:label>Incorrect Execution-Assigned Permissions</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-28 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-28">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-23"/>
        <cwe-id>CWE-28</cwe-id>
        <definition>The product uses external input to construct a pathname that should be within a restricted directory, but it does not properly neutralize &quot;..\&quot; sequences that can resolve to a location that is outside of that directory.</definition>
        <rdfs:label>Path Traversal: &apos;..\filedir&apos;</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-280 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-280">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-755"/>
        <cwe-id>CWE-280</cwe-id>
        <definition>The product does not handle or incorrectly handles when it has insufficient privileges to access resources or functionality as specified by their permissions. This may cause it to follow unexpected code paths that may leave the product in an invalid state.</definition>
        <rdfs:label>Improper Handling of Insufficient Permissions or Privileges</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-281 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-281">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-732"/>
        <cwe-id>CWE-281</cwe-id>
        <definition>The product does not preserve permissions or incorrectly preserves permissions when copying, restoring, or sharing objects, which can cause them to have less restrictive permissions than intended.</definition>
        <rdfs:label>Improper Preservation of Permissions</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-282 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-282">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-284"/>
        <cwe-id>CWE-282</cwe-id>
        <definition>The product assigns the wrong ownership, or does not properly verify the ownership, of an object or resource.</definition>
        <rdfs:label>Improper Ownership Management</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-283 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-283">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-282"/>
        <cwe-id>CWE-283</cwe-id>
        <definition>The product does not properly verify that a critical resource is owned by the proper entity.</definition>
        <rdfs:label>Unverified Ownership</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-284 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-284">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#Weakness"/>
        <cwe-id>CWE-284</cwe-id>
        <definition>The product does not restrict or incorrectly restricts access to a resource from an unauthorized actor.</definition>
        <synonym>Authorization</synonym>
        <rdfs:label>Improper Access Control</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-285 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-285">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-284"/>
        <cwe-id>CWE-285</cwe-id>
        <definition>The product does not perform or incorrectly performs an authorization check when an actor attempts to access a resource or perform an action.</definition>
        <synonym>AuthZ</synonym>
        <rdfs:label>Improper Authorization</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-286 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-286">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-284"/>
        <cwe-id>CWE-286</cwe-id>
        <definition>The product does not properly manage a user within its environment.</definition>
        <rdfs:label>Incorrect User Management</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-287 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-287">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-284"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#weakness-of"/>
                <owl:someValuesFrom rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#AuthenticationFunction"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-288 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-288">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-306"/>
        <cwe-id>CWE-288</cwe-id>
        <definition>The product requires authentication, but the product has an alternate path or channel that does not require authentication.</definition>
        <rdfs:label>Authentication Bypass Using an Alternate Path or Channel</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-289 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-289">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1390"/>
        <cwe-id>CWE-289</cwe-id>
        <definition>The product performs authentication based on the name of a resource being accessed, or the name of the actor performing the access, but it does not properly check all possible names for that resource or actor.</definition>
        <rdfs:label>Authentication Bypass by Alternate Name</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-29 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-29">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-23"/>
        <cwe-id>CWE-29</cwe-id>
        <definition>The product uses external input to construct a pathname that should be within a restricted directory, but it does not properly neutralize &apos;\..\filename&apos; (leading backslash dot dot) sequences that can resolve to a location that is outside of that directory.</definition>
        <rdfs:label>Path Traversal: &apos;\..\filename&apos;</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-290 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-290">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1390"/>
        <cwe-id>CWE-290</cwe-id>
        <definition>This attack-focused weakness is caused by incorrectly implemented authentication schemes that are subject to spoofing attacks.</definition>
        <rdfs:label>Authentication Bypass by Spoofing</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-291 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-291">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-290"/>
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-471"/>
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-923"/>
        <cwe-id>CWE-291</cwe-id>
        <definition>The product uses an IP address for authentication.</definition>
        <rdfs:label>Reliance on IP Address for Authentication</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-293 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-293">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-290"/>
        <cwe-id>CWE-293</cwe-id>
        <definition>The referer field in HTTP requests can be easily modified and, as such, is not a valid means of message integrity checking.</definition>
        <synonym>referrer</synonym>
        <rdfs:label>Using Referer Field for Authentication</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-294 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-294">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1390"/>
        <cwe-id>CWE-294</cwe-id>
        <definition>A capture-replay flaw exists when the design of the product makes it possible for a malicious user to sniff network traffic and bypass authentication by replaying it to the server in question to the same effect as the original message (or with minor changes).</definition>
        <rdfs:label>Authentication Bypass by Capture-replay</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-295 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-295">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-287"/>
        <cwe-id>CWE-295</cwe-id>
        <definition>The product does not validate, or incorrectly validates, a certificate.</definition>
        <rdfs:label>Improper Certificate Validation</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-296 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-296">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-295"/>
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-573"/>
        <cwe-id>CWE-296</cwe-id>
        <definition>The product does not follow, or incorrectly follows, the chain of trust for a certificate back to a trusted root certificate, resulting in incorrect trust of any resource that is associated with that certificate.</definition>
        <rdfs:label>Improper Following of a Certificate&apos;s Chain of Trust</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-297 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-297">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-295"/>
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-923"/>
        <cwe-id>CWE-297</cwe-id>
        <definition>The product communicates with a host that provides a certificate, but the product does not properly ensure that the certificate is actually associated with that host.</definition>
        <rdfs:label>Improper Validation of Certificate with Host Mismatch</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-298 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-298">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-295"/>
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-672"/>
        <cwe-id>CWE-298</cwe-id>
        <definition>A certificate expiration is not validated or is incorrectly validated, so trust may be assigned to certificates that have been abandoned due to age.</definition>
        <rdfs:label>Improper Validation of Certificate Expiration</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-299 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-299">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-295"/>
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-404"/>
        <cwe-id>CWE-299</cwe-id>
        <definition>The product does not check or incorrectly checks the revocation status of a certificate, which may cause it to use a certificate that has been compromised.</definition>
        <rdfs:label>Improper Check for Certificate Revocation</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-30 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-30">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-23"/>
        <cwe-id>CWE-30</cwe-id>
        <definition>The product uses external input to construct a pathname that should be within a restricted directory, but it does not properly neutralize &apos;\dir\..\filename&apos; (leading backslash dot dot) sequences that can resolve to a location that is outside of that directory.</definition>
        <rdfs:label>Path Traversal: &apos;\dir\..\filename&apos;</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-300 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-300">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-923"/>
        <cwe-id>CWE-300</cwe-id>
        <definition>The product does not adequately verify the identity of actors at both ends of a communication channel, or does not adequately ensure the integrity of the channel, in a way that allows the channel to be accessed or influenced by an actor that is not an endpoint.</definition>
        <synonym>Adversary-in-the-Middle / AITM</synonym>
        <synonym>Interception attack</synonym>
        <synonym>Man-in-the-Middle / MITM</synonym>
        <synonym>Manipulator-in-the-Middle</synonym>
        <synonym>Monkey-in-the-Middle</synonym>
        <synonym>Monster-in-the-Middle</synonym>
        <synonym>On-path attack</synonym>
        <synonym>Person-in-the-Middle / PITM</synonym>
        <rdfs:label>Channel Accessible by Non-Endpoint</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-301 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-301">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1390"/>
        <cwe-id>CWE-301</cwe-id>
        <definition>Simple authentication protocols are subject to reflection attacks if a malicious user can use the target machine to impersonate a trusted user.</definition>
        <rdfs:label>Reflection Attack in an Authentication Protocol</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-302 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-302">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1390"/>
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-807"/>
        <cwe-id>CWE-302</cwe-id>
        <definition>The authentication scheme or implementation uses key data elements that are assumed to be immutable, but can be controlled or modified by the attacker.</definition>
        <rdfs:label>Authentication Bypass by Assumed-Immutable Data</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-303 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-303">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1390"/>
        <cwe-id>CWE-303</cwe-id>
        <definition>The requirements for the product dictate the use of an established authentication algorithm, but the implementation of the algorithm is incorrect.</definition>
        <rdfs:label>Incorrect Implementation of Authentication Algorithm</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-304 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-304">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-303"/>
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-573"/>
        <cwe-id>CWE-304</cwe-id>
        <definition>The product implements an authentication technique, but it skips a step that weakens the technique.</definition>
        <rdfs:label>Missing Critical Step in Authentication</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-305 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-305">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1390"/>
        <cwe-id>CWE-305</cwe-id>
        <definition>The authentication algorithm is sound, but the implemented mechanism can be bypassed as the result of a separate weakness that is primary to the authentication error.</definition>
        <rdfs:label>Authentication Bypass by Primary Weakness</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-306 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-306">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-287"/>
        <cwe-id>CWE-306</cwe-id>
        <definition>The product does not perform any authentication for functionality that requires a provable user identity or consumes a significant amount of resources.</definition>
        <rdfs:label>Missing Authentication for Critical Function</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-307 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-307">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1390"/>
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-799"/>
        <cwe-id>CWE-307</cwe-id>
        <definition>The product does not implement sufficient measures to prevent multiple failed authentication attempts within a short time frame.</definition>
        <rdfs:label>Improper Restriction of Excessive Authentication Attempts</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-308 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-308">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1390"/>
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-654"/>
        <cwe-id>CWE-308</cwe-id>
        <definition>The use of single-factor authentication can lead to unnecessary risk of compromise when compared with the benefits of a dual-factor authentication scheme.</definition>
        <rdfs:label>Use of Single-factor Authentication</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-309 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-309">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1390"/>
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-654"/>
        <cwe-id>CWE-309</cwe-id>
        <definition>The use of password systems as the primary means of authentication may be subject to several flaws or shortcomings, each reducing the effectiveness of the mechanism.</definition>
        <rdfs:label>Use of Password System for Primary Authentication</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-31 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-31">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-23"/>
        <cwe-id>CWE-31</cwe-id>
        <definition>The product uses external input to construct a pathname that should be within a restricted directory, but it does not properly neutralize &apos;dir\..\..\filename&apos; (multiple internal backslash dot dot) sequences that can resolve to a location that is outside of that directory.</definition>
        <rdfs:label>Path Traversal: &apos;dir\..\..\filename&apos;</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-311 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-311">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-693"/>
        <cwe-id>CWE-311</cwe-id>
        <definition>The product does not encrypt sensitive or critical information before storage or transmission.</definition>
        <rdfs:label>Missing Encryption of Sensitive Data</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-312 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-312">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-311"/>
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-922"/>
        <cwe-id>CWE-312</cwe-id>
        <definition>The product stores sensitive information in cleartext within a resource that might be accessible to another control sphere.</definition>
        <rdfs:label>Cleartext Storage of Sensitive Information</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-313 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-313">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-312"/>
        <cwe-id>CWE-313</cwe-id>
        <definition>The product stores sensitive information in cleartext in a file, or on disk.</definition>
        <rdfs:label>Cleartext Storage in a File or on Disk</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-314 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-314">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-312"/>
        <cwe-id>CWE-314</cwe-id>
        <definition>The product stores sensitive information in cleartext in the registry.</definition>
        <rdfs:label>Cleartext Storage in the Registry</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-315 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-315">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-312"/>
        <cwe-id>CWE-315</cwe-id>
        <definition>The product stores sensitive information in cleartext in a cookie.</definition>
        <rdfs:label>Cleartext Storage of Sensitive Information in a Cookie</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-316 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-316">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-312"/>
        <cwe-id>CWE-316</cwe-id>
        <definition>The product stores sensitive information in cleartext in memory.</definition>
        <rdfs:label>Cleartext Storage of Sensitive Information in Memory</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-317 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-317">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-312"/>
        <cwe-id>CWE-317</cwe-id>
        <definition>The product stores sensitive information in cleartext within the GUI.</definition>
        <rdfs:label>Cleartext Storage of Sensitive Information in GUI</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-318 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-318">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-312"/>
        <cwe-id>CWE-318</cwe-id>
        <definition>The product stores sensitive information in cleartext in an executable.</definition>
        <rdfs:label>Cleartext Storage of Sensitive Information in Executable</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-319 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-319">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-311"/>
        <cwe-id>CWE-319</cwe-id>
        <definition>The product transmits sensitive or security-critical data in cleartext in a communication channel that can be sniffed by unauthorized actors.</definition>
        <rdfs:label>Cleartext Transmission of Sensitive Information</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-32 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-32">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-23"/>
        <cwe-id>CWE-32</cwe-id>
        <definition>The product uses external input to construct a pathname that should be within a restricted directory, but it does not properly neutralize &apos;...&apos; (triple dot) sequences that can resolve to a location that is outside of that directory.</definition>
        <rdfs:label>Path Traversal: &apos;...&apos; (Triple Dot)</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-321 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-321">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-798"/>
        <cwe-id>CWE-321</cwe-id>
        <definition>The product uses a hard-coded, unchangeable cryptographic key.</definition>
        <rdfs:label>Use of Hard-coded Cryptographic Key</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-322 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-322">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-306"/>
        <cwe-id>CWE-322</cwe-id>
        <definition>The product performs a key exchange with an actor without verifying the identity of that actor.</definition>
        <rdfs:label>Key Exchange without Entity Authentication</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-323 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-323">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-344"/>
        <cwe-id>CWE-323</cwe-id>
        <definition>Nonces should be used for the present occasion and only once.</definition>
        <rdfs:label>Reusing a Nonce, Key Pair in Encryption</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-324 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-324">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-672"/>
        <cwe-id>CWE-324</cwe-id>
        <definition>The product uses a cryptographic key or password past its expiration date, which diminishes its safety significantly by increasing the timing window for cracking attacks against that key.</definition>
        <rdfs:label>Use of a Key Past its Expiration Date</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-325 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-325">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-573"/>
        <cwe-id>CWE-325</cwe-id>
        <definition>The product does not implement a required step in a cryptographic algorithm, resulting in weaker encryption than advertised by the algorithm.</definition>
        <rdfs:label>Missing Cryptographic Step</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-326 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-326">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-693"/>
        <cwe-id>CWE-326</cwe-id>
        <definition>The product stores or transmits sensitive data using an encryption scheme that is theoretically sound, but is not strong enough for the level of protection required.</definition>
        <rdfs:label>Inadequate Encryption Strength</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-327 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-327">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-693"/>
        <cwe-id>CWE-327</cwe-id>
        <definition>The product uses a broken or risky cryptographic algorithm or protocol.</definition>
        <rdfs:label>Use of a Broken or Risky Cryptographic Algorithm</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-328 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-328">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-326"/>
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-327"/>
        <cwe-id>CWE-328</cwe-id>
        <definition>The product uses an algorithm that produces a digest (output value) that does not meet security expectations for a hash function that allows an adversary to reasonably determine the original input (preimage attack), find another input that can produce the same hash (2nd preimage attack), or find multiple inputs that evaluate to the same hash (birthday attack).</definition>
        <rdfs:label>Use of Weak Hash</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-329 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-329">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1204"/>
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-573"/>
        <cwe-id>CWE-329</cwe-id>
        <definition>The product generates and uses a predictable initialization Vector (IV) with Cipher Block Chaining (CBC) Mode, which causes algorithms to be susceptible to dictionary attacks when they are encrypted under the same key.</definition>
        <rdfs:label>Generation of Predictable IV with CBC Mode</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-33 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-33">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-23"/>
        <cwe-id>CWE-33</cwe-id>
        <definition>The product uses external input to construct a pathname that should be within a restricted directory, but it does not properly neutralize &apos;....&apos; (multiple dot) sequences that can resolve to a location that is outside of that directory.</definition>
        <rdfs:label>Path Traversal: &apos;....&apos; (Multiple Dot)</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-330 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-330">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-693"/>
        <cwe-id>CWE-330</cwe-id>
        <definition>The product uses insufficiently random numbers or values in a security context that depends on unpredictable numbers.</definition>
        <rdfs:label>Use of Insufficiently Random Values</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-331 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-331">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-330"/>
        <cwe-id>CWE-331</cwe-id>
        <definition>The product uses an algorithm or scheme that produces insufficient entropy, leaving patterns or clusters of values that are more likely to occur than others.</definition>
        <rdfs:label>Insufficient Entropy</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-332 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-332">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-331"/>
        <cwe-id>CWE-332</cwe-id>
        <definition>The lack of entropy available for, or used by, a Pseudo-Random Number Generator (PRNG) can be a stability and security threat.</definition>
        <rdfs:label>Insufficient Entropy in PRNG</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-333 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-333">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-331"/>
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-703"/>
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-755"/>
        <cwe-id>CWE-333</cwe-id>
        <definition>True random number generators (TRNG) generally have a limited source of entropy and therefore can fail or block.</definition>
        <rdfs:label>Improper Handling of Insufficient Entropy in TRNG</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-334 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-334">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-330"/>
        <cwe-id>CWE-334</cwe-id>
        <definition>The number of possible random values is smaller than needed by the product, making it more susceptible to brute force attacks.</definition>
        <rdfs:label>Small Space of Random Values</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-335 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-335">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-330"/>
        <cwe-id>CWE-335</cwe-id>
        <definition>The product uses a Pseudo-Random Number Generator (PRNG) but does not correctly manage seeds.</definition>
        <rdfs:label>Incorrect Usage of Seeds in Pseudo-Random Number Generator (PRNG)</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-336 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-336">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-335"/>
        <cwe-id>CWE-336</cwe-id>
        <definition>A Pseudo-Random Number Generator (PRNG) uses the same seed each time the product is initialized.</definition>
        <rdfs:label>Same Seed in Pseudo-Random Number Generator (PRNG)</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-337 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-337">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-335"/>
        <cwe-id>CWE-337</cwe-id>
        <definition>A Pseudo-Random Number Generator (PRNG) is initialized from a predictable seed, such as the process ID or system time.</definition>
        <rdfs:label>Predictable Seed in Pseudo-Random Number Generator (PRNG)</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-338 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-338">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-330"/>
        <cwe-id>CWE-338</cwe-id>
        <definition>The product uses a Pseudo-Random Number Generator (PRNG) in a security context, but the PRNG&apos;s algorithm is not cryptographically strong.</definition>
        <rdfs:label>Use of Cryptographically Weak Pseudo-Random Number Generator (PRNG)</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-339 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-339">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-335"/>
        <cwe-id>CWE-339</cwe-id>
        <definition>A Pseudo-Random Number Generator (PRNG) uses a relatively small seed space, which makes it more susceptible to brute force attacks.</definition>
        <rdfs:label>Small Seed Space in PRNG</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-34 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-34">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-23"/>
        <cwe-id>CWE-34</cwe-id>
        <definition>The product uses external input to construct a pathname that should be within a restricted directory, but it does not properly neutralize &apos;....//&apos; (doubled dot dot slash) sequences that can resolve to a location that is outside of that directory.</definition>
        <rdfs:label>Path Traversal: &apos;....//&apos;</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-340 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-340">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-330"/>
        <cwe-id>CWE-340</cwe-id>
        <definition>The product uses a scheme that generates numbers or identifiers that are more predictable than required.</definition>
        <rdfs:label>Generation of Predictable Numbers or Identifiers</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-341 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-341">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-340"/>
        <cwe-id>CWE-341</cwe-id>
        <definition>A number or object is predictable based on observations that the attacker can make about the state of the system or network, such as time, process ID, etc.</definition>
        <rdfs:label>Predictable from Observable State</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-342 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-342">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-340"/>
        <cwe-id>CWE-342</cwe-id>
        <definition>An exact value or random number can be precisely predicted by observing previous values.</definition>
        <rdfs:label>Predictable Exact Value from Previous Values</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-343 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-343">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-340"/>
        <cwe-id>CWE-343</cwe-id>
        <definition>The product&apos;s random number generator produces a series of values which, when observed, can be used to infer a relatively small range of possibilities for the next value that could be generated.</definition>
        <rdfs:label>Predictable Value Range from Previous Values</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-344 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-344">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-330"/>
        <cwe-id>CWE-344</cwe-id>
        <definition>The product uses a constant value, name, or reference, but this value can (or should) vary across different environments.</definition>
        <rdfs:label>Use of Invariant Value in Dynamically Changing Context</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-345 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-345">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-693"/>
        <cwe-id>CWE-345</cwe-id>
        <definition>The product does not sufficiently verify the origin or authenticity of data, in a way that causes it to accept invalid data.</definition>
        <rdfs:label>Insufficient Verification of Data Authenticity</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-346 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-346">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-284"/>
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-345"/>
        <cwe-id>CWE-346</cwe-id>
        <definition>The product does not properly verify that the source of data or communication is valid.</definition>
        <rdfs:label>Origin Validation Error</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-347 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-347">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-345"/>
        <cwe-id>CWE-347</cwe-id>
        <definition>The product does not verify, or incorrectly verifies, the cryptographic signature for data.</definition>
        <rdfs:label>Improper Verification of Cryptographic Signature</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-348 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-348">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-345"/>
        <cwe-id>CWE-348</cwe-id>
        <definition>The product has two different sources of the same data or information, but it uses the source that has less support for verification, is less trusted, or is less resistant to attack.</definition>
        <rdfs:label>Use of Less Trusted Source</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-349 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-349">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-345"/>
        <cwe-id>CWE-349</cwe-id>
        <definition>The product, when processing trusted data, accepts any untrusted data that is also included with the trusted data, treating the untrusted data as if it were trusted.</definition>
        <rdfs:label>Acceptance of Extraneous Untrusted Data With Trusted Data</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-35 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-35">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-23"/>
        <cwe-id>CWE-35</cwe-id>
        <definition>The product uses external input to construct a pathname that should be within a restricted directory, but it does not properly neutralize &apos;.../...//&apos; (doubled triple dot slash) sequences that can resolve to a location that is outside of that directory.</definition>
        <rdfs:label>Path Traversal: &apos;.../...//&apos;</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-350 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-350">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-290"/>
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-807"/>
        <cwe-id>CWE-350</cwe-id>
        <definition>The product performs reverse DNS resolution on an IP address to obtain the hostname and make a security decision, but it does not properly ensure that the IP address is truly associated with the hostname.</definition>
        <rdfs:label>Reliance on Reverse DNS Resolution for a Security-Critical Action</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-351 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-351">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-345"/>
        <cwe-id>CWE-351</cwe-id>
        <definition>The product does not properly distinguish between different types of elements in a way that leads to insecure behavior.</definition>
        <rdfs:label>Insufficient Type Distinction</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-352 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-352">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-345"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#weakness-of"/>
                <owl:someValuesFrom rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#UserInputFunction"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-353 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-353">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-345"/>
        <cwe-id>CWE-353</cwe-id>
        <definition>The product uses a transmission protocol that does not include a mechanism for verifying the integrity of the data during transmission, such as a checksum.</definition>
        <rdfs:label>Missing Support for Integrity Check</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-354 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-354">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-345"/>
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-754"/>
        <cwe-id>CWE-354</cwe-id>
        <definition>The product does not validate or incorrectly validates the integrity check values or &quot;checksums&quot; of a message. This may prevent it from detecting if the data has been modified or corrupted in transmission.</definition>
        <rdfs:label>Improper Validation of Integrity Check Value</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-356 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-356">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-221"/>
        <cwe-id>CWE-356</cwe-id>
        <definition>The product&apos;s user interface does not warn the user before undertaking an unsafe action on behalf of that user. This makes it easier for attackers to trick users into inflicting damage to their system.</definition>
        <rdfs:label>Product UI does not Warn User of Unsafe Actions</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-357 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-357">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-693"/>
        <cwe-id>CWE-357</cwe-id>
        <definition>The user interface provides a warning to a user regarding dangerous or sensitive operations, but the warning is not noticeable enough to warrant attention.</definition>
        <rdfs:label>Insufficient UI Warning of Dangerous Operations</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-358 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-358">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-573"/>
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-693"/>
        <cwe-id>CWE-358</cwe-id>
        <definition>The product does not implement or incorrectly implements one or more security-relevant checks as specified by the design of a standardized algorithm, protocol, or technique.</definition>
        <rdfs:label>Improperly Implemented Security Check for Standard</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-359 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-359">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-200"/>
        <cwe-id>CWE-359</cwe-id>
        <definition>The product does not properly prevent a person&apos;s private, personal information from being accessed by actors who either (1) are not explicitly authorized to access the information or (2) do not have the implicit consent of the person about whom the information is collected.</definition>
        <synonym>Privacy leak</synonym>
        <synonym>Privacy leakage</synonym>
        <synonym>Privacy violation</synonym>
        <rdfs:label>Exposure of Private Personal Information to an Unauthorized Actor</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-36 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-36">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-22"/>
        <cwe-id>CWE-36</cwe-id>
        <definition>The product uses external input to construct a pathname that should be within a restricted directory, but it does not properly neutralize absolute path sequences such as &quot;/abs/path&quot; that can resolve to a location that is outside of that directory.</definition>
        <rdfs:label>Absolute Path Traversal</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-360 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-360">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-345"/>
        <cwe-id>CWE-360</cwe-id>
        <definition>Security based on event locations are insecure and can be spoofed.</definition>
        <rdfs:label>Trust of System Event Data</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-362 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-362">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-691"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#weakness-of"/>
                <owl:someValuesFrom rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#SharedResourceAccessFunction"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-363 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-363">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-367"/>
        <cwe-id>CWE-363</cwe-id>
        <definition>The product checks the status of a file or directory before accessing it, which produces a race condition in which the file can be replaced with a link before the access is performed, causing the product to access the wrong file.</definition>
        <rdfs:label>Race Condition Enabling Link Following</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-364 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-364">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-362"/>
        <cwe-id>CWE-364</cwe-id>
        <definition>The product uses a signal handler that introduces a race condition.</definition>
        <rdfs:label>Signal Handler Race Condition</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-366 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-366">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-362"/>
        <cwe-id>CWE-366</cwe-id>
        <definition>If two threads of execution use a resource simultaneously, there exists the possibility that resources may be used while invalid, in turn making the state of execution undefined.</definition>
        <rdfs:label>Race Condition within a Thread</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-367 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-367">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-362"/>
        <cwe-id>CWE-367</cwe-id>
        <definition>The product checks the state of a resource before using that resource, but the resource&apos;s state can change between the check and the use in a way that invalidates the results of the check. This can cause the product to perform invalid actions when the resource is in an unexpected state.</definition>
        <synonym>TOCCTOU</synonym>
        <synonym>TOCTTOU</synonym>
        <rdfs:label>Time-of-check Time-of-use (TOCTOU) Race Condition</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-368 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-368">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-362"/>
        <cwe-id>CWE-368</cwe-id>
        <definition>A product performs a series of non-atomic actions to switch between contexts that cross privilege or other security boundaries, but a race condition allows an attacker to modify or misrepresent the product&apos;s behavior during the switch.</definition>
        <rdfs:label>Context Switching Race Condition</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-369 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-369">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-682"/>
        <cwe-id>CWE-369</cwe-id>
        <definition>The product divides a value by zero.</definition>
        <rdfs:label>Divide By Zero</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-37 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-37">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-160"/>
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-36"/>
        <cwe-id>CWE-37</cwe-id>
        <definition>The product accepts input in the form of a slash absolute path (&apos;/absolute/pathname/here&apos;) without appropriate validation, which can allow an attacker to traverse the file system to unintended locations or access arbitrary files.</definition>
        <rdfs:label>Path Traversal: &apos;/absolute/pathname/here&apos;</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-370 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-370">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-299"/>
        <cwe-id>CWE-370</cwe-id>
        <definition>The product does not check the revocation status of a certificate after its initial revocation check, which can cause the product to perform privileged actions even after the certificate is revoked at a later time.</definition>
        <rdfs:label>Missing Check for Certificate Revocation after Initial Check</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-372 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-372">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-664"/>
        <cwe-id>CWE-372</cwe-id>
        <definition>The product does not properly determine which state it is in, causing it to assume it is in state X when in fact it is in state Y, causing it to perform incorrect operations in a security-relevant manner.</definition>
        <rdfs:label>Incomplete Internal State Distinction</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-374 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-374">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-668"/>
        <cwe-id>CWE-374</cwe-id>
        <definition>The product sends non-cloned mutable data as an argument to a method or function.</definition>
        <rdfs:label>Passing Mutable Objects to an Untrusted Method</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-375 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-375">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-668"/>
        <cwe-id>CWE-375</cwe-id>
        <definition>Sending non-cloned mutable data as a return value may result in that data being altered or deleted by the calling function.</definition>
        <rdfs:label>Returning a Mutable Object to an Untrusted Caller</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-377 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-377">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-668"/>
        <cwe-id>CWE-377</cwe-id>
        <definition>Creating and using insecure temporary files can leave application and system data vulnerable to attack.</definition>
        <rdfs:label>Insecure Temporary File</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-378 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-378">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-377"/>
        <cwe-id>CWE-378</cwe-id>
        <definition>Opening temporary files without appropriate measures or controls can leave the file, its contents and any function that it impacts vulnerable to attack.</definition>
        <rdfs:label>Creation of Temporary File With Insecure Permissions</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-379 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-379">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-377"/>
        <cwe-id>CWE-379</cwe-id>
        <definition>The product creates a temporary file in a directory whose permissions allow unintended actors to determine the file&apos;s existence or otherwise access that file.</definition>
        <rdfs:label>Creation of Temporary File in Directory with Insecure Permissions</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-38 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-38">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-36"/>
        <cwe-id>CWE-38</cwe-id>
        <definition>The product accepts input in the form of a backslash absolute path (&apos;\absolute\pathname\here&apos;) without appropriate validation, which can allow an attacker to traverse the file system to unintended locations or access arbitrary files.</definition>
        <rdfs:label>Path Traversal: &apos;\absolute\pathname\here&apos;</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-382 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-382">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-705"/>
        <cwe-id>CWE-382</cwe-id>
        <definition>A J2EE application uses System.exit(), which also shuts down its container.</definition>
        <rdfs:label>J2EE Bad Practices: Use of System.exit()</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-383 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-383">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-695"/>
        <cwe-id>CWE-383</cwe-id>
        <definition>Thread management in a Web application is forbidden in some circumstances and is always highly error prone.</definition>
        <rdfs:label>J2EE Bad Practices: Direct Use of Threads</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-384 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-384">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-610"/>
        <cwe-id>CWE-384</cwe-id>
        <definition>Authenticating a user, or otherwise establishing a new user session, without invalidating any existing session identifier gives an attacker the opportunity to steal authenticated sessions.</definition>
        <rdfs:label>Session Fixation</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-385 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-385">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-514"/>
        <cwe-id>CWE-385</cwe-id>
        <definition>Covert timing channels convey information by modulating some aspect of system behavior over time, so that the program receiving the information can observe system behavior and infer protected information.</definition>
        <rdfs:label>Covert Timing Channel</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-386 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-386">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-706"/>
        <cwe-id>CWE-386</cwe-id>
        <definition>A constant symbolic reference to an object is used, even though the reference can resolve to a different object over time.</definition>
        <rdfs:label>Symbolic Name not Mapping to Correct Object</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-39 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-39">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-36"/>
        <cwe-id>CWE-39</cwe-id>
        <definition>The product accepts input that contains a drive letter or Windows volume letter (&apos;C:dirname&apos;) that potentially redirects access to an unintended location or arbitrary file.</definition>
        <rdfs:label>Path Traversal: &apos;C:dirname&apos;</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-390 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-390">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-755"/>
        <cwe-id>CWE-390</cwe-id>
        <definition>The product detects a specific error, but takes no actions to handle the error.</definition>
        <rdfs:label>Detection of Error Condition Without Action</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-391 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-391">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-754"/>
        <cwe-id>CWE-391</cwe-id>
        <definition>[PLANNED FOR DEPRECATION. SEE MAINTENANCE NOTES AND CONSIDER CWE-252, CWE-248, OR CWE-1069.] Ignoring exceptions and other error conditions may allow an attacker to induce unexpected behavior unnoticed.</definition>
        <rdfs:label>Unchecked Error Condition</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-392 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-392">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-684"/>
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-703"/>
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-755"/>
        <cwe-id>CWE-392</cwe-id>
        <definition>The product encounters an error but does not provide a status code or return value to indicate that an error has occurred.</definition>
        <rdfs:label>Missing Report of Error Condition</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-393 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-393">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-684"/>
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-703"/>
        <cwe-id>CWE-393</cwe-id>
        <definition>A function or operation returns an incorrect return value or status code that does not indicate the true result of execution, causing the product to modify its behavior based on the incorrect result.</definition>
        <rdfs:label>Return of Wrong Status Code</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-394 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-394">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-754"/>
        <cwe-id>CWE-394</cwe-id>
        <definition>The product does not properly check when a function or operation returns a value that is legitimate for the function, but is not expected by the product.</definition>
        <rdfs:label>Unexpected Status Code or Return Value</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-395 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-395">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-705"/>
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-755"/>
        <cwe-id>CWE-395</cwe-id>
        <definition>Catching NullPointerException should not be used as an alternative to programmatic checks to prevent dereferencing a null pointer.</definition>
        <rdfs:label>Use of NullPointerException Catch to Detect NULL Pointer Dereference</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-396 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-396">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-221"/>
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-705"/>
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-755"/>
        <cwe-id>CWE-396</cwe-id>
        <definition>Catching overly broad exceptions promotes complex error handling code that is more likely to contain security vulnerabilities.</definition>
        <rdfs:label>Declaration of Catch for Generic Exception</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-397 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-397">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-221"/>
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-703"/>
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-705"/>
        <cwe-id>CWE-397</cwe-id>
        <definition>The product throws or raises an overly broad exceptions that can hide important details and produce inappropriate responses to certain conditions.</definition>
        <rdfs:label>Declaration of Throws for Generic Exception</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-40 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-40">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-36"/>
        <cwe-id>CWE-40</cwe-id>
        <definition>The product accepts input that identifies a Windows UNC share (&apos;\\UNC\share\name&apos;) that potentially redirects access to an unintended location or arbitrary file.</definition>
        <rdfs:label>Path Traversal: &apos;\\UNC\share\name\&apos; (Windows UNC Share)</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-400 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-400">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-664"/>
        <cwe-id>CWE-400</cwe-id>
        <definition>The product does not properly control the allocation and maintenance of a limited resource.</definition>
        <synonym>Resource Exhaustion</synonym>
        <rdfs:label>Uncontrolled Resource Consumption</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-401 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-401">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-772"/>
        <cwe-id>CWE-401</cwe-id>
        <definition>The product does not sufficiently track and release allocated memory after it has been used, making the memory unavailable for reallocation and reuse.</definition>
        <synonym>Memory Leak</synonym>
        <rdfs:label>Missing Release of Memory after Effective Lifetime</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-402 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-402">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-668"/>
        <cwe-id>CWE-402</cwe-id>
        <definition>The product makes resources available to untrusted parties when those resources are only intended to be accessed by the product.</definition>
        <synonym>Resource Leak</synonym>
        <rdfs:label>Transmission of Private Resources into a New Sphere (&apos;Resource Leak&apos;)</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-403 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-403">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-402"/>
        <cwe-id>CWE-403</cwe-id>
        <definition>A process does not close sensitive file descriptors before invoking a child process, which allows the child to perform unauthorized I/O operations using those descriptors.</definition>
        <synonym>File descriptor leak</synonym>
        <rdfs:label>Exposure of File Descriptor to Unintended Control Sphere (&apos;File Descriptor Leak&apos;)</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-404 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-404">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-664"/>
        <cwe-id>CWE-404</cwe-id>
        <definition>The product does not release or incorrectly releases a resource before it is made available for re-use.</definition>
        <rdfs:label>Improper Resource Shutdown or Release</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-405 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-405">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-400"/>
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-664"/>
        <cwe-id>CWE-405</cwe-id>
        <definition>The product does not properly control situations in which an adversary can cause the product to consume or produce excessive resources without requiring the adversary to invest equivalent work or otherwise prove authorization, i.e., the adversary&apos;s influence is &quot;asymmetric.&quot;</definition>
        <rdfs:label>Asymmetric Resource Consumption (Amplification)</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-406 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-406">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-405"/>
        <cwe-id>CWE-406</cwe-id>
        <definition>The product does not sufficiently monitor or control transmitted network traffic volume, so that an actor can cause the product to transmit more traffic than should be allowed for that actor.</definition>
        <rdfs:label>Insufficient Control of Network Message Volume (Network Amplification)</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-407 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-407">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-405"/>
        <cwe-id>CWE-407</cwe-id>
        <definition>An algorithm in a product has an inefficient worst-case computational complexity that may be detrimental to system performance and can be triggered by an attacker, typically using crafted manipulations that ensure that the worst case is being reached.</definition>
        <synonym>Quadratic Complexity</synonym>
        <rdfs:label>Inefficient Algorithmic Complexity</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-408 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-408">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-405"/>
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-696"/>
        <cwe-id>CWE-408</cwe-id>
        <definition>The product allows an entity to perform a legitimate but expensive operation before authentication or authorization has taken place.</definition>
        <rdfs:label>Incorrect Behavior Order: Early Amplification</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-409 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-409">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-405"/>
        <cwe-id>CWE-409</cwe-id>
        <definition>The product does not handle or incorrectly handles a compressed input with a very high compression ratio that produces a large output.</definition>
        <rdfs:label>Improper Handling of Highly Compressed Data (Data Amplification)</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-41 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-41">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-706"/>
        <cwe-id>CWE-41</cwe-id>
        <definition>The product is vulnerable to file system contents disclosure through path equivalence. Path equivalence involves the use of special characters in file and directory names. The associated manipulations are intended to generate multiple names for the same object.</definition>
        <rdfs:label>Improper Resolution of Path Equivalence</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-410 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-410">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-664"/>
        <cwe-id>CWE-410</cwe-id>
        <definition>The product&apos;s resource pool is not large enough to handle peak demand, which allows an attacker to prevent others from accessing the resource by using a (relatively) large number of requests for resources.</definition>
        <rdfs:label>Insufficient Resource Pool</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-412 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-412">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-667"/>
        <cwe-id>CWE-412</cwe-id>
        <definition>The product properly checks for the existence of a lock, but the lock can be externally controlled or influenced by an actor that is outside of the intended sphere of control.</definition>
        <rdfs:label>Unrestricted Externally Accessible Lock</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-413 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-413">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-667"/>
        <cwe-id>CWE-413</cwe-id>
        <definition>The product does not lock or does not correctly lock a resource when the product must have exclusive access to the resource.</definition>
        <rdfs:label>Improper Resource Locking</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-414 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-414">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-667"/>
        <cwe-id>CWE-414</cwe-id>
        <definition>A product does not check to see if a lock is present before performing sensitive operations on a resource.</definition>
        <rdfs:label>Missing Lock Check</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-415 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-415">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1341"/>
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-666"/>
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-825"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#weakness-of"/>
                <owl:someValuesFrom rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#MemoryFreeFunction"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-416 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-416">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-825"/>
        <cwe-id>CWE-416</cwe-id>
        <definition>The product reuses or references memory after it has been freed. At some point afterward, the memory may be allocated again and saved in another pointer, while the original pointer references a location somewhere within the new allocation. Any operations using the original pointer are no longer valid because the memory &quot;belongs&quot; to the code that operates on the new pointer.</definition>
        <synonym>Dangling pointer</synonym>
        <synonym>UAF</synonym>
        <synonym>Use-After-Free</synonym>
        <rdfs:label>Use After Free</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-419 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-419">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-923"/>
        <cwe-id>CWE-419</cwe-id>
        <definition>The product uses a primary channel for administration or restricted functionality, but it does not properly protect the channel.</definition>
        <rdfs:label>Unprotected Primary Channel</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-42 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-42">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-162"/>
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-41"/>
        <cwe-id>CWE-42</cwe-id>
        <definition>The product accepts path input in the form of trailing dot (&apos;filedir.&apos;) without appropriate validation, which can lead to ambiguous path resolution and allow an attacker to traverse the file system to unintended locations or access arbitrary files.</definition>
        <rdfs:label>Path Equivalence: &apos;filename.&apos; (Trailing Dot)</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-420 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-420">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-923"/>
        <cwe-id>CWE-420</cwe-id>
        <definition>The product protects a primary channel, but it does not use the same level of protection for an alternate channel.</definition>
        <rdfs:label>Unprotected Alternate Channel</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-421 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-421">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-362"/>
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-420"/>
        <cwe-id>CWE-421</cwe-id>
        <definition>The product opens an alternate channel to communicate with an authorized user, but the channel is accessible to other actors.</definition>
        <rdfs:label>Race Condition During Access to Alternate Channel</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-422 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-422">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-360"/>
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-420"/>
        <cwe-id>CWE-422</cwe-id>
        <definition>The product does not properly verify the source of a message in the Windows Messaging System while running at elevated privileges, creating an alternate channel through which an attacker can directly send a message to the product.</definition>
        <rdfs:label>Unprotected Windows Messaging Channel (&apos;Shatter&apos;)</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-424 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-424">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-638"/>
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-693"/>
        <cwe-id>CWE-424</cwe-id>
        <definition>The product does not sufficiently protect all possible paths that a user can take to access restricted functionality or resources.</definition>
        <rdfs:label>Improper Protection of Alternate Path</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-425 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-425">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-288"/>
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-424"/>
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-862"/>
        <cwe-id>CWE-425</cwe-id>
        <definition>The web application does not adequately enforce appropriate authorization on all restricted URLs, scripts, or files.</definition>
        <synonym>forced browsing</synonym>
        <rdfs:label>Direct Request (&apos;Forced Browsing&apos;)</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-426 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-426">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-642"/>
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-673"/>
        <cwe-id>CWE-426</cwe-id>
        <definition>The product searches for critical resources using an externally-supplied search path that can point to resources that are not under the product&apos;s direct control.</definition>
        <synonym>Untrusted Path</synonym>
        <rdfs:label>Untrusted Search Path</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-427 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-427">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-668"/>
        <cwe-id>CWE-427</cwe-id>
        <definition>The product uses a fixed or controlled search path to find resources, but one or more locations in that path can be under the control of unintended actors.</definition>
        <synonym>Binary planting</synonym>
        <synonym>DLL preloading</synonym>
        <synonym>Dependency confusion</synonym>
        <synonym>Insecure library loading</synonym>
        <rdfs:label>Uncontrolled Search Path Element</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-428 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-428">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-668"/>
        <cwe-id>CWE-428</cwe-id>
        <definition>The product uses a search path that contains an unquoted element, in which the element contains whitespace or other separators. This can cause the product to access resources in a parent path.</definition>
        <rdfs:label>Unquoted Search Path or Element</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-43 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-43">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-163"/>
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-42"/>
        <cwe-id>CWE-43</cwe-id>
        <definition>The product accepts path input in the form of multiple trailing dot (&apos;filedir....&apos;) without appropriate validation, which can lead to ambiguous path resolution and allow an attacker to traverse the file system to unintended locations or access arbitrary files.</definition>
        <rdfs:label>Path Equivalence: &apos;filename....&apos; (Multiple Trailing Dot)</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-430 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-430">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-691"/>
        <cwe-id>CWE-430</cwe-id>
        <definition>The wrong &quot;handler&quot; is assigned to process an object.</definition>
        <rdfs:label>Deployment of Wrong Handler</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-431 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-431">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-691"/>
        <cwe-id>CWE-431</cwe-id>
        <definition>A handler is not available or implemented.</definition>
        <rdfs:label>Missing Handler</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-432 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-432">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-364"/>
        <cwe-id>CWE-432</cwe-id>
        <definition>The product uses a signal handler that shares state with other signal handlers, but it does not properly mask or prevent those signal handlers from being invoked while the original signal handler is still running.</definition>
        <rdfs:label>Dangerous Signal Handler not Disabled During Sensitive Operations</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-433 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-433">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-219"/>
        <cwe-id>CWE-433</cwe-id>
        <definition>The product stores raw content or supporting code under the web document root with an extension that is not specifically handled by the server.</definition>
        <rdfs:label>Unparsed Raw Web Content Delivery</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-434 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-434">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-669"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#weakness-of"/>
                <owl:someValuesFrom rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#UserInputFunction"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-435 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-435">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#Weakness"/>
        <cwe-id>CWE-435</cwe-id>
        <definition>An interaction error occurs when two entities have correct behavior when running independently of each other, but when they are integrated as components in a larger system or process, they introduce incorrect behaviors that may cause resultant weaknesses.</definition>
        <synonym>Emergent Fault</synonym>
        <synonym>Interaction Error</synonym>
        <rdfs:label>Improper Interaction Between Multiple Correctly-Behaving Entities</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-436 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-436">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-435"/>
        <cwe-id>CWE-436</cwe-id>
        <definition>Product A handles inputs or steps differently than Product B, which causes A to perform incorrect actions based on its perception of B&apos;s state.</definition>
        <rdfs:label>Interpretation Conflict</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-437 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-437">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-436"/>
        <cwe-id>CWE-437</cwe-id>
        <definition>A product acts as an intermediary or monitor between two or more endpoints, but it does not have a complete model of an endpoint&apos;s features, behaviors, or state, potentially causing the product to perform incorrect actions based on this incomplete model.</definition>
        <rdfs:label>Incomplete Model of Endpoint Features</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-439 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-439">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-435"/>
        <cwe-id>CWE-439</cwe-id>
        <definition>A&apos;s behavior or functionality changes with a new version of A, or a new environment, which is not known (or manageable) by B.</definition>
        <synonym>Functional change</synonym>
        <rdfs:label>Behavioral Change in New Version or Environment</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-44 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-44">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-41"/>
        <cwe-id>CWE-44</cwe-id>
        <definition>The product accepts path input in the form of internal dot (&apos;file.ordir&apos;) without appropriate validation, which can lead to ambiguous path resolution and allow an attacker to traverse the file system to unintended locations or access arbitrary files.</definition>
        <rdfs:label>Path Equivalence: &apos;file.name&apos; (Internal Dot)</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-440 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-440">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-684"/>
        <cwe-id>CWE-440</cwe-id>
        <definition>A feature, API, or function does not perform according to its specification.</definition>
        <rdfs:label>Expected Behavior Violation</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-441 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-441">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-610"/>
        <cwe-id>CWE-441</cwe-id>
        <definition>The product receives a request, message, or directive from an upstream component, but the product does not sufficiently preserve the original source of the request before forwarding the request to an external actor that is outside of the product&apos;s control sphere. This causes the product to appear to be the source of the request, leading it to act as a proxy or other intermediary between the upstream component and the external actor.</definition>
        <synonym>Confused Deputy</synonym>
        <rdfs:label>Unintended Proxy or Intermediary (&apos;Confused Deputy&apos;)</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-444 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-444">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-436"/>
        <cwe-id>CWE-444</cwe-id>
        <definition>The product acts as an intermediary HTTP agent (such as a proxy or firewall) in the data flow between two entities such as a client and server, but it does not interpret malformed HTTP requests or responses in ways that are consistent with how the messages will be processed by those entities that are at the ultimate destination.</definition>
        <synonym>HTTP Request Smuggling</synonym>
        <synonym>HTTP Response Smuggling</synonym>
        <synonym>HTTP Smuggling</synonym>
        <rdfs:label>Inconsistent Interpretation of HTTP Requests (&apos;HTTP Request/Response Smuggling&apos;)</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-446 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-446">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-684"/>
        <cwe-id>CWE-446</cwe-id>
        <definition>The user interface does not correctly enable or configure a security feature, but the interface provides feedback that causes the user to believe that the feature is in a secure state.</definition>
        <rdfs:label>UI Discrepancy for Security Feature</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-447 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-447">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-446"/>
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-671"/>
        <cwe-id>CWE-447</cwe-id>
        <definition>A UI function for a security feature appears to be supported and gives feedback to the user that suggests that it is supported, but the underlying functionality is not implemented.</definition>
        <rdfs:label>Unimplemented or Unsupported Feature in UI</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-448 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-448">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-446"/>
        <cwe-id>CWE-448</cwe-id>
        <definition>A UI function is obsolete and the product does not warn the user.</definition>
        <rdfs:label>Obsolete Feature in UI</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-449 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-449">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-446"/>
        <cwe-id>CWE-449</cwe-id>
        <definition>The UI performs the wrong action with respect to the user&apos;s request.</definition>
        <rdfs:label>The UI Performs the Wrong Action</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-45 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-45">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-165"/>
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-44"/>
        <cwe-id>CWE-45</cwe-id>
        <definition>The product accepts path input in the form of multiple internal dot (&apos;file...dir&apos;) without appropriate validation, which can lead to ambiguous path resolution and allow an attacker to traverse the file system to unintended locations or access arbitrary files.</definition>
        <rdfs:label>Path Equivalence: &apos;file...name&apos; (Multiple Internal Dot)</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-450 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-450">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-357"/>
        <cwe-id>CWE-450</cwe-id>
        <definition>The UI has multiple interpretations of user input but does not prompt the user when it selects the less secure interpretation.</definition>
        <rdfs:label>Multiple Interpretations of UI Input</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-451 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-451">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-221"/>
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-684"/>
        <cwe-id>CWE-451</cwe-id>
        <definition>The user interface (UI) does not properly represent critical information to the user, allowing the information - or its source - to be obscured or spoofed. This is often a component in phishing attacks.</definition>
        <rdfs:label>User Interface (UI) Misrepresentation of Critical Information</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-453 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-453">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1188"/>
        <cwe-id>CWE-453</cwe-id>
        <definition>The product, by default, initializes an internal variable with an insecure or less secure value than is possible.</definition>
        <rdfs:label>Insecure Default Variable Initialization</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-454 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-454">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1419"/>
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-665"/>
        <cwe-id>CWE-454</cwe-id>
        <definition>The product initializes critical internal variables or data stores using inputs that can be modified by untrusted actors.</definition>
        <rdfs:label>External Initialization of Trusted Variables or Data Stores</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-455 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-455">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-636"/>
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-665"/>
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-705"/>
        <cwe-id>CWE-455</cwe-id>
        <definition>The product does not exit or otherwise modify its operation when security-relevant errors occur during initialization, such as when a configuration file has a format error or a hardware security module (HSM) cannot be activated, which can cause the product to execute in a less secure fashion than intended by the administrator.</definition>
        <rdfs:label>Non-exit on Failed Initialization</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-456 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-456">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-909"/>
        <cwe-id>CWE-456</cwe-id>
        <definition>The product does not initialize critical variables, which causes the execution environment to use unexpected values.</definition>
        <rdfs:label>Missing Initialization of a Variable</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-457 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-457">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-908"/>
        <cwe-id>CWE-457</cwe-id>
        <definition>The code uses a variable that has not been initialized, leading to unpredictable or unintended results.</definition>
        <rdfs:label>Use of Uninitialized Variable</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-459 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-459">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-404"/>
        <cwe-id>CWE-459</cwe-id>
        <definition>The product does not properly &quot;clean up&quot; and remove temporary or supporting resources after they have been used.</definition>
        <synonym>Insufficient Cleanup</synonym>
        <rdfs:label>Incomplete Cleanup</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-46 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-46">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-162"/>
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-41"/>
        <cwe-id>CWE-46</cwe-id>
        <definition>The product accepts path input in the form of trailing space (&apos;filedir &apos;) without appropriate validation, which can lead to ambiguous path resolution and allow an attacker to traverse the file system to unintended locations or access arbitrary files.</definition>
        <rdfs:label>Path Equivalence: &apos;filename &apos; (Trailing Space)</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-460 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-460">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-459"/>
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-755"/>
        <cwe-id>CWE-460</cwe-id>
        <definition>The product does not clean up its state or incorrectly cleans up its state when an exception is thrown, leading to unexpected state or control flow.</definition>
        <rdfs:label>Improper Cleanup on Thrown Exception</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-462 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-462">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-694"/>
        <cwe-id>CWE-462</cwe-id>
        <definition>Duplicate keys in associative lists can lead to non-unique keys being mistaken for an error.</definition>
        <rdfs:label>Duplicate Key in Associative List (Alist)</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-463 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-463">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-707"/>
        <cwe-id>CWE-463</cwe-id>
        <definition>The accidental deletion of a data-structure sentinel can cause serious programming logic problems.</definition>
        <rdfs:label>Deletion of Data Structure Sentinel</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-464 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-464">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-138"/>
        <cwe-id>CWE-464</cwe-id>
        <definition>The accidental addition of a data-structure sentinel can cause serious programming logic problems.</definition>
        <rdfs:label>Addition of Data Structure Sentinel</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-466 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-466">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-119"/>
        <cwe-id>CWE-466</cwe-id>
        <definition>A function can return a pointer to memory that is outside of the buffer that the pointer is expected to reference.</definition>
        <rdfs:label>Return of Pointer Value Outside of Expected Range</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-467 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-467">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-131"/>
        <cwe-id>CWE-467</cwe-id>
        <definition>The code calls sizeof() on a pointer type, which can be an incorrect calculation if the programmer intended to determine the size of the data that is being pointed to.</definition>
        <rdfs:label>Use of sizeof() on a Pointer Type</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-468 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-468">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-682"/>
        <cwe-id>CWE-468</cwe-id>
        <definition>In C and C++, one may often accidentally refer to the wrong memory due to the semantics of when math operations are implicitly scaled.</definition>
        <rdfs:label>Incorrect Pointer Scaling</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-469 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-469">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-682"/>
        <cwe-id>CWE-469</cwe-id>
        <definition>The product subtracts one pointer from another in order to determine size, but this calculation can be incorrect if the pointers do not exist in the same memory chunk.</definition>
        <rdfs:label>Use of Pointer Subtraction to Determine Size</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-47 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-47">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-41"/>
        <cwe-id>CWE-47</cwe-id>
        <definition>The product accepts path input in the form of leading space (&apos; filedir&apos;) without appropriate validation, which can lead to ambiguous path resolution and allow an attacker to traverse the file system to unintended locations or access arbitrary files.</definition>
        <rdfs:label>Path Equivalence: &apos; filename&apos; (Leading Space)</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-470 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-470">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-610"/>
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-913"/>
        <cwe-id>CWE-470</cwe-id>
        <definition>The product uses external input with reflection to select which classes or code to use, but it does not sufficiently prevent the input from selecting improper classes or code.</definition>
        <synonym>Reflection Injection</synonym>
        <rdfs:label>Use of Externally-Controlled Input to Select Classes or Code (&apos;Unsafe Reflection&apos;)</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-471 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-471">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-664"/>
        <cwe-id>CWE-471</cwe-id>
        <definition>The product does not properly protect an assumed-immutable element from being modified by an attacker.</definition>
        <rdfs:label>Modification of Assumed-Immutable Data (MAID)</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-472 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-472">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-471"/>
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-642"/>
        <cwe-id>CWE-472</cwe-id>
        <definition>The web application does not sufficiently verify inputs that are assumed to be immutable but are actually externally controllable, such as hidden form fields.</definition>
        <synonym>Assumed-Immutable Parameter Tampering</synonym>
        <rdfs:label>External Control of Assumed-Immutable Web Parameter</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-473 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-473">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-471"/>
        <cwe-id>CWE-473</cwe-id>
        <definition>A PHP application does not properly protect against the modification of variables from external sources, such as query parameters or cookies. This can expose the application to numerous weaknesses that would not exist otherwise.</definition>
        <rdfs:label>PHP External Variable Modification</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-474 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-474">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-758"/>
        <cwe-id>CWE-474</cwe-id>
        <definition>The code uses a function that has inconsistent implementations across operating systems and versions.</definition>
        <rdfs:label>Use of Function with Inconsistent Implementations</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-475 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-475">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-573"/>
        <cwe-id>CWE-475</cwe-id>
        <definition>The behavior of this function is undefined unless its control parameter is set to a specific value.</definition>
        <rdfs:label>Undefined Behavior for Input to API</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-476 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-476">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-710"/>
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-754"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#weakness-of"/>
                <owl:someValuesFrom rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#PointerDereferencingFunction"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-477 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-477">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-710"/>
        <cwe-id>CWE-477</cwe-id>
        <definition>The code uses deprecated or obsolete functions, which suggests that the code has not been actively reviewed or maintained.</definition>
        <rdfs:label>Use of Obsolete Function</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-478 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-478">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1023"/>
        <cwe-id>CWE-478</cwe-id>
        <definition>The code does not have a default case in an expression with multiple conditions, such as a switch statement.</definition>
        <rdfs:label>Missing Default Case in Multiple Condition Expression</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-479 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-479">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-663"/>
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-828"/>
        <cwe-id>CWE-479</cwe-id>
        <definition>The product defines a signal handler that calls a non-reentrant function.</definition>
        <rdfs:label>Signal Handler Use of a Non-reentrant Function</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-48 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-48">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-41"/>
        <cwe-id>CWE-48</cwe-id>
        <definition>The product accepts path input in the form of internal space (&apos;file(SPACE)name&apos;) without appropriate validation, which can lead to ambiguous path resolution and allow an attacker to traverse the file system to unintended locations or access arbitrary files.</definition>
        <rdfs:label>Path Equivalence: &apos;file name&apos; (Internal Whitespace)</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-480 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-480">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-670"/>
        <cwe-id>CWE-480</cwe-id>
        <definition>The product accidentally uses the wrong operator, which changes the logic in security-relevant ways.</definition>
        <rdfs:label>Use of Incorrect Operator</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-481 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-481">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-480"/>
        <cwe-id>CWE-481</cwe-id>
        <definition>The code uses an operator for assignment when the intention was to perform a comparison.</definition>
        <rdfs:label>Assigning instead of Comparing</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-482 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-482">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-480"/>
        <cwe-id>CWE-482</cwe-id>
        <definition>The code uses an operator for comparison when the intention was to perform an assignment.</definition>
        <rdfs:label>Comparing instead of Assigning</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-483 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-483">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-670"/>
        <cwe-id>CWE-483</cwe-id>
        <definition>The code does not explicitly delimit a block that is intended to contain 2 or more statements, creating a logic error.</definition>
        <rdfs:label>Incorrect Block Delimitation</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-484 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-484">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-670"/>
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-710"/>
        <cwe-id>CWE-484</cwe-id>
        <definition>The product omits a break statement within a switch or similar construct, causing code associated with multiple conditions to execute. This can cause problems when the programmer only intended to execute code associated with one condition.</definition>
        <rdfs:label>Omitted Break Statement in Switch</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-486 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-486">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1025"/>
        <cwe-id>CWE-486</cwe-id>
        <definition>The product compares classes by name, which can cause it to use the wrong class when multiple classes can have the same name.</definition>
        <rdfs:label>Comparison of Classes by Name</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-487 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-487">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-664"/>
        <cwe-id>CWE-487</cwe-id>
        <definition>Java packages are not inherently closed; therefore, relying on them for code security is not a good practice.</definition>
        <rdfs:label>Reliance on Package-level Scope</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-488 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-488">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-668"/>
        <cwe-id>CWE-488</cwe-id>
        <definition>The product does not sufficiently enforce boundaries between the states of different sessions, causing data to be provided to, or used by, the wrong session.</definition>
        <rdfs:label>Exposure of Data Element to Wrong Session</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-489 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-489">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-710"/>
        <cwe-id>CWE-489</cwe-id>
        <definition>The product is deployed to unauthorized actors with debugging code still enabled or active, which can create unintended entry points or expose sensitive information.</definition>
        <synonym>Leftover debug code</synonym>
        <rdfs:label>Active Debug Code</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-49 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-49">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-162"/>
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-41"/>
        <cwe-id>CWE-49</cwe-id>
        <definition>The product accepts path input in the form of trailing slash (&apos;filedir/&apos;) without appropriate validation, which can lead to ambiguous path resolution and allow an attacker to traverse the file system to unintended locations or access arbitrary files.</definition>
        <rdfs:label>Path Equivalence: &apos;filename/&apos; (Trailing Slash)</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-491 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-491">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-668"/>
        <cwe-id>CWE-491</cwe-id>
        <definition>A class has a cloneable() method that is not declared final, which allows an object to be created without calling the constructor. This can cause the object to be in an unexpected state.</definition>
        <rdfs:label>Public cloneable() Method Without Final (&apos;Object Hijack&apos;)</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-492 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-492">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-668"/>
        <cwe-id>CWE-492</cwe-id>
        <definition>Inner classes are translated into classes that are accessible at package scope and may expose code that the programmer intended to keep private to attackers.</definition>
        <rdfs:label>Use of Inner Class Containing Sensitive Data</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-493 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-493">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-668"/>
        <cwe-id>CWE-493</cwe-id>
        <definition>The product has a critical public variable that is not final, which allows the variable to be modified to contain unexpected values.</definition>
        <rdfs:label>Critical Public Variable Without Final Modifier</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-494 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-494">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-345"/>
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-669"/>
        <cwe-id>CWE-494</cwe-id>
        <definition>The product downloads source code or an executable from a remote location and executes the code without sufficiently verifying the origin and integrity of the code.</definition>
        <rdfs:label>Download of Code Without Integrity Check</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-495 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-495">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-664"/>
        <cwe-id>CWE-495</cwe-id>
        <definition>The product has a method that is declared public, but returns a reference to a private data structure, which could then be modified in unexpected ways.</definition>
        <rdfs:label>Private Data Structure Returned From A Public Method</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-496 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-496">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-664"/>
        <cwe-id>CWE-496</cwe-id>
        <definition>Assigning public data to a private array is equivalent to giving public access to the array.</definition>
        <rdfs:label>Public Data Assigned to Private Array-Typed Field</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-497 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-497">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-200"/>
        <cwe-id>CWE-497</cwe-id>
        <definition>The product does not properly prevent sensitive system-level information from being accessed by unauthorized actors who do not have the same level of access to the underlying system as the product does.</definition>
        <rdfs:label>Exposure of Sensitive System Information to an Unauthorized Control Sphere</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-498 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-498">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-668"/>
        <cwe-id>CWE-498</cwe-id>
        <definition>The code contains a class with sensitive data, but the class is cloneable. The data can then be accessed by cloning the class.</definition>
        <rdfs:label>Cloneable Class Containing Sensitive Information</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-499 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-499">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-668"/>
        <cwe-id>CWE-499</cwe-id>
        <definition>The code contains a class with sensitive data, but the class does not explicitly deny serialization. The data can be accessed by serializing the class through another class.</definition>
        <rdfs:label>Serializable Class Containing Sensitive Data</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-5 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-5">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-319"/>
        <cwe-id>CWE-5</cwe-id>
        <definition>Information sent over a network can be compromised while in transit. An attacker may be able to read or modify the contents if the data are sent in plaintext or are weakly encrypted.</definition>
        <rdfs:label>J2EE Misconfiguration: Data Transmission Without Encryption</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-50 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-50">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-161"/>
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-41"/>
        <cwe-id>CWE-50</cwe-id>
        <definition>The product accepts path input in the form of multiple leading slash (&apos;//multiple/leading/slash&apos;) without appropriate validation, which can lead to ambiguous path resolution and allow an attacker to traverse the file system to unintended locations or access arbitrary files.</definition>
        <rdfs:label>Path Equivalence: &apos;//multiple/leading/slash&apos;</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-500 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-500">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-493"/>
        <cwe-id>CWE-500</cwe-id>
        <definition>An object contains a public static field that is not marked final, which might allow it to be modified in unexpected ways.</definition>
        <rdfs:label>Public Static Field Not Marked Final</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-501 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-501">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-664"/>
        <cwe-id>CWE-501</cwe-id>
        <definition>The product mixes trusted and untrusted data in the same data structure or structured message.</definition>
        <rdfs:label>Trust Boundary Violation</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-502 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-502">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-913"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#may-be-weakness-of"/>
                <owl:someValuesFrom rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#UserInputFunction"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#weakness-of"/>
                <owl:someValuesFrom rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#DeserializationFunction"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-506 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-506">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-912"/>
        <cwe-id>CWE-506</cwe-id>
        <definition>The product contains code that appears to be malicious in nature.</definition>
        <rdfs:label>Embedded Malicious Code</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-507 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-507">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-506"/>
        <cwe-id>CWE-507</cwe-id>
        <definition>The product appears to contain benign or useful functionality, but it also contains code that is hidden from normal operation that violates the intended security policy of the user or the system administrator.</definition>
        <rdfs:label>Trojan Horse</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-508 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-508">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-507"/>
        <cwe-id>CWE-508</cwe-id>
        <definition>Non-replicating malicious code only resides on the target system or product that is attacked; it does not attempt to spread to other systems.</definition>
        <rdfs:label>Non-Replicating Malicious Code</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-509 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-509">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-507"/>
        <cwe-id>CWE-509</cwe-id>
        <definition>Replicating malicious code, including viruses and worms, will attempt to attack other systems once it has successfully compromised the target system or the product.</definition>
        <rdfs:label>Replicating Malicious Code (Virus or Worm)</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-51 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-51">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-41"/>
        <cwe-id>CWE-51</cwe-id>
        <definition>The product accepts path input in the form of multiple internal slash (&apos;/multiple//internal/slash/&apos;) without appropriate validation, which can lead to ambiguous path resolution and allow an attacker to traverse the file system to unintended locations or access arbitrary files.</definition>
        <rdfs:label>Path Equivalence: &apos;/multiple//internal/slash&apos;</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-510 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-510">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-506"/>
        <cwe-id>CWE-510</cwe-id>
        <definition>A trapdoor is a hidden piece of code that responds to a special input, allowing its user access to resources without passing through the normal security enforcement mechanism.</definition>
        <rdfs:label>Trapdoor</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-511 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-511">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-506"/>
        <cwe-id>CWE-511</cwe-id>
        <definition>The product contains code that is designed to disrupt the legitimate operation of the product (or its environment) when a certain time passes, or when a certain logical condition is met.</definition>
        <rdfs:label>Logic/Time Bomb</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-512 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-512">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-506"/>
        <cwe-id>CWE-512</cwe-id>
        <definition>The product collects personally identifiable information about a human user or the user&apos;s activities, but the product accesses this information using other resources besides itself, and it does not require that user&apos;s explicit approval or direct input into the product.</definition>
        <rdfs:label>Spyware</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-514 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-514">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1229"/>
        <cwe-id>CWE-514</cwe-id>
        <definition>A covert channel is a path that can be used to transfer information in a way not intended by the system&apos;s designers.</definition>
        <rdfs:label>Covert Channel</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-515 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-515">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-514"/>
        <cwe-id>CWE-515</cwe-id>
        <definition>A covert storage channel transfers information through the setting of bits by one program and the reading of those bits by another. What distinguishes this case from that of ordinary operation is that the bits are used to convey encoded information.</definition>
        <rdfs:label>Covert Storage Channel</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-52 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-52">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-163"/>
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-41"/>
        <cwe-id>CWE-52</cwe-id>
        <definition>The product accepts path input in the form of multiple trailing slash (&apos;/multiple/trailing/slash//&apos;) without appropriate validation, which can lead to ambiguous path resolution and allow an attacker to traverse the file system to unintended locations or access arbitrary files.</definition>
        <rdfs:label>Path Equivalence: &apos;/multiple/trailing/slash//&apos;</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-520 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-520">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-266"/>
        <cwe-id>CWE-520</cwe-id>
        <definition>Allowing a .NET application to run at potentially escalated levels of access to the underlying operating and file systems can be dangerous and result in various forms of attacks.</definition>
        <rdfs:label>.NET Misconfiguration: Use of Impersonation</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-521 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-521">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1391"/>
        <cwe-id>CWE-521</cwe-id>
        <definition>The product does not require that users should have strong passwords, which makes it easier for attackers to compromise user accounts.</definition>
        <rdfs:label>Weak Password Requirements</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-522 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-522">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1390"/>
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-668"/>
        <cwe-id>CWE-522</cwe-id>
        <definition>The product transmits or stores authentication credentials, but it uses an insecure method that is susceptible to unauthorized interception and/or retrieval.</definition>
        <rdfs:label>Insufficiently Protected Credentials</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-523 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-523">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-522"/>
        <cwe-id>CWE-523</cwe-id>
        <definition>Login pages do not use adequate measures to protect the user name and password while they are in transit from the client to the server.</definition>
        <rdfs:label>Unprotected Transport of Credentials</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-524 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-524">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-668"/>
        <cwe-id>CWE-524</cwe-id>
        <definition>The code uses a cache that contains sensitive information, but the cache can be read by an actor outside of the intended control sphere.</definition>
        <rdfs:label>Use of Cache Containing Sensitive Information</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-525 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-525">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-524"/>
        <cwe-id>CWE-525</cwe-id>
        <definition>The web application does not use an appropriate caching policy that specifies the extent to which each web page and associated form fields should be cached.</definition>
        <rdfs:label>Use of Web Browser Cache Containing Sensitive Information</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-526 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-526">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-312"/>
        <cwe-id>CWE-526</cwe-id>
        <definition>The product uses an environment variable to store unencrypted sensitive information.</definition>
        <rdfs:label>Cleartext Storage of Sensitive Information in an Environment Variable</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-527 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-527">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-552"/>
        <cwe-id>CWE-527</cwe-id>
        <definition>The product stores a CVS, git, or other repository in a directory, archive, or other resource that is stored, transferred, or otherwise made accessible to unauthorized actors.</definition>
        <rdfs:label>Exposure of Version-Control Repository to an Unauthorized Control Sphere</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-528 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-528">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-552"/>
        <cwe-id>CWE-528</cwe-id>
        <definition>The product generates a core dump file in a directory, archive, or other resource that is stored, transferred, or otherwise made accessible to unauthorized actors.</definition>
        <rdfs:label>Exposure of Core Dump File to an Unauthorized Control Sphere</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-529 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-529">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-552"/>
        <cwe-id>CWE-529</cwe-id>
        <definition>The product stores access control list files in a directory or other container that is accessible to actors outside of the intended control sphere.</definition>
        <rdfs:label>Exposure of Access Control List Files to an Unauthorized Control Sphere</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-53 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-53">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-165"/>
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-41"/>
        <cwe-id>CWE-53</cwe-id>
        <definition>The product accepts path input in the form of multiple internal backslash (&apos;\multiple\trailing\\slash&apos;) without appropriate validation, which can lead to ambiguous path resolution and allow an attacker to traverse the file system to unintended locations or access arbitrary files.</definition>
        <rdfs:label>Path Equivalence: &apos;\multiple\\internal\backslash&apos;</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-530 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-530">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-552"/>
        <cwe-id>CWE-530</cwe-id>
        <definition>A backup file is stored in a directory or archive that is made accessible to unauthorized actors.</definition>
        <rdfs:label>Exposure of Backup File to an Unauthorized Control Sphere</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-531 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-531">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-540"/>
        <cwe-id>CWE-531</cwe-id>
        <definition>Accessible test applications can pose a variety of security risks. Since developers or administrators rarely consider that someone besides themselves would even know about the existence of these applications, it is common for them to contain sensitive information or functions.</definition>
        <rdfs:label>Inclusion of Sensitive Information in Test Code</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-532 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-532">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-538"/>
        <cwe-id>CWE-532</cwe-id>
        <definition>The product writes sensitive information to a log file.</definition>
        <rdfs:label>Insertion of Sensitive Information into Log File</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-535 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-535">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-211"/>
        <cwe-id>CWE-535</cwe-id>
        <definition>A command shell error message indicates that there exists an unhandled exception in the web application code. In many cases, an attacker can leverage the conditions that cause these errors in order to gain unauthorized access to the system.</definition>
        <rdfs:label>Exposure of Information Through Shell Error Message</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-536 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-536">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-211"/>
        <cwe-id>CWE-536</cwe-id>
        <definition>A servlet error message indicates that there exists an unhandled exception in your web application code and may provide useful information to an attacker.</definition>
        <rdfs:label>Servlet Runtime Error Message Containing Sensitive Information</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-537 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-537">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-211"/>
        <cwe-id>CWE-537</cwe-id>
        <definition>In many cases, an attacker can leverage the conditions that cause unhandled exception errors in order to gain unauthorized access to the system.</definition>
        <rdfs:label>Java Runtime Error Message Containing Sensitive Information</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-538 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-538">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-200"/>
        <cwe-id>CWE-538</cwe-id>
        <definition>The product places sensitive information into files or directories that are accessible to actors who are allowed to have access to the files, but not to the sensitive information.</definition>
        <rdfs:label>Insertion of Sensitive Information into Externally-Accessible File or Directory</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-539 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-539">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-552"/>
        <cwe-id>CWE-539</cwe-id>
        <definition>The web application uses persistent cookies, but the cookies contain sensitive information.</definition>
        <rdfs:label>Use of Persistent Cookies Containing Sensitive Information</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-54 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-54">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-162"/>
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-41"/>
        <cwe-id>CWE-54</cwe-id>
        <definition>The product accepts path input in the form of trailing backslash (&apos;filedir\&apos;) without appropriate validation, which can lead to ambiguous path resolution and allow an attacker to traverse the file system to unintended locations or access arbitrary files.</definition>
        <rdfs:label>Path Equivalence: &apos;filedir\&apos; (Trailing Backslash)</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-540 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-540">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-538"/>
        <cwe-id>CWE-540</cwe-id>
        <definition>Source code on a web server or repository often contains sensitive information and should generally not be accessible to users.</definition>
        <rdfs:label>Inclusion of Sensitive Information in Source Code</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-541 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-541">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-540"/>
        <cwe-id>CWE-541</cwe-id>
        <definition>If an include file source is accessible, the file can contain usernames and passwords, as well as sensitive information pertaining to the application and system.</definition>
        <rdfs:label>Inclusion of Sensitive Information in an Include File</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-543 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-543">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-820"/>
        <cwe-id>CWE-543</cwe-id>
        <definition>The product uses the singleton pattern when creating a resource within a multithreaded environment.</definition>
        <rdfs:label>Use of Singleton Pattern Without Synchronization in a Multithreaded Context</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-544 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-544">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-755"/>
        <cwe-id>CWE-544</cwe-id>
        <definition>The product does not use a standardized method for handling errors throughout the code, which might introduce inconsistent error handling and resultant weaknesses.</definition>
        <rdfs:label>Missing Standardized Error Handling Mechanism</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-546 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-546">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1078"/>
        <cwe-id>CWE-546</cwe-id>
        <definition>The code contains comments that suggest the presence of bugs, incomplete functionality, or weaknesses.</definition>
        <rdfs:label>Suspicious Comment</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-547 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-547">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1078"/>
        <cwe-id>CWE-547</cwe-id>
        <definition>The product uses hard-coded constants instead of symbolic names for security-critical values, which increases the likelihood of mistakes during code maintenance or security policy change.</definition>
        <rdfs:label>Use of Hard-coded, Security-relevant Constants</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-548 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-548">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-497"/>
        <cwe-id>CWE-548</cwe-id>
        <definition>The product inappropriately exposes a directory listing with an index of all the resources located inside of the directory.</definition>
        <rdfs:label>Exposure of Information Through Directory Listing</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-549 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-549">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-522"/>
        <cwe-id>CWE-549</cwe-id>
        <definition>The product does not mask passwords during entry, increasing the potential for attackers to observe and capture passwords.</definition>
        <rdfs:label>Missing Password Field Masking</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-55 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-55">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-41"/>
        <cwe-id>CWE-55</cwe-id>
        <definition>The product accepts path input in the form of single dot directory exploit (&apos;/./&apos;) without appropriate validation, which can lead to ambiguous path resolution and allow an attacker to traverse the file system to unintended locations or access arbitrary files.</definition>
        <rdfs:label>Path Equivalence: &apos;/./&apos; (Single Dot Directory)</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-550 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-550">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-209"/>
        <cwe-id>CWE-550</cwe-id>
        <definition>Certain conditions, such as network failure, will cause a server error message to be displayed.</definition>
        <rdfs:label>Server-generated Error Message Containing Sensitive Information</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-551 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-551">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-696"/>
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-863"/>
        <cwe-id>CWE-551</cwe-id>
        <definition>If a web server does not fully parse requested URLs before it examines them for authorization, it may be possible for an attacker to bypass authorization protection.</definition>
        <rdfs:label>Incorrect Behavior Order: Authorization Before Parsing and Canonicalization</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-552 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-552">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-285"/>
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-668"/>
        <cwe-id>CWE-552</cwe-id>
        <definition>The product makes files or directories accessible to unauthorized actors, even though they should not be.</definition>
        <rdfs:label>Files or Directories Accessible to External Parties</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-553 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-553">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-552"/>
        <cwe-id>CWE-553</cwe-id>
        <definition>A possible shell file exists in /cgi-bin/ or other accessible directories. This is extremely dangerous and can be used by an attacker to execute commands on the web server.</definition>
        <rdfs:label>Command Shell in Externally Accessible Directory</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-554 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-554">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1173"/>
        <cwe-id>CWE-554</cwe-id>
        <definition>The ASP.NET application does not use an input validation framework.</definition>
        <rdfs:label>ASP.NET Misconfiguration: Not Using Input Validation Framework</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-555 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-555">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-260"/>
        <cwe-id>CWE-555</cwe-id>
        <definition>The J2EE application stores a plaintext password in a configuration file.</definition>
        <rdfs:label>J2EE Misconfiguration: Plaintext Password in Configuration File</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-556 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-556">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-266"/>
        <cwe-id>CWE-556</cwe-id>
        <definition>Configuring an ASP.NET application to run with impersonated credentials may give the application unnecessary privileges.</definition>
        <rdfs:label>ASP.NET Misconfiguration: Use of Identity Impersonation</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-558 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-558">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-663"/>
        <cwe-id>CWE-558</cwe-id>
        <definition>The product uses the getlogin() function in a multithreaded context, potentially causing it to return incorrect values.</definition>
        <rdfs:label>Use of getlogin() in Multithreaded Application</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-56 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-56">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-155"/>
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-41"/>
        <cwe-id>CWE-56</cwe-id>
        <definition>The product accepts path input in the form of asterisk wildcard (&apos;filedir*&apos;) without appropriate validation, which can lead to ambiguous path resolution and allow an attacker to traverse the file system to unintended locations or access arbitrary files.</definition>
        <rdfs:label>Path Equivalence: &apos;filedir*&apos; (Wildcard)</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-560 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-560">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-687"/>
        <cwe-id>CWE-560</cwe-id>
        <definition>The product calls umask() with an incorrect argument that is specified as if it is an argument to chmod().</definition>
        <rdfs:label>Use of umask() with chmod-style Argument</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-561 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-561">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1164"/>
        <cwe-id>CWE-561</cwe-id>
        <definition>The product contains dead code, which can never be executed.</definition>
        <rdfs:label>Dead Code</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-562 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-562">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-758"/>
        <cwe-id>CWE-562</cwe-id>
        <definition>A function returns the address of a stack variable, which will cause unintended program behavior, typically in the form of a crash.</definition>
        <rdfs:label>Return of Stack Variable Address</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-563 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-563">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1164"/>
        <cwe-id>CWE-563</cwe-id>
        <definition>The variable&apos;s value is assigned but never used, making it a dead store.</definition>
        <synonym>Unused Variable</synonym>
        <rdfs:label>Assignment to Variable without Use</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-564 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-564">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-89"/>
        <cwe-id>CWE-564</cwe-id>
        <definition>Using Hibernate to execute a dynamic SQL statement built with user-controlled input can allow an attacker to modify the statement&apos;s meaning or to execute arbitrary SQL commands.</definition>
        <rdfs:label>SQL Injection: Hibernate</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-565 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-565">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-602"/>
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-642"/>
        <cwe-id>CWE-565</cwe-id>
        <definition>The product relies on the existence or values of cookies when performing security-critical operations, but it does not properly ensure that the setting is valid for the associated user.</definition>
        <rdfs:label>Reliance on Cookies without Validation and Integrity Checking</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-566 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-566">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-639"/>
        <cwe-id>CWE-566</cwe-id>
        <definition>The product uses a database table that includes records that should not be accessible to an actor, but it executes a SQL statement with a primary key that can be controlled by that actor.</definition>
        <rdfs:label>Authorization Bypass Through User-Controlled SQL Primary Key</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-567 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-567">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-820"/>
        <cwe-id>CWE-567</cwe-id>
        <definition>The product does not properly synchronize shared data, such as static variables across threads, which can lead to undefined behavior and unpredictable data changes.</definition>
        <rdfs:label>Unsynchronized Access to Shared Data in a Multithreaded Context</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-568 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-568">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-459"/>
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-573"/>
        <cwe-id>CWE-568</cwe-id>
        <definition>The product contains a finalize() method that does not call super.finalize().</definition>
        <rdfs:label>finalize() Method Without super.finalize()</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-57 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-57">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-41"/>
        <cwe-id>CWE-57</cwe-id>
        <definition>The product contains protection mechanisms to restrict access to &apos;realdir/filename&apos;, but it constructs pathnames using external input in the form of &apos;fakedir/../realdir/filename&apos; that are not handled by those mechanisms. This allows attackers to perform unauthorized actions against the targeted file.</definition>
        <rdfs:label>Path Equivalence: &apos;fakedir/../realdir/filename&apos;</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-570 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-570">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-710"/>
        <cwe-id>CWE-570</cwe-id>
        <definition>The product contains an expression that will always evaluate to false.</definition>
        <rdfs:label>Expression is Always False</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-571 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-571">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-710"/>
        <cwe-id>CWE-571</cwe-id>
        <definition>The product contains an expression that will always evaluate to true.</definition>
        <rdfs:label>Expression is Always True</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-572 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-572">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-821"/>
        <cwe-id>CWE-572</cwe-id>
        <definition>The product calls a thread&apos;s run() method instead of calling start(), which causes the code to run in the thread of the caller instead of the callee.</definition>
        <rdfs:label>Call to Thread run() instead of start()</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-573 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-573">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-710"/>
        <cwe-id>CWE-573</cwe-id>
        <definition>The product does not follow or incorrectly follows the specifications as required by the implementation language, environment, framework, protocol, or platform.</definition>
        <rdfs:label>Improper Following of Specification by Caller</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-574 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-574">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-695"/>
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-821"/>
        <cwe-id>CWE-574</cwe-id>
        <definition>The product violates the Enterprise JavaBeans (EJB) specification by using thread synchronization primitives.</definition>
        <rdfs:label>EJB Bad Practices: Use of Synchronization Primitives</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-575 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-575">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-695"/>
        <cwe-id>CWE-575</cwe-id>
        <definition>The product violates the Enterprise JavaBeans (EJB) specification by using AWT/Swing.</definition>
        <rdfs:label>EJB Bad Practices: Use of AWT Swing</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-576 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-576">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-695"/>
        <cwe-id>CWE-576</cwe-id>
        <definition>The product violates the Enterprise JavaBeans (EJB) specification by using the java.io package.</definition>
        <rdfs:label>EJB Bad Practices: Use of Java I/O</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-577 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-577">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-573"/>
        <cwe-id>CWE-577</cwe-id>
        <definition>The product violates the Enterprise JavaBeans (EJB) specification by using sockets.</definition>
        <rdfs:label>EJB Bad Practices: Use of Sockets</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-578 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-578">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-573"/>
        <cwe-id>CWE-578</cwe-id>
        <definition>The product violates the Enterprise JavaBeans (EJB) specification by using the class loader.</definition>
        <rdfs:label>EJB Bad Practices: Use of Class Loader</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-579 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-579">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-573"/>
        <cwe-id>CWE-579</cwe-id>
        <definition>The product stores a non-serializable object as an HttpSession attribute, which can hurt reliability.</definition>
        <rdfs:label>J2EE Bad Practices: Non-serializable Object Stored in Session</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-58 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-58">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-41"/>
        <cwe-id>CWE-58</cwe-id>
        <definition>The product contains a protection mechanism that restricts access to a long filename on a Windows operating system, but it does not properly restrict access to the equivalent short &quot;8.3&quot; filename.</definition>
        <rdfs:label>Path Equivalence: Windows 8.3 Filename</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-580 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-580">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-573"/>
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-664"/>
        <cwe-id>CWE-580</cwe-id>
        <definition>The product contains a clone() method that does not call super.clone() to obtain the new object.</definition>
        <rdfs:label>clone() Method Without super.clone()</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-581 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-581">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-573"/>
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-697"/>
        <cwe-id>CWE-581</cwe-id>
        <definition>The product does not maintain equal hashcodes for equal objects.</definition>
        <rdfs:label>Object Model Violation: Just One of Equals and Hashcode Defined</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-582 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-582">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-668"/>
        <cwe-id>CWE-582</cwe-id>
        <definition>The product declares an array public, final, and static, which is not sufficient to prevent the array&apos;s contents from being modified.</definition>
        <rdfs:label>Array Declared Public, Final, and Static</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-583 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-583">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-668"/>
        <cwe-id>CWE-583</cwe-id>
        <definition>The product violates secure coding principles for mobile code by declaring a finalize() method public.</definition>
        <rdfs:label>finalize() Method Declared Public</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-584 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-584">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-705"/>
        <cwe-id>CWE-584</cwe-id>
        <definition>The code has a return statement inside a finally block, which will cause any thrown exception in the try block to be discarded.</definition>
        <rdfs:label>Return Inside Finally Block</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-585 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-585">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1071"/>
        <cwe-id>CWE-585</cwe-id>
        <definition>The product contains an empty synchronized block.</definition>
        <rdfs:label>Empty Synchronized Block</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-586 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-586">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1076"/>
        <cwe-id>CWE-586</cwe-id>
        <definition>The product makes an explicit call to the finalize() method from outside the finalizer.</definition>
        <rdfs:label>Explicit Call to Finalize()</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-587 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-587">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-344"/>
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-758"/>
        <cwe-id>CWE-587</cwe-id>
        <definition>The product sets a pointer to a specific address other than NULL or 0.</definition>
        <rdfs:label>Assignment of a Fixed Address to a Pointer</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-588 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-588">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-704"/>
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-758"/>
        <cwe-id>CWE-588</cwe-id>
        <definition>Casting a non-structure type to a structure type and accessing a field can lead to memory access errors or data corruption.</definition>
        <rdfs:label>Attempt to Access Child of a Non-structure Pointer</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-589 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-589">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-474"/>
        <cwe-id>CWE-589</cwe-id>
        <definition>The product uses an API function that does not exist on all versions of the target platform. This could cause portability problems or inconsistencies that allow denial of service or other consequences.</definition>
        <rdfs:label>Call to Non-ubiquitous API</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-59 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-59">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-706"/>
        <cwe-id>CWE-59</cwe-id>
        <definition>The product attempts to access a file based on the filename, but it does not properly prevent that filename from identifying a link or shortcut that resolves to an unintended resource.</definition>
        <synonym>Zip Slip</synonym>
        <synonym>insecure temporary file</synonym>
        <rdfs:label>Improper Link Resolution Before File Access (&apos;Link Following&apos;)</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-590 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-590">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-762"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#weakness-of"/>
                <owl:someValuesFrom rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#MemoryFreeFunction"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-591 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-591">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-413"/>
        <cwe-id>CWE-591</cwe-id>
        <definition>The product stores sensitive data in memory that is not locked, or that has been incorrectly locked, which might cause the memory to be written to swap files on disk by the virtual memory manager. This can make the data more accessible to external actors.</definition>
        <rdfs:label>Sensitive Data Storage in Improperly Locked Memory</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-593 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-593">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1390"/>
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-666"/>
        <cwe-id>CWE-593</cwe-id>
        <definition>The product modifies the SSL context after connection creation has begun.</definition>
        <rdfs:label>Authentication Bypass: OpenSSL CTX Object Modified after SSL Objects are Created</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-594 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-594">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1076"/>
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-710"/>
        <cwe-id>CWE-594</cwe-id>
        <definition>When the J2EE container attempts to write unserializable objects to disk there is no guarantee that the process will complete successfully.</definition>
        <rdfs:label>J2EE Framework: Saving Unserializable Objects to Disk</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-595 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-595">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1025"/>
        <cwe-id>CWE-595</cwe-id>
        <definition>The product compares object references instead of the contents of the objects themselves, preventing it from detecting equivalent objects.</definition>
        <rdfs:label>Comparison of Object References Instead of Object Contents</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-597 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-597">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-480"/>
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-595"/>
        <cwe-id>CWE-597</cwe-id>
        <definition>The product uses the wrong operator when comparing a string, such as using &quot;==&quot; when the .equals() method should be used instead.</definition>
        <rdfs:label>Use of Wrong Operator in String Comparison</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-598 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-598">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-201"/>
        <cwe-id>CWE-598</cwe-id>
        <definition>The web application uses the HTTP GET method to process a request and includes sensitive information in the query string of that request.</definition>
        <rdfs:label>Use of GET Request Method With Sensitive Query Strings</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-599 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-599">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-295"/>
        <cwe-id>CWE-599</cwe-id>
        <definition>The product uses OpenSSL and trusts or uses a certificate without using the SSL_get_verify_result() function to ensure that the certificate satisfies all necessary security requirements.</definition>
        <rdfs:label>Missing Validation of OpenSSL Certificate</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-6 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-6">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-334"/>
        <cwe-id>CWE-6</cwe-id>
        <definition>The J2EE application is configured to use an insufficient session ID length.</definition>
        <rdfs:label>J2EE Misconfiguration: Insufficient Session-ID Length</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-600 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-600">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-248"/>
        <cwe-id>CWE-600</cwe-id>
        <definition>The Servlet does not catch all exceptions, which may reveal sensitive debugging information.</definition>
        <synonym>Missing Catch Block</synonym>
        <rdfs:label>Uncaught Exception in Servlet</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-601 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-601">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-610"/>
        <cwe-id>CWE-601</cwe-id>
        <definition>The web application accepts a user-controlled input that specifies a link to an external site, and uses that link in a redirect.</definition>
        <synonym>Cross-domain Redirect</synonym>
        <synonym>Cross-site Redirect</synonym>
        <synonym>Open Redirect</synonym>
        <synonym>Unvalidated Redirect</synonym>
        <rdfs:label>URL Redirection to Untrusted Site (&apos;Open Redirect&apos;)</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-602 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-602">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-693"/>
        <cwe-id>CWE-602</cwe-id>
        <definition>The product is composed of a server that relies on the client to implement a mechanism that is intended to protect the server.</definition>
        <rdfs:label>Client-Side Enforcement of Server-Side Security</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-603 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-603">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1390"/>
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-602"/>
        <cwe-id>CWE-603</cwe-id>
        <definition>A client/server product performs authentication within client code but not in server code, allowing server-side authentication to be bypassed via a modified client that omits the authentication check.</definition>
        <rdfs:label>Use of Client-Side Authentication</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-605 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-605">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-666"/>
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-675"/>
        <cwe-id>CWE-605</cwe-id>
        <definition>When multiple sockets are allowed to bind to the same port, other services on that port may be stolen or spoofed.</definition>
        <rdfs:label>Multiple Binds to the Same Port</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-606 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-606">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1284"/>
        <cwe-id>CWE-606</cwe-id>
        <definition>The product does not properly check inputs that are used for loop conditions, potentially leading to a denial of service or other consequences because of excessive looping.</definition>
        <rdfs:label>Unchecked Input for Loop Condition</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-607 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-607">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-471"/>
        <cwe-id>CWE-607</cwe-id>
        <definition>A public or protected static final field references a mutable object, which allows the object to be changed by malicious code, or accidentally from another package.</definition>
        <rdfs:label>Public Static Final Field References Mutable Object</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-608 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-608">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-668"/>
        <cwe-id>CWE-608</cwe-id>
        <definition>An ActionForm class contains a field that has not been declared private, which can be accessed without using a setter or getter.</definition>
        <rdfs:label>Struts: Non-private Field in ActionForm Class</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-609 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-609">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-667"/>
        <cwe-id>CWE-609</cwe-id>
        <definition>The product uses double-checked locking to access a resource without the overhead of explicit synchronization, but the locking is insufficient.</definition>
        <rdfs:label>Double-Checked Locking</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-61 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-61">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-59"/>
        <cwe-id>CWE-61</cwe-id>
        <definition>The product, when opening a file or directory, does not sufficiently account for when the file is a symbolic link that resolves to a target outside of the intended control sphere. This could allow an attacker to cause the product to operate on unauthorized files.</definition>
        <synonym>Symlink following</synonym>
        <synonym>symlink vulnerability</synonym>
        <rdfs:label>UNIX Symbolic Link (Symlink) Following</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-610 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-610">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-664"/>
        <cwe-id>CWE-610</cwe-id>
        <definition>The product uses an externally controlled name or reference that resolves to a resource that is outside of the intended control sphere.</definition>
        <rdfs:label>Externally Controlled Reference to a Resource in Another Sphere</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-611 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-611">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-610"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#weakness-of"/>
                <owl:someValuesFrom rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#ExternalContentInclusionFunction"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-612 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-612">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1230"/>
        <cwe-id>CWE-612</cwe-id>
        <definition>The product creates a search index of private or sensitive documents, but it does not properly limit index access to actors who are authorized to see the original information.</definition>
        <rdfs:label>Improper Authorization of Index Containing Sensitive Information</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-613 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-613">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-672"/>
        <cwe-id>CWE-613</cwe-id>
        <definition>According to WASC, &quot;Insufficient Session Expiration is when a web site permits an attacker to reuse old session credentials or session IDs for authorization.&quot;</definition>
        <rdfs:label>Insufficient Session Expiration</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-614 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-614">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-319"/>
        <cwe-id>CWE-614</cwe-id>
        <definition>The Secure attribute for sensitive cookies in HTTPS sessions is not set, which could cause the user agent to send those cookies in plaintext over an HTTP session.</definition>
        <rdfs:label>Sensitive Cookie in HTTPS Session Without &apos;Secure&apos; Attribute</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-615 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-615">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-540"/>
        <cwe-id>CWE-615</cwe-id>
        <definition>While adding general comments is very useful, some programmers tend to leave important data, such as: filenames related to the web application, old links or links which were not meant to be browsed by users, old code fragments, etc.</definition>
        <rdfs:label>Inclusion of Sensitive Information in Source Code Comments</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-616 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-616">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-345"/>
        <cwe-id>CWE-616</cwe-id>
        <definition>The PHP application uses an old method for processing uploaded files by referencing the four global variables that are set for each file (e.g. $varname, $varname_size, $varname_name, $varname_type). These variables could be overwritten by attackers, causing the application to process unauthorized files.</definition>
        <rdfs:label>Incomplete Identification of Uploaded File Variables (PHP)</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-617 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-617">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-670"/>
        <cwe-id>CWE-617</cwe-id>
        <definition>The product contains an assert() or similar statement that can be triggered by an attacker, which leads to an application exit or other behavior that is more severe than necessary.</definition>
        <synonym>assertion failure</synonym>
        <rdfs:label>Reachable Assertion</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-618 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-618">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-749"/>
        <cwe-id>CWE-618</cwe-id>
        <definition>An ActiveX control is intended for use in a web browser, but it exposes dangerous methods that perform actions that are outside of the browser&apos;s security model (e.g. the zone or domain).</definition>
        <rdfs:label>Exposed Unsafe ActiveX Method</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-619 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-619">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-402"/>
        <cwe-id>CWE-619</cwe-id>
        <definition>If a database cursor is not closed properly, then it could become accessible to other users while retaining the same privileges that were originally assigned, leaving the cursor &quot;dangling.&quot;</definition>
        <rdfs:label>Dangling Database Cursor (&apos;Cursor Injection&apos;)</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-62 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-62">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-59"/>
        <cwe-id>CWE-62</cwe-id>
        <definition>The product, when opening a file or directory, does not sufficiently account for when the name is associated with a hard link to a target that is outside of the intended control sphere. This could allow an attacker to cause the product to operate on unauthorized files.</definition>
        <rdfs:label>UNIX Hard Link</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-620 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-620">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1390"/>
        <cwe-id>CWE-620</cwe-id>
        <definition>When setting a new password for a user, the product does not require knowledge of the original password, or using another form of authentication.</definition>
        <rdfs:label>Unverified Password Change</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-621 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-621">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-914"/>
        <cwe-id>CWE-621</cwe-id>
        <definition>The product uses external input to determine the names of variables into which information is extracted, without verifying that the names of the specified variables are valid. This could cause the program to overwrite unintended variables.</definition>
        <synonym>Variable overwrite</synonym>
        <rdfs:label>Variable Extraction Error</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-622 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-622">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-20"/>
        <cwe-id>CWE-622</cwe-id>
        <definition>The product adds hooks to user-accessible API functions, but it does not properly validate the arguments. This could lead to resultant vulnerabilities.</definition>
        <rdfs:label>Improper Validation of Function Hook Arguments</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-623 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-623">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-267"/>
        <cwe-id>CWE-623</cwe-id>
        <definition>An ActiveX control is intended for restricted use, but it has been marked as safe-for-scripting.</definition>
        <rdfs:label>Unsafe ActiveX Control Marked Safe For Scripting</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-624 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-624">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-77"/>
        <cwe-id>CWE-624</cwe-id>
        <definition>The product uses a regular expression that either (1) contains an executable component with user-controlled inputs, or (2) allows a user to enable execution by inserting pattern modifiers.</definition>
        <rdfs:label>Executable Regular Expression Error</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-625 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-625">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-185"/>
        <cwe-id>CWE-625</cwe-id>
        <definition>The product uses a regular expression that does not sufficiently restrict the set of allowed values.</definition>
        <rdfs:label>Permissive Regular Expression</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-626 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-626">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-147"/>
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-436"/>
        <cwe-id>CWE-626</cwe-id>
        <definition>The product does not properly handle null bytes or NUL characters when passing data between different representations or components.</definition>
        <rdfs:label>Null Byte Interaction Error (Poison Null Byte)</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-627 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-627">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-914"/>
        <cwe-id>CWE-627</cwe-id>
        <definition>In a language where the user can influence the name of a variable at runtime, if the variable names are not controlled, an attacker can read or write to arbitrary variables, or access arbitrary functions.</definition>
        <synonym>Dynamic evaluation</synonym>
        <rdfs:label>Dynamic Variable Evaluation</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-628 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-628">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-573"/>
        <cwe-id>CWE-628</cwe-id>
        <definition>The product calls a function, procedure, or routine with arguments that are not correctly specified, leading to always-incorrect behavior and resultant weaknesses.</definition>
        <rdfs:label>Function Call with Incorrectly Specified Arguments</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-636 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-636">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-657"/>
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-755"/>
        <cwe-id>CWE-636</cwe-id>
        <definition>When the product encounters an error condition or failure, its design requires it to fall back to a state that is less secure than other options that are available, such as selecting the weakest encryption algorithm or using the most permissive access control restrictions.</definition>
        <synonym>Failing Open</synonym>
        <rdfs:label>Not Failing Securely (&apos;Failing Open&apos;)</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-637 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-637">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-657"/>
        <cwe-id>CWE-637</cwe-id>
        <definition>The product uses a more complex mechanism than necessary, which could lead to resultant weaknesses when the mechanism is not correctly understood, modeled, configured, implemented, or used.</definition>
        <synonym>Unnecessary Complexity</synonym>
        <rdfs:label>Unnecessary Complexity in Protection Mechanism (Not Using &apos;Economy of Mechanism&apos;)</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-638 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-638">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-657"/>
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-862"/>
        <cwe-id>CWE-638</cwe-id>
        <definition>The product does not perform access checks on a resource every time the resource is accessed by an entity, which can create resultant weaknesses if that entity&apos;s rights or privileges change over time.</definition>
        <rdfs:label>Not Using Complete Mediation</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-639 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-639">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-863"/>
        <cwe-id>CWE-639</cwe-id>
        <definition>The system&apos;s authorization functionality does not prevent one user from gaining access to another user&apos;s data or record by modifying the key value identifying the data.</definition>
        <synonym>Broken Object Level Authorization / BOLA</synonym>
        <synonym>Horizontal Authorization</synonym>
        <synonym>Insecure Direct Object Reference / IDOR</synonym>
        <rdfs:label>Authorization Bypass Through User-Controlled Key</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-64 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-64">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-59"/>
        <cwe-id>CWE-64</cwe-id>
        <definition>The product, when opening a file or directory, does not sufficiently handle when the file is a Windows shortcut (.LNK) whose target is outside of the intended control sphere. This could allow an attacker to cause the product to operate on unauthorized files.</definition>
        <synonym>Windows symbolic link following</synonym>
        <synonym>symlink</synonym>
        <rdfs:label>Windows Shortcut Following (.LNK)</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-640 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-640">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1390"/>
        <cwe-id>CWE-640</cwe-id>
        <definition>The product contains a mechanism for users to recover or change their passwords without knowing the original password, but the mechanism is weak.</definition>
        <rdfs:label>Weak Password Recovery Mechanism for Forgotten Password</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-641 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-641">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-99"/>
        <cwe-id>CWE-641</cwe-id>
        <definition>The product constructs the name of a file or other resource using input from an upstream component, but it does not restrict or incorrectly restricts the resulting name.</definition>
        <rdfs:label>Improper Restriction of Names for Files and Other Resources</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-642 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-642">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-668"/>
        <cwe-id>CWE-642</cwe-id>
        <definition>The product stores security-critical state information about its users, or the product itself, in a location that is accessible to unauthorized actors.</definition>
        <rdfs:label>External Control of Critical State Data</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-643 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-643">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-91"/>
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-943"/>
        <cwe-id>CWE-643</cwe-id>
        <definition>The product uses external input to dynamically construct an XPath expression used to retrieve data from an XML database, but it does not neutralize or incorrectly neutralizes that input. This allows an attacker to control the structure of the query.</definition>
        <rdfs:label>Improper Neutralization of Data within XPath Expressions (&apos;XPath Injection&apos;)</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-644 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-644">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-116"/>
        <cwe-id>CWE-644</cwe-id>
        <definition>The product does not neutralize or incorrectly neutralizes web scripting syntax in HTTP headers that can be used by web browser components that can process raw headers, such as Flash.</definition>
        <rdfs:label>Improper Neutralization of HTTP Headers for Scripting Syntax</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-645 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-645">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-287"/>
        <cwe-id>CWE-645</cwe-id>
        <definition>The product contains an account lockout protection mechanism, but the mechanism is too restrictive and can be triggered too easily, which allows attackers to deny service to legitimate users by causing their accounts to be locked out.</definition>
        <rdfs:label>Overly Restrictive Account Lockout Mechanism</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-646 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-646">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-345"/>
        <cwe-id>CWE-646</cwe-id>
        <definition>The product allows a file to be uploaded, but it relies on the file name or extension of the file to determine the appropriate behaviors. This could be used by attackers to cause the file to be misclassified and processed in a dangerous fashion.</definition>
        <rdfs:label>Reliance on File Name or Extension of Externally-Supplied File</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-647 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-647">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-863"/>
        <cwe-id>CWE-647</cwe-id>
        <definition>The product defines policy namespaces and makes authorization decisions based on the assumption that a URL is canonical. This can allow a non-canonical URL to bypass the authorization.</definition>
        <rdfs:label>Use of Non-Canonical URL Paths for Authorization Decisions</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-648 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-648">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-269"/>
        <cwe-id>CWE-648</cwe-id>
        <definition>The product does not conform to the API requirements for a function call that requires extra privileges. This could allow attackers to gain privileges by causing the function to be called incorrectly.</definition>
        <rdfs:label>Incorrect Use of Privileged APIs</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-649 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-649">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-345"/>
        <cwe-id>CWE-649</cwe-id>
        <definition>The product uses obfuscation or encryption of inputs that should not be mutable by an external actor, but the product does not use integrity checks to detect if those inputs have been modified.</definition>
        <rdfs:label>Reliance on Obfuscation or Encryption of Security-Relevant Inputs without Integrity Checking</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-65 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-65">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-59"/>
        <cwe-id>CWE-65</cwe-id>
        <definition>The product, when opening a file or directory, does not sufficiently handle when the name is associated with a hard link to a target that is outside of the intended control sphere. This could allow an attacker to cause the product to operate on unauthorized files.</definition>
        <rdfs:label>Windows Hard Link</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-650 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-650">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-436"/>
        <cwe-id>CWE-650</cwe-id>
        <definition>The server contains a protection mechanism that assumes that any URI that is accessed using HTTP GET will not cause a state change to the associated resource. This might allow attackers to bypass intended access restrictions and conduct resource modification and deletion attacks, since some applications allow GET to modify state.</definition>
        <rdfs:label>Trusting HTTP Permission Methods on the Server Side</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-651 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-651">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-538"/>
        <cwe-id>CWE-651</cwe-id>
        <definition>The Web services architecture may require exposing a Web Service Definition Language (WSDL) file that contains information on the publicly accessible services and how callers of these services should interact with them (e.g. what parameters they expect and what types they return).</definition>
        <rdfs:label>Exposure of WSDL File Containing Sensitive Information</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-652 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-652">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-91"/>
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-943"/>
        <cwe-id>CWE-652</cwe-id>
        <definition>The product uses external input to dynamically construct an XQuery expression used to retrieve data from an XML database, but it does not neutralize or incorrectly neutralizes that input. This allows an attacker to control the structure of the query.</definition>
        <rdfs:label>Improper Neutralization of Data within XQuery Expressions (&apos;XQuery Injection&apos;)</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-653 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-653">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-657"/>
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-693"/>
        <cwe-id>CWE-653</cwe-id>
        <definition>The product does not properly compartmentalize or isolate functionality, processes, or resources that require different privilege levels, rights, or permissions.</definition>
        <synonym>Separation of Privilege</synonym>
        <rdfs:label>Improper Isolation or Compartmentalization</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-654 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-654">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-657"/>
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-693"/>
        <cwe-id>CWE-654</cwe-id>
        <definition>A protection mechanism relies exclusively, or to a large extent, on the evaluation of a single condition or the integrity of a single object or entity in order to make a decision about granting access to restricted resources or functionality.</definition>
        <synonym>Separation of Privilege</synonym>
        <rdfs:label>Reliance on a Single Factor in a Security Decision</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-655 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-655">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-657"/>
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-693"/>
        <cwe-id>CWE-655</cwe-id>
        <definition>The product has a protection mechanism that is too difficult or inconvenient to use, encouraging non-malicious users to disable or bypass the mechanism, whether by accident or on purpose.</definition>
        <rdfs:label>Insufficient Psychological Acceptability</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-656 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-656">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-657"/>
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-693"/>
        <cwe-id>CWE-656</cwe-id>
        <definition>The product uses a protection mechanism whose strength depends heavily on its obscurity, such that knowledge of its algorithms or key data is sufficient to defeat the mechanism.</definition>
        <synonym>Never Assuming your secrets are safe</synonym>
        <rdfs:label>Reliance on Security Through Obscurity</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-657 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-657">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-710"/>
        <cwe-id>CWE-657</cwe-id>
        <definition>The product violates well-established principles for secure design.</definition>
        <rdfs:label>Violation of Secure Design Principles</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-66 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-66">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-706"/>
        <cwe-id>CWE-66</cwe-id>
        <definition>The product does not handle or incorrectly handles a file name that identifies a &quot;virtual&quot; resource that is not directly specified within the directory that is associated with the file name, causing the product to perform file-based operations on a resource that is not a file.</definition>
        <rdfs:label>Improper Handling of File Names that Identify Virtual Resources</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-662 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-662">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-664"/>
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-691"/>
        <cwe-id>CWE-662</cwe-id>
        <definition>The product utilizes multiple threads or processes to allow temporary access to a shared resource that can only be exclusive to one process at a time, but it does not properly synchronize these actions, which might cause simultaneous accesses of this resource by multiple threads or processes.</definition>
        <rdfs:label>Improper Synchronization</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-663 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-663">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-662"/>
        <cwe-id>CWE-663</cwe-id>
        <definition>The product calls a non-reentrant function in a concurrent context in which a competing code sequence (e.g. thread or signal handler) may have an opportunity to call the same function or otherwise influence its state.</definition>
        <rdfs:label>Use of a Non-reentrant Function in a Concurrent Context</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-664 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-664">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#Weakness"/>
        <cwe-id>CWE-664</cwe-id>
        <definition>The product does not maintain or incorrectly maintains control over a resource throughout its lifetime of creation, use, and release.</definition>
        <rdfs:label>Improper Control of a Resource Through its Lifetime</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-665 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-665">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-664"/>
        <cwe-id>CWE-665</cwe-id>
        <definition>The product does not initialize or incorrectly initializes a resource, which might leave the resource in an unexpected state when it is accessed or used.</definition>
        <rdfs:label>Improper Initialization</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-666 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-666">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-664"/>
        <cwe-id>CWE-666</cwe-id>
        <definition>The product performs an operation on a resource at the wrong phase of the resource&apos;s lifecycle, which can lead to unexpected behaviors.</definition>
        <rdfs:label>Operation on Resource in Wrong Phase of Lifetime</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-667 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-667">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-662"/>
        <cwe-id>CWE-667</cwe-id>
        <definition>The product does not properly acquire or release a lock on a resource, leading to unexpected resource state changes and behaviors.</definition>
        <rdfs:label>Improper Locking</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-668 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-668">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-664"/>
        <cwe-id>CWE-668</cwe-id>
        <definition>The product exposes a resource to the wrong control sphere, providing unintended actors with inappropriate access to the resource.</definition>
        <rdfs:label>Exposure of Resource to Wrong Sphere</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-669 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-669">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-664"/>
        <cwe-id>CWE-669</cwe-id>
        <definition>The product does not properly transfer a resource/behavior to another sphere, or improperly imports a resource/behavior from another sphere, in a manner that provides unintended control over that resource.</definition>
        <rdfs:label>Incorrect Resource Transfer Between Spheres</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-67 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-67">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-66"/>
        <cwe-id>CWE-67</cwe-id>
        <definition>The product constructs pathnames from user input, but it does not handle or incorrectly handles a pathname containing a Windows device name such as AUX or CON. This typically leads to denial of service or an information exposure when the application attempts to process the pathname as a regular file.</definition>
        <rdfs:label>Improper Handling of Windows Device Names</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-670 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-670">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-691"/>
        <cwe-id>CWE-670</cwe-id>
        <definition>The code contains a control flow path that does not reflect the algorithm that the path is intended to implement, leading to incorrect behavior any time this path is navigated.</definition>
        <rdfs:label>Always-Incorrect Control Flow Implementation</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-671 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-671">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-657"/>
        <cwe-id>CWE-671</cwe-id>
        <definition>The product uses security features in a way that prevents the product&apos;s administrator from tailoring security settings to reflect the environment in which the product is being used. This introduces resultant weaknesses or prevents it from operating at a level of security that is desired by the administrator.</definition>
        <rdfs:label>Lack of Administrator Control over Security</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-672 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-672">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-666"/>
        <cwe-id>CWE-672</cwe-id>
        <definition>The product uses, accesses, or otherwise operates on a resource after that resource has been expired, released, or revoked.</definition>
        <rdfs:label>Operation on a Resource after Expiration or Release</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-673 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-673">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-664"/>
        <cwe-id>CWE-673</cwe-id>
        <definition>The product does not prevent the definition of control spheres from external actors.</definition>
        <rdfs:label>External Influence of Sphere Definition</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-674 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-674">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-834"/>
        <cwe-id>CWE-674</cwe-id>
        <definition>The product does not properly control the amount of recursion that takes place, consuming excessive resources, such as allocated memory or the program stack.</definition>
        <synonym>Stack Exhaustion</synonym>
        <rdfs:label>Uncontrolled Recursion</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-675 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-675">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-573"/>
        <cwe-id>CWE-675</cwe-id>
        <definition>The product performs the same operation on a resource two or more times, when the operation should only be applied once.</definition>
        <rdfs:label>Multiple Operations on Resource in Single-Operation Context</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-676 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-676">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1177"/>
        <cwe-id>CWE-676</cwe-id>
        <definition>The product invokes a potentially dangerous function that could introduce a vulnerability if it is used incorrectly, but the function can also be used safely.</definition>
        <rdfs:label>Use of Potentially Dangerous Function</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-680 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-680">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-119"/>
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-190"/>
        <cwe-id>CWE-680</cwe-id>
        <definition>The product performs a calculation to determine how much memory to allocate, but an integer overflow can occur that causes less memory to be allocated than expected, leading to a buffer overflow.</definition>
        <rdfs:label>Integer Overflow to Buffer Overflow</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-681 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-681">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-704"/>
        <cwe-id>CWE-681</cwe-id>
        <definition>When converting from one data type to another, such as long to integer, data can be omitted or translated in a way that produces unexpected values. If the resulting values are used in a sensitive context, then dangerous behaviors may occur.</definition>
        <rdfs:label>Incorrect Conversion between Numeric Types</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-682 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-682">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#Weakness"/>
        <cwe-id>CWE-682</cwe-id>
        <definition>The product performs a calculation that generates incorrect or unintended results that are later used in security-critical decisions or resource management.</definition>
        <rdfs:label>Incorrect Calculation</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-683 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-683">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-628"/>
        <cwe-id>CWE-683</cwe-id>
        <definition>The product calls a function, procedure, or routine, but the caller specifies the arguments in an incorrect order, leading to resultant weaknesses.</definition>
        <rdfs:label>Function Call With Incorrect Order of Arguments</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-684 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-684">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-710"/>
        <cwe-id>CWE-684</cwe-id>
        <definition>The code does not function according to its published specifications, potentially leading to incorrect usage.</definition>
        <rdfs:label>Incorrect Provision of Specified Functionality</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-685 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-685">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-628"/>
        <cwe-id>CWE-685</cwe-id>
        <definition>The product calls a function, procedure, or routine, but the caller specifies too many arguments, or too few arguments, which may lead to undefined behavior and resultant weaknesses.</definition>
        <rdfs:label>Function Call With Incorrect Number of Arguments</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-686 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-686">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-628"/>
        <cwe-id>CWE-686</cwe-id>
        <definition>The product calls a function, procedure, or routine, but the caller specifies an argument that is the wrong data type, which may lead to resultant weaknesses.</definition>
        <rdfs:label>Function Call With Incorrect Argument Type</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-687 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-687">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-628"/>
        <cwe-id>CWE-687</cwe-id>
        <definition>The product calls a function, procedure, or routine, but the caller specifies an argument that contains the wrong value, which may lead to resultant weaknesses.</definition>
        <rdfs:label>Function Call With Incorrectly Specified Argument Value</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-688 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-688">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-628"/>
        <cwe-id>CWE-688</cwe-id>
        <definition>The product calls a function, procedure, or routine, but the caller specifies the wrong variable or reference as one of the arguments, which may lead to undefined behavior and resultant weaknesses.</definition>
        <rdfs:label>Function Call With Incorrect Variable or Reference as Argument</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-689 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-689">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-362"/>
        <cwe-id>CWE-689</cwe-id>
        <definition>The product, while copying or cloning a resource, does not set the resource&apos;s permissions or access control until the copy is complete, leaving the resource exposed to other spheres while the copy is taking place.</definition>
        <rdfs:label>Permission Race Condition During Resource Copy</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-69 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-69">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-66"/>
        <cwe-id>CWE-69</cwe-id>
        <definition>The product does not properly prevent access to, or detect usage of, alternate data streams (ADS).</definition>
        <rdfs:label>Improper Handling of Windows ::DATA Alternate Data Stream</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-690 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-690">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-252"/>
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-476"/>
        <cwe-id>CWE-690</cwe-id>
        <definition>The product does not check for an error after calling a function that can return with a NULL pointer if the function fails, which leads to a resultant NULL pointer dereference.</definition>
        <rdfs:label>Unchecked Return Value to NULL Pointer Dereference</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-691 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-691">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#Weakness"/>
        <cwe-id>CWE-691</cwe-id>
        <definition>The code does not sufficiently manage its control flow during execution, creating conditions in which the control flow can be modified in unexpected ways.</definition>
        <rdfs:label>Insufficient Control Flow Management</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-692 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-692">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-184"/>
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-79"/>
        <cwe-id>CWE-692</cwe-id>
        <definition>The product uses a denylist-based protection mechanism to defend against XSS attacks, but the denylist is incomplete, allowing XSS variants to succeed.</definition>
        <rdfs:label>Incomplete Denylist to Cross-Site Scripting</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-693 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-693">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#Weakness"/>
        <cwe-id>CWE-693</cwe-id>
        <definition>The product does not use or incorrectly uses a protection mechanism that provides sufficient defense against directed attacks against the product.</definition>
        <rdfs:label>Protection Mechanism Failure</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-694 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-694">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-573"/>
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-99"/>
        <cwe-id>CWE-694</cwe-id>
        <definition>The product uses multiple resources that can have the same identifier, in a context in which unique identifiers are required.</definition>
        <rdfs:label>Use of Multiple Resources with Duplicate Identifier</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-695 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-695">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-573"/>
        <cwe-id>CWE-695</cwe-id>
        <definition>The product uses low-level functionality that is explicitly prohibited by the framework or specification under which the product is supposed to operate.</definition>
        <rdfs:label>Use of Low-Level Functionality</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-696 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-696">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-691"/>
        <cwe-id>CWE-696</cwe-id>
        <definition>The product performs multiple related behaviors, but the behaviors are performed in the wrong order in ways which may produce resultant weaknesses.</definition>
        <rdfs:label>Incorrect Behavior Order</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-697 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-697">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#Weakness"/>
        <cwe-id>CWE-697</cwe-id>
        <definition>The product compares two entities in a security-relevant context, but the comparison is incorrect, which may lead to resultant weaknesses.</definition>
        <rdfs:label>Incorrect Comparison</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-698 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-698">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-670"/>
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-705"/>
        <cwe-id>CWE-698</cwe-id>
        <definition>The web application sends a redirect to another location, but instead of exiting, it executes additional code.</definition>
        <synonym>Redirect Without Exit</synonym>
        <rdfs:label>Execution After Redirect (EAR)</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-7 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-7">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-756"/>
        <cwe-id>CWE-7</cwe-id>
        <definition>The default error page of a web application should not display sensitive information about the product.</definition>
        <rdfs:label>J2EE Misconfiguration: Missing Custom Error Page</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-703 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-703">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#Weakness"/>
        <cwe-id>CWE-703</cwe-id>
        <definition>The product does not properly anticipate or handle exceptional conditions that rarely occur during normal operation of the product.</definition>
        <rdfs:label>Improper Check or Handling of Exceptional Conditions</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-704 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-704">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-664"/>
        <cwe-id>CWE-704</cwe-id>
        <definition>The product does not correctly convert an object, resource, or structure from one type to a different type.</definition>
        <rdfs:label>Incorrect Type Conversion or Cast</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-705 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-705">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-691"/>
        <cwe-id>CWE-705</cwe-id>
        <definition>The product does not properly return control flow to the proper location after it has completed a task or detected an unusual condition.</definition>
        <rdfs:label>Incorrect Control Flow Scoping</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-706 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-706">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-664"/>
        <cwe-id>CWE-706</cwe-id>
        <definition>The product uses a name or reference to access a resource, but the name/reference resolves to a resource that is outside of the intended control sphere.</definition>
        <rdfs:label>Use of Incorrectly-Resolved Name or Reference</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-707 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-707">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#Weakness"/>
        <cwe-id>CWE-707</cwe-id>
        <definition>The product does not ensure or incorrectly ensures that structured messages or data are well-formed and that certain security properties are met before being read from an upstream component or sent to a downstream component.</definition>
        <rdfs:label>Improper Neutralization</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-708 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-708">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-282"/>
        <cwe-id>CWE-708</cwe-id>
        <definition>The product assigns an owner to a resource, but the owner is outside of the intended control sphere.</definition>
        <rdfs:label>Incorrect Ownership Assignment</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-710 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-710">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#Weakness"/>
        <cwe-id>CWE-710</cwe-id>
        <definition>The product does not follow certain coding rules for development, which can lead to resultant weaknesses or increase the severity of the associated vulnerabilities.</definition>
        <rdfs:label>Improper Adherence to Coding Standards</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-72 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-72">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-66"/>
        <cwe-id>CWE-72</cwe-id>
        <definition>The product does not properly handle special paths that may identify the data or resource fork of a file on the HFS+ file system.</definition>
        <rdfs:label>Improper Handling of Apple HFS+ Alternate Data Stream Path</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-73 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-73">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-610"/>
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-642"/>
        <cwe-id>CWE-73</cwe-id>
        <definition>The product allows user input to control or influence paths or file names that are used in filesystem operations.</definition>
        <rdfs:label>External Control of File Name or Path</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-732 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-732">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-285"/>
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-668"/>
        <cwe-id>CWE-732</cwe-id>
        <definition>The product specifies permissions for a security-critical resource in a way that allows that resource to be read or modified by unintended actors.</definition>
        <rdfs:label>Incorrect Permission Assignment for Critical Resource</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-733 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-733">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1038"/>
        <cwe-id>CWE-733</cwe-id>
        <definition>The developer builds a security-critical protection mechanism into the software, but the compiler optimizes the program such that the mechanism is removed or modified.</definition>
        <rdfs:label>Compiler Optimization Removal or Modification of Security-critical Code</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-74 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-74">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-707"/>
        <cwe-id>CWE-74</cwe-id>
        <definition>The product constructs all or part of a command, data structure, or record using externally-influenced input from an upstream component, but it does not neutralize or incorrectly neutralizes special elements that could modify how it is parsed or interpreted when it is sent to a downstream component.</definition>
        <rdfs:label>Improper Neutralization of Special Elements in Output Used by a Downstream Component (&apos;Injection&apos;)</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-749 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-749">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-284"/>
        <cwe-id>CWE-749</cwe-id>
        <definition>The product provides an Applications Programming Interface (API) or similar interface for interaction with external actors, but the interface includes a dangerous method or function that is not properly restricted.</definition>
        <rdfs:label>Exposed Dangerous Method or Function</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-75 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-75">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-74"/>
        <cwe-id>CWE-75</cwe-id>
        <definition>The product does not adequately filter user-controlled input for special elements with control implications.</definition>
        <rdfs:label>Failure to Sanitize Special Elements into a Different Plane (Special Element Injection)</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-754 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-754">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-703"/>
        <cwe-id>CWE-754</cwe-id>
        <definition>The product does not check or incorrectly checks for unusual or exceptional conditions that are not expected to occur frequently during day to day operation of the product.</definition>
        <rdfs:label>Improper Check for Unusual or Exceptional Conditions</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-755 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-755">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-703"/>
        <cwe-id>CWE-755</cwe-id>
        <definition>The product does not handle or incorrectly handles an exceptional condition.</definition>
        <rdfs:label>Improper Handling of Exceptional Conditions</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-756 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-756">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-755"/>
        <cwe-id>CWE-756</cwe-id>
        <definition>The product does not return custom error pages to the user, possibly exposing sensitive information.</definition>
        <rdfs:label>Missing Custom Error Page</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-757 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-757">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-693"/>
        <cwe-id>CWE-757</cwe-id>
        <definition>A protocol or its implementation supports interaction between multiple actors and allows those actors to negotiate which algorithm should be used as a protection mechanism such as encryption or authentication, but it does not select the strongest algorithm that is available to both parties.</definition>
        <rdfs:label>Selection of Less-Secure Algorithm During Negotiation (&apos;Algorithm Downgrade&apos;)</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-758 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-758">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-710"/>
        <cwe-id>CWE-758</cwe-id>
        <definition>The product uses an API function, data structure, or other entity in a way that relies on properties that are not always guaranteed to hold for that entity.</definition>
        <rdfs:label>Reliance on Undefined, Unspecified, or Implementation-Defined Behavior</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-759 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-759">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-916"/>
        <cwe-id>CWE-759</cwe-id>
        <definition>The product uses a one-way cryptographic hash against an input that should not be reversible, such as a password, but the product does not also use a salt as part of the input.</definition>
        <rdfs:label>Use of a One-Way Hash without a Salt</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-76 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-76">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-75"/>
        <cwe-id>CWE-76</cwe-id>
        <definition>The product correctly neutralizes certain special elements, but it improperly neutralizes equivalent special elements.</definition>
        <rdfs:label>Improper Neutralization of Equivalent Special Elements</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-760 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-760">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-916"/>
        <cwe-id>CWE-760</cwe-id>
        <definition>The product uses a one-way cryptographic hash against an input that should not be reversible, such as a password, but the product uses a predictable salt as part of the input.</definition>
        <rdfs:label>Use of a One-Way Hash with a Predictable Salt</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-761 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-761">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-763"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#weakness-of"/>
                <owl:someValuesFrom rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#MemoryFreeFunction"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-762 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-762">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-763"/>
        <cwe-id>CWE-762</cwe-id>
        <definition>The product attempts to return a memory resource to the system, but it calls a release function that is not compatible with the function that was originally used to allocate that resource.</definition>
        <rdfs:label>Mismatched Memory Management Routines</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-763 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-763">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-404"/>
        <cwe-id>CWE-763</cwe-id>
        <definition>The product attempts to return a memory resource to the system, but it calls the wrong release function or calls the appropriate release function incorrectly.</definition>
        <rdfs:label>Release of Invalid Pointer or Reference</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-764 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-764">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-667"/>
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-675"/>
        <cwe-id>CWE-764</cwe-id>
        <definition>The product locks a critical resource more times than intended, leading to an unexpected state in the system.</definition>
        <rdfs:label>Multiple Locks of a Critical Resource</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-765 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-765">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-667"/>
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-675"/>
        <cwe-id>CWE-765</cwe-id>
        <definition>The product unlocks a critical resource more times than intended, leading to an unexpected state in the system.</definition>
        <rdfs:label>Multiple Unlocks of a Critical Resource</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-766 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-766">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1061"/>
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-732"/>
        <cwe-id>CWE-766</cwe-id>
        <definition>The product declares a critical variable, field, or member to be public when intended security policy requires it to be private.</definition>
        <rdfs:label>Critical Data Element Declared Public</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-767 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-767">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-668"/>
        <cwe-id>CWE-767</cwe-id>
        <definition>The product defines a public method that reads or modifies a private variable.</definition>
        <rdfs:label>Access to Critical Private Variable via Public Method</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-768 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-768">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-691"/>
        <cwe-id>CWE-768</cwe-id>
        <definition>The product contains a conditional statement with multiple logical expressions in which one of the non-leading expressions may produce side effects. This may lead to an unexpected state in the program after the execution of the conditional, because short-circuiting logic may prevent the side effects from occurring.</definition>
        <rdfs:label>Incorrect Short Circuit Evaluation</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-77 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-77">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-74"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#weakness-of"/>
                <owl:someValuesFrom rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#UserInputFunction"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-770 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-770">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-400"/>
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-665"/>
        <cwe-id>CWE-770</cwe-id>
        <definition>The product allocates a reusable resource or group of resources on behalf of an actor without imposing any restrictions on the size or number of resources that can be allocated, in violation of the intended security policy for that actor.</definition>
        <rdfs:label>Allocation of Resources Without Limits or Throttling</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-771 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-771">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-400"/>
        <cwe-id>CWE-771</cwe-id>
        <definition>The product does not properly maintain a reference to a resource that has been allocated, which prevents the resource from being reclaimed.</definition>
        <rdfs:label>Missing Reference to Active Allocated Resource</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-772 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-772">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-404"/>
        <cwe-id>CWE-772</cwe-id>
        <definition>The product does not release a resource after its effective lifetime has ended, i.e., after the resource is no longer needed.</definition>
        <rdfs:label>Missing Release of Resource after Effective Lifetime</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-773 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-773">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-771"/>
        <cwe-id>CWE-773</cwe-id>
        <definition>The product does not properly maintain references to a file descriptor or handle, which prevents that file descriptor/handle from being reclaimed.</definition>
        <rdfs:label>Missing Reference to Active File Descriptor or Handle</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-774 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-774">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-770"/>
        <cwe-id>CWE-774</cwe-id>
        <definition>The product allocates file descriptors or handles on behalf of an actor without imposing any restrictions on how many descriptors can be allocated, in violation of the intended security policy for that actor.</definition>
        <synonym>File Descriptor Exhaustion</synonym>
        <rdfs:label>Allocation of File Descriptors or Handles Without Limits or Throttling</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-775 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-775">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-772"/>
        <cwe-id>CWE-775</cwe-id>
        <definition>The product does not release a file descriptor or handle after its effective lifetime has ended, i.e., after the file descriptor/handle is no longer needed.</definition>
        <rdfs:label>Missing Release of File Descriptor or Handle after Effective Lifetime</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-776 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-776">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-405"/>
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-674"/>
        <cwe-id>CWE-776</cwe-id>
        <definition>The product uses XML documents and allows their structure to be defined with a Document Type Definition (DTD), but it does not properly control the number of recursive definitions of entities.</definition>
        <synonym>Billion Laughs Attack</synonym>
        <synonym>XEE</synonym>
        <synonym>XML Bomb</synonym>
        <rdfs:label>Improper Restriction of Recursive Entity References in DTDs (&apos;XML Entity Expansion&apos;)</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-777 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-777">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-625"/>
        <cwe-id>CWE-777</cwe-id>
        <definition>The product uses a regular expression to perform neutralization, but the regular expression is not anchored and may allow malicious or malformed data to slip through.</definition>
        <rdfs:label>Regular Expression without Anchors</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-778 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-778">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-223"/>
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-693"/>
        <cwe-id>CWE-778</cwe-id>
        <definition>When a security-critical event occurs, the product either does not record the event or omits important details about the event when logging it.</definition>
        <rdfs:label>Insufficient Logging</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-779 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-779">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-400"/>
        <cwe-id>CWE-779</cwe-id>
        <definition>The product logs too much information, making log files hard to process and possibly hindering recovery efforts or forensic analysis after an attack.</definition>
        <rdfs:label>Logging of Excessive Data</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-78 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-78">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-77"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#may-be-weakness-of"/>
                <owl:someValuesFrom rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#EvalFunction"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#may-be-weakness-of"/>
                <owl:someValuesFrom rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#ProcessStartFunction"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#may-be-weakness-of"/>
                <owl:someValuesFrom rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#UserInputFunction"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-780 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-780">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-327"/>
        <cwe-id>CWE-780</cwe-id>
        <definition>The product uses the RSA algorithm but does not incorporate Optimal Asymmetric Encryption Padding (OAEP), which might weaken the encryption.</definition>
        <rdfs:label>Use of RSA Algorithm without OAEP</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-781 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-781">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1285"/>
        <cwe-id>CWE-781</cwe-id>
        <definition>The product defines an IOCTL that uses METHOD_NEITHER for I/O, but it does not validate or incorrectly validates the addresses that are provided.</definition>
        <rdfs:label>Improper Address Validation in IOCTL with METHOD_NEITHER I/O Control Code</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-782 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-782">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-749"/>
        <cwe-id>CWE-782</cwe-id>
        <definition>The product implements an IOCTL with functionality that should be restricted, but it does not properly enforce access control for the IOCTL.</definition>
        <rdfs:label>Exposed IOCTL with Insufficient Access Control</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-783 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-783">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-670"/>
        <cwe-id>CWE-783</cwe-id>
        <definition>The product uses an expression in which operator precedence causes incorrect logic to be used.</definition>
        <rdfs:label>Operator Precedence Logic Error</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-784 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-784">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-565"/>
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-807"/>
        <cwe-id>CWE-784</cwe-id>
        <definition>The product uses a protection mechanism that relies on the existence or values of a cookie, but it does not properly ensure that the cookie is valid for the associated user.</definition>
        <rdfs:label>Reliance on Cookies without Validation and Integrity Checking in a Security Decision</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-785 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-785">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-120"/>
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-676"/>
        <cwe-id>CWE-785</cwe-id>
        <definition>The product invokes a function for normalizing paths or file names, but it provides an output buffer that is smaller than the maximum possible size, such as PATH_MAX.</definition>
        <rdfs:label>Use of Path Manipulation Function without Maximum-sized Buffer</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-786 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-786">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-119"/>
        <cwe-id>CWE-786</cwe-id>
        <definition>The product reads or writes to a buffer using an index or pointer that references a memory location prior to the beginning of the buffer.</definition>
        <rdfs:label>Access of Memory Location Before Start of Buffer</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-787 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-787">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-119"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#weakness-of"/>
                <owl:someValuesFrom rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#RawMemoryAccessFunction"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-788 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-788">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-119"/>
        <cwe-id>CWE-788</cwe-id>
        <definition>The product reads or writes to a buffer using an index or pointer that references a memory location after the end of the buffer.</definition>
        <rdfs:label>Access of Memory Location After End of Buffer</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-789 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-789">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1284"/>
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-770"/>
        <cwe-id>CWE-789</cwe-id>
        <definition>The product allocates memory based on an untrusted, large size value, but it does not ensure that the size is within expected limits, allowing arbitrary amounts of memory to be allocated.</definition>
        <synonym>Stack Exhaustion</synonym>
        <rdfs:label>Memory Allocation with Excessive Size Value</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-79 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-79">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-74"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#weakness-of"/>
                <owl:someValuesFrom rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#UserInputFunction"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-790 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-790">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-138"/>
        <cwe-id>CWE-790</cwe-id>
        <definition>The product receives data from an upstream component, but does not filter or incorrectly filters special elements before sending it to a downstream component.</definition>
        <rdfs:label>Improper Filtering of Special Elements</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-791 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-791">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-790"/>
        <cwe-id>CWE-791</cwe-id>
        <definition>The product receives data from an upstream component, but does not completely filter special elements before sending it to a downstream component.</definition>
        <rdfs:label>Incomplete Filtering of Special Elements</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-792 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-792">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-791"/>
        <cwe-id>CWE-792</cwe-id>
        <definition>The product receives data from an upstream component, but does not completely filter one or more instances of special elements before sending it to a downstream component.</definition>
        <rdfs:label>Incomplete Filtering of One or More Instances of Special Elements</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-793 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-793">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-792"/>
        <cwe-id>CWE-793</cwe-id>
        <definition>The product receives data from an upstream component, but only filters a single instance of a special element before sending it to a downstream component.</definition>
        <rdfs:label>Only Filtering One Instance of a Special Element</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-794 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-794">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-792"/>
        <cwe-id>CWE-794</cwe-id>
        <definition>The product receives data from an upstream component, but does not filter all instances of a special element before sending it to a downstream component.</definition>
        <rdfs:label>Incomplete Filtering of Multiple Instances of Special Elements</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-795 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-795">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-791"/>
        <cwe-id>CWE-795</cwe-id>
        <definition>The product receives data from an upstream component, but only accounts for special elements at a specified location, thereby missing remaining special elements that may exist before sending it to a downstream component.</definition>
        <rdfs:label>Only Filtering Special Elements at a Specified Location</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-796 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-796">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-795"/>
        <cwe-id>CWE-796</cwe-id>
        <definition>The product receives data from an upstream component, but only accounts for special elements positioned relative to a marker (e.g. &quot;at the beginning/end of a string; the second argument&quot;), thereby missing remaining special elements that may exist before sending it to a downstream component.</definition>
        <rdfs:label>Only Filtering Special Elements Relative to a Marker</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-797 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-797">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-795"/>
        <cwe-id>CWE-797</cwe-id>
        <definition>The product receives data from an upstream component, but only accounts for special elements at an absolute position (e.g. &quot;byte number 10&quot;), thereby missing remaining special elements that may exist before sending it to a downstream component.</definition>
        <rdfs:label>Only Filtering Special Elements at an Absolute Position</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-798 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-798">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1391"/>
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-344"/>
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-671"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#weakness-of"/>
                <owl:someValuesFrom rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#AuthenticationFunction"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-799 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-799">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-691"/>
        <cwe-id>CWE-799</cwe-id>
        <definition>The product does not properly limit the number or frequency of interactions that it has with an actor, such as the number of incoming requests.</definition>
        <synonym>Brute force</synonym>
        <synonym>Insufficient anti-automation</synonym>
        <rdfs:label>Improper Control of Interaction Frequency</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-8 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-8">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-668"/>
        <cwe-id>CWE-8</cwe-id>
        <definition>When an application exposes a remote interface for an entity bean, it might also expose methods that get or set the bean&apos;s data. These methods could be leveraged to read sensitive information, or to change data in ways that violate the application&apos;s expectations, potentially leading to other vulnerabilities.</definition>
        <rdfs:label>J2EE Misconfiguration: Entity Bean Declared Remote</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-80 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-80">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-79"/>
        <cwe-id>CWE-80</cwe-id>
        <definition>The product receives input from an upstream component, but it does not neutralize or incorrectly neutralizes special characters such as &quot;&lt;&quot;, &quot;&gt;&quot;, and &quot;&amp;&quot; that could be interpreted as web-scripting elements when they are sent to a downstream component that processes web pages.</definition>
        <rdfs:label>Improper Neutralization of Script-Related HTML Tags in a Web Page (Basic XSS)</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-804 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-804">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1390"/>
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-863"/>
        <cwe-id>CWE-804</cwe-id>
        <definition>The product uses a CAPTCHA challenge, but the challenge can be guessed or automatically recognized by a non-human actor.</definition>
        <rdfs:label>Guessable CAPTCHA</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-805 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-805">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-119"/>
        <cwe-id>CWE-805</cwe-id>
        <definition>The product uses a sequential operation to read or write a buffer, but it uses an incorrect length value that causes it to access memory that is outside of the bounds of the buffer.</definition>
        <rdfs:label>Buffer Access with Incorrect Length Value</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-806 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-806">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-805"/>
        <cwe-id>CWE-806</cwe-id>
        <definition>The product uses the size of a source buffer when reading from or writing to a destination buffer, which may cause it to access memory that is outside of the bounds of the buffer.</definition>
        <rdfs:label>Buffer Access Using Size of Source Buffer</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-807 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-807">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-693"/>
        <cwe-id>CWE-807</cwe-id>
        <definition>The product uses a protection mechanism that relies on the existence or values of an input, but the input can be modified by an untrusted actor in a way that bypasses the protection mechanism.</definition>
        <rdfs:label>Reliance on Untrusted Inputs in a Security Decision</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-81 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-81">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-79"/>
        <cwe-id>CWE-81</cwe-id>
        <definition>The product receives input from an upstream component, but it does not neutralize or incorrectly neutralizes special characters that could be interpreted as web-scripting elements when they are sent to an error page.</definition>
        <rdfs:label>Improper Neutralization of Script in an Error Message Web Page</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-82 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-82">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-83"/>
        <cwe-id>CWE-82</cwe-id>
        <definition>The web application does not neutralize or incorrectly neutralizes scripting elements within attributes of HTML IMG tags, such as the src attribute.</definition>
        <rdfs:label>Improper Neutralization of Script in Attributes of IMG Tags in a Web Page</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-820 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-820">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-662"/>
        <cwe-id>CWE-820</cwe-id>
        <definition>The product utilizes a shared resource in a concurrent manner but does not attempt to synchronize access to the resource.</definition>
        <rdfs:label>Missing Synchronization</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-821 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-821">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-662"/>
        <cwe-id>CWE-821</cwe-id>
        <definition>The product utilizes a shared resource in a concurrent manner, but it does not correctly synchronize access to the resource.</definition>
        <rdfs:label>Incorrect Synchronization</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-822 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-822">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-119"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#weakness-of"/>
                <owl:someValuesFrom rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#PointerDereferencingFunction"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-823 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-823">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-119"/>
        <cwe-id>CWE-823</cwe-id>
        <definition>The product performs pointer arithmetic on a valid pointer, but it uses an offset that can point outside of the intended range of valid memory locations for the resulting pointer.</definition>
        <synonym>Untrusted pointer offset</synonym>
        <rdfs:label>Use of Out-of-range Pointer Offset</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-824 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-824">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-119"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#weakness-of"/>
                <owl:someValuesFrom rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#PointerDereferencingFunction"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-825 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-825">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-119"/>
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-672"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#weakness-of"/>
                <owl:someValuesFrom rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#UserInputFunction"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-826 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-826">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-666"/>
        <cwe-id>CWE-826</cwe-id>
        <definition>The product releases a resource that is still intended to be used by itself or another actor.</definition>
        <rdfs:label>Premature Release of Resource During Expected Lifetime</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-827 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-827">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-706"/>
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-829"/>
        <cwe-id>CWE-827</cwe-id>
        <definition>The product does not restrict a reference to a Document Type Definition (DTD) to the intended control sphere. This might allow attackers to reference arbitrary DTDs, possibly causing the product to expose files, consume excessive system resources, or execute arbitrary http requests on behalf of the attacker.</definition>
        <rdfs:label>Improper Control of Document Type Definition</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-828 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-828">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-364"/>
        <cwe-id>CWE-828</cwe-id>
        <definition>The product defines a signal handler that contains code sequences that are not asynchronous-safe, i.e., the functionality is not reentrant, or it can be interrupted.</definition>
        <rdfs:label>Signal Handler with Functionality that is not Asynchronous-Safe</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-829 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-829">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-669"/>
        <cwe-id>CWE-829</cwe-id>
        <definition>The product imports, requires, or includes executable functionality (such as a library) from a source that is outside of the intended control sphere.</definition>
        <rdfs:label>Inclusion of Functionality from Untrusted Control Sphere</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-83 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-83">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-79"/>
        <cwe-id>CWE-83</cwe-id>
        <definition>The product does not neutralize or incorrectly neutralizes &quot;javascript:&quot; or other URIs from dangerous attributes within tags, such as onmouseover, onload, onerror, or style.</definition>
        <rdfs:label>Improper Neutralization of Script in Attributes in a Web Page</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-830 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-830">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-829"/>
        <cwe-id>CWE-830</cwe-id>
        <definition>The product includes web functionality (such as a web widget) from another domain, which causes it to operate within the domain of the product, potentially granting total access and control of the product to the untrusted source.</definition>
        <rdfs:label>Inclusion of Web Functionality from an Untrusted Source</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-831 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-831">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-364"/>
        <cwe-id>CWE-831</cwe-id>
        <definition>The product defines a function that is used as a handler for more than one signal.</definition>
        <rdfs:label>Signal Handler Function Associated with Multiple Signals</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-832 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-832">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-667"/>
        <cwe-id>CWE-832</cwe-id>
        <definition>The product attempts to unlock a resource that is not locked.</definition>
        <rdfs:label>Unlock of a Resource that is not Locked</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-833 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-833">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-667"/>
        <cwe-id>CWE-833</cwe-id>
        <definition>The product contains multiple threads or executable segments that are waiting for each other to release a necessary lock, resulting in deadlock.</definition>
        <rdfs:label>Deadlock</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-834 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-834">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-691"/>
        <cwe-id>CWE-834</cwe-id>
        <definition>The product performs an iteration or loop without sufficiently limiting the number of times that the loop is executed.</definition>
        <rdfs:label>Excessive Iteration</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-835 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-835">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-834"/>
        <cwe-id>CWE-835</cwe-id>
        <definition>The product contains an iteration or loop with an exit condition that cannot be reached, i.e., an infinite loop.</definition>
        <rdfs:label>Loop with Unreachable Exit Condition (&apos;Infinite Loop&apos;)</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-836 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-836">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1390"/>
        <cwe-id>CWE-836</cwe-id>
        <definition>The product records password hashes in a data store, receives a hash of a password from a client, and compares the supplied hash to the hash obtained from the data store.</definition>
        <rdfs:label>Use of Password Hash Instead of Password for Authentication</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-837 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-837">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-799"/>
        <cwe-id>CWE-837</cwe-id>
        <definition>The product requires that an actor should only be able to perform an action once, or to have only one unique action, but the product does not enforce or improperly enforces this restriction.</definition>
        <rdfs:label>Improper Enforcement of a Single, Unique Action</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-838 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-838">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-116"/>
        <cwe-id>CWE-838</cwe-id>
        <definition>The product uses or specifies an encoding when generating output to a downstream component, but the specified encoding is not the same as the encoding that is expected by the downstream component.</definition>
        <rdfs:label>Inappropriate Encoding for Output Context</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-839 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-839">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-1023"/>
        <cwe-id>CWE-839</cwe-id>
        <definition>The product checks a value to ensure that it is less than or equal to a maximum, but it does not also verify that the value is greater than or equal to the minimum.</definition>
        <synonym>Signed comparison</synonym>
        <rdfs:label>Numeric Range Comparison Without Minimum Check</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-84 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-84">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-79"/>
        <cwe-id>CWE-84</cwe-id>
        <definition>The web application improperly neutralizes user-controlled input for executable script disguised with URI encodings.</definition>
        <rdfs:label>Improper Neutralization of Encoded URI Schemes in a Web Page</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-841 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-841">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-691"/>
        <cwe-id>CWE-841</cwe-id>
        <definition>The product supports a session in which more than one behavior must be performed by an actor, but it does not properly ensure that the actor performs the behaviors in the required sequence.</definition>
        <rdfs:label>Improper Enforcement of Behavioral Workflow</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-842 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-842">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-286"/>
        <cwe-id>CWE-842</cwe-id>
        <definition>The product or the administrator places a user into an incorrect group.</definition>
        <rdfs:label>Placement of User into Incorrect Group</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-843 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-843">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-704"/>
        <cwe-id>CWE-843</cwe-id>
        <definition>The product allocates or initializes a resource such as a pointer, object, or variable using one type, but it later accesses that resource using a type that is incompatible with the original type.</definition>
        <synonym>Object Type Confusion</synonym>
        <rdfs:label>Access of Resource Using Incompatible Type (&apos;Type Confusion&apos;)</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-85 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-85">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-79"/>
        <cwe-id>CWE-85</cwe-id>
        <definition>The web application does not filter user-controlled input for executable script disguised using doubling of the involved characters.</definition>
        <rdfs:label>Doubled Character XSS Manipulations</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-86 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-86">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-436"/>
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-79"/>
        <cwe-id>CWE-86</cwe-id>
        <definition>The product does not neutralize or incorrectly neutralizes invalid characters or byte sequences in the middle of tag names, URI schemes, and other identifiers.</definition>
        <rdfs:label>Improper Neutralization of Invalid Characters in Identifiers in Web Pages</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-862 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-862">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-285"/>
        <cwe-id>CWE-862</cwe-id>
        <definition>The product does not perform an authorization check when an actor attempts to access a resource or perform an action.</definition>
        <synonym>AuthZ</synonym>
        <rdfs:comment>Broad and could apply to all resource accesses.</rdfs:comment>
        <rdfs:label>Missing Authorization</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-863 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-863">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-285"/>
        <cwe-id>CWE-863</cwe-id>
        <definition>The product performs an authorization check when an actor attempts to access a resource or perform an action, but it does not correctly perform the check.</definition>
        <synonym>AuthZ</synonym>
        <rdfs:label>Incorrect Authorization</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-87 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-87">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-79"/>
        <cwe-id>CWE-87</cwe-id>
        <definition>The product does not neutralize or incorrectly neutralizes user-controlled input for alternate script syntax.</definition>
        <rdfs:label>Improper Neutralization of Alternate XSS Syntax</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-88 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-88">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-77"/>
        <cwe-id>CWE-88</cwe-id>
        <definition>The product constructs a string for a command to be executed by a separate component in another control sphere, but it does not properly delimit the intended arguments, options, or switches within that command string.</definition>
        <rdfs:label>Improper Neutralization of Argument Delimiters in a Command (&apos;Argument Injection&apos;)</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-89 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-89">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-943"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#weakness-of"/>
                <owl:someValuesFrom rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#UserInputFunction"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-9 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-9">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-266"/>
        <cwe-id>CWE-9</cwe-id>
        <definition>If elevated access rights are assigned to EJB methods, then an attacker can take advantage of the permissions to exploit the product.</definition>
        <rdfs:label>J2EE Misconfiguration: Weak Access Permissions for EJB Methods</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-90 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-90">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-943"/>
        <cwe-id>CWE-90</cwe-id>
        <definition>The product constructs all or part of an LDAP query using externally-influenced input from an upstream component, but it does not neutralize or incorrectly neutralizes special elements that could modify the intended LDAP query when it is sent to a downstream component.</definition>
        <rdfs:label>Improper Neutralization of Special Elements used in an LDAP Query (&apos;LDAP Injection&apos;)</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-908 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-908">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-665"/>
        <cwe-id>CWE-908</cwe-id>
        <definition>The product uses or accesses a resource that has not been initialized.</definition>
        <rdfs:label>Use of Uninitialized Resource</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-909 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-909">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-665"/>
        <cwe-id>CWE-909</cwe-id>
        <definition>The product does not initialize a critical resource.</definition>
        <rdfs:label>Missing Initialization of Resource</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-91 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-91">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-74"/>
        <cwe-id>CWE-91</cwe-id>
        <definition>The product does not properly neutralize special elements that are used in XML, allowing attackers to modify the syntax, content, or commands of the XML before it is processed by an end system.</definition>
        <rdfs:label>XML Injection (aka Blind XPath Injection)</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-910 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-910">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-672"/>
        <cwe-id>CWE-910</cwe-id>
        <definition>The product uses or accesses a file descriptor after it has been closed.</definition>
        <synonym>Stale file descriptor</synonym>
        <rdfs:label>Use of Expired File Descriptor</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-911 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-911">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-664"/>
        <cwe-id>CWE-911</cwe-id>
        <definition>The product uses a reference count to manage a resource, but it does not update or incorrectly updates the reference count.</definition>
        <rdfs:label>Improper Update of Reference Count</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-912 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-912">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-684"/>
        <cwe-id>CWE-912</cwe-id>
        <definition>The product contains functionality that is not documented, not part of the specification, and not accessible through an interface or command sequence that is obvious to the product&apos;s users or administrators.</definition>
        <rdfs:label>Hidden Functionality</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-913 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-913">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-664"/>
        <cwe-id>CWE-913</cwe-id>
        <definition>The product does not properly restrict reading from or writing to dynamically-managed code resources such as variables, objects, classes, attributes, functions, or executable instructions or statements.</definition>
        <rdfs:label>Improper Control of Dynamically-Managed Code Resources</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-914 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-914">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-913"/>
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-99"/>
        <cwe-id>CWE-914</cwe-id>
        <definition>The product does not properly restrict reading from or writing to dynamically-identified variables.</definition>
        <rdfs:label>Improper Control of Dynamically-Identified Variables</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-915 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-915">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-913"/>
        <cwe-id>CWE-915</cwe-id>
        <definition>The product receives input from an upstream component that specifies multiple attributes, properties, or fields that are to be initialized or updated in an object, but it does not properly control which attributes can be modified.</definition>
        <synonym>AutoBinding</synonym>
        <synonym>Mass Assignment</synonym>
        <synonym>PHP Object Injection</synonym>
        <rdfs:label>Improperly Controlled Modification of Dynamically-Determined Object Attributes</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-916 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-916">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-327"/>
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-328"/>
        <cwe-id>CWE-916</cwe-id>
        <definition>The product generates a hash for a password, but it uses a scheme that does not provide a sufficient level of computational effort that would make password cracking attacks infeasible or expensive.</definition>
        <rdfs:label>Use of Password Hash With Insufficient Computational Effort</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-917 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-917">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-77"/>
        <cwe-id>CWE-917</cwe-id>
        <definition>The product constructs all or part of an expression language (EL) statement in a framework such as a Java Server Page (JSP) using externally-influenced input from an upstream component, but it does not neutralize or incorrectly neutralizes special elements that could modify the intended EL statement before it is executed.</definition>
        <synonym>EL Injection</synonym>
        <rdfs:label>Improper Neutralization of Special Elements used in an Expression Language Statement (&apos;Expression Language Injection&apos;)</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-918 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-918">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-441"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#weakness-of"/>
                <owl:someValuesFrom rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#UserInputFunction"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-920 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-920">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-400"/>
        <cwe-id>CWE-920</cwe-id>
        <definition>The product operates in an environment in which power is a limited resource that cannot be automatically replenished, but the product does not properly restrict the amount of power that its operation consumes.</definition>
        <rdfs:label>Improper Restriction of Power Consumption</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-921 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-921">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-922"/>
        <cwe-id>CWE-921</cwe-id>
        <definition>The product stores sensitive information in a file system or device that does not have built-in access control.</definition>
        <rdfs:label>Storage of Sensitive Data in a Mechanism without Access Control</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-922 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-922">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-664"/>
        <cwe-id>CWE-922</cwe-id>
        <definition>The product stores sensitive information without properly limiting read or write access by unauthorized actors.</definition>
        <rdfs:label>Insecure Storage of Sensitive Information</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-923 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-923">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-284"/>
        <cwe-id>CWE-923</cwe-id>
        <definition>The product establishes a communication channel to (or from) an endpoint for privileged or protected operations, but it does not properly ensure that it is communicating with the correct endpoint.</definition>
        <rdfs:label>Improper Restriction of Communication Channel to Intended Endpoints</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-924 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-924">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-345"/>
        <cwe-id>CWE-924</cwe-id>
        <definition>The product establishes a communication channel with an endpoint and receives a message from that endpoint, but it does not sufficiently ensure that the message was not modified during transmission.</definition>
        <rdfs:label>Improper Enforcement of Message Integrity During Transmission in a Communication Channel</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-925 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-925">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-940"/>
        <cwe-id>CWE-925</cwe-id>
        <definition>The Android application uses a Broadcast Receiver that receives an Intent but does not properly verify that the Intent came from an authorized source.</definition>
        <synonym>Intent Spoofing</synonym>
        <rdfs:label>Improper Verification of Intent by Broadcast Receiver</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-926 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-926">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-285"/>
        <cwe-id>CWE-926</cwe-id>
        <definition>The Android application exports a component for use by other applications, but does not properly restrict which applications can launch the component or access the data it contains.</definition>
        <rdfs:label>Improper Export of Android Application Components</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-927 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-927">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-285"/>
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-668"/>
        <cwe-id>CWE-927</cwe-id>
        <definition>The Android application uses an implicit intent for transmitting sensitive data to other applications.</definition>
        <rdfs:label>Use of Implicit Intent for Sensitive Communication</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-93 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-93">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-74"/>
        <cwe-id>CWE-93</cwe-id>
        <definition>The product uses CRLF (carriage return line feeds) as a special element, e.g. to separate lines or records, but it does not neutralize or incorrectly neutralizes CRLF sequences from inputs.</definition>
        <rdfs:label>Improper Neutralization of CRLF Sequences (&apos;CRLF Injection&apos;)</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-939 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-939">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-862"/>
        <cwe-id>CWE-939</cwe-id>
        <definition>The product uses a handler for a custom URL scheme, but it does not properly restrict which actors can invoke the handler using the scheme.</definition>
        <rdfs:label>Improper Authorization in Handler for Custom URL Scheme</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-94 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-94">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-74"/>
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-913"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#may-be-weakness-of"/>
                <owl:someValuesFrom rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#EvalFunction"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#may-be-weakness-of"/>
                <owl:someValuesFrom rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#UserInputFunction"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-940 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-940">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-346"/>
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-923"/>
        <cwe-id>CWE-940</cwe-id>
        <definition>The product establishes a communication channel to handle an incoming request that has been initiated by an actor, but it does not properly verify that the request is coming from the expected origin.</definition>
        <rdfs:label>Improper Verification of Source of a Communication Channel</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-941 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-941">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-923"/>
        <cwe-id>CWE-941</cwe-id>
        <definition>The product creates a communication channel to initiate an outgoing request to an actor, but it does not correctly specify the intended destination for that actor.</definition>
        <rdfs:label>Incorrectly Specified Destination in a Communication Channel</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-942 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-942">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-183"/>
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-863"/>
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-923"/>
        <cwe-id>CWE-942</cwe-id>
        <definition>The product uses a cross-domain policy file that includes domains that should not be trusted.</definition>
        <rdfs:label>Permissive Cross-domain Policy with Untrusted Domains</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-943 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-943">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-74"/>
        <cwe-id>CWE-943</cwe-id>
        <definition>The product generates a query intended to access or manipulate data in a data store such as a database, but it does not neutralize or incorrectly neutralizes special elements that can modify the intended logic of the query.</definition>
        <synonym>NoSQL Injection, NoSQLi</synonym>
        <rdfs:label>Improper Neutralization of Special Elements in Data Query Logic</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-95 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-95">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-94"/>
        <cwe-id>CWE-95</cwe-id>
        <definition>The product receives input from an upstream component, but it does not neutralize or incorrectly neutralizes code syntax before using the input in a dynamic evaluation call (e.g. &quot;eval&quot;).</definition>
        <rdfs:label>Improper Neutralization of Directives in Dynamically Evaluated Code (&apos;Eval Injection&apos;)</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-96 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-96">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-94"/>
        <cwe-id>CWE-96</cwe-id>
        <definition>The product receives input from an upstream component, but it does not neutralize or incorrectly neutralizes code syntax before inserting the input into an executable resource, such as a library, configuration file, or template.</definition>
        <rdfs:label>Improper Neutralization of Directives in Statically Saved Code (&apos;Static Code Injection&apos;)</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-97 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-97">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-96"/>
        <cwe-id>CWE-97</cwe-id>
        <definition>The product generates a web page, but does not neutralize or incorrectly neutralizes user-controllable input that could be interpreted as a server-side include (SSI) directive.</definition>
        <rdfs:label>Improper Neutralization of Server-Side Includes (SSI) Within a Web Page</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-98 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-98">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-706"/>
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-829"/>
        <cwe-id>CWE-98</cwe-id>
        <definition>The PHP application receives input from an upstream component, but it does not restrict or incorrectly restricts the input before its usage in &quot;require,&quot; &quot;include,&quot; or similar functions.</definition>
        <synonym>Local file inclusion</synonym>
        <synonym>RFI</synonym>
        <synonym>Remote file include</synonym>
        <rdfs:label>Improper Control of Filename for Include/Require Statement in PHP Program (&apos;PHP Remote File Inclusion&apos;)</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-99 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-99">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CWE-74"/>
        <cwe-id>CWE-99</cwe-id>
        <definition>The product receives input from an upstream component, but it does not restrict or incorrectly restricts the input before it is used as an identifier for a resource that may be outside the intended sphere of control.</definition>
        <synonym>Insecure Direct Object Reference</synonym>
        <rdfs:label>Improper Control of Resource Identifiers (&apos;Resource Injection&apos;)</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CacheMemory -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CacheMemory">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#PrimaryStorage"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#accessed-by"/>
                <owl:someValuesFrom rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CentralProcessingUnit"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#may-contain"/>
                <owl:someValuesFrom rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#ProcessSegment"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#modifies"/>
                <owl:someValuesFrom rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CacheMemory"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CallStack -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CallStack">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#DigitalInformationBearer"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#contains"/>
                <owl:someValuesFrom rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#StackFrame"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CanopyClustering -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CanopyClustering">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#ClusterAnalysis"/>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#Capability -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#Capability">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#ExternalThing"/>
        <rdfs:isDefinedBy rdf:resource="http://dbpedia.org/resource/Capability_(systems_engineering)"/>
        <rdfs:label>Capability</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://web.archive.org/web/20081123014953/http://www.dtic.mil/doctrine/jel/new_pubs/jp1_02.pdf"/>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CentralProcessingUnit -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CentralProcessingUnit">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#Processor"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#contains"/>
                <owl:someValuesFrom rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#ProcessorRegister"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#may-contain"/>
                <owl:someValuesFrom rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CacheMemory"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#may-contain"/>
                <owl:someValuesFrom rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#MemoryManagementUnit"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#may-contain"/>
                <owl:someValuesFrom rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#MemoryProtectionUnit"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CentralTendency -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CentralTendency">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#DescriptiveStatistics"/>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#Centroid-basedClustering -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#Centroid-basedClustering">
