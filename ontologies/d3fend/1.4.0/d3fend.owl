    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#AccessControlAdministrationEvent -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#AccessControlAdministrationEvent">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#AccessControlEvent"/>
        <definition>An event concerning the administrative actions of setting, modifying, or abolishing permissions, configuring access control settings, and managing user access rights to ensure alignment with access control policies.</definition>
        <rdfs:label>Access Control Administration Event</rdfs:label>
        <skos:altLabel>Permission Administration Event</skos:altLabel>
        <skos:altLabel>Permission Provisioning Event</skos:altLabel>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#AccessControlConfiguration -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#AccessControlConfiguration">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#ConfigurationResource"/>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#AccessControlEvent -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#AccessControlEvent">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#AuthorizationEvent"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#has-participant"/>
                <owl:someValuesFrom rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#AccessControlConfiguration"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <definition>An event that captures the implementation or evaluation of access control measures, including the application of rules and policies to govern the accessibility of resources by agents within a digital system.</definition>
        <rdfs:label>Access Control Event</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#AccessControlGroup -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#AccessControlGroup">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#AccessControlConfiguration"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#restricted-by"/>
                <owl:someValuesFrom rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#AccessControlList"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#AccessControlList -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#AccessControlList">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#AccessControlConfiguration"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#restricts"/>
                <owl:someValuesFrom rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#UserGroup"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#AccessDeniedEvent -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#AccessDeniedEvent">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#AccessMediationEvent"/>
        <definition>An event indicating the refusal of access to a resource, where an access request has been evaluated and denied based on current authorization policies, preventing operations by the requesting agent.</definition>
        <rdfs:label>Access Denied Event</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#AccessGrantedEvent -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#AccessGrantedEvent">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#AccessMediationEvent"/>
        <definition>An event signifying that access to a resource has been authorized and successfully enforced, allowing the requesting agent to perform specified operations based on the access control policies.</definition>
        <rdfs:label>Access Granted Event</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#AccessMediation -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#AccessMediation">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#DefensiveTechnique"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#enables"/>
                <owl:someValuesFrom rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#Isolate"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#AccessMediationEvent -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#AccessMediationEvent">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#AccessControlEvent"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#has-participant"/>
                <owl:someValuesFrom rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#AccessMediator"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <definition>An event involving the intermediary control mechanism that evaluates access requests and enforces access control decisions, ensuring that subjects&apos; resource interactions comply with the established access policies.</definition>
        <rdfs:label>Access Mediation Event</rdfs:label>
        <skos:altLabel>Access Enforcement Event</skos:altLabel>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#AccessMediator -->

