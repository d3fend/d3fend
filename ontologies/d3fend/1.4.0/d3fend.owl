    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#Forecasting -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#Forecasting">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#AnalyticalPurpose"/>
