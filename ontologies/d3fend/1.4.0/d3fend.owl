<?xml version="1.0"?>
<rdf:RDF xmlns="http://d3fend.mitre.org/ontologies/d3fend.owl#"
     xml:base="http://d3fend.mitre.org/ontologies/d3fend.owl"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:skos="http://www.w3.org/2004/02/skos/core#"
     xmlns:d3fend="http://d3fend.mitre.org/ontologies/d3fend.owl#"
     xmlns:dcterms="http://purl.org/dc/terms/">
    <owl:Ontology rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl">
        <owl:versionIRI rdf:resource="http://d3fend.mitre.org/ontologies/d3fend/1.4.0/d3fend.owl"/>
        <release-date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2026-03-31T00:12:00+00:00</release-date>
        <dcterms:description>D3FEND is a framework which encodes a countermeasure knowledge base as a knowledge graph. The graph contains the types and relations that define key concepts in the cybersecurity countermeasure domain and the relations necessary to link those concepts to each other. Each of these concepts and relations are linked to references in the cybersecurity literature.</dcterms:description>
        <dcterms:license>MIT</dcterms:license>
        <dcterms:title>D3FEND™ - A knowledge graph of cybersecurity countermeasures</dcterms:title>
        <rdfs:comment>Use of the D3FEND Knowledge Graph, and the associated references from this ontology are subject to the Terms of Use. D3FEND is funded by the National Security Agency (NSA) Cybersecurity Directorate and managed by the National Security Engineering Center (NSEC) which is operated by The MITRE Corporation. D3FEND™ and the D3FEND logo are trademarks of The MITRE Corporation. This software was produced for the U.S. Government under Basic Contract No. W56KGU-18-D0004, and is subject to the Rights in Noncommercial Computer Software and Noncommercial Computer Software Documentation Clause 252.227-7014 (FEB 2012) Copyright 2022 The MITRE Corporation.</rdfs:comment>
        <owl:versionInfo>1.4.0</owl:versionInfo>
    </owl:Ontology>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Annotation properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#attack-id -->

    <owl:AnnotationProperty rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#attack-id">
        <definition>x attack-id y: The offensive technique x has the att&amp;ck unique id of y.</definition>
        <rdfs:label>attack-id</rdfs:label>
        <rdfs:subPropertyOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#attack-kb-annotation"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:domain rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#OffensiveTechnique"/>
    </owl:AnnotationProperty>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#attack-kb-annotation -->

    <owl:AnnotationProperty rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#attack-kb-annotation">
        <definition>x attack-kb-annotation y: The offensive technique x has the kb annotation of y.</definition>
        <rdfs:label>attack-kb-annotation</rdfs:label>
        <rdfs:subPropertyOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#d3fend-annotation"/>
        <rdfs:domain rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#OffensiveTechnique"/>
    </owl:AnnotationProperty>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#contributor -->

    <owl:AnnotationProperty rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#contributor"/>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#cwe-id -->

    <owl:AnnotationProperty rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#cwe-id">
        <rdfs:label>cwe-id</rdfs:label>
        <rdfs:subPropertyOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#cwe-kb-annotation"/>
    </owl:AnnotationProperty>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#cwe-kb-annotation -->

    <owl:AnnotationProperty rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#cwe-kb-annotation">
        <rdfs:label>cwe-kb-annotation</rdfs:label>
        <rdfs:subPropertyOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#d3fend-annotation"/>
    </owl:AnnotationProperty>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#d3fend-annotation -->

    <owl:AnnotationProperty rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#d3fend-annotation">
        <definition>x d3fend-annotation y: The d3fend object x has the annotation y.</definition>
        <rdfs:label>d3fend-annotation</rdfs:label>
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#versionInfo"/>
    </owl:AnnotationProperty>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#d3fend-catalog-annotation-property -->

    <owl:AnnotationProperty rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#d3fend-catalog-annotation-property">
        <rdfs:label>d3fend-catalog-annotation-property</rdfs:label>
        <skos:altLabel>d3fend-vendor-registry-annotation-property</skos:altLabel>
        <rdfs:subPropertyOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#d3fend-annotation"/>
    </owl:AnnotationProperty>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#d3fend-display-annotation -->

    <owl:AnnotationProperty rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#d3fend-display-annotation">
        <rdfs:label>d3fend-display-annotation</rdfs:label>
        <rdfs:subPropertyOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#d3fend-annotation"/>
    </owl:AnnotationProperty>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#d3fend-kb-annotation-property -->

    <owl:AnnotationProperty rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#d3fend-kb-annotation-property">
        <definition>x d3fend-kb-annotation-property y: The entity x had the d3fend kb annotation y.</definition>
        <rdfs:label>d3fend-kb-annotation-property</rdfs:label>
        <rdfs:subPropertyOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#d3fend-annotation"/>
    </owl:AnnotationProperty>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#d3fend-kb-reference-annotation -->

    <owl:AnnotationProperty rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#d3fend-kb-reference-annotation">
        <definition>x d3fend-kb-data-property y: The reference x has the data property y.</definition>
        <rdfs:label>d3fend-kb-reference-annotation</rdfs:label>
        <rdfs:subPropertyOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#d3fend-kb-annotation-property"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:domain rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#TechniqueReference"/>
    </owl:AnnotationProperty>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#definition -->

    <owl:AnnotationProperty rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#definition">
        <definition>x definition y: The d3fend object x has the definition y.</definition>
        <rdfs:isDefinedBy rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <rdfs:label>definition</rdfs:label>
        <rdfs:subPropertyOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#d3fend-annotation"/>
    </owl:AnnotationProperty>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#description -->

    <owl:AnnotationProperty rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#description">
        <definition>A statement that represents something in words.</definition>
        <rdfs:isDefinedBy rdf:resource="http://wordnet-rdf.princeton.edu/id/06737512-n"/>
        <rdfs:label xml:lang="en">description</rdfs:label>
        <rdfs:subPropertyOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#d3fend-catalog-annotation-property"/>
    </owl:AnnotationProperty>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#display-baseurl -->

    <owl:AnnotationProperty rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#display-baseurl">
        <definition>A base string to use as prefix to create a full URL for an entity. The baseurl must end in a forward slash: /</definition>
        <rdfs:label>display-baseurl</rdfs:label>
        <rdfs:subPropertyOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#d3fend-display-annotation"/>
    </owl:AnnotationProperty>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#display-order -->

    <owl:AnnotationProperty rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#display-order">
        <definition>x display-order y: An object x should be displayed in ordinal position y when placed or listed in a d3fend display with other objects of its kind.</definition>
        <rdfs:label>display-order</rdfs:label>
        <rdfs:subPropertyOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#d3fend-display-annotation"/>
    </owl:AnnotationProperty>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#display-priority -->

    <owl:AnnotationProperty rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#display-priority">
        <rdfs:label>display-priority</rdfs:label>
        <rdfs:subPropertyOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#d3fend-display-annotation"/>
    </owl:AnnotationProperty>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#kb-abstract -->

    <owl:AnnotationProperty rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#kb-abstract">
        <definition>x kb-abstract y: The reference x has the abstract y.</definition>
        <rdfs:label>kb-abstract</rdfs:label>
        <rdfs:subPropertyOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#d3fend-kb-reference-annotation"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:domain rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#TechniqueReference"/>
    </owl:AnnotationProperty>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#kb-article -->

    <owl:AnnotationProperty rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#kb-article">
        <definition>The technique x has the kb-article y, where y is written in Markdown.</definition>
        <rdfs:label>kb-article</rdfs:label>
        <rdfs:subPropertyOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#d3fend-kb-reference-annotation"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:domain rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#Technique"/>
    </owl:AnnotationProperty>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#kb-author -->

    <owl:AnnotationProperty rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#kb-author">
        <definition>x kb-author y: The reference x has some author y.</definition>
        <rdfs:label>kb-author</rdfs:label>
        <rdfs:subPropertyOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#d3fend-kb-reference-annotation"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:domain rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#TechniqueReference"/>
    </owl:AnnotationProperty>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#kb-mitre-analysis -->

    <owl:AnnotationProperty rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#kb-mitre-analysis">
        <definition>x kb-mitre-analysis y: The reference x has the mitre d3fend analysis y.</definition>
        <rdfs:label>kb-mitre-analysis</rdfs:label>
        <rdfs:subPropertyOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#d3fend-kb-annotation-property"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:domain rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#TechniqueReference"/>
    </owl:AnnotationProperty>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#kb-organization -->

    <owl:AnnotationProperty rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#kb-organization">
        <definition>x kb-organization y: The reference x was created or owned by the organization y.</definition>
        <rdfs:label>kb-organization</rdfs:label>
        <rdfs:subPropertyOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#d3fend-kb-annotation-property"/>
    </owl:AnnotationProperty>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#label -->

    <owl:AnnotationProperty rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#label">
        <rdfs:label xml:lang="en">label</rdfs:label>
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
    </owl:AnnotationProperty>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#pref-label -->

    <owl:AnnotationProperty rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#pref-label">
        <definition>x pref-label y: The preferred display value for x is y in d3fend tools.</definition>
        <rdfs:label>pref-label</rdfs:label>
        <rdfs:subPropertyOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#d3fend-annotation"/>
    </owl:AnnotationProperty>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#release-date -->

    <owl:AnnotationProperty rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#release-date">
        <definition>x release-date y: The object x has the release-date y.</definition>
        <rdfs:label>release-date</rdfs:label>
        <rdfs:subPropertyOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#d3fend-annotation"/>
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#versionInfo"/>
    </owl:AnnotationProperty>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#synonym -->

    <owl:AnnotationProperty rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#synonym">
        <definition>an equivalent term.</definition>
        <rdfs:label>synonym</rdfs:label>
        <rdfs:subPropertyOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#d3fend-annotation"/>
    </owl:AnnotationProperty>
    


    <!-- http://purl.org/dc/terms/description -->

    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/description"/>
    


    <!-- http://purl.org/dc/terms/license -->

    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/license"/>
    


    <!-- http://purl.org/dc/terms/title -->

    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/title"/>
    


    <!-- http://www.w3.org/2000/01/rdf-schema#isDefinedBy -->

    <owl:AnnotationProperty rdf:about="http://www.w3.org/2000/01/rdf-schema#isDefinedBy">
        <rdfs:label>isDefinedBy</rdfs:label>
    </owl:AnnotationProperty>
    


    <!-- http://www.w3.org/2000/01/rdf-schema#label -->

    <owl:AnnotationProperty rdf:about="http://www.w3.org/2000/01/rdf-schema#label"/>
    


    <!-- http://www.w3.org/2000/01/rdf-schema#seeAlso -->

    <owl:AnnotationProperty rdf:about="http://www.w3.org/2000/01/rdf-schema#seeAlso"/>
    


    <!-- http://www.w3.org/2004/02/skos/core#altLabel -->

    <owl:AnnotationProperty rdf:about="http://www.w3.org/2004/02/skos/core#altLabel"/>
    


    <!-- http://www.w3.org/2004/02/skos/core#example -->

    <owl:AnnotationProperty rdf:about="http://www.w3.org/2004/02/skos/core#example"/>
    


    <!-- http://www.w3.org/2004/02/skos/core#prefLabel -->

    <owl:AnnotationProperty rdf:about="http://www.w3.org/2004/02/skos/core#prefLabel"/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Object Properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#abuses -->

    <owl:ObjectProperty rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#abuses">
        <rdfs:subPropertyOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#uses"/>
        <definition>x abuses y: The entity x applies an artifact y to a wrong thing or person; x applies y badly or incorrectly.</definition>
        <rdfs:isDefinedBy rdf:resource="http://wordnet-rdf.princeton.edu/id/01163606-v"/>
        <rdfs:label>abuses</rdfs:label>
        <skos:altLabel>misapplies</skos:altLabel>
        <skos:altLabel>misuses</skos:altLabel>
    </owl:ObjectProperty>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#access-mediated-by -->

    <owl:ObjectProperty rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#access-mediated-by">
        <rdfs:subPropertyOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#associated-with"/>
        <owl:inverseOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#mediates-access-to"/>
        <definition>x access-mediated-by y: The entity or resource x has its access regulated, controlled, or facilitated by entity y, which acts as an intermediary or gatekeeper to enforce access control policies.</definition>
        <rdfs:label>access-mediated-by</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#accessed-by -->

    <owl:ObjectProperty rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#accessed-by">
        <rdfs:subPropertyOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#associated-with"/>
        <rdfs:subPropertyOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#may-be-accessed-by"/>
        <owl:inverseOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#accesses"/>
        <definition>x accessed-by y: The entity or resource x is accessed by entity y.</definition>
        <rdfs:label>accessed-by</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#accesses -->

    <owl:ObjectProperty rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#accesses">
        <rdfs:subPropertyOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#associated-with"/>
        <rdfs:subPropertyOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#may-access"/>
        <definition>x accesses y: The subject x takes the action of reading from, writing into, or executing the stored information in the object y. Reads, writes, and executes are specific cases of accesses.</definition>
        <rdfs:isDefinedBy rdf:resource="http://wordnet-rdf.princeton.edu/id/02673854-n"/>
        <rdfs:label>accesses</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#addressed-by -->

    <owl:ObjectProperty rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#addressed-by">
        <rdfs:subPropertyOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#associated-with"/>
        <owl:inverseOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#addresses"/>
        <definition>x addressed-by y: Relates a resource x (e.g., network host, peripheral device, disk sector, a memory cell or other logical or physical entity) to a discrete address y in an address space that points to it.</definition>
        <rdfs:label>addressed-by</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#addresses -->

    <owl:ObjectProperty rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#addresses">
        <rdfs:subPropertyOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#associated-with"/>
        <definition>x addresses y: Relates a pointer x to a digital artifact y located in the address space to which x points. The address space is part of some digital store, whether it be in memory, an image, or a persistent storage device.</definition>
        <rdfs:label>addresses</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dbpedia.org/resource/Pointer_(computer_programming)"/>
        <rdfs:seeAlso rdf:resource="http://wordnet-rdf.princeton.edu/id/02253826-v"/>
        <skos:altLabel>points-to</skos:altLabel>
    </owl:ObjectProperty>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#adds -->

    <owl:ObjectProperty rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#adds">
        <rdfs:subPropertyOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#associated-with"/>
        <rdfs:subPropertyOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#may-add"/>
        <definition>x adds y: The subject x adds a data object y, such as a file, to some other digital artifact, such as a directory. Examples include an agent or technique adding a record to a database or a domain entry to a DNS server.</definition>
        <rdfs:label>adds</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#analyzes -->

    <owl:ObjectProperty rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#analyzes">
        <rdfs:subPropertyOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#associated-with"/>
        <rdfs:subPropertyOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#detects"/>
        <definition>x analyzes y: The subject x breaks down object y into components or essential features, assessing y by quantitative methods, qualitative methods, or both.  Usually the analysis is done in terms of some model or framework.</definition>
        <rdfs:isDefinedBy rdf:resource="http://wordnet-rdf.princeton.edu/id/00738221-v"/>
        <rdfs:label>analyzes</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#associated-with -->

    <owl:ObjectProperty rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#associated-with">
        <rdfs:subPropertyOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#may-be-associated-with"/>
        <definition>x associated-with y: The subject x and object y are associated in some way.  This is the most general definite relationship in d3fend (i.e., most general relationship that is not prefixed by &apos;may-&apos;.)</definition>
        <rdfs:label>associated-with</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://wordnet-rdf.princeton.edu/id/13804981-n"/>
    </owl:ObjectProperty>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#attached-to -->

    <owl:ObjectProperty rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#attached-to">
        <rdfs:subPropertyOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#associated-with"/>
        <definition>x attached-to y: A subject x is joined in close association to an object y.</definition>
        <rdfs:isDefinedBy rdf:resource="http://wordnet-rdf.princeton.edu/id/01980375-s"/>
        <rdfs:label>attached-to</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#connects"/>
    </owl:ObjectProperty>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#attack-may-be-countered-by -->

    <owl:ObjectProperty rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#attack-may-be-countered-by">
        <rdfs:subPropertyOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#may-be-tactically-associated-with"/>
        <rdfs:label>attack-may-be-countered-by</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#authenticates -->

    <owl:ObjectProperty rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#authenticates">
        <rdfs:subPropertyOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#associated-with"/>
        <rdfs:subPropertyOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#hardens"/>
        <definition>x authenticates y: The subject x establishes the authenticity of some y. This relation indicates an authentication event has occurred.</definition>
        <rdfs:isDefinedBy rdf:resource="http://wordnet-rdf.princeton.edu/id/01980375-s"/>
        <rdfs:label>authenticates</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#authorizes -->

    <owl:ObjectProperty rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#authorizes">
        <rdfs:subPropertyOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#associated-with"/>
        <rdfs:subPropertyOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#hardens"/>
        <definition>x authorizes y: A subject x grants authorization or clearance for an agent y to use an object.  This relation indicates an authorization event has occurred.</definition>
        <rdfs:isDefinedBy rdf:resource="http://wordnet-rdf.princeton.edu/id/00804987-v"/>
        <rdfs:label>authorizes</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://wordnet-rdf.princeton.edu/id/00805664-v"/>
    </owl:ObjectProperty>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#blocks -->

    <owl:ObjectProperty rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#blocks">
        <rdfs:subPropertyOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#counters"/>
        <rdfs:subPropertyOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#filters"/>
        <rdfs:subPropertyOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#may-block"/>
        <definition>x blocks y: The entity x blocks off the use of digital artifact y by reference to a block or allow list (or both.)</definition>
        <rdfs:isDefinedBy rdf:resource="http://wordnet-rdf.princeton.edu/id/01480024-v"/>
        <rdfs:label>blocks</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#broader -->

    <owl:ObjectProperty rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#broader">
        <rdfs:subPropertyOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#semantic-relation"/>
        <definition>x broader y: The entity x represents a more general or inclusive concept than entity y.</definition>
        <rdfs:label>broader</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#broader-transitive -->

    <owl:ObjectProperty rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#broader-transitive">
        <rdfs:subPropertyOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#semantic-relation"/>
        <definition>x broader-transitive y: The entity x represents a more general concept than entity y, including indirect or hierarchical relationships where x encompasses y through intermediate entities.</definition>
        <rdfs:label>broader-transitive</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#carried-by -->

    <owl:ObjectProperty rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#carried-by">
        <rdfs:subPropertyOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#associated-with"/>
        <owl:inverseOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#carries"/>
        <definition>x carried-by y: The information entity x is dependent upon the entity y for its storage, transport, or communication. Entity y serves as the necessary bearer or link from which x can be recovered or interpreted.</definition>
        <rdfs:label>carried-by</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#carries -->

    <owl:ObjectProperty rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#carries">
        <rdfs:subPropertyOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#associated-with"/>
        <definition>x carries y: The entity x serves as the bearer or link for information y, enabling y to be stored, transported, or communicated such that y can be recovered or interpreted from x</definition>
        <rdfs:label>carries</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#caused-by -->

    <owl:ObjectProperty rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#caused-by">
        <rdfs:subPropertyOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#associated-with"/>
        <owl:inverseOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#causes"/>
        <definition>x caused-by y: The event or action x occurs as a consequence of event or action y.</definition>
        <rdfs:isDefinedBy rdf:resource="https://www.commoncoreontologies.org/ont00001819"/>
        <rdfs:label>caused-by</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#causes -->

    <owl:ObjectProperty rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#causes">
        <rdfs:subPropertyOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#associated-with"/>
        <definition>x causes y: The event or action x brings about event or action y as a consequence.</definition>
        <rdfs:isDefinedBy rdf:resource="https://www.commoncoreontologies.org/ont00001803"/>
        <rdfs:label>causes</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#communicates-with -->

    <owl:ObjectProperty rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#communicates-with">
        <rdfs:subPropertyOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#associated-with"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#SymmetricProperty"/>
        <definition>x communicates-with y: x and y exchange signals or data bidirectionally, enabling mutual awareness, coordination, or interaction.</definition>
        <rdfs:label>communicates-with</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#configures -->

    <owl:ObjectProperty rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#configures">
        <rdfs:subPropertyOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#associated-with"/>
        <rdfs:subPropertyOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#hardens"/>
        <definition>x configures y: The entity x sets the operational parameters of entity y, determining how y will operate.</definition>
        <rdfs:label>configures</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#connected-to -->

    <owl:ObjectProperty rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#connected-to">
        <rdfs:subPropertyOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#associated-with"/>
        <definition>x connected-to y: The subject x shares a direct physical or logical link with object y such that communication is possible between them without intermediate routing.</definition>
        <rdfs:label>connected-to</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#connects -->

    <owl:ObjectProperty rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#connects">
        <rdfs:subPropertyOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#associated-with"/>
        <definition>x connects y: The subject x joins system y by means of communication equipment (to some other system, typically the adversary-targeted host).</definition>
        <rdfs:isDefinedBy rdf:resource="http://wordnet-rdf.princeton.edu/id/01071413-v"/>
        <rdfs:label>connects</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#contained-by -->

    <owl:ObjectProperty rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#contained-by">
        <rdfs:subPropertyOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#associated-with"/>
        <rdfs:subPropertyOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#may-be-contained-by"/>
        <owl:inverseOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#contains"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
        <definition>x contained-by y: The entity x exists within or is physically or logically enclosed by entity y.</definition>
        <rdfs:label>contained-by</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#contains -->

    <owl:ObjectProperty rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#contains">
        <rdfs:subPropertyOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#associated-with"/>
        <rdfs:subPropertyOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#may-contain"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
        <definition>x contains y: A core relation that holds between a whole x and its part y.  Equivalent to relational concept &apos;has part&apos; and thus transitive.</definition>
        <rdfs:isDefinedBy rdf:resource="http://wordnet-rdf.princeton.edu/id/02639021-v"/>
        <rdfs:label>contains</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#controlled-by -->

    <owl:ObjectProperty rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#controlled-by">
        <rdfs:subPropertyOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#associated-with"/>
        <owl:inverseOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#controls"/>
        <definition>x controlled-by y: x&apos;s operation or behavior is directed or regulated by y.</definition>
        <rdfs:label>controlled-by</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#controls -->

    <owl:ObjectProperty rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#controls">
        <rdfs:subPropertyOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#associated-with"/>
        <definition>x controls y: x directs or regulates y&apos;s operational state, behavior, or function.</definition>
        <rdfs:label>controls</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#copies -->

    <owl:ObjectProperty rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#copies">
        <rdfs:subPropertyOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#creates"/>
        <definition>x copies y: A technique or agent x reproduces or makes an exact copy of some digital artifact y.</definition>
        <rdfs:isDefinedBy rdf:resource="http://wordnet-rdf.princeton.edu/id/01738810-v"/>
        <rdfs:label>copies</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#copy-of -->

    <owl:ObjectProperty rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#copy-of">
        <rdfs:subPropertyOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#associated-with"/>
        <definition>x copy-of y: The subject x is a duplicate of the object y.</definition>
        <rdfs:label>copy-of</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#corrupts -->

    <owl:ObjectProperty rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#corrupts">
        <rdfs:subPropertyOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#impairs"/>
        <definition>x corrupts y: The entity x causes y to enter an incorrect, inconsistent, or unintended state by modifying y&apos;s information-bearing content (e.g., a bit, symbol, word, configuration cell, or stored parameter) such that y&apos;s value no longer matches the expected or previously valid value.</definition>
        <rdfs:label>corrupts</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#counters -->

    <owl:ObjectProperty rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#counters">
        <rdfs:subPropertyOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#may-counter"/>
        <rdfs:label>counters</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#created-by -->

    <owl:ObjectProperty rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#created-by">
        <rdfs:subPropertyOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#associated-with"/>
        <rdfs:subPropertyOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#may-be-created-by"/>
        <owl:inverseOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#creates"/>
        <definition>x created-by y: The entity x is brought into existence, developed, or generated by entity y.</definition>
        <rdfs:label>created-by</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#creates -->

    <owl:ObjectProperty rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#creates">
        <rdfs:subPropertyOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#associated-with"/>
        <rdfs:subPropertyOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#may-create"/>
        <definition>x creates y: The subject x brings into existence an object y. Some technique or agent x creates a persistent digital artifact y (as opposed to production of a consumable or transient object.); i.e., bring forth or generate.</definition>
        <rdfs:isDefinedBy rdf:resource="http://wordnet-rdf.princeton.edu/id/01630392-v"/>
        <rdfs:label>creates</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#produces"/>
    </owl:ObjectProperty>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#d3fend-general-object-property -->

    <owl:ObjectProperty rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#d3fend-general-object-property">
        <rdfs:subPropertyOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#d3fend-object-property"/>
        <rdfs:label>d3fend-general-object-property</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#d3fend-kb-object-property -->

    <owl:ObjectProperty rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#d3fend-kb-object-property">
        <rdfs:subPropertyOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#d3fend-object-property"/>
        <definition>x d3fend-kb-object-property y: The object y is a d3fend knowledge base object property. These properties allow the linkage of knowledge and information supporting and illustrating the d3fend model.</definition>
        <rdfs:label>d3fend-kb-object-property</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#d3fend-object-property -->

    <owl:ObjectProperty rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#d3fend-object-property">
        <rdfs:label>d3fend-object-property</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#d3fend-process-object-property -->

    <owl:ObjectProperty rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#d3fend-process-object-property">
        <rdfs:subPropertyOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#d3fend-object-property"/>
        <rdfs:label>d3fend-process-object-property</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#d3fend-tactical-verb-property -->

    <owl:ObjectProperty rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#d3fend-tactical-verb-property">
        <rdfs:subPropertyOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#d3fend-object-property"/>
        <rdfs:label>d3fend-tactical-verb-property</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#d3fend-use-case-object-property -->

    <owl:ObjectProperty rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#d3fend-use-case-object-property">
        <rdfs:subPropertyOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#d3fend-object-property"/>
    </owl:ObjectProperty>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#deceives -->

    <owl:ObjectProperty rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#deceives">
        <rdfs:subPropertyOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#counters"/>
        <rdfs:label>deceives</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#deceives-with -->

    <owl:ObjectProperty rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#deceives-with">
        <rdfs:subPropertyOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#d3fend-tactical-verb-property"/>
        <definition>x deceives-with y: The entity x misleads or manipulates another entity using y as a tool, method, or mechanism to create false perceptions or understanding.</definition>
        <rdfs:label>deceives-with</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#decodes -->

    <owl:ObjectProperty rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#decodes">
        <rdfs:subPropertyOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#associated-with"/>
        <definition>x decodes y: The entity x transforms data y to a different form, usually through decompression.</definition>
        <rdfs:label>decodes</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#deletes -->

    <owl:ObjectProperty rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#deletes">
        <rdfs:subPropertyOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#evicts"/>
        <rdfs:subPropertyOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#modifies"/>
        <definition>x deletes y: A technique or agent x wipes out the digitally or magnetically recorded information of digital object y.</definition>
        <rdfs:isDefinedBy rdf:resource="http://wordnet-rdf.princeton.edu/id/01001860-v"/>
        <rdfs:label>deletes</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#dependent -->

    <owl:ObjectProperty rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#dependent">
        <rdfs:subPropertyOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#associated-with"/>
        <definition>x dependent y: A dependent y is an entity that requires the fulfillment of the requirements specified in dependency x.</definition>
        <rdfs:isDefinedBy rdf:resource="http://wordnet-rdf.princeton.edu/id/00729216-a"/>
        <rdfs:label>dependent</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#depends-on -->

    <owl:ObjectProperty rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#depends-on">
        <rdfs:subPropertyOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#associated-with"/>
        <owl:inverseOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#has-dependent"/>
        <definition>x depends-on y: The entity x is contingent on y being available; x relies on y.</definition>
        <rdfs:isDefinedBy rdf:resource="http://wordnet-rdf.princeton.edu/id/00729216-a"/>
        <rdfs:label>depends-on</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://www.cisa.gov/what-are-dependencies"/>
    </owl:ObjectProperty>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#derived-from -->

    <owl:ObjectProperty rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#derived-from">
        <rdfs:subPropertyOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#depends-on"/>
        <definition>x derived-from y: The entity x is derived from or based on the value of y.</definition>
        <rdfs:label>derived-from</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#detects -->

    <owl:ObjectProperty rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#detects">
        <rdfs:subPropertyOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#counters"/>
        <rdfs:subPropertyOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#d3fend-tactical-verb-property"/>
        <definition>x detects y: The entity x discovers the presence, occurrence, or state of entity y through observation or measurement.</definition>
        <rdfs:label>detects</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#disables -->

    <owl:ObjectProperty rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#disables">
        <rdfs:subPropertyOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#evicts"/>
        <rdfs:subPropertyOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#may-disable"/>
        <rdfs:subPropertyOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#modifies"/>
        <definition>x disables y: The technique or agent x makes an entity y unable to perform its actions or capabilities.</definition>
        <rdfs:isDefinedBy rdf:resource="http://wordnet-rdf.princeton.edu/id/00513267-v"/>
        <rdfs:label>disables</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#drives -->

    <owl:ObjectProperty rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#drives">
        <rdfs:subPropertyOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#associated-with"/>
        <definition>x drives y: The device driver x causes a system component y to function by controlling it.</definition>
        <rdfs:isDefinedBy rdf:resource="http://wordnet-rdf.princeton.edu/id/01184038-v"/>
        <rdfs:label>drives</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dbpedia.org/resource/Device_driver"/>
    </owl:ObjectProperty>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#employed-by -->

    <owl:ObjectProperty rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#employed-by">
        <rdfs:subPropertyOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#associated-with"/>
        <owl:inverseOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#employs"/>
        <definition>x employed-by y: An entity x is put into service by a technique or agent y. Inverse of y employs x.</definition>
        <rdfs:isDefinedBy rdf:resource="http://wordnet-rdf.princeton.edu/id/01161188-v"/>
        <rdfs:label>employed-by</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#employs -->

    <owl:ObjectProperty rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#employs">
        <rdfs:subPropertyOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#associated-with"/>
        <definition>x employs y: The entity x makes purposeful use of entity y to perform a function.</definition>
        <rdfs:label>employs</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#enabled-by -->

    <owl:ObjectProperty rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#enabled-by">
        <rdfs:subPropertyOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#associated-with"/>
        <owl:inverseOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#enables"/>
        <definition>x enabled-by y: A top level technique y enables a tactic x, that is, the property indicates that a technique y is used to put a particular tactic x into action. In other words, y renders x capable or able for some task.  Inverse of enables.</definition>
        <rdfs:isDefinedBy rdf:resource="http://wordnet-rdf.princeton.edu/id/00513958-v"/>
        <rdfs:label>enabled-by</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#enables -->

    <owl:ObjectProperty rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#enables">
        <rdfs:subPropertyOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#associated-with"/>
        <definition>x enables y: A top level technique x enables a tactic y, that is, the property indicates that a technique x is used to put a particular tactic y into action. In other words, x renders y capable or able for some task.</definition>
        <rdfs:isDefinedBy rdf:resource="http://wordnet-rdf.princeton.edu/id/00513958-v"/>
        <rdfs:label>enables</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#encodes -->

    <owl:ObjectProperty rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#encodes">
        <rdfs:subPropertyOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#associated-with"/>
        <definition>x encodes y: The entity x transforms data y to a different form, usually through compression.</definition>
        <rdfs:label>encodes</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#encrypts -->

    <owl:ObjectProperty rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#encrypts">
        <rdfs:subPropertyOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#associated-with"/>
        <rdfs:subPropertyOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#hardens"/>
        <definition>x encrypts y: The entity x converts the ordinary representation of a digital artifact y into a secret code.</definition>
        <rdfs:isDefinedBy rdf:resource="http://wordnet-rdf.princeton.edu/id/00996121-v"/>
        <rdfs:label>encrypts</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#end -->

    <owl:ObjectProperty rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#end">
        <rdfs:subPropertyOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#d3fend-process-object-property"/>
        <rdfs:label>end</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#enforces -->

    <owl:ObjectProperty rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#enforces">
        <rdfs:subPropertyOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#associated-with"/>
        <definition>x enforces y: Technique x forces entity y to be compliant with a law, rule, or obligation.</definition>
        <rdfs:label>enforces</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#enumerates -->

    <owl:ObjectProperty rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#enumerates">
        <rdfs:subPropertyOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#reads"/>
        <definition>x enumerates y: The subject x takes the action of reading from a digital source y to acquire data and create a list of its contents.</definition>
        <rdfs:label>enumerates</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#erases -->

    <owl:ObjectProperty rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#erases">
        <rdfs:subPropertyOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#associated-with"/>
        <definition>x erases y: A technique x removes recorded data from storage device y creating space for new data.</definition>
        <rdfs:label>erases</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#evaluated-by -->

    <owl:ObjectProperty rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#evaluated-by">
        <rdfs:subPropertyOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#associated-with"/>
        <owl:inverseOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#evaluates"/>
        <definition>x evaluated-by y: The entity x is assessed and analyzed by entity y.</definition>
        <rdfs:label>evaluated-by</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#evaluates -->

    <owl:ObjectProperty rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#evaluates">
        <rdfs:subPropertyOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#associated-with"/>
        <rdfs:subPropertyOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#may-evaluate"/>
        <definition>x evaluates y: The entity x systematically assesses entity y to judge its state, quality, or risk.</definition>
        <rdfs:label>evaluates</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#evicts -->

    <owl:ObjectProperty rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#evicts">
        <rdfs:subPropertyOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#counters"/>
        <rdfs:subPropertyOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#d3fend-tactical-verb-property"/>
        <rdfs:subPropertyOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#may-evict"/>
        <definition>x evicts y: The entity x forcibly removes entity y from the environment or resource where y was residing.</definition>
        <rdfs:label>evicts</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#exactly -->

    <owl:ObjectProperty rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#exactly">
        <rdfs:subPropertyOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#semantic-relation"/>
        <definition>x exactly y: The entity x is identical to or fully corresponds to entity y.</definition>
        <rdfs:label>exactly</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#excises -->

    <owl:ObjectProperty rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#excises">
        <rdfs:subPropertyOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#associated-with"/>
        <definition>x excises y: Technique x removes a section of entity y.</definition>
        <rdfs:label>excises</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#executed-by -->

    <owl:ObjectProperty rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#executed-by">
        <rdfs:subPropertyOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#associated-with"/>
        <owl:inverseOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#executes"/>
        <definition>x executed-by y: The entity or function x is carried out, performed, or run by entity y.</definition>
        <rdfs:label>executed-by</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#executes -->

    <owl:ObjectProperty rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#executes">
        <rdfs:subPropertyOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#accesses"/>
        <rdfs:subPropertyOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#may-execute"/>
        <rdfs:subPropertyOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#runs"/>
        <definition>x executes y: The subject x takes the action of carrying out (executing) y, which is a single software module, function, or instruction.</definition>
        <rdfs:isDefinedBy rdf:resource="http://wordnet-rdf.princeton.edu/id/02569242-v"/>
        <rdfs:label>executes</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#extends -->

    <owl:ObjectProperty rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#extends">
        <rdfs:subPropertyOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#modifies"/>
        <definition>x extends y: The entity x extends the scope or range or area of entity y, especially in the sense of widening the range of applications.</definition>
        <rdfs:isDefinedBy rdf:resource="http://wordnet-rdf.princeton.edu/id/00541315-v"/>
        <rdfs:label>extends</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#filters -->

    <owl:ObjectProperty rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#filters">
        <rdfs:subPropertyOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#associated-with"/>
        <rdfs:subPropertyOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#isolates"/>
        <definition>x filters y: An technique or agent x removes some specified set of of entities from the content of a digital artifact y, by passing an artifact&apos;s content through a filter.  A filter is a device that removes something from whatever passes through it.</definition>
        <rdfs:isDefinedBy rdf:resource="http://wordnet-rdf.princeton.edu/id/01461293-v"/>
        <rdfs:label>filters</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://wordnet-rdf.princeton.edu/id/03344588-n"/>
        <rdfs:seeAlso rdf:resource="http://www.ontologyrepository.com/CommonCoreOntologies/Filter"/>
    </owl:ObjectProperty>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#forges -->

    <owl:ObjectProperty rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#forges">
        <rdfs:subPropertyOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#creates"/>
        <definition>x forges y: An technique or agent x counterfeits a digital artifact y, such as a fake credential, with the intent to deceive.</definition>
        <rdfs:label>forges</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://wordnet-rdf.princeton.edu/id/01657814-v"/>
    </owl:ObjectProperty>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#fork -->

    <owl:ObjectProperty rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#fork">
        <rdfs:subPropertyOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#d3fend-process-object-property"/>
        <rdfs:label>fork</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#hardens -->

    <owl:ObjectProperty rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#hardens">
        <rdfs:subPropertyOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#counters"/>
        <rdfs:subPropertyOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#d3fend-tactical-verb-property"/>
        <definition>x hardens y: The entity x fortifies entity y to reduce its weaknesses so y can better withstand attack or failure.</definition>
        <rdfs:label>hardens</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#has-account -->

    <owl:ObjectProperty rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#has-account">
        <rdfs:subPropertyOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#owns"/>
        <definition>x has-account y: The subject x has ownership or possession of some account y.</definition>
        <rdfs:label>has-account</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://wordnet-rdf.princeton.edu/id/02209474-v"/>
    </owl:ObjectProperty>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#has-agent -->

    <owl:ObjectProperty rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#has-agent">
        <rdfs:subPropertyOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#has-participant"/>
        <definition>x has-agent y: The event x occurs because agent y actively carries it out.</definition>
        <rdfs:label>has-agent</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#has-audience -->

    <owl:ObjectProperty rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#has-audience">
        <rdfs:subPropertyOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#d3fend-use-case-object-property"/>
        <rdfs:label>has-audience</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#has-contribution -->

    <owl:ObjectProperty rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#has-contribution">
        <rdfs:subPropertyOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#d3fend-kb-object-property"/>
        <rdfs:label>has-contribution</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#has-contributor -->

    <owl:ObjectProperty rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#has-contributor">
        <rdfs:subPropertyOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#d3fend-kb-object-property"/>
        <rdfs:label>has-contributor</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#has-dependent -->

    <owl:ObjectProperty rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#has-dependent">
        <rdfs:subPropertyOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#associated-with"/>
        <definition>x has-dependent y: The entity x is relied upon or required by entity y.</definition>
        <rdfs:label>has-dependent</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#has-goal -->

    <owl:ObjectProperty rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#has-goal">
        <rdfs:subPropertyOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#d3fend-use-case-object-property"/>
        <rdfs:label>has-goal</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#has-input -->

    <owl:ObjectProperty rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#has-input">
        <rdfs:subPropertyOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#has-participant"/>
        <owl:inverseOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#input-of"/>
        <rdfs:domain rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#Event"/>
        <rdfs:range rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#Artifact"/>
        <definition>x has-input y: An event x has input y iff y is an artifact that is present at the start of x, provides material or information required for x to begin, and during x either y&apos;s state is altered or the information content it bears is realized.</definition>
        <rdfs:label>has-input</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://purl.obolibrary.org/obo/RO_0002233"/>
        <rdfs:seeAlso rdf:resource="https://www.commoncoreontologies.org/ont00001921"/>
    </owl:ObjectProperty>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#has-location -->

    <owl:ObjectProperty rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#has-location">
        <rdfs:subPropertyOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#associated-with"/>
        <definition>x has-location y: The entity x is situated in a particular spot or position y.</definition>
        <rdfs:isDefinedBy rdf:resource="http://wordnet-rdf.princeton.edu/id/02133811-s"/>
        <rdfs:label>has-location</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://www.obofoundry.org/ro/#OBO_REL:located_in"/>
        <skos:altLabel>located_in</skos:altLabel>
    </owl:ObjectProperty>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#has-mediator -->

    <owl:ObjectProperty rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#has-mediator">
        <rdfs:subPropertyOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#has-participant"/>
        <definition>x has-mediator y: The entity x relies on or is facilitated by entity y.</definition>
        <rdfs:label>has-mediator</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#has-member -->

    <owl:ObjectProperty rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#has-member">
        <rdfs:subPropertyOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#d3fend-kb-object-property"/>
        <owl:inverseOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#member-of"/>
        <rdfs:label>has-member</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#has-operating-mode -->

    <owl:ObjectProperty rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#has-operating-mode">
        <rdfs:subPropertyOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#associated-with"/>
        <definition>x has-operating-mode y: The entity x is currently operating in or has the potential to be in operating mode y.</definition>
        <rdfs:label>has-operating-mode</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#has-output -->

    <owl:ObjectProperty rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#has-output">
        <rdfs:subPropertyOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#has-participant"/>
        <owl:inverseOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#output-of"/>
        <rdfs:domain rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#Event"/>
        <rdfs:range rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#Artifact"/>
        <definition>x has-output y: An event x has output y iff y is an artifact that is present at the end of x, was not present in the same state at the start of x, and whose presence at the end is required for x to be considered complete; the change in state may arise either from a transformation of y itself or from the realization of the information content y bears.</definition>
        <rdfs:label>has-output</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://purl.obolibrary.org/obo/RO_0002234"/>
        <rdfs:seeAlso rdf:resource="https://www.commoncoreontologies.org/ont00001986"/>
    </owl:ObjectProperty>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#has-participant -->

    <owl:ObjectProperty rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#has-participant">
        <rdfs:subPropertyOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#associated-with"/>
        <owl:inverseOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#participates-in"/>
        <definition>x has-participant y: The event x involves an object y as a participant, indicating that y plays some role in the event, whether actively, passively, or otherwise.</definition>
        <rdfs:isDefinedBy rdf:resource="http://purl.obolibrary.org/obo/BFO_0000057"/>
        <rdfs:label>has-participant</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#has-prerequisite -->

    <owl:ObjectProperty rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#has-prerequisite">
        <rdfs:subPropertyOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#d3fend-use-case-object-property"/>
        <rdfs:label>has-prerequisite</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#has-procedure -->

    <owl:ObjectProperty rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#has-procedure">
        <rdfs:subPropertyOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#d3fend-general-object-property"/>
        <rdfs:label>has-procedure</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#has-recipient -->

    <owl:ObjectProperty rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#has-recipient">
        <rdfs:subPropertyOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#associated-with"/>
        <definition>x has-recipient y: An agent y is the intended recipient and decoder of the information contained in communication x.</definition>
        <rdfs:isDefinedBy rdf:resource="http://www.ontologyrepository.com/CommonCoreOntologies/has_recipient"/>
        <rdfs:label>has-recipient</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://wordnet-rdf.princeton.edu/id/09651094-n"/>
        <rdfs:seeAlso rdf:resource="http://wordnet-rdf.princeton.edu/id/09788768-n"/>
    </owl:ObjectProperty>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#has-sender -->

    <owl:ObjectProperty rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#has-sender">
        <rdfs:subPropertyOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#associated-with"/>
        <definition>x has-sender y: An agent y is the sender and encoder of the information contained in communication x.</definition>
        <rdfs:isDefinedBy rdf:resource="http://www.ontologyrepository.com/CommonCoreOntologies/has_sender"/>
        <rdfs:label>has-sender</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://wordnet-rdf.princeton.edu/id/10598214-n"/>
    </owl:ObjectProperty>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#has-weakness -->

    <owl:ObjectProperty rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#has-weakness">
        <rdfs:subPropertyOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#may-have-weakness"/>
        <owl:inverseOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#weakness-of"/>
        <definition>x has-weakness y: The entity x exhibits a condition y that could, in some circumstances, lead to a vulnerability.</definition>
        <rdfs:label>has-weakness</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#hides -->

    <owl:ObjectProperty rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#hides">
        <rdfs:subPropertyOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#associated-with"/>
        <rdfs:range rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#DigitalArtifact"/>
        <definition>x hides y: A technique or operation x conceals the digital artifact y.</definition>
        <rdfs:label>hides</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#identified-by -->

    <owl:ObjectProperty rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#identified-by">
        <rdfs:subPropertyOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#associated-with"/>
        <owl:inverseOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#identifies"/>
        <definition>x identified-by y: The entity x is recognized or described by entity y.</definition>
        <rdfs:label>identified-by</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#identifies -->

    <owl:ObjectProperty rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#identifies">
        <rdfs:subPropertyOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#associated-with"/>
        <definition>x identifies y: The entity x recognizes or brings attention to entity y, making it distinct or clear through naming, description, or discovery.</definition>
        <rdfs:label>identifies</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#impairs -->

    <owl:ObjectProperty rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#impairs">
        <rdfs:subPropertyOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#associated-with"/>
        <definition>x impairs y: The entity or action x hinders entity y by reducing its normal function, capacity, or availability.</definition>
        <rdfs:label>impairs</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#implemented-by -->

    <owl:ObjectProperty rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#implemented-by">
        <rdfs:subPropertyOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#associated-with"/>
        <owl:inverseOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#implements"/>
        <definition>x implemented-by y: The entity x is realized or brought into operation by entity y.</definition>
        <rdfs:label>implemented-by</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#implements -->

    <owl:ObjectProperty rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#implements">
        <rdfs:subPropertyOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#associated-with"/>
        <definition>x implements y: The entity x realizes entity y by putting its design or specification into effect.</definition>
        <rdfs:label>implements</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#initiates -->

    <owl:ObjectProperty rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#initiates">
        <rdfs:subPropertyOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#associated-with"/>
        <definition>x initiates y: The entity or action x starts or triggers entity or function y, bringing it into action.</definition>
        <rdfs:label>initiates</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#injects -->

    <owl:ObjectProperty rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#injects">
        <rdfs:subPropertyOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#executes"/>
        <definition>x injects y: The subject x takes the action of exploiting a security flaw by introducing (injecting) y, which is code or data that will change the course of execution or state of a computing process to an alternate course or state. Typically code injection is associated with adversaries intending the alternate course to facilitate a malevolent purpose; however, code injection can be unintentional or the intentions behind it may be good or benign.</definition>
        <rdfs:label>injects</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dbpedia.org/resource/Code_injection"/>
        <rdfs:seeAlso rdf:resource="http://wordnet-rdf.princeton.edu/id/00916722-v"/>
    </owl:ObjectProperty>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#input-of -->

    <owl:ObjectProperty rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#input-of">
        <rdfs:subPropertyOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#participates-in"/>
        <rdfs:domain rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#Artifact"/>
        <rdfs:range rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#Event"/>
        <definition>x input-of y: An artifact x is input of an event y iff x participates at the start of y, provides the material or information required for y to begin, and during y either x&apos;s state is altered or the information content it bears is realized.</definition>
        <rdfs:label>input-of</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://www.commoncoreontologies.org/ont00001841"/>
    </owl:ObjectProperty>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#installs -->

    <owl:ObjectProperty rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#installs">
        <rdfs:subPropertyOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#associated-with"/>
        <definition>x installs y: An entity x sets up digital artifact y for subsequent use.  For example, an installation program can install application software.</definition>
        <rdfs:isDefinedBy rdf:resource="http://wordnet-rdf.princeton.edu/id/01572394-v"/>
        <rdfs:label>installs</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#instructed-by -->

    <owl:ObjectProperty rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#instructed-by">
        <rdfs:subPropertyOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#associated-with"/>
        <definition>x instructed-by y: A subject x takes machine instructions from object y.</definition>
        <rdfs:label>instructed-by</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#instructs -->

    <owl:ObjectProperty rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#instructs">
        <rdfs:subPropertyOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#associated-with"/>
        <definition>x instructs y: A subject x delivers machine instructions to object y.</definition>
        <rdfs:label>instructs</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#interprets -->

    <owl:ObjectProperty rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#interprets">
        <rdfs:subPropertyOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#executes"/>
        <rdfs:subPropertyOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#may-interpret"/>
        <definition>x interprets y: The subject x interprets the executable script y. The definition of interprets here is &apos;Parse the source code and perform its behavior directly.&apos;</definition>
        <rdfs:label>interprets</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dbpedia.org/resource/Interpreter_(computing)"/>
    </owl:ObjectProperty>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#inventoried-by -->

    <owl:ObjectProperty rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#inventoried-by">
        <rdfs:subPropertyOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#associated-with"/>
        <owl:inverseOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#inventories"/>
        <definition>x inventoried-by y: The entity x is cataloged, recorded, or tracked by entity y.</definition>
        <rdfs:label>inventoried-by</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#inventories -->

    <owl:ObjectProperty rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#inventories">
        <rdfs:subPropertyOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#associated-with"/>
        <definition>x inventories y: The entity x systematically discovers entity y and records its presence and key details for tracking.</definition>
        <rdfs:label>inventories</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#invoked-by -->

    <owl:ObjectProperty rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#invoked-by">
        <rdfs:subPropertyOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#associated-with"/>
        <rdfs:subPropertyOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#may-be-invoked-by"/>
        <owl:inverseOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#invokes"/>
        <definition>x invoked-by y: The entity x is called, triggered, or activated by entity y.</definition>
        <rdfs:label>invoked-by</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#invokes -->

    <owl:ObjectProperty rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#invokes">
        <rdfs:subPropertyOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#executes"/>
        <rdfs:subPropertyOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#may-invoke"/>
        <definition>x invokes y: The subject x invokes a system service by use of an instruction object y that interrupts the program being executed and passes control to the operating system to perform that operation.</definition>
        <rdfs:isDefinedBy rdf:resource="http://wordnet-rdf.princeton.edu/id/06599393-n"/>
        <rdfs:label>invokes</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dbpedia.org/resource/System_call"/>
        <skos:altLabel>calls</skos:altLabel>
    </owl:ObjectProperty>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#isolates -->

    <owl:ObjectProperty rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#isolates">
        <rdfs:subPropertyOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#associated-with"/>
        <rdfs:subPropertyOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#d3fend-tactical-verb-property"/>
        <definition>x isolates y: The technique or agent x sets digital artifact y apart from other digital artifacts, sequestering y.</definition>
        <rdfs:isDefinedBy rdf:resource="http://wordnet-rdf.princeton.edu/id/00496744-v"/>
        <rdfs:label>isolates</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#jams -->

    <owl:ObjectProperty rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#jams">
        <rdfs:subPropertyOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#impairs"/>
        <definition>x jams y: The entity x deliberately introduces interfering energy that degrades, disrupts, blocks, or masks the information-bearing capability of the target y.</definition>
        <rdfs:label>jams</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#kb-reference -->

    <owl:ObjectProperty rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#kb-reference">
        <rdfs:subPropertyOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#d3fend-kb-object-property"/>
        <owl:inverseOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#kb-reference-of"/>
        <rdfs:label>kb-reference</rdfs:label>
        <skos:altLabel>has-technique-reference</skos:altLabel>
    </owl:ObjectProperty>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#kb-reference-of -->

    <owl:ObjectProperty rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#kb-reference-of">
        <rdfs:subPropertyOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#d3fend-kb-object-property"/>
        <rdfs:range rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CyberTechnique"/>
        <definition>x kb-is-example-of y: The reference x is an example of technique y.</definition>
        <rdfs:label>kb-reference-of</rdfs:label>
        <skos:altLabel>kb-is-example-of</skos:altLabel>
    </owl:ObjectProperty>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#limits -->

    <owl:ObjectProperty rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#limits">
        <rdfs:subPropertyOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#restricts"/>
        <definition>x limits y: The entity x specifies a designated limit beyond which some entity y cannot function or must be terminated.</definition>
        <rdfs:isDefinedBy rdf:resource="http://wordnet-rdf.princeton.edu/id/13781154-n"/>
        <rdfs:label>limits</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://wordnet-rdf.princeton.edu/id/13780436-n"/>
        <skos:altLabel>cutoff</skos:altLabel>
    </owl:ObjectProperty>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#loaded-by -->

    <owl:ObjectProperty rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#loaded-by">
        <rdfs:subPropertyOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#associated-with"/>
        <owl:inverseOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#loads"/>
        <definition>x loaded-by y: The entity x is brought into memory by entity y.</definition>
        <rdfs:label>loaded-by</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#loads -->

    <owl:ObjectProperty rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#loads">
        <rdfs:subPropertyOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#associated-with"/>
        <definition>x loads y: The technique or process x transfers a software from storage y to a computer&apos;s memory for subsequent execution.</definition>
        <rdfs:isDefinedBy rdf:resource="http://wordnet-rdf.princeton.edu/id/02236692-v"/>
        <rdfs:label>loads</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#manages -->

    <owl:ObjectProperty rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#manages">
        <rdfs:subPropertyOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#associated-with"/>
        <definition>x manages y: The technique or agent x watches and directs the use of digital artifact y.</definition>
        <rdfs:isDefinedBy rdf:resource="http://wordnet-rdf.princeton.edu/id/02447914-v"/>
        <rdfs:label>manages</rdfs:label>
        <skos:altLabel>oversees</skos:altLabel>
        <skos:altLabel>supervises</skos:altLabel>
    </owl:ObjectProperty>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#mapped-by -->

    <owl:ObjectProperty rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#mapped-by">
        <rdfs:subPropertyOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#associated-with"/>
        <owl:inverseOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#maps"/>
        <definition>x mapped-by y: The entity x is linked to another entity by entity y.</definition>
        <rdfs:label>mapped-by</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#maps -->

    <owl:ObjectProperty rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#maps">
        <rdfs:subPropertyOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#may-map"/>
        <definition>x maps y: The entity x discovers and records how entity y is arranged and interconnected.</definition>
        <rdfs:label>maps</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#may-access -->

    <owl:ObjectProperty rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#may-access">
        <rdfs:subPropertyOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#may-be-associated-with"/>
        <owl:inverseOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#may-be-accessed-by"/>
        <definition>x may-access y: The entity x may access the thing y; that is, &apos;x accesses y&apos; may be true.</definition>
        <rdfs:label>may-access</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#may-add -->

    <owl:ObjectProperty rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#may-add">
        <rdfs:subPropertyOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#may-be-associated-with"/>
        <definition>x may-add y: The entity x may add the thing y; that is, &apos;x adds y&apos; may be true.</definition>
        <rdfs:label>may-add</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#may-be-accessed-by -->

    <owl:ObjectProperty rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#may-be-accessed-by">
        <rdfs:subPropertyOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#may-be-associated-with"/>
        <rdfs:label>may-be-accessed-by</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#may-be-associated-with -->

    <owl:ObjectProperty rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#may-be-associated-with">
        <rdfs:subPropertyOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#d3fend-object-property"/>
        <definition>x may-be-associated-with y: The subject x and object y may be associated in some way.</definition>
        <rdfs:label>may-be-associated-with</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://wordnet-rdf.princeton.edu/id/13804981-n"/>
    </owl:ObjectProperty>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#may-be-contained-by -->

    <owl:ObjectProperty rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#may-be-contained-by">
        <rdfs:subPropertyOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#may-be-associated-with"/>
        <owl:inverseOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#may-contain"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
        <rdfs:label>may-be-contained-by</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#may-be-created-by -->

    <owl:ObjectProperty rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#may-be-created-by">
        <rdfs:subPropertyOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#may-be-associated-with"/>
        <owl:inverseOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#may-create"/>
        <rdfs:label>may-be-created-by</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#may-be-deceived-by -->

    <owl:ObjectProperty rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#may-be-deceived-by">
        <rdfs:subPropertyOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#attack-may-be-countered-by"/>
        <owl:inverseOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#may-deceive"/>
        <pref-label>may be deceived by</pref-label>
        <rdfs:label>may-be-deceived-by</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#may-be-detected-by -->

    <owl:ObjectProperty rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#may-be-detected-by">
        <rdfs:subPropertyOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#attack-may-be-countered-by"/>
        <owl:inverseOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#may-detect"/>
        <pref-label>may be detected by</pref-label>
        <rdfs:label>may-be-detected-by</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#may-be-evicted-by -->

    <owl:ObjectProperty rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#may-be-evicted-by">
        <rdfs:subPropertyOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#attack-may-be-countered-by"/>
        <owl:inverseOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#may-evict"/>
        <pref-label>may be evicted by</pref-label>
        <rdfs:label>may-be-evicted-by</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#may-be-hardened-against-by -->

    <owl:ObjectProperty rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#may-be-hardened-against-by">
        <rdfs:subPropertyOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#attack-may-be-countered-by"/>
        <owl:inverseOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#may-harden"/>
        <pref-label>may be hardened against by</pref-label>
        <rdfs:label>may-be-hardened-against-by</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#may-be-invoked-by -->

    <owl:ObjectProperty rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#may-be-invoked-by">
        <rdfs:subPropertyOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#may-be-associated-with"/>
        <owl:inverseOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#may-invoke"/>
        <rdfs:label>may-be-invoked-by</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#may-be-isolated-by -->

    <owl:ObjectProperty rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#may-be-isolated-by">
