    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#HardwareCryptographicModule -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#HardwareCryptographicModule"/>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#HardwareDevice -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#HardwareDevice">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#DigitalInformationBearer"/>
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#PhysicalArtifact"/>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#HardwareDeviceBindEvent -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#HardwareDeviceBindEvent">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#HardwareDeviceStateEvent"/>
        <definition>An event where a device is logically bound to a system or process, typically for exclusive use or integration with specific software components.</definition>
        <rdfs:label>Hardware Device Bind Event</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#HardwareDeviceConfiguration -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#HardwareDeviceConfiguration">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#ConfigurationResource"/>
        <definition>Information used to configure the parameters and settings for hardware devices.</definition>
        <rdfs:label>Hardware Device Configuration</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#HardwareDeviceConnectionEvent -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#HardwareDeviceConnectionEvent">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#HardwareDeviceStateEvent"/>
        <definition>An event representing the physical or logical attachment of a device to a system, enabling its operational functionality.</definition>
        <rdfs:label>Hardware Device Connection Event</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#HardwareDeviceDisabledEvent -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#HardwareDeviceDisabledEvent">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#HardwareDeviceStateEvent"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#preceded-by"/>
                <owl:someValuesFrom rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#HardwareDeviceEnabledEvent"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <definition>An event where a device transitions to an inactive or unavailable state, often due to deactivation, failure, or maintenance.</definition>
        <rdfs:label>Hardware Device Disabled Event</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#HardwareDeviceDisconnectionEvent -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#HardwareDeviceDisconnectionEvent">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#HardwareDeviceStateEvent"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#preceded-by"/>
                <owl:someValuesFrom rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#HardwareDeviceConnectionEvent"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <definition>An event representing the removal of a device from a system, ceasing its operational functionality or availability.</definition>
        <rdfs:label>Hardware Device Disconnection Event</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#HardwareDeviceEnabledEvent -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#HardwareDeviceEnabledEvent">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#HardwareDeviceStateEvent"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#preceded-by"/>
                <owl:someValuesFrom rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#HardwareDeviceConnectionEvent"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <definition>An event where a device becomes operational and available for use, typically following initialization, activation, or repair.</definition>
        <rdfs:label>Hardware Device Enabled Event</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#HardwareDeviceEvent -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#HardwareDeviceEvent">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#DigitalEvent"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#has-participant"/>
                <owl:someValuesFrom rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#HardwareDevice"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <definition>An event capturing the existence, state, or interaction of hardware or virtual devices within a system. Device events encompass activities such as discovery, connection, disconnection, operational state changes, or configuration modifications, providing visibility into device behavior and health.</definition>
        <rdfs:label>Hardware Device Event</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#HardwareDeviceMoveEvent -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#HardwareDeviceMoveEvent">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#HardwareDeviceStateEvent"/>
        <definition>An event where a device is relocated or reassigned within a system or network, potentially affecting its operational scope or connectivity.</definition>
        <rdfs:label>Hardware Device Move Event</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#HardwareDeviceStateEvent -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#HardwareDeviceStateEvent">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#HardwareDeviceEvent"/>
        <definition>An event involving a change to a device&apos;s state, such as connection, disconnection, modification, or operational state transitions (e.g., online or offline). Device state events provide visibility into device availability and operational conditions.</definition>
        <rdfs:label>Hardware Device State Event</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#HardwareDeviceUnbindEvent -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#HardwareDeviceUnbindEvent">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#HardwareDeviceStateEvent"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#preceded-by"/>
                <owl:someValuesFrom rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#HardwareDeviceBindEvent"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <definition>An event where a device is logically unbound from a system or process, releasing it from exclusive use or integration.</definition>
        <rdfs:label>Hardware Device Unbind Event</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#HardwareDeviceUpdateEvent -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#HardwareDeviceUpdateEvent">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#HardwareDeviceStateEvent"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#preceded-by"/>
                <owl:someValuesFrom rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#HardwareDeviceConnectionEvent"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <definition>An event capturing updates or changes to a device&apos;s configuration, properties, or state, including firmware updates, reconfigurations, or optimizations.</definition>
        <rdfs:label>Hardware Device Update Event</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#HardwareDriver -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#HardwareDriver">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#DigitalInformationBearer"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#drives"/>
                <owl:someValuesFrom rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#HardwareDevice"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#HardwareTimer -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#HardwareTimer">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#HardwareDevice"/>
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#Timer"/>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#HardwareTimerConfigurationEvent -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#HardwareTimerConfigurationEvent">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#HardwareTimerEvent"/>
        <definition>An event in which a hardware timer&apos;s registers or operational parameters are programmed or modified.</definition>
        <rdfs:label>Hardware Timer Configuration Event</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#HardwareTimerDeviceDriver -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#HardwareTimerDeviceDriver">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#HardwareDriver"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#drives"/>
                <owl:someValuesFrom rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#HardwareTimer"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#HardwareTimerEvent -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#HardwareTimerEvent">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#TimerEvent"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#has-participant"/>
                <owl:someValuesFrom rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#HardwareTimer"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <definition>A timer event involving a physical timer mechanism implemented in hardware components.</definition>
        <rdfs:label>Hardware Timer Event</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#HardwareTimerInterruptEvent -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#HardwareTimerInterruptEvent">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#HardwareTimerEvent"/>
        <definition>An event in which a hardware timer generates an interrupt signal upon expiration or interval completion.</definition>
        <rdfs:label>Hardware Timer Interrupt Event</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#HardwareWatchdogTimer -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#HardwareWatchdogTimer">
