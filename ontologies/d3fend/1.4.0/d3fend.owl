    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#SPARTATactic -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#SPARTATactic">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#SPARTAThing"/>
        <definition>SPARTA Tactics represent the &apos;why&apos; of a SPARTA technique. They denote the tactical goal of a threat actor and the reason for performing a technique.</definition>
        <rdfs:label>SPARTA Tactic</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://sparta.aerospace.org/tactic/SPARTA"/>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#SPARTATechnique -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#SPARTATechnique">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#SPARTAThing"/>
        <definition>SPARTA Techniques represent &apos;how&apos; a threat actor achieves a tactical goal by performing a threat action.</definition>
        <rdfs:label>SPARTA Technique</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://sparta.aerospace.org/technique/SPARTA"/>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#SPARTAThing -->

