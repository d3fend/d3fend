    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#DeonticLogic -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#DeonticLogic">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#ModalLogic"/>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#Dependency -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#Dependency">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#DigitalInformationBearer"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#dependent"/>
