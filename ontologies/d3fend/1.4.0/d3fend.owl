        <narrower rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#ExecutableDenylisting"/>
        <published rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2013-02-28T00:00:00</published>
        <contributor rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#DISA_FSO"/>
        <definition>The organization employs an allow-all, deny-by-exception policy to prohibit the execution of unauthorized software programs on the information system.</definition>
        <rdfs:label>CCI-001767</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CCI-001774_v2022-04-05 -->

    <owl:NamedIndividual rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CCI-001774_v2022-04-05">
        <rdf:type rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CCIControl"/>
