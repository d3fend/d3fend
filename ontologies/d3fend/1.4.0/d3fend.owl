    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#LinearRegression -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#LinearRegression">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#RegressionAnalysis"/>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#LinearRegressionLearning -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#LinearRegressionLearning">
