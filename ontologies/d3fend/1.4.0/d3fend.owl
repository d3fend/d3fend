                <owl:onProperty rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#may-contain"/>
                <owl:someValuesFrom rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#File"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#IntranetMulticastNetworkTraffic -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#IntranetMulticastNetworkTraffic">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#IntranetNetworkTraffic"/>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#IntranetNetwork -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#IntranetNetwork">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#Network"/>
    </owl:Class>
    


