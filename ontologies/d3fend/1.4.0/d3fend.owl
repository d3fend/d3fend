        <contributor rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#DISA_FSO"/>
        <definition>The information system, when transferring information between different security domains, uses organization-defined data type identifiers to validate data essential for information flow decisions.</definition>
        <rdfs:label>CCI-002201</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CCI-002205_v2022-04-05 -->

    <owl:NamedIndividual rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CCI-002205_v2022-04-05">
        <rdf:type rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CCIControl"/>
        <member-of rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CCICatalog_v2022-04-05"/>
