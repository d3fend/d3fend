    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#GetThreadContext -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#GetThreadContext">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#SystemCall"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#queries"/>
                <owl:someValuesFrom rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#Thread"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


