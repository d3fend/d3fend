    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#TA0029">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#ATTACKMobileTactic"/>
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#OffensiveTactic"/>
