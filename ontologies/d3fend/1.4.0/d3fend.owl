    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#LinuxPauseProcess -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#LinuxPauseProcess">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#OSAPISuspendProcess"/>
        <definition>Causes the calling process to sleep until a signal is delivered that either terminates the process or causes the invocation of a signal-catching function.</definition>
        <rdfs:isDefinedBy rdf:resource="https://man7.org/linux/man-pages/man2/pause.2.html"/>
        <rdfs:label>Linux Pause Process</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#LinuxPauseThread -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#LinuxPauseThread">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#OSAPISuspendThread"/>
        <definition>Causes the calling thread to sleep until a signal is delivered that either terminates the thread or causes the invocation of a signal-catching function.</definition>
        <rdfs:isDefinedBy rdf:resource="https://man7.org/linux/man-pages/man2/pause.2.html"/>
        <rdfs:label>Linux Pause Thread</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#LinuxPtraceArgumentPTRACEATTACH -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#LinuxPtraceArgumentPTRACEATTACH">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#OSAPIAccessProcess"/>
        <definition>Attach to the process specified in pid, making it a tracee of the calling process.</definition>
        <rdfs:isDefinedBy rdf:resource="https://man7.org/linux/man-pages/man2/ptrace.2.html"/>
        <rdfs:label>Linux Ptrace Argument PTRACE_ATTACH</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#LinuxPtraceArgumentPTRACECONT -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#LinuxPtraceArgumentPTRACECONT">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#OSAPIResumeProcess"/>
        <definition>Restart the stopped tracee process.</definition>
        <rdfs:isDefinedBy rdf:resource="https://man7.org/linux/man-pages/man2/ptrace.2.html"/>
        <rdfs:label>Linux Ptrace Argument PTRACE_CONT</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#LinuxPtraceArgumentPTRACEGETREGS -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#LinuxPtraceArgumentPTRACEGETREGS">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#OSAPISaveRegisters"/>
        <definition>Copy the tracee&apos;s general-purpose or floating-point registers, respectively, to the address data in the tracer.</definition>
        <rdfs:isDefinedBy rdf:resource="https://man7.org/linux/man-pages/man2/ptrace.2.html"/>
        <rdfs:label>Linux Ptrace Argument PTRACE_GETREGS</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#LinuxPtraceArgumentPTRACEINTERRUPT -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#LinuxPtraceArgumentPTRACEINTERRUPT">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#OSAPISuspendProcess"/>
        <definition>Stops a tracee.</definition>
        <rdfs:isDefinedBy rdf:resource="https://man7.org/linux/man-pages/man2/ptrace.2.html"/>
        <rdfs:label>Linux Ptrace Argument PTRACE_INTERRUPT</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#LinuxPtraceArgumentPTRACEPEEKTEXT -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#LinuxPtraceArgumentPTRACEPEEKTEXT">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#OSAPIReadMemory"/>
        <definition>Read a word at the address addr in the tracee&apos;s memory, returning the word as the result of the ptrace() call.</definition>
        <rdfs:isDefinedBy rdf:resource="https://man7.org/linux/man-pages/man2/ptrace.2.html"/>
        <rdfs:label>Linux Ptrace Argument PTRACE_PEEKTEXT</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#LinuxPtraceArgumentPTRACEPOKETEXT -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#LinuxPtraceArgumentPTRACEPOKETEXT">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#OSAPIWriteMemory"/>
        <definition>Copy the word data to the address addr in the tracee&apos;s memory.</definition>
        <rdfs:isDefinedBy rdf:resource="https://man7.org/linux/man-pages/man2/ptrace.2.html"/>
        <rdfs:label>Linux Ptrace Argument PTRACE_POKETEXT</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#LinuxPtraceArgumentPTRACESETREGS -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#LinuxPtraceArgumentPTRACESETREGS">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#OSAPISetRegisters"/>
        <definition>Modify the tracee&apos;s general-purpose or floating-point registers, respectively, from the address data in the tracer.</definition>
        <rdfs:isDefinedBy rdf:resource="https://man7.org/linux/man-pages/man2/ptrace.2.html"/>
        <rdfs:label>Linux Ptrace Argument PTRACE_SETREGS</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#LinuxPtraceArgumentPTRACE_DETACH -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#LinuxPtraceArgumentPTRACE_DETACH">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#OSAPIResumeProcess"/>
        <definition>Restart the stopped tracee as for PTRACE_CONT, but first detach from it.</definition>
        <rdfs:isDefinedBy rdf:resource="https://man7.org/linux/man-pages/man2/ptrace.2.html"/>
        <rdfs:label>Linux Ptrace Argument PTRACE_DETACH</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#LinuxPtraceArgumentPTRACE_TRACEME -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#LinuxPtraceArgumentPTRACE_TRACEME">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#OSAPITraceProcess"/>
