        <rdfs:seeAlso rdf:resource="https://modbus.org/docs/Modbus_Application_Protocol_V1_1b3.pdf"/>
        <rdfs:seeAlso rdf:resource="https://nvlpubs.nist.gov/nistpubs/TechnicalNotes/NIST.TN.2023.pdf"/>
    </owl:Class>
    


