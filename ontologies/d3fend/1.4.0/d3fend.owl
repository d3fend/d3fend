        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#LogicalLink"/>
        <definition>A communication link between two network devices connected directly at the physical layer and on the same network segment; i.e., an OSI Layer 2 link.</definition>
        <synonym>Data Link Layer Link</synonym>
        <synonym>Layer-2 Link</synonym>
        <synonym>Link Layer Link</synonym>
        <rdfs:label>Data Link Link</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://dbpedia.org/resource/Link_layer"/>
    </owl:Class>
    


