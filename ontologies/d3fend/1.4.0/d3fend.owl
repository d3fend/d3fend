                <owl:someValuesFrom rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#NetworkTraffic"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#has-participant"/>
                <owl:someValuesFrom rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#OTConnectionCommand"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <definition>Establish a network connection with a device.</definition>
        <rdfs:label>OT Connection Command Event</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#OTControlCommand -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#OTControlCommand">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#OTProcessDataCommand"/>
        <definition>Command and control the managed process.</definition>
        <rdfs:comment>CIP: Reset
CIP: Start
CIP: Stop
CIP: Create
CIP: Delete
CIP: Apply Attributes
CIP: Restore
CIP: Save </rdfs:comment>
        <rdfs:comment>GE-SRTP: PLC SHORT STATUS REQUEST</rdfs:comment>
        <rdfs:label>OT Control Command</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://icscsi.org/library/Documents/ICS_Protocols/Control%20Microsystems%20-%20DNP3%20User%20and%20Reference%20Manual.pdf"/>
        <rdfs:seeAlso rdf:resource="https://modbus.org/docs/Modbus_Application_Protocol_V1_1b3.pdf"/>
        <rdfs:seeAlso rdf:resource="https://nvlpubs.nist.gov/nistpubs/TechnicalNotes/NIST.TN.2023.pdf"/>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#OTControlCommandEvent -->

