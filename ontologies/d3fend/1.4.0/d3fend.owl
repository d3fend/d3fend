    </owl:NamedIndividual>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CCI-001019_v2022-04-05 -->

    <owl:NamedIndividual rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CCI-001019_v2022-04-05">
        <rdf:type rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CCIControl"/>
        <member-of rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CCICatalog_v2022-04-05"/>
        <narrower rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#DiskEncryption"/>
        <narrower rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#FileEncryption"/>
        <published rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2009-09-21T00:00:00</published>
        <contributor rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#DISA_FSO"/>
        <definition>The organization employs cryptographic mechanisms to protect information in storage.</definition>
        <rdfs:label>CCI-001019</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CCI-001067_v2022-04-05 -->

    <owl:NamedIndividual rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CCI-001067_v2022-04-05">
        <rdf:type rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CCIControl"/>
        <member-of rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CCICatalog_v2022-04-05"/>
        <narrower rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#PlatformHardening"/>
        <published rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2009-09-21T00:00:00</published>
        <contributor rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#DISA_FSO"/>
        <definition>The information system implements privileged access authorization to organization-identified information system components for selected organization-defined vulnerability scanning activities.</definition>
        <rdfs:label>CCI-001067</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CCI-001069_v2022-04-05 -->

    <owl:NamedIndividual rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CCI-001069_v2022-04-05">
        <rdf:type rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CCIControl"/>
        <member-of rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CCICatalog_v2022-04-05"/>
        <narrower rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#ExecutableAllowlisting"/>
        <narrower rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#ExecutableDenylisting"/>
        <published rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2009-09-21T00:00:00</published>
        <contributor rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#DISA_FSO"/>
        <definition>The organization employs automated mechanisms to detect the presence of unauthorized software on organizational information systems and notify designated organizational officials in accordance with the organization-defined frequency.</definition>
        <rdfs:label>CCI-001069</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CCI-001082_v2022-04-05 -->

    <owl:NamedIndividual rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CCI-001082_v2022-04-05">
        <rdf:type rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CCIControl"/>
        <broader rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#LocalFilePermissions"/>
        <broader rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#SystemConfigurationPermissions"/>
        <member-of rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CCICatalog_v2022-04-05"/>
        <published rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2009-09-21T00:00:00</published>
        <contributor rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#DISA_FSO"/>
        <definition>The information system separates user functionality (including user interface services) from information system management functionality.</definition>
        <rdfs:label>CCI-001082</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CCI-001083_v2022-04-05 -->

    <owl:NamedIndividual rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CCI-001083_v2022-04-05">
        <rdf:type rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CCIControl"/>
        <member-of rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CCICatalog_v2022-04-05"/>
        <narrower rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#LocalFilePermissions"/>
        <narrower rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#SystemConfigurationPermissions"/>
        <published rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2009-09-21T00:00:00</published>
        <contributor rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#DISA_FSO"/>
        <definition>The information system prevents the presentation of information system management-related functionality at an interface for non-privileged users.</definition>
        <rdfs:label>CCI-001083</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CCI-001084_v2022-04-05 -->

    <owl:NamedIndividual rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CCI-001084_v2022-04-05">
        <rdf:type rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CCIControl"/>
        <member-of rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CCICatalog_v2022-04-05"/>
        <narrower rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#SystemConfigurationPermissions"/>
        <published rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2009-09-21T00:00:00</published>
        <contributor rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#DISA_FSO"/>
        <definition>The information system isolates security functions from nonsecurity functions.</definition>
        <rdfs:label>CCI-001084</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CCI-001085_v2022-04-05 -->

    <owl:NamedIndividual rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CCI-001085_v2022-04-05">
        <rdf:type rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CCIControl"/>
        <broader rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#Hardware-basedProcessIsolation"/>
        <member-of rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CCICatalog_v2022-04-05"/>
        <published rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2009-09-21T00:00:00</published>
        <contributor rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#DISA_FSO"/>
        <definition>The information system utilizes underlying hardware separation mechanisms to implement security function isolation.</definition>
        <rdfs:label>CCI-001085</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CCI-001086_v2022-04-05 -->

    <owl:NamedIndividual rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CCI-001086_v2022-04-05">
        <rdf:type rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CCIControl"/>
        <member-of rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CCICatalog_v2022-04-05"/>
        <narrower rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#SystemConfigurationPermissions"/>
        <published rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2009-09-21T00:00:00</published>
        <contributor rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#DISA_FSO"/>
        <definition>The information system isolates security functions enforcing access and information flow control from both nonsecurity functions and from other security functions.</definition>
        <rdfs:label>CCI-001086</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CCI-001087_v2022-04-05 -->

    <owl:NamedIndividual rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CCI-001087_v2022-04-05">
        <rdf:type rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CCIControl"/>
        <member-of rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CCICatalog_v2022-04-05"/>
        <narrower rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#SystemConfigurationPermissions"/>
        <published rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2009-09-21T00:00:00</published>
        <contributor rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#DISA_FSO"/>
        <definition>The organization implements an information system isolation boundary to minimize the number of nonsecurity functions included within the boundary containing security functions.</definition>
        <rdfs:label>CCI-001087</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CCI-001089_v2022-04-05 -->

    <owl:NamedIndividual rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CCI-001089_v2022-04-05">
        <rdf:type rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CCIControl"/>
        <member-of rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CCICatalog_v2022-04-05"/>
        <narrower rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#SystemConfigurationPermissions"/>
        <published rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2009-09-21T00:00:00</published>
        <contributor rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#DISA_FSO"/>
        <definition>The organization implements security functions as a layered structure minimizing interactions between layers of the design and avoiding any dependence by lower layers on the functionality or correctness of higher layers.</definition>
        <rdfs:label>CCI-001089</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CCI-001090_v2022-04-05 -->

    <owl:NamedIndividual rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CCI-001090_v2022-04-05">
        <rdf:type rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CCIControl"/>
        <member-of rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CCICatalog_v2022-04-05"/>
        <narrower rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#NetworkTrafficFiltering"/>
        <published rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2009-09-21T00:00:00</published>
        <contributor rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#DISA_FSO"/>
        <definition>The information system prevents unauthorized and unintended information transfer via shared system resources.</definition>
        <rdfs:label>CCI-001090</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CCI-001092_v2022-04-05 -->

    <owl:NamedIndividual rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CCI-001092_v2022-04-05">
        <rdf:type rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CCIControl"/>
        <member-of rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CCICatalog_v2022-04-05"/>
        <narrower rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#InboundTrafficFiltering"/>
        <narrower rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#OutboundTrafficFiltering"/>
        <published rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2009-09-21T00:00:00</published>
        <contributor rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#DISA_FSO"/>
        <definition>The information system protects against or limits the effects of the organization-defined or referenced types of denial of service attacks.</definition>
        <rdfs:label>CCI-001092</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CCI-001094_v2022-04-05 -->

    <owl:NamedIndividual rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CCI-001094_v2022-04-05">
        <rdf:type rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CCIControl"/>
        <member-of rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CCICatalog_v2022-04-05"/>
        <narrower rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#InboundTrafficFiltering"/>
        <narrower rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#OutboundTrafficFiltering"/>
        <published rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2009-09-21T00:00:00</published>
        <contributor rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#DISA_FSO"/>
        <definition>The information system restricts the ability of individuals to launch organization-defined denial of service attacks against other information systems.</definition>
        <rdfs:label>CCI-001094</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CCI-001096_v2022-04-05 -->

    <owl:NamedIndividual rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CCI-001096_v2022-04-05">
        <rdf:type rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CCIControl"/>
        <member-of rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CCICatalog_v2022-04-05"/>
        <narrower rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#LocalFilePermissions"/>
        <narrower rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#SystemConfigurationPermissions"/>
        <published rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2009-09-21T00:00:00</published>
        <contributor rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#DISA_FSO"/>
        <definition>The information system limits the use of resources by priority.</definition>
        <rdfs:label>CCI-001096</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CCI-001100_v2022-04-05 -->

    <owl:NamedIndividual rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CCI-001100_v2022-04-05">
        <rdf:type rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CCIControl"/>
        <member-of rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CCICatalog_v2022-04-05"/>
        <published rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2009-09-21T00:00:00</published>
        <contributor rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#DISA_FSO"/>
        <definition>The information system prevents public access into the organization&apos;s internal networks except as appropriately mediated by managed interfaces employing boundary protection devices.</definition>
        <rdfs:label>CCI-001100</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CCI-001109_v2022-04-05 -->

    <owl:NamedIndividual rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CCI-001109_v2022-04-05">
        <rdf:type rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CCIControl"/>
        <exactly rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#InboundTrafficFiltering"/>
        <exactly rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#OutboundTrafficFiltering"/>
        <member-of rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CCICatalog_v2022-04-05"/>
        <published rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2009-09-21T00:00:00</published>
        <contributor rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#DISA_FSO"/>
        <definition>The information system at managed interfaces denies network communications traffic by default and allows network communications traffic by exception (i.e., deny all, permit by exception).</definition>
        <rdfs:label>CCI-001109</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CCI-001111_v2022-04-05 -->

    <owl:NamedIndividual rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CCI-001111_v2022-04-05">
        <rdf:type rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CCIControl"/>
        <member-of rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CCICatalog_v2022-04-05"/>
        <narrower rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#InboundTrafficFiltering"/>
        <narrower rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#OutboundTrafficFiltering"/>
        <published rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2009-09-21T00:00:00</published>
        <contributor rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#DISA_FSO"/>
        <definition>The information system prevents remote devices that have established a non-remote connection with the system from communicating outside of that communications path with resources in external networks.</definition>
        <rdfs:label>CCI-001111</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CCI-001115_v2022-04-05 -->

    <owl:NamedIndividual rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CCI-001115_v2022-04-05">
        <rdf:type rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CCIControl"/>
        <member-of rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CCICatalog_v2022-04-05"/>
        <narrower rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#InboundTrafficFiltering"/>
        <narrower rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#OutboundTrafficFiltering"/>
        <published rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2009-09-21T00:00:00</published>
        <contributor rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#DISA_FSO"/>
        <definition>The information system, at managed interfaces, denies network traffic and audits internal users (or malicious code) posing a threat to external information systems.</definition>
        <rdfs:label>CCI-001115</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CCI-001117_v2022-04-05 -->

    <owl:NamedIndividual rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CCI-001117_v2022-04-05">
        <rdf:type rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CCIControl"/>
        <member-of rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CCICatalog_v2022-04-05"/>
        <narrower rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#InboundTrafficFiltering"/>
        <narrower rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#OutboundTrafficFiltering"/>
        <published rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2009-09-21T00:00:00</published>
        <contributor rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#DISA_FSO"/>
        <definition>The information system checks incoming communications to ensure the communications are coming from an authorized source and routed to an authorized destination.</definition>
        <rdfs:label>CCI-001117</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CCI-001118_v2022-04-05 -->

    <owl:NamedIndividual rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CCI-001118_v2022-04-05">
        <rdf:type rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CCIControl"/>
        <broader rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#NetworkIsolation"/>
        <member-of rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CCICatalog_v2022-04-05"/>
        <published rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2009-09-21T00:00:00</published>
        <contributor rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#DISA_FSO"/>
        <definition>The information system implements host-based boundary protection mechanisms for servers, workstations, and mobile devices.</definition>
        <rdfs:label>CCI-001118</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CCI-001124_v2022-04-05 -->

    <owl:NamedIndividual rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CCI-001124_v2022-04-05">
        <rdf:type rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CCIControl"/>
        <broader rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#BroadcastDomainIsolation"/>
        <member-of rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CCICatalog_v2022-04-05"/>
        <published rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2009-09-21T00:00:00</published>
        <contributor rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#DISA_FSO"/>
        <definition>The information system prevents discovery of specific system components composing a managed interface.</definition>
        <rdfs:label>CCI-001124</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CCI-001125_v2022-04-05 -->

    <owl:NamedIndividual rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CCI-001125_v2022-04-05">
        <rdf:type rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CCIControl"/>
        <member-of rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CCICatalog_v2022-04-05"/>
        <narrower rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#InboundTrafficFiltering"/>
        <narrower rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#OutboundTrafficFiltering"/>
