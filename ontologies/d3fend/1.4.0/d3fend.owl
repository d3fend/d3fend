        <contributor rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#DISA_FSO"/>
        <definition>The information system enforces a role-based access control policy over defined subjects and objects.</definition>
        <rdfs:label>CCI-002169</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CCI-002178_v2022-04-05 -->

    <owl:NamedIndividual rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CCI-002178_v2022-04-05">
        <rdf:type rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CCIControl"/>
