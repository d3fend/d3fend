            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#OTControlVariable -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#OTControlVariable">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#OTLogicVariable"/>
        <definition>A control variable is the measurement of the physical condition of the device that influences the Process Variables.</definition>
        <rdfs:isDefinedBy>https://isagca.org/hubfs/2023%20ISA%20Website%20Redesigns/ISAGCA/PDFs/Industrial%20Cybersecurity%20Knowledge%20FINAL.pdf?hsLang=en</rdfs:isDefinedBy>
        <rdfs:label>OT Control Variable</rdfs:label>
        <skos:example>If the Set Point of a temperature control system for a residential dwelling is 72 degrees, and the Process Variable is 82 degrees, the Control Variable for the air conditioner should be &apos;on.&apos;</skos:example>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#OTController -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#OTController">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#OTEmbeddedComputer"/>
        <rdfs:subClassOf>
