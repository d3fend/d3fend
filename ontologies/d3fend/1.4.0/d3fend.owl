    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#ForwardProxyServer -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#ForwardProxyServer">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#ProxyServer"/>
        <definition>An forward (or open) proxy is a proxy server that is accessible by any Internet user. Generally, a proxy server only allows users within a network group (i.e. a closed proxy) to store and forward Internet services such as DNS or web pages to reduce and control the bandwidth used by the group. With an open proxy, however, any user on the Internet is able to use this forwarding service.</definition>
        <rdfs:isDefinedBy rdf:resource="http://dbpedia.org/resource/Open_proxy"/>
        <rdfs:label>Forward Proxy Server</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#ForwardResolutionDomainDenylisting -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#ForwardResolutionDomainDenylisting">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#DNSDenylisting"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#blocks"/>
                <owl:someValuesFrom rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#OutboundInternetDNSLookupTraffic"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#ForwardResolutionIPDenylisting -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#ForwardResolutionIPDenylisting">
