        <rdfs:label>D3FEND Core</rdfs:label>
    </rdf:Description>
    <rdf:Description rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#DBSCAN">
        <definition>A density-based clustering algorithm that works on the assumption that clusters are dense regions in space separated by regions of lower density.</definition>
