                <owl:onProperty rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#modifies"/>
                <owl:someValuesFrom rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CloudConfiguration"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#T1562.009 -->

