                <owl:someValuesFrom rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#Detect"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#MessageAuthentication -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#MessageAuthentication">
