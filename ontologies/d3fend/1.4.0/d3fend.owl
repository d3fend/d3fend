                <owl:someValuesFrom rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#OTControlCommand"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <definition>Command and control the managed process.</definition>
        <rdfs:label>OT Control Command Event</rdfs:label>
    </owl:Class>
    


