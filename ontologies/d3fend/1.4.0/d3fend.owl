        <published rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2009-05-13T00:00:00</published>
        <contributor rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#DISA_FSO"/>
        <definition>The information system enforces organization-defined limitations on the embedding of data types within other data types.</definition>
        <rdfs:label>CCI-000029</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CCI-000030_v2022-04-05 -->

    <owl:NamedIndividual rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CCI-000030_v2022-04-05">
