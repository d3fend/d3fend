    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#ATLASTactic -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#ATLASTactic">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#ATLASThing"/>
        <definition>An ATLAS Tactic is a categorical classification of techniques within the MITRE ATLAS™ framework, representing adversarial goals particular to artificial intelligence systems. It also adapts MITRE ATT&amp;CK® Enterprise Matrix tactics by integrating machine learning concepts, thus capturing the unique motives behind actions in AI-specific operations.</definition>
        <rdfs:label>ATLAS Tactic</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://atlas.mitre.org/tactics"/>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#ATLASTechnique -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#ATLASTechnique">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#ATLASThing"/>
        <definition>An ATLAS Technique is an action conducted by adversaries to accomplish tactical goals within the context of artificial intelligence systems. These techniques articulate both &apos;how&apos; adversaries execute these actions to reach their objectives and &apos;what&apos; outcomes are achieved from these maneuvers.</definition>
        <rdfs:label>ATLAS Technique</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://atlas.mitre.org/techniques"/>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#ATLASThing -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#ATLASThing">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#ExternalThreatModelThing"/>
        <rdfs:label>ATLAS Thing</rdfs:label>
    </owl:Class>
    


