    </rdf:Description>
    <rdf:Description rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#TA0108">
        <rdfs:label>Initial Access - ATTACK ICS</rdfs:label>
        <skos:prefLabel>Initial Access</skos:prefLabel>
    </rdf:Description>
