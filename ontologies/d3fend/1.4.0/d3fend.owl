    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#UserInitScript -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#UserInitScript">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#ExecutableScript"/>
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#InitScript"/>
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#UserLogonInitResource"/>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#UserInputFunction -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#UserInputFunction">
