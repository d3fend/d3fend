    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CCI-001147_v2022-04-05 -->

    <owl:NamedIndividual rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CCI-001147_v2022-04-05">
