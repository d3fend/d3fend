    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#HardwareClockEvent -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#HardwareClockEvent">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#ClockEvent"/>
