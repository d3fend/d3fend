        <contributor rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#DISA_FSO"/>
        <definition>The information system provides a real-time alert in an organization-defined real-time period to organization-defined personnel, roles, and/or locations when organization-defined audit failure events requiring real-time alerts occur.</definition>
        <rdfs:label>CCI-001858</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CCI-001936_v2022-04-05 -->

    <owl:NamedIndividual rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CCI-001936_v2022-04-05">
