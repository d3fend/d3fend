        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#IntranetNetworkTraffic"/>
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#RPCNetworkTraffic"/>
        <definition>Intranet RPC network traffic is network traffic that does not cross a given network&apos;s boundaries and uses a standard remote procedure call (e.g., RFC 1050) protocol.</definition>
        <rdfs:label>Intranet RPC Network Traffic</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dbpedia.org/resource/Intranet"/>
        <rdfs:seeAlso rdf:resource="http://dbpedia.org/resource/Remote_procedure_call"/>
    </owl:Class>
    


