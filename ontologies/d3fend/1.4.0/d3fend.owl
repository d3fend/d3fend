    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#LinuxUnlinkat">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#OSAPIDeleteFile"/>
        <definition>Delete a name and possibly the file it refers to. Different parameter handling than Linux Unlink</definition>
        <rdfs:isDefinedBy rdf:resource="https://man7.org/linux/man-pages/man2/unlinkat.2.html"/>
        <rdfs:label>Linux Unlinkat</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#LinuxVfork -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#LinuxVfork">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#OSAPICreateProcess"/>
        <definition>Create child process that temp suspends parent process until it terminates.</definition>
        <rdfs:isDefinedBy rdf:resource="https://man7.org/linux/man-pages/man2/vfork.2.html"/>
        <rdfs:label>Linux Vfork</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#LinuxWrite -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#LinuxWrite">
