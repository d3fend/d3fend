    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#StackComponent -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#StackComponent">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#DigitalInformationBearer"/>
        <definition>A stack component is any component of a call stack used for stack-based memory allocation in a running process.  Examples include saved instruction pointers, stack frames, and stack frame canaries.</definition>
        <rdfs:label>Stack Component</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dbpedia.org/resource/Call_stack"/>
    </owl:Class>
    


