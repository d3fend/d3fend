    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#Link -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#Link">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#D3FENDCore"/>
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#DigitalInformationBearer"/>
        <definition>A link is a connection or association between two entities that facilitates communication, interaction, or data transfer.</definition>
        <rdfs:label>Link</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://dbpedia.org/resource/Link"/>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#LinuxClone -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#LinuxClone">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#OSAPICreateProcess"/>
        <definition>Creates a child process and provides more precise control over the data shared between the parent and child processes.</definition>
        <rdfs:isDefinedBy rdf:resource="https://man7.org/linux/man-pages/man2/clone.2.html"/>
        <rdfs:label>Linux Clone</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#LinuxClone3 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#LinuxClone3">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#OSAPICreateProcess"/>
        <definition>Creates a child process and provides more precise control over the data shared between the parent and child processes.

Newer system call.</definition>
        <rdfs:isDefinedBy rdf:resource="https://man7.org/linux/man-pages/man2/clone3.2.html"/>
        <rdfs:label>Linux Clone3</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#LinuxClone3ArgumentCLONE_THREAD -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#LinuxClone3ArgumentCLONE_THREAD">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#OSAPICreateThread"/>
        <definition>A flag parameter to the Clone3 syscall. If set, the child is placed in the same thread group as the calling process.</definition>
        <rdfs:isDefinedBy rdf:resource="https://man7.org/linux/man-pages/man2/clone3.2.html"/>
        <rdfs:label>Linux Clone3 Argument CLONE_THREAD</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#LinuxCloneArgumentCLONE_THREAD -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#LinuxCloneArgumentCLONE_THREAD">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#OSAPICreateThread"/>
        <definition>A flag parameter to the Clone syscall. If set, the child is placed in the same thread group as the calling process.</definition>
        <rdfs:isDefinedBy rdf:resource="https://man7.org/linux/man-pages/man2/clone.2.html"/>
        <rdfs:label>Linux Clone Argument CLONE_THREAD</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#LinuxConnect -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#LinuxConnect">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#OSAPIConnectSocket"/>
        <definition>Initiate a connection on a socket.</definition>
        <rdfs:isDefinedBy rdf:resource="https://man7.org/linux/man-pages/man2/connect.2.html"/>
        <rdfs:label>Linux Connect</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#LinuxCreat -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#LinuxCreat">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#OSAPICreateFile"/>
        <definition>Equivalent to calling Linux Open with flags equal to O_CREAT|O_WRONLY|O_TRUNC.</definition>
        <rdfs:isDefinedBy rdf:resource="https://man7.org/linux/man-pages/man2/creat.2.html"/>
        <rdfs:label>Linux Creat</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#LinuxDeleteModule -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#LinuxDeleteModule">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#OSAPIUnloadModule"/>
        <definition>Attempts to remove the unused loadable module entry identified by name. If the module has an exit function, then that function is executed before unloading the module.</definition>
        <rdfs:isDefinedBy rdf:resource="https://man7.org/linux/man-pages/man2/delete_module.2.html"/>
        <rdfs:label>Linux Delete Module</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#LinuxExecve -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#LinuxExecve">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#OSAPIExec"/>
        <definition>Executes a program by replacing the calling process with a new program, with newly initialized stack, heap, and (initialized and uninitialized) data segments. The PID stays the same.</definition>
        <rdfs:isDefinedBy rdf:resource="https://man7.org/linux/man-pages/man2/execve.2.html"/>
        <rdfs:label>Linux Execve</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#LinuxExecveat -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#LinuxExecveat">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#OSAPIExec"/>
        <definition>Execute program relative to a directory file descriptor. Behavior is similar to Linux Execve.</definition>
        <rdfs:isDefinedBy rdf:resource="https://man7.org/linux/man-pages/man2/execveat.2.html"/>
        <rdfs:label>Linux Execveat</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#LinuxFork -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#LinuxFork">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#OSAPICreateProcess"/>
        <definition>Creates a child process with unique PID but retains parent PID as Parent Process Identifier (PPID).</definition>
        <rdfs:isDefinedBy rdf:resource="https://man7.org/linux/man-pages/man2/fork.2.html"/>
        <rdfs:label>Linux Fork</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#LinuxInitModule -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#LinuxInitModule">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#OSAPILoadModule"/>
        <definition>Loads an ELF image into kernel space, performs any necessary symbol relocations, initializes module parameters to values provided by the caller, and then runs the module&apos;s init function.</definition>
        <rdfs:isDefinedBy rdf:resource="https://man7.org/linux/man-pages/man2/init_module.2.html"/>
        <rdfs:label>Linux Init_Module</rdfs:label>
    </owl:Class>
    


