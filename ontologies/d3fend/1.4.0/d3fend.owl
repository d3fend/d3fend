        <pref-label>External Knowledge Base</pref-label>
        <rdfs:label>External Knowledge Base</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#ExternalThing -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#ExternalThing">
        <rdfs:label>External Thing</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#ExternalThreatModelThing -->

