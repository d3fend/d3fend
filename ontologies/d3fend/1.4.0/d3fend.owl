        <rdfs:comment>BACnet: getEnrollmentSummary
BACnet: confirmed-audit-notification
BACnet: audit-log-query
BACnet: unconfirmed-audit-notification </rdfs:comment>
        <rdfs:comment>Modbus: Get Comm. Event Log
Modbus: Return Query Data
Modbus: Clear Counters
Modbus: Get Comm. Event Counters</rdfs:comment>
        <rdfs:label>OT Debug Command</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://icscsi.org/library/Documents/ICS_Protocols/Control%20Microsystems%20-%20DNP3%20User%20and%20Reference%20Manual.pdf"/>
