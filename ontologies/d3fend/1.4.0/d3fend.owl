        <published rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2013-06-24T00:00:00</published>
        <contributor rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#DISA_FSO"/>
        <definition>The information system enforces the revocation of access authorizations resulting from changes to the security attributes of objects based on organization-defined rules governing the timing of revocations of access authorizations.</definition>
        <rdfs:label>CCI-002179</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CCI-002201_v2022-04-05 -->

    <owl:NamedIndividual rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CCI-002201_v2022-04-05">
        <rdf:type rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CCIControl"/>
