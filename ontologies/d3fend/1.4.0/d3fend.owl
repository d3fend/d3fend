    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#ConsoleOutputFunction">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#Subroutine"/>
        <definition>Outputs characters to a computer console.</definition>
        <rdfs:label>Console Output Function</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#ContainerBuildTool -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#ContainerBuildTool">
