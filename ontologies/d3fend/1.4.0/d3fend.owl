                <owl:someValuesFrom rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#OperatingSystemClock"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <definition>An event in which the operating system&apos;s primary timekeeping value is modified or synchronized.</definition>
        <rdfs:label>System Clock Update Event</rdfs:label>
    </owl:Class>
    


