    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#SafeMode -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#SafeMode">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#OperatingMode"/>
        <definition>An intentionally constrained operating mode of a system in which nonessential functions are disabled or limited and control is shifted to a minimal, well-tested configuration that prioritizes preventing harm (to the system, its environment, or data), maintaining basic stability and monitoring, and enabling diagnosis and recovery back to normal operation.</definition>
        <rdfs:label>Safe Mode</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dbpedia.org/resource/Safe_mode"/>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#Satellite -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#Satellite">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#Spacecraft"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#may-contain"/>
                <owl:someValuesFrom rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#SatelliteTransponder"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <definition>A satellite or an artificial satellite is an object, typically a spacecraft, placed into orbit around a celestial body. They have a variety of uses, including communication relay, weather forecasting, navigation (GPS), broadcasting, scientific research, and Earth observation.</definition>
        <rdfs:isDefinedBy rdf:resource="http://dbpedia.org/resource/Satellite"/>
        <rdfs:label>Satellite</rdfs:label>
    </owl:Class>
    


