        <definition>Write to a file descriptor.</definition>
        <rdfs:isDefinedBy rdf:resource="https://man7.org/linux/man-pages/man2/write.2.html"/>
        <rdfs:label>Linux Write</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#LinuxWritev -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#LinuxWritev">
