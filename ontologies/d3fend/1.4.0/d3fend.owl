        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#FileMetadata"/>
        <definition>The content of a header block not including the signature.</definition>
        <rdfs:label>File Header Block Content</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#FileHeaderBlockSignature -->

