                <owl:someValuesFrom rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#OTWriteCommand"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <definition>Write or store data.</definition>
        <rdfs:label>OT Write Command Event</rdfs:label>
    </owl:Class>
    


