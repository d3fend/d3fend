    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#OutboundInternetWebTraffic">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#OutboundInternetNetworkTraffic"/>
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#WebNetworkTraffic"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#may-contain"/>
                <owl:someValuesFrom rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#URL"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


