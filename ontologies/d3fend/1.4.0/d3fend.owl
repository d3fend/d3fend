    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#SlowSymbolicLink -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#SlowSymbolicLink">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#SymbolicLink"/>
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#UnixLink"/>
        <definition>A slow symbolic link is any symbolic link on a Unix filesystem that is not a fast symbolic link; slow symlink is thus retroactively termed from fast symlink.  Slow symbolic links stored the symbolic link information as data in regular files.</definition>
        <rdfs:label>Slow Symbolic Link</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dbpedia.org/resource/Symbolic_link#Storage_of_symbolic_links"/>
        <skos:altLabel>Slow Symlink</skos:altLabel>
    </owl:Class>
    


