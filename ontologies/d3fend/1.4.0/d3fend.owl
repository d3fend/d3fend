            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#T1135 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#T1135">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#DiscoveryTechnique"/>
        <attack-id>T1135</attack-id>
        <definition>Adversaries may look for folders and drives shared on remote systems as a means of identifying sources of information to gather as a precursor for Collection and to identify potential systems of interest for Lateral Movement. Networks often contain shared network drives and folders that enable users to access file directories on various systems across a network.</definition>
        <rdfs:label>Network Share Discovery</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#T1136 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#T1136">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#PersistenceTechnique"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#creates"/>
                <owl:someValuesFrom rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#UserAccount"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#T1136.001 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#T1136.001">
