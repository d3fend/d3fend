        <rdfs:label>User Application</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dbpedia.org/resource/Enterprise_software"/>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#UserBehavior -->

