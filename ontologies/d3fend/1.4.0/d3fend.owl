        <published rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2009-09-22T00:00:00</published>
        <contributor rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#DISA_FSO"/>
        <definition>The organization employs automated mechanisms on an organization-defined frequency to determine the state of information system components with regard to flaw remediation.</definition>
        <rdfs:label>CCI-001233</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CCI-001237_v2022-04-05 -->

    <owl:NamedIndividual rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CCI-001237_v2022-04-05">
