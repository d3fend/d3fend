    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#MailService -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#MailService">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#NetworkService"/>
        <definition>A mail service provides the ability to send and receive mail across a computer network.  The mail service runs on message transfer agents (i.e., mail servers) and is accessed by users through an email client.</definition>
        <rdfs:label>Mail Service</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dbpedia.org/resource/Email"/>
        <rdfs:seeAlso rdf:resource="http://dbpedia.org/resource/Message_transfer_agent"/>
        <skos:altLabel>Email Service</skos:altLabel>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#Matching -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#Matching">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#AnalyticalPurpose"/>
        <rdfs:label>Matching</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#MathematicalFunction -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#MathematicalFunction">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#Subroutine"/>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#Maximum-marginLearning -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#Maximum-marginLearning">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#IntrinsicallySemi-supervisedLearning"/>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#Mean -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#Mean">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CentralTendency"/>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#MeanAbsoluteDeviation -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#MeanAbsoluteDeviation">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#AverageAbsoluteDeviation"/>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#MediaGeneration -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#MediaGeneration">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#Generation"/>
        <owl:disjointWith rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#Simulation"/>
        <rdfs:label>Media Generation</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#MediaServer -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#MediaServer">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#Server"/>
        <definition>A media server is a computer appliance or an application software that stores digital media (video, audio or images) and makes it available over a network. Media servers range from servers that provide video on demand to smaller personal computers or NAS (Network Attached Storage) for the home.</definition>
        <rdfs:isDefinedBy rdf:resource="http://dbpedia.org/resource/Media_server"/>
        <rdfs:label>Media Server</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#Median -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#Median">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CentralTendency"/>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#MedianAbsoluteDeviation -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#MedianAbsoluteDeviation">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#AverageAbsoluteDeviation"/>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#MemoryAddress -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#MemoryAddress">
