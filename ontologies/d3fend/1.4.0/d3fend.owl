    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#NetworkAudioStreamingResource -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#NetworkAudioStreamingResource">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#NetworkMediaStreamingResource"/>
