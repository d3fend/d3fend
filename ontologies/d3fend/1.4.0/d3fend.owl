                <owl:someValuesFrom rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#OTWriteCommand"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#OTWatchdogTimer -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#OTWatchdogTimer">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#OTProcessVariable"/>
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#SoftwareWatchdogTimer"/>
        <definition>An OT Watchdog Timer is a software-based monitoring mechanism used in operational technology (OT) environments to continuously supervise the execution and responsiveness of critical control applications, devices, or communication links. It operates by requiring periodic “heartbeat” signals or status updates from monitored processes within a defined time window; if these signals are not received on time (indicating a hang, fault, or abnormal delay) the OT Watchdog Timer automatically triggers predefined safety or recovery actions, such as placing equipment in a fail-safe state, restarting services, generating alarms, or initiating controlled shutdowns.</definition>
        <rdfs:label>OT Watchdog Timer</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://literature.rockwellautomation.com/idc/groups/literature/documents/pm/1756-pm005_-en-p.pdf"/>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#OTWriteCommand -->

