        <broader rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#NetworkTrafficAnalysis"/>
        <broader rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#PlatformMonitoring"/>
