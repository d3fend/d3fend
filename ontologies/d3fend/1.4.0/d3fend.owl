        <definition>An administrative event where authorization is given, allowing a subject to perform specific operations on a protected resource, effectuating a policy decision to allow access rights.</definition>
        <rdfs:label>Permission Granting Event</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://schema.ocsf.io/classes/user_access"/>
