        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#OSAPIOpenFile"/>
        <definition>Same functionality as Linux Open but slight differences in parameter.</definition>
        <rdfs:isDefinedBy rdf:resource="https://man7.org/linux/man-pages/man2/openat.2.html"/>
