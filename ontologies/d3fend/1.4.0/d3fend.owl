    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#BarcodeScannerInputDevice -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#BarcodeScannerInputDevice">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#ImageScannerInputDevice"/>
        <definition>A barcode reader (or barcode scanner) is an optical scanner that can read printed barcodes, decode the data contained in the barcode and send the data to a computer. Like a flatbed scanner, it consists of a light source, a lens and a light sensor translating for optical impulses into electrical signals. Additionally, nearly all barcode readers contain decoder circuitry that can analyze the barcode&apos;s image data provided by the sensor and sending the barcode&apos;s content to the scanner&apos;s output port.</definition>
        <rdfs:isDefinedBy rdf:resource="http://dbpedia.org/resource/Barcode_reader"/>
        <rdfs:label>Barcode Scanner Input Device</rdfs:label>
        <skos:altLabel>Barcode Reader</skos:altLabel>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#BayesOptimalClassifier -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#BayesOptimalClassifier">
