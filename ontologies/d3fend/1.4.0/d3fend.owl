    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#RadioModem -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#RadioModem">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#Modem"/>
        <definition>A radio modem provides the means to send digital data wirelessly.  Radio modems are used to communicate by direct broadcast satellite, WiFi, WiMax, mobile phones, GPS, Bluetooth and NFC. Modern telecommunications and data networks also make extensive use of radio modems where long distance data links are required. Such systems are an important part of the PSTN, and are also in common use for high-speed computer network links to outlying areas where fiber optic is not economical.</definition>
        <rdfs:isDefinedBy rdf:resource="http://dbpedia.org/resource/Modem#Radio"/>
        <rdfs:label>Radio Modem</rdfs:label>
    </owl:Class>
    


