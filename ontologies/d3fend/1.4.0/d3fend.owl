    <rdf:Description rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#Dependency">
        <definition>A dependency is the relationship of relying on or being controlled by someone or something else.  This class reifies dependencies that correspond to the object property depends-on.</definition>
        <rdfs:label>Dependency</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://wordnet-rdf.princeton.edu/id/14024833-n"/>
