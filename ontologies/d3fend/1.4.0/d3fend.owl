                <owl:someValuesFrom rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#OffensiveTactic"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#initiates"/>
                <owl:someValuesFrom rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#Access"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <display-baseurl>/offensive-technique/attack/</display-baseurl>
        <rdfs:isDefinedBy rdf:resource="https://attack.mitre.org/docs/ATTACK_Design_and_Philosophy_March_2020.pdf"/>
        <rdfs:label>Offensive Technique</rdfs:label>
    </owl:Class>
    


