        <definition>A software build tool that creates a container (e.g., Docker container) for deployment.</definition>
        <rdfs:label>Container Build Tool</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#ContainerImage -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#ContainerImage">
