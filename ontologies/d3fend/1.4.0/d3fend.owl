    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CollaborativeSoftware -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CollaborativeSoftware">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#UserApplication"/>
        <definition>Collaborative software or groupware is application software designed to help people working on a common task to attain their goals. One of the earliest definitions of groupware is &quot;intentional group processes plus software to support them&quot;. Collaborative software is a broad concept that overlaps considerably with computer-supported cooperative work (CSCW). According to Carstensen and Schmidt (1999) groupware is part of CSCW. The authors claim that CSCW, and thereby groupware, addresses &quot;how collaborative activities and their coordination can be supported by means of computer systems.&quot;</definition>
        <rdfs:isDefinedBy rdf:resource="http://dbpedia.org/resource/Collaborative_software"/>
        <rdfs:label>Collaborative Software</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CollectionTechnique -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CollectionTechnique">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#ATTACKEnterpriseTechnique"/>
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#OffensiveTechnique"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#enables"/>
                <owl:someValuesFrom rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#TA0009"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CombinationLock -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CombinationLock">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#PhysicalLock"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#uses"/>
                <owl:someValuesFrom rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#Password"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <definition>A combination lock is a type of locking device in which a sequence of symbols, usually numbers, is used to open the lock.</definition>
        <rdfs:isDefinedBy rdf:resource="https://dbpedia.org/resource/Combination_lock"/>
        <rdfs:label>Combination Lock</rdfs:label>
        <rdfs:seeAlso>Federal Specification FL-L-2937</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#Command -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#Command">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#DigitalInformation"/>
        <definition>A directive (i.e., an instruction specifying a procedure) which, when issued to a computer system, software, or hardware component, causes that entity to execute a specific action, operation, or computation.</definition>
        <rdfs:isDefinedBy rdf:resource="http://dbpedia.org/resource/Command_(computing)"/>
        <rdfs:label>Command</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CommandAndControlTechnique -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CommandAndControlTechnique">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#ATTACKEnterpriseTechnique"/>
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#OffensiveTechnique"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#enables"/>
                <owl:someValuesFrom rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#TA0011"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CommandHistoryLog -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CommandHistoryLog">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#EventLog"/>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CommandHistoryLogFile -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CommandHistoryLogFile">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#LogFile"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#contains"/>
                <owl:someValuesFrom rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CommandHistoryLog"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CommandLineInterface -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CommandLineInterface">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#UserInterface"/>
        <definition>A command-line interface or command language interpreter (CLI), also known as command-line user interface, console user interface, and character user interface (CUI), is a means of interacting with a computer program where the user (or client) issues commands to the program in the form of successive lines of text (command lines). Command-line interfaces to computer operating systems are less widely used by casual computer users, who favor graphical user interfaces. Programs with command-line interfaces are generally easier to automate via scripting.</definition>
        <rdfs:isDefinedBy rdf:resource="http://dbpedia.org/resource/Command-line_interface"/>
        <rdfs:label>Command Line Interface</rdfs:label>
        <skos:altLabel>CLI</skos:altLabel>
        <skos:altLabel>CUI</skos:altLabel>
        <skos:altLabel>Command-line Interface</skos:altLabel>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CommonAttackPattern -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CommonAttackPattern">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CAPECThing"/>
        <definition>A common attack pattern that is in the CAPEC knowledge base.</definition>
        <rdfs:label>Common Attack Pattern</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#Compiler -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#Compiler">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#BuildTool"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#reads"/>
                <owl:someValuesFrom rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CompilerConfigurationFile"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CompilerConfigurationFile -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CompilerConfigurationFile">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#ApplicationConfigurationFile"/>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#ComputeDeviceEvent -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#ComputeDeviceEvent">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#HardwareDeviceEvent"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#has-participant"/>
                <owl:someValuesFrom rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#Processor"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <definition>An event capturing the operation, state, or performance of computational hardware, such as CPUs, GPUs, or accelerators. These events reflect processing capacity changes, utilization anomalies, or device health.</definition>
        <rdfs:label>Compute Device Event</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#ComputerCabinet -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#ComputerCabinet">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#ComputerEnclosure"/>
        <definition>A computer cabinet houses one or more computers and can range in size and material.</definition>
        <rdfs:label>Computer Cabinet</rdfs:label>
        <rdfs:seeAlso>IEEE C37.20.2</rdfs:seeAlso>
        <rdfs:seeAlso>https://dbpedia.org/page/Computer_cabinet</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#ComputerCase -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#ComputerCase">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#ComputerEnclosure"/>
        <definition>A computer case is a computer enclosure which encloses a single primary computer.</definition>
        <rdfs:label>Computer Case</rdfs:label>
        <rdfs:seeAlso>https://dbpedia.org/page/Computer_case</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#ComputerEnclosure -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#ComputerEnclosure">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#PhysicalArtifact"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#contains"/>
                <owl:someValuesFrom rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#ComputerPlatform"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#may-contain"/>
                <owl:someValuesFrom rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#PhysicalLock"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#ComputerNetworkNode -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#ComputerNetworkNode">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#ComputerPlatform"/>
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#NetworkNode"/>
        <definition>A network node running on a computer platform.</definition>
        <rdfs:label>Computer Network Node</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://schema.ocsf.io/objects/network_endpoint"/>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#ComputerPlatform -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#ComputerPlatform">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#DigitalInformationBearer"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#contains"/>
                <owl:someValuesFrom rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#Firmware"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#contains"/>
                <owl:someValuesFrom rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#HardwareDevice"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#contains"/>
                <owl:someValuesFrom rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#OperatingSystem"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#contains"/>
                <owl:someValuesFrom rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#SystemPlatformVariable"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#ComputingImage -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#ComputingImage">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#DigitalInformationBearer"/>
        <definition>A computing image captures the full state or contents of a computing entity, such as a process or volume.</definition>
        <rdfs:isDefinedBy rdf:resource="http://dbpedia.org/resource/System_image#Process_images"/>
        <rdfs:label>Computing Image</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#ComputingServer -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#ComputingServer">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#Server"/>
        <definition>A compute server is a system specifically designed to undertake large amounts of computation, usually but not necessarily in a client/server environment.</definition>
        <rdfs:isDefinedBy rdf:resource="https://www.encyclopedia.com/computing/dictionaries-thesauruses-pictures-and-press-releases/compute-server"/>
        <rdfs:label>Computing Server</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#ComputingSnapshot -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#ComputingSnapshot">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#DigitalInformationBearer"/>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#Condition -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#Condition">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#D3FENDCore"/>
        <definition>An assumption on which rests the validity or effect of something else.</definition>
        <rdfs:comment>Less common usage versus state, meant to superclass precondition, postcondition, and effect.</rdfs:comment>
        <rdfs:isDefinedBy>n-06768279</rdfs:isDefinedBy>
        <rdfs:label>Condition</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#ConfigurationDatabase -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#ConfigurationDatabase">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#ConfigurationResource"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#contains"/>
                <owl:someValuesFrom rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#ConfigurationDatabaseRecord"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#ConfigurationDatabaseRecord -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#ConfigurationDatabaseRecord">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#ConfigurationResource"/>
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#DatabaseRecord"/>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#ConfigurationEvent -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#ConfigurationEvent">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#DigitalEvent"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#has-participant"/>
                <owl:someValuesFrom rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#ConfigurationResource"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <definition>A discrete event that creates, applies, modifies, or deletes configuration resources to determine or alter the function of a system, device, application, or service.</definition>
        <rdfs:label>Configuration Event</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#ConfigurationFile -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#ConfigurationFile">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#File"/>
        <definition>A file containing Information used to configure the parameters and initial settings for some computer programs. They are used for user applications, server processes and operating system settings.</definition>
        <rdfs:isDefinedBy rdf:resource="http://dbpedia.org/resource/Configuration_file"/>
        <rdfs:label>Configuration File</rdfs:label>
        <skos:altLabel>Settings File</skos:altLabel>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#ConfigurationInventory -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#ConfigurationInventory">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#AssetInventory"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#inventories"/>
                <owl:someValuesFrom rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#ConfigurationResource"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#ConfigurationManagementDatabase -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#ConfigurationManagementDatabase">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#ConfigurationDatabase"/>
        <definition>A database used to store configuration records throughout their lifecycle. The Configuration Management System (CMS) maintains one or more CMDBs, and each CMDB stores attributes of configuration items (CIs), and relationships with other CIs.</definition>
        <rdfs:isDefinedBy rdf:resource="https://web.archive.org/web/20111201040529/http://www.best-management-practice.com/gempdf/itil_glossary_v3_1_24.pdf"/>
        <rdfs:label>Configuration Management Database</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://dbpedia.org/resource/Configuration_management_database"/>
        <rdfs:seeAlso rdf:resource="https://wiki.en.it-processmaps.com/index.php/ITIL_Glossary/_ITIL_Terms_C#Config_Management_Database_.28CMDB.29"/>
        <rdfs:seeAlso rdf:resource="https://www.dmtf.org/standards/cmdbf"/>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#ConfigurationModificationEvent -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#ConfigurationModificationEvent">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#ConfigurationEvent"/>
        <definition>An event that changes the persisted state of configuration resources by adding, updating, or removing parameters, impacting the target component&apos;s behavior.</definition>
        <rdfs:label>Configuration Modification Event</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#ConfigurationResource -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#ConfigurationResource">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#Resource"/>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#ConnectSocket -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#ConnectSocket">
