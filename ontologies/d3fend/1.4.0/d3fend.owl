    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#Group -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#Group">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#D3FENDCore"/>
        <rdfs:label>Group</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#GroupCreationEvent -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#GroupCreationEvent">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#GroupManagementEvent"/>
        <definition>An event where a new group is established within the system, defining an entity to manage users and permissions collectively.</definition>
        <rdfs:label>Group Creation Event</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#GroupDeletionEvent -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#GroupDeletionEvent">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#GroupManagementEvent"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#preceded-by"/>
                <owl:someValuesFrom rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#GroupCreationEvent"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <definition>An event where an existing group is permanently removed from the system, dissolving its associated memberships and privileges.</definition>
        <rdfs:label>Group Deletion Event</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#GroupManagementEvent -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#GroupManagementEvent">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#DigitalEvent"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#has-participant"/>
                <owl:someValuesFrom rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#AccessControlGroup"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <definition>An event involving the creation, modification, or deletion of a group, or changes to its membership and privileges. Group management events facilitate the enforcement of role-based access control by organizing users and permissions into logical units for streamlined administration and policy enforcement.</definition>
        <rdfs:label>Group Management Event</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://schema.ocsf.io/classes/group_management"/>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#GroupPolicy -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#GroupPolicy">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#AccessControlConfiguration"/>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#Grouping -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#Grouping">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#Summarizing"/>
        <rdfs:label>Grouping</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#GuidelineReference -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#GuidelineReference">
