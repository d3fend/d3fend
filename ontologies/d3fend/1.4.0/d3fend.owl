    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#ProxyServer">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#ComputerNetworkNode"/>
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#Server"/>
        <definition>In computer networking, a proxy server is a server application or appliance that acts as an intermediary for requests from clients seeking resources from servers that provide those resources. A proxy server thus functions on behalf of the client when requesting service, potentially masking the true origin of the request to the resource server.</definition>
        <rdfs:isDefinedBy rdf:resource="http://dbpedia.org/resource/Proxy_server"/>
        <rdfs:label>Proxy Server</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://schema.ocsf.io/objects/network_proxy"/>
    </owl:Class>
    


