        <contributor rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#DISA_FSO"/>
        <definition>The information system uniquely identifies and authenticates destination by organization, system, application, and/or individual for information transfer.</definition>
        <rdfs:label>CCI-002207</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CCI-002211_v2022-04-05 -->

    <owl:NamedIndividual rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CCI-002211_v2022-04-05">
        <rdf:type rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CCIControl"/>
        <member-of rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CCICatalog_v2022-04-05"/>
        <narrower rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#InboundTrafficFiltering"/>
        <narrower rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#OutboundTrafficFiltering"/>
        <published rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2013-06-24T00:00:00</published>
        <contributor rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#DISA_FSO"/>
        <definition>The information system, when transferring information between different security domains, applies the same security policy filtering to metadata as it applies to data payloads.</definition>
        <rdfs:label>CCI-002211</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CCI-002218_v2022-04-05 -->

    <owl:NamedIndividual rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CCI-002218_v2022-04-05">
        <rdf:type rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CCIControl"/>
        <member-of rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CCICatalog_v2022-04-05"/>
        <narrower rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#DomainTrustPolicy"/>
        <published rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2013-06-24T00:00:00</published>
        <contributor rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#DISA_FSO"/>
        <definition>The information system provides access from a single device to computing platforms, applications, or data residing on multiple different security domains, while preventing any information flow between the different security domains.</definition>
        <rdfs:label>CCI-002218</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CCI-002233_v2022-04-05 -->

    <owl:NamedIndividual rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CCI-002233_v2022-04-05">
        <rdf:type rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CCIControl"/>
        <member-of rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CCICatalog_v2022-04-05"/>
        <narrower rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#ExecutableDenylisting"/>
        <published rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2013-06-24T00:00:00</published>
        <contributor rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#DISA_FSO"/>
        <definition>The information system prevents organization-defined software from executing at higher privilege levels than users executing the software.</definition>
        <rdfs:label>CCI-002233</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CCI-002235_v2022-04-05 -->

    <owl:NamedIndividual rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CCI-002235_v2022-04-05">
        <rdf:type rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CCIControl"/>
        <member-of rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CCICatalog_v2022-04-05"/>
        <narrower rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#SystemConfigurationPermissions"/>
        <published rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2013-06-24T00:00:00</published>
        <contributor rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#DISA_FSO"/>
        <definition>The information system prevents non-privileged users from executing privileged functions to include disabling, circumventing, or altering implemented security safeguards/countermeasures.</definition>
        <rdfs:label>CCI-002235</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CCI-002238_v2022-04-05 -->

    <owl:NamedIndividual rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CCI-002238_v2022-04-05">
        <rdf:type rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CCIControl"/>
        <member-of rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CCICatalog_v2022-04-05"/>
        <narrower rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#AccountLocking"/>
        <published rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2013-06-24T00:00:00</published>
        <contributor rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#DISA_FSO"/>
        <definition>The information system automatically locks the account or node for either an organization-defined time period, until the locked account or node is released by an administrator, or delays the next logon prompt according to the organization-defined delay algorithm when the maximum number of unsuccessful logon attempts is exceeded.</definition>
        <rdfs:label>CCI-002238</rdfs:label>
    </owl:NamedIndividual>
    


