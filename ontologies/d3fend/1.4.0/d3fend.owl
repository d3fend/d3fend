    <rdf:Description rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#PrivateKey">
        <definition>A private key can be used to decrypt messages encrypted using the corresponding public key, or used to sign a message that can be authenticated with the corresponding public key.</definition>
