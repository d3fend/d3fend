                <owl:someValuesFrom rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#Directory"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#NetworkEvent -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#NetworkEvent">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#DigitalEvent"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#has-participant"/>
                <owl:someValuesFrom rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#NetworkTraffic"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <definition>An event involving network communications within or between digital systems.</definition>
        <rdfs:label>Network Event</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://schema.ocsf.io/categories/network"/>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#NetworkFileResource -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#NetworkFileResource">
