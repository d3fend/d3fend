        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#OffensiveTactic"/>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#TCPEvent -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#TCPEvent">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#TransportLayerEvent"/>
        <definition>An event involving the Transmission Control Protocol (TCP), providing reliable, ordered, and error-checked delivery of data between applications.</definition>
        <rdfs:label>TCP Event</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#TFTPNetworkTraffic -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#TFTPNetworkTraffic">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#NetworkTraffic"/>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#TFTPServer -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#TFTPServer">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#Server"/>
        <definition>Trivial File Transfer Protocol (TFTP) is a simple file transfer protocol, typically used to automatically transfer configuration or boot files between machines.  It is used where user authentication and directory visibility are not required.</definition>
        <rdfs:isDefinedBy rdf:resource="http://dbpedia.org/resource/Trivial_File_Transfer_Protocol"/>
        <rdfs:label>TFTP Server</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#TPMBootIntegrity -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#TPMBootIntegrity">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#PlatformHardening"/>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#TabletComputer -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#TabletComputer">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#PersonalComputer"/>
        <definition>A tablet computer, commonly shortened to tablet, is a mobile device, typically with a mobile operating system and touchscreen display processing circuitry, and a rechargeable battery in a single, thin and flat package. Tablets, being computers, do what other personal computers do, but lack some input/output (I/O) abilities that others have. Modern tablets largely resemble modern smartphones, the only differences being that tablets are relatively larger than smartphones, with screens 7 inches (18 cm) or larger, measured diagonally, and may not support access to a cellular network.</definition>
        <rdfs:isDefinedBy rdf:resource="http://dbpedia.org/resource/Tablet_computer"/>
        <rdfs:label>Tablet Computer</rdfs:label>
        <skos:altLabel>Tablet</skos:altLabel>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#TargetAudience -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#TargetAudience">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#AgentGroup"/>
        <rdfs:label>Target Audience</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#Technique -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#Technique">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#Plan"/>
        <rdfs:label>Technique</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#TechniqueReference -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#TechniqueReference">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#D3FENDKBThing"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#kb-reference-of"/>
                <owl:someValuesFrom rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#DefensiveTechnique"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#has-link"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#anyURI"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#kb-reference-title"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <definition>A reference used to develop KB articles.</definition>
        <pref-label>Technique Reference</pref-label>
        <rdfs:label>Technique Reference</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#Telecommand -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#Telecommand">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#RemoteCommand"/>
        <definition>A telecommand or telecontrol is a command sent to control a remote system or systems not directly connected (e.g. via wires) to the place from which the telecommand is sent.</definition>
        <synonym>Remote Control Command</synonym>
        <rdfs:isDefinedBy rdf:resource="http://dbpedia.org/resource/Telecommand"/>
        <rdfs:label>Telecommand</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#TemporalDifferenceLearning -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#TemporalDifferenceLearning">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#Model-freeReinforcementLearning"/>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#TemporalLogic -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#TemporalLogic">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#ModalLogic"/>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#TerminateProcess -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#TerminateProcess">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#SystemCall"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#terminates"/>
                <owl:someValuesFrom rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#Process"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#TertiaryStorage -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#TertiaryStorage">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#HardwareDevice"/>
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#SecondaryStorage"/>
        <definition>Tertiary storage or tertiary memory is memory primarily used for archiving rarely accessed information. It is primarily useful for extraordinarily large data stores. Typical examples include tape libraries and optical jukeboxes.</definition>
        <rdfs:isDefinedBy rdf:resource="https://en.wikipedia.org/wiki/Computer_data_storage#Tertiary_storage"/>
        <rdfs:label>Tertiary Storage</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#TestExecutionTool -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#TestExecutionTool">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#DeveloperApplication"/>
        <definition>A test execution tool is a type of software used to test software, hardware or complete systems.  Synonyms of test execution tool include test execution engine, test executive, test manager, test sequencer.  Two common forms in which a test execution engine may appear are as a: (a) module of a test software suite (test bench) or an integrated development environment, or (b) stand-alone application software.</definition>
        <rdfs:isDefinedBy rdf:resource="http://dbpedia.org/resource/Test_execution_engine"/>
        <rdfs:label>Test Execution Tool</rdfs:label>
        <skos:altLabel>Test Execution Engine</skos:altLabel>
        <skos:altLabel>Test Executive</skos:altLabel>
        <skos:altLabel>Test Manager</skos:altLabel>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#ThinClientComputer -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#ThinClientComputer">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#SharedComputer"/>
        <definition>A thin client is a lightweight computer that has been optimized for establishing a remote connection with a server-based computing environment. The server does most of the work, which can include launching software programs, performing calculations, and storing data. This contrasts with a fat client or a conventional personal computer; the former is also intended for working in a client-server model but has significant local processing power, while the latter aims to perform its function mostly locally. Thin clients are shared computers as the thin client&apos;s computing resources are provided by a remote server.</definition>
        <rdfs:isDefinedBy rdf:resource="http://dbpedia.org/resource/Thin_client"/>
        <rdfs:label>Thin Client Computer</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#Thread -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#Thread">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#DigitalInformationBearer"/>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#ThreadStartFunction -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#ThreadStartFunction">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#Subroutine"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#executes"/>
                <owl:someValuesFrom rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#Thread"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#TicketGrantingTicket -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#TicketGrantingTicket">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#AccessToken"/>
        <definition>In some computer security systems, a Ticket Granting Ticket or Ticket to Get Tickets (TGT) is a small, encrypted identification file with a limited validity period. After authentication, this file is granted to a user for data traffic protection by the key distribution center (KDC) subsystem of authentication services such as Kerberos. The TGT file contains the session key, its expiration date, and the user&apos;s IP address, which protects the user from man-in-the-middle attacks. The TGT is used to obtain a service ticket from Ticket Granting Service (TGS). User is granted access to network services only after this service ticket is provided.</definition>
        <rdfs:isDefinedBy rdf:resource="http://dbpedia.org/resource/Ticket_Granting_Ticket"/>
        <rdfs:label>Ticket Granting Ticket</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dbpedia.org/resource/Charlie_and_the_Chocolate_Factory"/>
        <skos:altLabel>Golden Ticket</skos:altLabel>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#Time -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#Time">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#D3FENDCore"/>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#TimeInstant -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#TimeInstant">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#Time"/>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#TimeInterval -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#TimeInterval">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#Time"/>
        <definition>A time interval is a one-dimensional temporal region that has duration and represents a continuous extent of time bounded by two time instants (a start instant and an end instant).</definition>
        <rdfs:label>Time Interval</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#TimeRecord -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#TimeRecord">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#Record"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#records"/>
                <owl:someValuesFrom rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#Time"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#TimeSeriesAnalysis -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#TimeSeriesAnalysis">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#StatisticalMethod"/>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#TimeSeriesDatabase -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#TimeSeriesDatabase">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#Database"/>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#Timer -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#Timer">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#Clock"/>
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#RuntimeVariable"/>
        <definition>A timer or countdown timer is a type of clock that starts from a specified time duration and stops upon reaching 00:00. It can also usually be stopped manually before the whole duration has elapsed. An example of a simple timer is an hourglass. Commonly, a timer triggers an alarm when it ends. A timer can be implemented through hardware or software.</definition>
        <rdfs:isDefinedBy rdf:resource="https://dbpedia.org/resource/Timer"/>
        <rdfs:label>Timer</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#TimerEvent -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#TimerEvent">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#DigitalEvent"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#has-participant"/>
                <owl:someValuesFrom rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#Timer"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <definition>An event involving a timer artifact, characterized by the initiation, expiration, modification, or cancellation of a countdown or interval-based temporal mechanism.</definition>
        <rdfs:label>Timer Event</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#TimerExpirationEvent -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#TimerExpirationEvent">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#SoftwareTimerEvent"/>
        <definition>An event in which a software timer reaches its configured duration and triggers associated actions (callbacks, interrupts, or signals).</definition>
        <rdfs:label>Timer Expiration Event</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#TimerModificationEvent -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#TimerModificationEvent">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#SoftwareTimerEvent"/>
        <definition>An event in which the duration or expiration time of an active timer is changed.</definition>
        <rdfs:label>Timer Modification Event</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#TimerSetEvent -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#TimerSetEvent">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#SoftwareTimerEvent"/>
        <definition>An event in which a software timer is initialized with a specific duration or expiration time.</definition>
        <rdfs:label>Timer Set Event</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#Token-basedAuthentication -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#Token-basedAuthentication">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#AgentAuthentication"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#uses"/>
                <owl:someValuesFrom rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#AccessToken"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#TokenBinding -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#TokenBinding">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CredentialHardening"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#strengthens"/>
                <owl:someValuesFrom rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#AccessToken"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#TraceProcess -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#TraceProcess">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#SystemCall"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#monitors"/>
                <owl:someValuesFrom rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#Process"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#TraceThread -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#TraceThread">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#SystemCall"/>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#TrajectoryPrediction -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#TrajectoryPrediction">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#Forecasting"/>
        <rdfs:label>Trajectory Prediction</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#Transceiver -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#Transceiver">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#HardwareDevice"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#contains"/>
                <owl:someValuesFrom rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#Receiver"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#contains"/>
                <owl:someValuesFrom rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#Transmitter"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#TransducerSensor -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#TransducerSensor">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#Sensor"/>
        <definition>A Transducer Sensor converts physical signals into digital data for monitoring purposes.</definition>
        <rdfs:label>Transducer Sensor</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#TransferAgentAuthentication -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#TransferAgentAuthentication">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#MessageHardening"/>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#TransferLearning -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#TransferLearning">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#MachineLearning"/>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#Transformer-XL -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#Transformer-XL">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#Transformer-basedLearning"/>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#Transformer-basedLearning -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#Transformer-basedLearning">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#MachineLearning"/>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#TranslationLookasideBuffer -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#TranslationLookasideBuffer">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#MemoryManagementUnitComponent"/>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#Transmitter -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#Transmitter">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#HardwareDevice"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#transmits"/>
                <owl:someValuesFrom rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#Signal"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#Transponder -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#Transponder">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#HardwareDevice"/>
        <definition>In telecommunications, a transponder is a device that, upon receiving a signal, emits a different signal in response.</definition>
        <rdfs:isDefinedBy rdf:resource="http://dbpedia.org/resource/Transponder"/>
        <rdfs:label>Transponder</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#TransportLayerEvent -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#TransportLayerEvent">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#NetworkEvent"/>
        <definition>An event occurring at the transport layer, responsible for end-to-end communication and data transfer management.</definition>
        <rdfs:label>Transport Layer Event</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#TransportLink -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#TransportLink">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#LogicalLink"/>
        <definition>A Transport Link is a type of logical link that exists at the transport layer of a network or system architecture.</definition>
        <rdfs:label>Transport Link</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#TrimmedMean -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#TrimmedMean">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CentralTendency"/>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#TrustStore -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#TrustStore">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#DigitalInformationBearer"/>
        <definition>Stores public information necessary to determine if another party can be trusted.</definition>
        <rdfs:label>Trust Store</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dbpedia.org/resource/Public_key_certificate"/>
        <rdfs:seeAlso rdf:resource="https://www.educative.io/edpresso/keystore-vs-truststore"/>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#TrustedAdministratorAttacker -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#TrustedAdministratorAttacker">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#TrustedAttacker"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#accesses"/>
                <owl:someValuesFrom rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#PrivilegedUserAccount"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <definition>A trusted attacker who misuses administrative access to execute attacks, often with elevated privileges.</definition>
        <rdfs:label>Trusted Administrator Attacker</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#TrustedAttacker -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#TrustedAttacker">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#Attacker"/>
        <definition>An individual who exploits their authorized access to conduct unauthorized actions, either intentionally or through negligence.</definition>
        <rdfs:label>Trusted Attacker</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#TrustedLibrary -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#TrustedLibrary">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#SourceCodeHardening"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#hardens"/>
                <owl:someValuesFrom rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#Subroutine"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#TrustedUserAttacker -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#TrustedUserAttacker">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#TrustedAttacker"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#accesses"/>
                <owl:someValuesFrom rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#DefaultUserAccount"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#accesses"/>
                <owl:someValuesFrom rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#DomainUserAccount"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#accesses"/>
                <owl:someValuesFrom rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#LocalUserAccount"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <definition>A trusted attacker who abuses regular user-level access privileges to compromise systems or data.</definition>
        <rdfs:label>Trusted User Attacker</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#TunnelCloseEvent -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#TunnelCloseEvent">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#TunnelEvent"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#preceded-by"/>
                <owl:someValuesFrom rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#TunnelOpenEvent"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <definition>An event where a network tunnel is terminated, ending encapsulated communication and releasing the associated resources.</definition>
        <rdfs:label>Tunnel Close Event</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#TunnelEvent -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#TunnelEvent">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#NetworkEvent"/>
        <definition>An event involving the establishment, usage, or termination of a network tunnel. Tunnels provide encapsulated communication pathways across various layers, enabling secure, isolated, or virtualized transport of data.</definition>
        <rdfs:label>Tunnel Event</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://schema.ocsf.io/classes/tunnel_activity"/>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#TunnelOpenEvent -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#TunnelOpenEvent">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#TunnelEvent"/>
        <definition>An event where a network tunnel is established, enabling encapsulated communication between endpoints. This marks the initiation of secure or isolated data transport through the tunnel.</definition>
        <rdfs:label>Tunnel Open Event</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#TunnelRenewEvent -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#TunnelRenewEvent">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#TunnelEvent"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#preceded-by"/>
                <owl:someValuesFrom rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#TunnelOpenEvent"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <definition>An event where the lifecycle of a network tunnel is extended, ensuring continued encapsulated communication and avoiding session expiration.</definition>
        <rdfs:label>Tunnel Renew Event</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#UDPEvent -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#UDPEvent">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#TransportLayerEvent"/>
        <definition>An event involving the User Datagram Protocol (UDP), providing a connectionless datagram service with minimal protocol mechanisms.</definition>
        <rdfs:label>UDP Event</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#URL -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#URL">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#Identifier"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#addresses"/>
                <owl:someValuesFrom rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#Resource"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#URLAnalysis -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#URLAnalysis">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#IdentifierAnalysis"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#analyzes"/>
                <owl:someValuesFrom rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#URL"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#URLReputationAnalysis -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#URLReputationAnalysis">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#IdentifierReputationAnalysis"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#analyzes"/>
                <owl:someValuesFrom rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#URL"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#UncertaintySampling -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#UncertaintySampling">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#ActiveLearning"/>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#UnitTestExecutionTool -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#UnitTestExecutionTool">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#TestExecutionTool"/>
        <definition>An unit test execution tool automatically performs unit testing.  Unit testing is a software testing method by which individual units of source code are tested to determine whether they are fit for use.  Unit test execution tools work with sets of one or more computer program modules together with associated control data, usage procedures, and operating procedures. This contrasts with integration testing, which tests inter-unit dependencies and the modules as a group.</definition>
        <rdfs:label>Unit Test Execution Tool</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dbpedia.org/resource/Unit_testing"/>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#UnixHardLink -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#UnixHardLink">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#HardLink"/>
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#UnixLink"/>
        <definition>A Unix hard link is a hard link on a Unix file system.</definition>
        <rdfs:isDefinedBy rdf:resource="http://dbpedia.org/resource/Hard_link"/>
        <rdfs:label>Unix Hard Link</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#UnixLink -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#UnixLink">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#FileSystemLink"/>
        <definition>A Unix link is a file link in a Unix file system.</definition>
        <rdfs:label>Unix Link</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#UnloadLibraryEvent -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#UnloadLibraryEvent">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#ProcessEvent"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#has-participant"/>
                <owl:someValuesFrom rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#SharedLibraryFile"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#preceded-by"/>
                <owl:someValuesFrom rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#LoadLibraryEvent"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <definition>An event where a process unloads a dynamically linked library or module, reducing its memory footprint or functionality.</definition>
        <rdfs:label>Unload Library Event</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://schema.ocsf.io/classes/module_activity"/>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#UnloadModule -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#UnloadModule">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#SystemCall"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#unloads"/>
                <owl:someValuesFrom rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#HardwareDriver"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#unloads"/>
                <owl:someValuesFrom rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#KernelModule"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#UnlockAccount -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#UnlockAccount">
