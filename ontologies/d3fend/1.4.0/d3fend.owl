    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#OTChangeDataCommand -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#OTChangeDataCommand">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#OTWriteCommand"/>
        <definition>OT command that modifies existing data on a remote device.</definition>
        <rdfs:comment>BACnet: atomicWriteFile
BACnet: writeProperty
BACnet: writePropertyMultiple
BACnet: write-group </rdfs:comment>
        <rdfs:comment>CIP: Set Attributes All
CIP: Set Attribute List
CIP: Set Attribute Single
CIP: Set Member</rdfs:comment>
        <rdfs:comment>GE-SRTP: WRITE SYSTEM MEMORY
GE-SRTP: WRITE TASK MEMORY </rdfs:comment>
        <rdfs:comment>Modbus: Write Single Coil
Modbus: Write Single Register
Modbus: Write Multiple Coils
Modbus: Write Multiple Registers
Modbus: Write File Record
Modbus: Mask Write Register
Modbus: Read Write Register</rdfs:comment>
        <rdfs:label>OT Change Data Command</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://icscsi.org/library/Documents/ICS_Protocols/Control%20Microsystems%20-%20DNP3%20User%20and%20Reference%20Manual.pdf"/>
        <rdfs:seeAlso rdf:resource="https://modbus.org/docs/Modbus_Application_Protocol_V1_1b3.pdf"/>
        <rdfs:seeAlso rdf:resource="https://nvlpubs.nist.gov/nistpubs/TechnicalNotes/NIST.TN.2023.pdf"/>
    </owl:Class>
    


