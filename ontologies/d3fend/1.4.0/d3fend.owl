        <contributor rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#DISA_FSO"/>
        <definition>The information system uniquely identifies and authenticates source by organization, system, application, and/or individual for information transfer.</definition>
        <rdfs:label>CCI-002205</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CCI-002207_v2022-04-05 -->

    <owl:NamedIndividual rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CCI-002207_v2022-04-05">
        <rdf:type rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CCIControl"/>
        <member-of rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CCICatalog_v2022-04-05"/>
