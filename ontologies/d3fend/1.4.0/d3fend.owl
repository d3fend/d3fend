    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#SatelliteTransponder">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#Transponder"/>
    </owl:Class>
    


