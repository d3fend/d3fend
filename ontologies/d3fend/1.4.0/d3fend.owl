        <kb-reference-title>A One-Time Password System</kb-reference-title>
        <kb-organization>Internet Engineering Task Force (IETF)</kb-organization>
        <rdfs:label>Reference - RFC 2289 - A One-Time Password System</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#Reference-RFC3411-AnArchitectureForDescribingSimpleNetworkManagementProtocolSNMPManagementFrameworks -->

    <owl:NamedIndividual rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#Reference-RFC3411-AnArchitectureForDescribingSimpleNetworkManagementProtocolSNMPManagementFrameworks">
        <rdf:type rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#SpecificationReference"/>
