    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#UserGroup -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#UserGroup">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#AccessControlGroup"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#contains"/>
                <owl:someValuesFrom rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#UserAccount"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#UserGroupPermissions -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#UserGroupPermissions">
