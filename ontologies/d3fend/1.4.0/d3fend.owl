        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#SharedLibraryFile"/>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#OperationalActivityMapping -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#OperationalActivityMapping">
