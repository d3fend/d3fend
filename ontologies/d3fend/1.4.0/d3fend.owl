                <owl:someValuesFrom rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#DomainUserAccount"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#T1136.003 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#T1136.003">
