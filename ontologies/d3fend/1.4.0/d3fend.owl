                <owl:onProperty rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#loads"/>
                <owl:someValuesFrom rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#SharedLibraryFile"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#In-memoryPasswordStore -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#In-memoryPasswordStore">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#PasswordStore"/>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#InboundInternetDNSResponseTraffic -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#InboundInternetDNSResponseTraffic">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#InboundInternetNetworkTraffic"/>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#InboundInternetEncryptedTraffic -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#InboundInternetEncryptedTraffic">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#InboundInternetNetworkTraffic"/>
        <definition>Inbound  internet encrypted traffic is encrypted network traffic on an incoming connection initiated from a host outside the network to a host within a network .</definition>
        <rdfs:label>Inbound Internet Encrypted Traffic</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#InboundInternetEncryptedWebTraffic -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#InboundInternetEncryptedWebTraffic">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#InboundInternetEncryptedTraffic"/>
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#InboundInternetWebTraffic"/>
        <definition>Inbound internet web traffic is network traffic that is: (a) on an incoming connection initiated from a host outside the network to a host within a network, and (b) using a standard web encryption protocol.</definition>
        <rdfs:label>Inbound Internet Encrypted Web Traffic</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dbpedia.org/resource/Internetworking"/>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#InboundInternetMailTraffic -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#InboundInternetMailTraffic">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#InboundInternetNetworkTraffic"/>
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#InboundNetworkTraffic"/>
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#MailNetworkTraffic"/>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#InboundInternetNetworkTraffic -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#InboundInternetNetworkTraffic">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#InboundNetworkTraffic"/>
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#InternetNetworkTraffic"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#produces"/>
                <owl:someValuesFrom rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#NetworkTraffic"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#InboundInternetWebTraffic -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#InboundInternetWebTraffic">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#InboundInternetNetworkTraffic"/>
        <definition>Inbound internet web traffic is network traffic that is: (a) on an incoming connection initiated from a host outside the network to a host within a network, and (b) using a standard web protocol.</definition>
        <rdfs:label>Inbound Internet Web Traffic</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dbpedia.org/resource/Internetworking"/>
        <rdfs:seeAlso rdf:resource="https://schema.ocsf.io/objects/http_response"/>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#InboundNetworkTraffic -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#InboundNetworkTraffic">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#NetworkTraffic"/>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#InboundSessionVolumeAnalysis -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#InboundSessionVolumeAnalysis">
