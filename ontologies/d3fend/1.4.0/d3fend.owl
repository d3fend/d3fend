        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#FileHeaderBlockSignature"/>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#FileMetadata -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#FileMetadata">
