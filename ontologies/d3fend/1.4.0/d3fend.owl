    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#RemoteAuthorizationService -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#RemoteAuthorizationService">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#AuthorizationService"/>
        <definition>A remote authorization service provides for the authorization of a user across a network (i.e., remotely).</definition>
        <rdfs:label>Remote Authorization Service</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#RemoteCommand -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#RemoteCommand">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#Command"/>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#RemoteDatabaseQuery -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#RemoteDatabaseQuery">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#DatabaseQuery"/>
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#RemoteCommand"/>
        <definition>A remote query session enabling a user to make an SQL, SPARQL, or similar query over the network from one host to another.</definition>
        <rdfs:label>Remote Database Query</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://www.sciencedirect.com/topics/computer-science/remote-database-server"/>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#RemoteFileAccessMediation -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#RemoteFileAccessMediation">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#NetworkResourceAccessMediation"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#isolates"/>
                <owl:someValuesFrom rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#File"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#RemoteFirmwareUpdateMonitoring -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#RemoteFirmwareUpdateMonitoring">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#ApplicationProtocolCommandAnalysis"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#detects"/>
                <owl:someValuesFrom rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#OTDeviceFirmwareCommand"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#monitors"/>
                <owl:someValuesFrom rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#OTNetworkTraffic"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#RemoteLoginSession -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#RemoteLoginSession">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#NetworkSession"/>
        <definition>A remote login session is a login session where a client has logged in from their local host machine to a server via a network.</definition>
        <rdfs:label>Remote Login Session</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#RemoteProcedureCall -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#RemoteProcedureCall">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#RemoteCommand"/>
        <definition>In distributed computing a remote procedure call (RPC) is when a computer program causes a procedure (subroutine) to execute in another address space (commonly on another computer on a shared network), which is coded as if it were a normal (local) procedure call, without the programmer explicitly coding the details for the remote interaction. That is, the programmer writes essentially the same code whether the subroutine is local to the executing program, or remote. This is a form of client-server interaction (caller is client, executor is server), typically implemented via a request-response message-passing system. The object-oriented programming analog is remote method invocation (RMI). The RPC model implies a level of location transparency.</definition>
        <rdfs:isDefinedBy rdf:resource="http://dbpedia.org/resource/Remote_procedure_call"/>
        <rdfs:label>Remote Procedure Call</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://schema.ocsf.io/objects/dce_rpc"/>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#RemoteResource -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#RemoteResource">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#Resource"/>
        <definition>In computing, a remote  resource is a computer resource made available from one host to other hosts on a computer network. It is a device or piece of information on a computer that can be remotely accessed from another computer, typically via a local area network or an enterprise intranet.</definition>
        <rdfs:label>Remote Resource</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#NetworkResource"/>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#RemoteSession -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#RemoteSession">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#NetworkSession"/>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#RemoteShellCommand -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#RemoteShellCommand">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#RemoteCommand"/>
        <definition>A remote shell command is a command sent from one computer to another to be executed on the remote computer.  One example of this, is through a command-line interface (CLI) like using Invoke-Command from PowerShell or a command sent through an ssh session. This class generalizes to all means of sending a command through an established protocol to control capabilities on a remote computer.</definition>
        <rdfs:label>Remote Shell Command</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://dbpedia.org/resource/Remote_Shell"/>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#RemoteTerminalSession -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#RemoteTerminalSession">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#NetworkSession"/>
        <definition>A remote terminal session is a session that provides a user access from one host to another host via a terminal.</definition>
        <rdfs:label>Remote Terminal Session</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#RemoteTerminalSessionDetection -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#RemoteTerminalSessionDetection">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#NetworkTrafficAnalysis"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#analyzes"/>
                <owl:someValuesFrom rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#NetworkTraffic"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#RemovableMediaDevice -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#RemovableMediaDevice">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#HardwareDevice"/>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#RemoveUserFromGroupEvent -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#RemoveUserFromGroupEvent">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#GroupManagementEvent"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#has-participant"/>
                <owl:someValuesFrom rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#UserAccount"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#preceded-by"/>
                <owl:someValuesFrom rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#AddUserToGroupEvent"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <definition>An event where a user is removed from a group, revoking the permissions and privileges associated with the group from the user.</definition>
        <rdfs:label>Remove User from Group Event</rdfs:label>
    </owl:Class>
    


