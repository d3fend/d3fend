                <owl:someValuesFrom rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#OTDeviceConfigurationCommand"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <definition>Configure or administer managed devices.</definition>
        <rdfs:label>OT Device Configuration Command Event</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#OTDeviceDescriptionMessage -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#OTDeviceDescriptionMessage">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#OTDeviceManagementMessage"/>
        <definition>Describe features, abilities, or performance of system components.</definition>
        <rdfs:comment>ENIP: List Services
ENIP: List Interfaces </rdfs:comment>
        <rdfs:comment>GE-SRTP: RETURN CONTROL PROGRAM NAMES
