    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#ContainerRuntime -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#ContainerRuntime">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#ServiceApplication"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#runs"/>
                <owl:someValuesFrom rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#ContainerImage"/>
