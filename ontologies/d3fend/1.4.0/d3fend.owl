    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#HeapSegment -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#HeapSegment">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#ProcessSegment"/>
