            </owl:Restriction>
        </rdfs:subClassOf>
        <definition>An event where a registry value is deleted from the Windows Registry, permanently removing its associated data.</definition>
        <rdfs:label>Windows Registry Value Deletion Event</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#WindowsRegistryValueEvent -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#WindowsRegistryValueEvent">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#WindowsRegistryEvent"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#has-participant"/>
                <owl:someValuesFrom rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#WindowsRegistryValue"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <definition>Events representing actions performed on Windows Registry values, which store configuration data within registry keys.</definition>
        <rdfs:label>Windows Registry Value Event</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://schema.ocsf.io/classes/win/registry_value_activity"/>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#WindowsRegistryValueGetEvent -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#WindowsRegistryValueGetEvent">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#WindowsRegistryValueEvent"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#preceded-by"/>
                <owl:someValuesFrom rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#WindowsRegistryValueSetEvent"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <definition>An event where the data of a registry value is retrieved, typically to read its configuration or state.</definition>
        <rdfs:label>Windows Registry Value Get Event</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#WindowsRegistryValueSetEvent -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#WindowsRegistryValueSetEvent">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#WindowsRegistryValueEvent"/>
        <definition>An event where data is assigned to a registry value, either creating it or updating its existing content.</definition>
        <rdfs:label>Windows Registry Value Set Event</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#WindowsRegistryValueUpdateEvent -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#WindowsRegistryValueUpdateEvent">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#WindowsRegistryValueEvent"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#preceded-by"/>
                <owl:someValuesFrom rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#WindowsRegistryValueSetEvent"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <definition>An event indicating changes to the data or configuration of an existing registry value within the Windows Registry.</definition>
        <rdfs:label>Windows Registry Value Update Event</rdfs:label>
    </owl:Class>
    


