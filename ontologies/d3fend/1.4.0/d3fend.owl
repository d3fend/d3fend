        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#OutboundNetworkTraffic"/>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#OutboundInternetRPCTraffic -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#OutboundInternetRPCTraffic">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#OutboundInternetNetworkTraffic"/>
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#OutboundNetworkTraffic"/>
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#RPCNetworkTraffic"/>
        <definition>Outbound internet RPC traffic is RPC traffic that is: (a) on an outgoing connection initiated from a host within a network to a host outside the network, and (b) using a standard RPC protocol.</definition>
        <rdfs:label>Outbound Internet RPC Traffic</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dbpedia.org/resource/Internetworking"/>
        <rdfs:seeAlso rdf:resource="http://dbpedia.org/resource/Remote_procedure_call"/>
    </owl:Class>
    


