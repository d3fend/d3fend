        <definition>Automated tasks that can be executed at a specific time or on a recurring schedule running in the background (ex: Cron daemon, task scheduler, BITS)</definition>
        <rdfs:comment>The digital artifact mapping for this data source is only applicable to the Scheduled Job Metadata component</rdfs:comment>
        <rdfs:label>Scheduled Job (ATT&amp;CK DS)</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#DS0004 -->

    <owl:NamedIndividual rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#DS0004">
        <rdf:type rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#ATTACKEnterpriseDataSource"/>
        <narrower rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#FileHash"/>
        <narrower rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#ImageCodeSegment"/>
        <definition>Information obtained (via shared or submitted samples) regarding malicious software (droppers, backdoors, etc.) used by adversaries</definition>
        <rdfs:comment>The digital artifact mapping for this data source is only applicable to the Scheduled Job Metadata component</rdfs:comment>
        <rdfs:label>Malware Repository (ATT&amp;CK DS)</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#DS0005 -->

    <owl:NamedIndividual rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#DS0005">
        <rdf:type rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#ATTACKEnterpriseDataSource"/>
        <definition>The infrastructure for management data and operations that enables local and remote management of Windows personal computers and servers</definition>
        <rdfs:comment>This data source captures events relating to WMI objects and therefore has no direct mappings to digital artifacts.</rdfs:comment>
        <rdfs:label>WMI (ATT&amp;CK DS)</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#DS0006 -->

    <owl:NamedIndividual rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#DS0006">
        <rdf:type rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#ATTACKEnterpriseDataSource"/>
        <definition>Credential material, such as session cookies or tokens, used to authenticate to web applications and services</definition>
        <rdfs:comment>This data source captures events relating to web credentials and therefore has no direct mappings to digital artifacts.</rdfs:comment>
        <rdfs:label>Web Credential (ATT&amp;CK DS)</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#DS0007 -->

    <owl:NamedIndividual rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#DS0007">
        <rdf:type rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#ATTACKEnterpriseDataSource"/>
        <exactly rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#VMImage"/>
        <definition>A single file used to deploy a virtual machine/bootable disk into an on-premise or third-party cloud environment</definition>
        <rdfs:comment>The digital artifact mapping for this data source is only applicable to the Image Metadata component</rdfs:comment>
        <rdfs:label>Image (ATT&amp;CK DS)</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#DS0008 -->

    <owl:NamedIndividual rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#DS0008">
        <rdf:type rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#ATTACKEnterpriseDataSource"/>
        <definition>A computer program, at the core of a computer OS, that resides in memory and facilitates interactions between hardware and software components</definition>
        <rdfs:comment>This data source captures events relating to kernel modules and therefore has no direct mappings to digital artifacts.</rdfs:comment>
        <rdfs:label>Kernel (ATT&amp;CK DS)</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#DS0009 -->

    <owl:NamedIndividual rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#DS0009">
        <rdf:type rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#ATTACKEnterpriseDataSource"/>
        <exactly rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#Process"/>
        <definition>Instances of computer programs that are being executed by at least one thread. Processes have memory space for process executables, loaded modules (DLLs or shared libraries), and allocated memory regions containing everything from user input to application-specific data structures</definition>
        <rdfs:comment>The digital artifact mapping for this data source is only applicable to the Process Metadata component</rdfs:comment>
        <rdfs:label>Process (ATT&amp;CK DS)</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#DS0010 -->

    <owl:NamedIndividual rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#DS0010">
        <rdf:type rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#ATTACKEnterpriseDataSource"/>
        <exactly rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CloudStorage"/>
        <definition>Data object storage infrastructure hosted on-premise or by third-party providers, made available to users through network connections and/or APIs</definition>
        <rdfs:comment>The digital artifact mapping for this data source is only applicable to the Cloud Storage Metadata component</rdfs:comment>
        <rdfs:label>Cloud Storage (ATT&amp;CK DS)</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#DS0011 -->

    <owl:NamedIndividual rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#DS0011">
        <rdf:type rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#ATTACKEnterpriseDataSource"/>
        <definition>Executable files consisting of one or more shared classes and interfaces, such as portable executable (PE) format binaries/dynamic link libraries (DLL), executable and linkable format (ELF) binaries/shared libraries, and Mach-O format binaries/shared libraries</definition>
        <rdfs:comment>This data source captures events relating to software libraries and therefore has no direct mappings to digital artifacts.</rdfs:comment>
        <rdfs:label>Module (ATT&amp;CK DS)</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#DS0012 -->

    <owl:NamedIndividual rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#DS0012">
        <rdf:type rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#ATTACKEnterpriseDataSource"/>
        <definition>A file or stream containing a list of commands, allowing them to be launched in sequence</definition>
        <rdfs:comment>This data source captures events relating to scripts and therefore has no direct mappings to digital artifacts.</rdfs:comment>
        <rdfs:label>Script (ATT&amp;CK DS)</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#DS0013 -->

    <owl:NamedIndividual rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#DS0013">
        <rdf:type rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#ATTACKEnterpriseDataSource"/>
        <definition>Information from host telemetry providing insights about system status, errors, or other notable functional activity</definition>
        <rdfs:comment>This data source currently has no mappings to digital artifacts.</rdfs:comment>
        <rdfs:label>Sensor Health (ATT&amp;CK DS)</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#DS0014 -->

    <owl:NamedIndividual rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#DS0014">
        <rdf:type rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#ATTACKEnterpriseDataSource"/>
        <definition>A single unit of shared resources within a cluster, comprised of one or more containers</definition>
        <rdfs:comment>This data source captures events relating to pods and therefore has no direct mappings to digital artifacts.</rdfs:comment>
        <rdfs:label>Pod (ATT&amp;CK DS)</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#DS0015 -->

    <owl:NamedIndividual rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#DS0015">
        <rdf:type rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#ATTACKEnterpriseDataSource"/>
        <broader rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#Log"/>
        <definition>Events collected by third-party services such as mail servers, web applications, or other appliances (not by the native OS or platform)</definition>
        <rdfs:label>Application Log (ATT&amp;CK DS)</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#DS0016 -->

    <owl:NamedIndividual rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#DS0016">
        <rdf:type rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#ATTACKEnterpriseDataSource"/>
        <definition>A non-volatile data storage device (hard drive, floppy disk, USB flash drive) with at least one formatted partition, typically mounted to the file system and/or assigned a drive letter</definition>
        <rdfs:comment>This data source captures events relating to drives and therefore has no direct mappings to digital artifacts.</rdfs:comment>
        <rdfs:label>Drive (ATT&amp;CK DS)</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#DS0017 -->

    <owl:NamedIndividual rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#DS0017">
        <rdf:type rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#ATTACKEnterpriseDataSource"/>
        <definition>A directive given to a computer program, acting as an interpreter of some kind, in order to perform a specific task</definition>
        <rdfs:comment>This data source captures events relating to commands and therefore has no direct mappings to digital artifacts.</rdfs:comment>
        <rdfs:label>Command (ATT&amp;CK DS)</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#DS0018 -->

    <owl:NamedIndividual rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#DS0018">
        <rdf:type rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#ATTACKEnterpriseDataSource"/>
        <exactly rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#Firewall"/>
        <definition>A network security system, running locally on an endpoint or remotely as a service (ex: cloud environment), that monitors and controls incoming/outgoing network traffic based on predefined rules</definition>
        <rdfs:comment>The digital artifact mapping for this data source is only applicable to the Firewall Metadata component</rdfs:comment>
        <rdfs:label>Firewall (ATT&amp;CK DS)</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#DS0019 -->

    <owl:NamedIndividual rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#DS0019">
        <rdf:type rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#ATTACKEnterpriseDataSource"/>
        <exactly rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#ServiceApplicationProcess"/>
        <definition>A computer process that is configured to execute continuously in the background and perform system tasks, in some cases before any user has logged in</definition>
        <rdfs:comment>The digital artifact mapping for this data source is only applicable to the Service Metadata component</rdfs:comment>
        <rdfs:label>Service (ATT&amp;CK DS)</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#DS0020 -->

    <owl:NamedIndividual rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#DS0020">
        <rdf:type rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#ATTACKEnterpriseDataSource"/>
        <exactly rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#VolumeSnapshot"/>
        <definition>A point-in-time copy of cloud volumes (files, settings, etc.) that can be created and/or deployed in cloud environments</definition>
        <rdfs:comment>The digital artifact mapping for this data source is only applicable to the Volume Metadata component</rdfs:comment>
        <rdfs:label>Snapshot (ATT&amp;CK DS)</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#DS0021 -->

    <owl:NamedIndividual rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#DS0021">
        <rdf:type rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#ATTACKEnterpriseDataSource"/>
        <definition>A malicious online profile representing a user commonly used by adversaries to social engineer or otherwise target victims</definition>
        <rdfs:comment>This data source currently has no mappings to digital artifacts.</rdfs:comment>
        <rdfs:label>Persona (ATT&amp;CK DS)</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#DS0022 -->

    <owl:NamedIndividual rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#DS0022">
        <rdf:type rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#ATTACKEnterpriseDataSource"/>
        <narrower rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#FileSystemMetadata"/>
        <definition>A computer resource object, managed by the I/O system, for storing data (such as images, text, videos, computer programs, or any wide variety of other media)</definition>
        <rdfs:comment>The digital artifact mapping for this data source is only applicable to the File Metadata component</rdfs:comment>
        <rdfs:label>File (ATT&amp;CK DS)</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#DS0023 -->

    <owl:NamedIndividual rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#DS0023">
        <rdf:type rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#ATTACKEnterpriseDataSource"/>
        <exactly rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#NamedPipe"/>
        <definition>Mechanisms that allow inter-process communication locally or over the network. A named pipe is usually found as a file and processes attach to it</definition>
        <rdfs:label>Named Pipe (ATT&amp;CK DS)</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#DS0024 -->

    <owl:NamedIndividual rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#DS0024">
        <rdf:type rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#ATTACKEnterpriseDataSource"/>
        <definition>A Windows OS hierarchical database that stores much of the information and settings for software programs, hardware devices, user preferences, and operating-system configurations</definition>
        <rdfs:comment>This data source captures events relating to Windows registry keys and values and therefore has no direct mappings to digital artifacts.</rdfs:comment>
        <rdfs:label>Windows Registry (ATT&amp;CK DS)</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#DS0025 -->

    <owl:NamedIndividual rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#DS0025">
        <rdf:type rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#ATTACKEnterpriseDataSource"/>
        <definition>Infrastructure, platforms, or software that are hosted on-premise or by third-party providers, made available to users through network connections and/or APIs</definition>
        <rdfs:comment>This data source currently has no mappings to digital artifacts.</rdfs:comment>
        <rdfs:label>Cloud Service (ATT&amp;CK DS)</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#DS0026 -->

    <owl:NamedIndividual rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#DS0026">
        <rdf:type rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#ATTACKEnterpriseDataSource"/>
        <definition>A database and set of services that allows administrators to manage permissions, access to network resources, and stored data objects (user, group, application, or devices)</definition>
        <rdfs:comment>This data source captures events relating to Active Directory objects and therefore has no direct mappings to digital artifacts.</rdfs:comment>
        <rdfs:label>Active Directory (ATT&amp;CK DS)</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#DS0027 -->

    <owl:NamedIndividual rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#DS0027">
        <rdf:type rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#ATTACKEnterpriseDataSource"/>
        <definition>A computer program that operates or controls a particular type of device that is attached to a computer. Provides a software interface to hardware devices, enabling operating systems and other computer programs to access hardware functions without needing to know precise details about the hardware being used</definition>
        <rdfs:comment>This data source captures events relating to hardware drivers and therefore has no direct mappings to digital artifacts.</rdfs:comment>
        <rdfs:label>Driver (ATT&amp;CK DS)</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#DS0028 -->

    <owl:NamedIndividual rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#DS0028">
        <rdf:type rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#ATTACKEnterpriseDataSource"/>
        <broader rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#LoginSession"/>
        <definition>Logon occurring on a system or resource (local, domain, or cloud) to which a user/device is gaining access after successful authentication and authorization</definition>
        <rdfs:comment>The digital artifact mapping for this data source is only applicable to the Login Session Metadata component</rdfs:comment>
        <rdfs:label>Logon Session (ATT&amp;CK DS)</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#DS0029 -->

    <owl:NamedIndividual rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#DS0029">
        <rdf:type rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#ATTACKEnterpriseDataSource"/>
        <exactly rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#NetworkTraffic"/>
        <definition>Data transmitted across a network (ex: Web, DNS, Mail, File, etc.), that is either summarized (ex: Netflow) and/or captured as raw data in an analyzable format (ex: PCAP)</definition>
        <rdfs:comment>The digital artifact mapping for this data source is only applicable to the Network Traffic Content component</rdfs:comment>
        <rdfs:label>Network Traffic (ATT&amp;CK DS)</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#DS0030 -->

    <owl:NamedIndividual rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#DS0030">
        <rdf:type rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#ATTACKEnterpriseDataSource"/>
        <definition>A virtual server environment which runs workloads, hosted on-premise or by third-party cloud providers</definition>
        <rdfs:comment>This data source currently has no mappings to digital artifacts.</rdfs:comment>
        <rdfs:label>Instance (ATT&amp;CK DS)</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#DS0032 -->

    <owl:NamedIndividual rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#DS0032">
        <rdf:type rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#ATTACKEnterpriseDataSource"/>
        <definition>A standard unit of virtualized software that packages up code and all its dependencies so the application runs quickly and reliably from one computing environment to another</definition>
        <rdfs:comment>This data source captures events relating to containers and therefore has no direct mappings to digital artifacts.</rdfs:comment>
        <rdfs:label>Container (ATT&amp;CK DS)</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#DS0033 -->

    <owl:NamedIndividual rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#DS0033">
        <rdf:type rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#ATTACKEnterpriseDataSource"/>
        <definition>A storage resource (typically a folder or drive) made available from one host to others using network protocols, such as Server Message Block (SMB) or Network File System (NFS)</definition>
        <rdfs:comment>This data source captures events relating to shared network resources and therefore has no direct mappings to digital artifacts.</rdfs:comment>
        <rdfs:label>Network Share (ATT&amp;CK DS)</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#DS0034 -->

    <owl:NamedIndividual rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#DS0034">
        <rdf:type rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#ATTACKEnterpriseDataSource"/>
        <definition>Block object storage hosted on-premise or by third-party providers, typically made available to resources as virtualized hard drives</definition>
        <rdfs:comment>This data source currently has no mappings to digital artifacts.</rdfs:comment>
        <rdfs:label>Volume (ATT&amp;CK DS)</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#DS0035 -->

    <owl:NamedIndividual rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#DS0035">
        <rdf:type rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#ATTACKEnterpriseDataSource"/>
        <definition>Information obtained (commonly via active network traffic probes or web crawling) regarding various types of resources and servers connected to the public Internet</definition>
        <rdfs:comment>This data source currently has no mappings to digital artifacts.</rdfs:comment>
        <rdfs:label>Internet Scan (ATT&amp;CK DS)</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#DS0036 -->

    <owl:NamedIndividual rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#DS0036">
        <rdf:type rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#ATTACKEnterpriseDataSource"/>
        <exactly rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#UserGroup"/>
        <definition>A collection of multiple user accounts that share the same access rights to the computer and/or network resources and have common security rights</definition>
        <rdfs:comment>The digital artifact mapping for this data source is only applicable to the Group Metadata component</rdfs:comment>
        <rdfs:label>Group (ATT&amp;CK DS)</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#DS0037 -->

    <owl:NamedIndividual rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#DS0037">
        <rdf:type rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#ATTACKEnterpriseDataSource"/>
        <definition>A digital document, which highlights information such as the owner&apos;s identity, used to instill trust in public keys used while encrypting network communications</definition>
        <rdfs:comment>This data source captures events relating to certificates and therefore has no direct mappings to digital artifacts.</rdfs:comment>
        <rdfs:label>Certificate (ATT&amp;CK DS)</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#DS0038 -->

    <owl:NamedIndividual rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#DS0038">
        <rdf:type rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#ATTACKEnterpriseDataSource"/>
        <definition>Information obtained (commonly through registration or activity logs) regarding one or more IP addresses registered with human readable names (ex: mitre.org)</definition>
        <rdfs:comment>This data source currently has no mappings to digital artifacts.</rdfs:comment>
        <rdfs:label>Domain Name (ATT&amp;CK DS)</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#DS0039 -->

    <owl:NamedIndividual rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#DS0039">
        <rdf:type rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#ATTACKEnterpriseDataSource"/>
        <exactly rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#AssetInventoryAgent"/>
        <definition>Data sources with information about the set of devices found within the network, along with their current software and configurations</definition>
        <rdfs:label>Asset (ATT&amp;CK DS)</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#DS0040 -->

    <owl:NamedIndividual rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#DS0040">
        <rdf:type rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#ATTACKEnterpriseDataSource"/>
        <definition>Operational databases contain information about the status of the operational process and associated devices, including any measurements, events, history, or alarms that have occurred</definition>
        <rdfs:comment>This data source currently has no mappings to digital artifacts.</rdfs:comment>
