    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#Grid-basedClustering -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#Grid-basedClustering">
