        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#Attacker"/>
        <definition>An attacker who exploits systems without being physically present near the target, often over the internet.</definition>
        <rdfs:label>Remote Attacker</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#RemoteAuthenticationService -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#RemoteAuthenticationService">
