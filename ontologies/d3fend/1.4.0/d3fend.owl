    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#TA0030 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#TA0030">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#ATTACKMobileTactic"/>
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#OffensiveTactic"/>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#TA0031 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#TA0031">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#ATTACKMobileTactic"/>
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#OffensiveTactic"/>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#TA0032 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#TA0032">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#ATTACKMobileTactic"/>
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#OffensiveTactic"/>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#TA0033 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#TA0033">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#ATTACKMobileTactic"/>
