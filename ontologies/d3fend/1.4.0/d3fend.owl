        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#AccessControlAdministrationEvent"/>
        <definition>An administrative event entailing the withdrawal of previously granted access rights, reconfiguring permissions to prevent a subject from performing specific actions on a resource, in accordance with updated access policies.</definition>
        <rdfs:label>Permission Revoking Event</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#PersistenceTechnique -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#PersistenceTechnique">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#ATTACKEnterpriseTechnique"/>
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#OffensiveTechnique"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#enables"/>
                <owl:someValuesFrom rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#TA0003"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#Person -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#Person">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#Agent"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#name"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#PersonalComputer -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#PersonalComputer">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#ClientComputer"/>
        <definition>A personal computer (PC) is a multi-purpose computer whose size, capabilities, and price make it feasible for individual use. Personal computers are intended to be operated directly by an end user, rather than by a computer expert or technician. Unlike large, costly minicomputers and mainframes, time-sharing by many people at the same time is not used with personal computers. PCs have in practice become powerful enough that they may be shared by multiple users at any given time, though this is not common practice nor the primary purpose of a PC.</definition>
        <rdfs:isDefinedBy rdf:resource="http://dbpedia.org/resource/Personal_computer"/>
        <rdfs:label>Personal Computer</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#Perturbation-basedLearning -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#Perturbation-basedLearning">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#IntrinsicallySemi-supervisedLearning"/>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#PhiCoefficient -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#PhiCoefficient">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#Correlation"/>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#PhysicalAccessAlarmEvent -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#PhysicalAccessAlarmEvent">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#DigitalEvent"/>
        <rdfs:comment>An event occuring when a physical threshold is crossed.</rdfs:comment>
        <rdfs:label>Physical Access Alarm Event</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#PhysicalAccessMediation -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#PhysicalAccessMediation">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#AccessMediation"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#isolates"/>
                <owl:someValuesFrom rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#PhysicalArtifact"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#mediates-access-to"/>
                <owl:someValuesFrom rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#PhysicalArtifact"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#PhysicalAccessMonitoring -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#PhysicalAccessMonitoring">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#DefensiveTechnique"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#enables"/>
                <owl:someValuesFrom rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#Detect"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#PhysicalAddress -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#PhysicalAddress">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#MemoryAddress"/>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#PhysicalArtifact -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#PhysicalArtifact">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#Artifact"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#has-location"/>
                <owl:someValuesFrom rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#PhysicalLocation"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#PhysicalAttacker -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#PhysicalAttacker">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#LocalAttacker"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#accesses"/>
                <owl:someValuesFrom rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#ComputerPlatform"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#accesses"/>
                <owl:someValuesFrom rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#HardwareDevice"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <definition>An attacker who is physically close enough to interact with the system directly, such as through physical access to devices.</definition>
        <rdfs:label>Physical Attacker</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#PhysicalDataDiode -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#PhysicalDataDiode">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#HardwareDevice"/>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#PhysicalEnclosureHardening -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#PhysicalEnclosureHardening">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#PlatformHardening"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#hardens"/>
                <owl:someValuesFrom rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#ComputerEnclosure"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#PhysicalKey -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#PhysicalKey">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#PhysicalArtifact"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#operates"/>
                <owl:someValuesFrom rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#PhysicalKeyLock"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <definition>A physical key is used to operate a lock, typically metal, designed with specific markers that match the internal mechanism of a lock, allowing it to rotate the lock when inserted.</definition>
        <rdfs:label>Physical Key</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#PhysicalKeyLock -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#PhysicalKeyLock">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#PhysicalLock"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#uses"/>
                <owl:someValuesFrom rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#PhysicalKey"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <definition>A mechanical locking device for securing moveable portions of physical barriers (e.g., doors, gates, drawers) in a secured position.</definition>
        <synonym>keyed lock</synonym>
        <rdfs:isDefinedBy>NRC Regulatory Guide 5.12 Rev1</rdfs:isDefinedBy>
        <rdfs:label>Physical Key Lock</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#PhysicalLink -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#PhysicalLink">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#Link"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#carries"/>
                <owl:someValuesFrom rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#Signal"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#PhysicalLinkConnectEvent -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#PhysicalLinkConnectEvent">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#PhysicalLinkEvent"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#precedes"/>
                <owl:someValuesFrom rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#PhysicalLinkUpEvent"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <definition>The medium is attached or the port is enabled, establishing electrical or optical continuity so that link negotiation can begin.</definition>
        <rdfs:label>Physical Link Connect Event</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#PhysicalLinkDisableEvent -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#PhysicalLinkDisableEvent">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#PhysicalLinkEvent"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#preceded-by"/>
                <owl:someValuesFrom rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#PhysicalLinkUpEvent"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <definition>An administrator issues a shutdown or disable command, forcing the link out of service regardless of signal status.</definition>
        <rdfs:label>Physical Link Disable Event</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#PhysicalLinkDisconnectEvent -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#PhysicalLinkDisconnectEvent">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#PhysicalLinkEvent"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#preceded-by"/>
                <owl:someValuesFrom rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#PhysicalLinkDownEvent"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <definition>The transmission medium is removed or power is cut, physically breaking the path between the two interfaces.</definition>
        <rdfs:label>Physical Link Disconnect Event</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#PhysicalLinkDownEvent -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#PhysicalLinkDownEvent">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#PhysicalLinkEvent"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#preceded-by"/>
                <owl:someValuesFrom rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#PhysicalLinkUpEvent"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#precedes"/>
                <owl:someValuesFrom rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#PhysicalLinkDisconnectEvent"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <definition>Carrier or negotiation is lost, or the port is shut, rendering the link non-operational while the medium remains connected.</definition>
        <rdfs:label>Physical Link Down Event</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#PhysicalLinkErrorDisableEvent -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#PhysicalLinkErrorDisableEvent">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#PhysicalLinkEvent"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#preceded-by"/>
                <owl:someValuesFrom rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#PhysicalLinkDownEvent"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <definition>The device automatically disables the link in response to fault conditions such as excessive faults or signal degradation.</definition>
        <rdfs:label>Physical Link Error Disable Event</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#PhysicalLinkEvent -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#PhysicalLinkEvent">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#NetworkDeviceEvent"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#has-participant"/>
                <owl:someValuesFrom rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#PhysicalLink"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <definition>A discrete event that changes either the presence of the transmission medium or the operational state of a single-hop layer-1 link between two network nodes.</definition>
        <rdfs:label>Physical Link Event</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#PhysicalLinkMapping -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#PhysicalLinkMapping">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#NetworkMapping"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#maps"/>
                <owl:someValuesFrom rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#NetworkNode"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#maps"/>
                <owl:someValuesFrom rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#PhysicalLink"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#PhysicalLinkUpEvent -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#PhysicalLinkUpEvent">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#PhysicalLinkEvent"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#preceded-by"/>
                <owl:someValuesFrom rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#PhysicalLinkConnectEvent"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#precedes"/>
                <owl:someValuesFrom rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#PhysicalLinkDownEvent"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <definition>Auto-negotiation and signal detection complete; carrier is present and the link can forward frames.</definition>
        <rdfs:label>Physical Link Up Event</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#PhysicalLocation -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#PhysicalLocation">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#D3FENDCore"/>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#PhysicalLock -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#PhysicalLock">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#PhysicalArtifact"/>
        <definition>A lock is a mechanical latching device for securing moveable portions of physical barriers in a secured position.</definition>
        <rdfs:label>Physical Lock</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://dbpedia.org/page/Lock_and_key"/>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#PhysicalLocking -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#PhysicalLocking">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#PhysicalAccessMediation"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#mediates-access-to"/>
                <owl:someValuesFrom rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#ComputerEnclosure"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#Pipe -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#Pipe">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#DigitalInformationBearer"/>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#Pix2Pix -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#Pix2Pix">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#Image-to-ImageTranslationGAN"/>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#Plan -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#Plan">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#D3FENDCore"/>
        <rdfs:label>Plan</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#Planning -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#Planning">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#AnalyticalPurpose"/>
        <rdfs:label>Planning</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#PlatformHardening -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#PlatformHardening">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#DefensiveTechnique"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#enables"/>
                <owl:someValuesFrom rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#Harden"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#PlatformMonitoring -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#PlatformMonitoring">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#DefensiveTechnique"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#enables"/>
                <owl:someValuesFrom rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#Detect"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#PlatformUptime -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#PlatformUptime">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#SystemPlatformVariable"/>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#PlatformUptimeMonitoring -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#PlatformUptimeMonitoring">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#PlatformMonitoring"/>
