    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CommonAttackPattern">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CAPECThing"/>
        <definition>A common attack pattern that is in the CAPEC knowledge base.</definition>
        <rdfs:label>Common Attack Pattern</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#Compiler -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#Compiler">
