    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#ContainerProcess -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#ContainerProcess">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#ApplicationProcess"/>
