    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#OTProtocolMessage">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#Command"/>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#OTReadDeviceConfigurationData -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#OTReadDeviceConfigurationData">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#OTGetData"/>
        <definition>OT command that requests configuration or identification data of a remote device.</definition>
        <rdfs:comment>BACnet/IP: READ_BROADCAST_TABLE
BACnet/IP: READ_FOREIGN_DEVICE_TABLE </rdfs:comment>
        <rdfs:comment>DNP3: Secure Authentication Version
DNP3: Device Manufacturer Hardware Version
DNP3: Device Manufacturer Name
DNP3: Device Manufacturer Product Name and Model
DNP3: Device Manufacturer Software Version
DNP3: Device Serial Number
DNP3: User-Assigned Device Name
DNP3: User-Assigned ID Code or Number
DNP3: User-Assigned Location Name</rdfs:comment>
        <rdfs:comment>GEMS: GetConfig
GEMS: GetConfigList</rdfs:comment>
        <rdfs:comment>Modbus/TCP: REPORT_SLAVE_ID
Modbus/TCP: READ_DEVICE_IDENTIFICATION
Modbus/TCP: REPORT_LOCAL_ADDRESS </rdfs:comment>
        <rdfs:label>OT Read Device Configuration Data</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#OTReadDeviceConfigurationDataEvent -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#OTReadDeviceConfigurationDataEvent">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#OTCommandEvent"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#has-participant"/>
                <owl:someValuesFrom rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#OTReadDeviceConfigurationData"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>OT Read Device Configuration Data Event</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#OTReadDeviceData -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#OTReadDeviceData">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#OTGetData"/>
        <definition>OT command that requests configuration or status details of a remote device.</definition>
        <rdfs:comment>Modbus/TCP: DIAGNOSTICS
DNP3: Non-Specific All Attributes Request
DNP3: List of Attribute Variations</rdfs:comment>
        <rdfs:label>OT Read Device Data</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#OTReadDeviceDataEvent -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#OTReadDeviceDataEvent">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#OTCommandEvent"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#has-participant"/>
                <owl:someValuesFrom rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#OTReadDeviceData"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>OT Read Device Data Event</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#OTReadDeviceMemory -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#OTReadDeviceMemory">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#OTGetData"/>
        <definition>Reads the contents of the specified number of consecutive memory area.</definition>
        <rdfs:label>OT Read Device Memory</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#OTReadDeviceMemoryEvent -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#OTReadDeviceMemoryEvent">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#OTCommandEvent"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#has-participant"/>
                <owl:someValuesFrom rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#OTReadDeviceMemory"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>OT Read Device Memory Event</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#OTReadDeviceStatus -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#OTReadDeviceStatus">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#OTGetData"/>
        <definition>OT command that requests device hardware, state, or parameter status data.</definition>
        <rdfs:comment>BACnet/IP: I_HAVE
BACnet/IP: WHO_HAS
BACnet/IP: GET_ENROLLMENT_SUMMARY
BACnet/IP: GET_EVENT_INFORMATION
BACnet/IP: LIFE_SAFETY_OPERATION
</rdfs:comment>
        <rdfs:label>OT Read Device Status</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#OTReadDeviceStatusEvent -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#OTReadDeviceStatusEvent">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#OTCommandEvent"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#has-participant"/>
                <owl:someValuesFrom rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#OTReadDeviceStatus"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>OT Read Device Status Event</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#OTReadFile -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#OTReadFile">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#OTReadDeviceMemory"/>
        <definition>Reads the contents of a specified  file stored in the file device connected to the PC.</definition>
        <rdfs:comment>BACnet/IP: ATOMIC_READ_FILE</rdfs:comment>
        <rdfs:comment>DNP3: GET_FILE_INFO
DNP3: OPEN_FILE
DNP3: ABORT_FILE
DNP3: CLOSE_FILE
DNP3: AUTHENTICATE_FILE</rdfs:comment>
        <rdfs:comment>Modbus/TCP: READ_FILE_RECORD</rdfs:comment>
        <rdfs:label>OT Read File</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#OTReadFileEvent -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#OTReadFileEvent">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#OTCommandEvent"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#has-participant"/>
                <owl:someValuesFrom rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#OTReadFile"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>OT Read File Event</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#OTReadSetValue -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#OTReadSetValue">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#OTReadDeviceMemory"/>
        <definition>Reads the contents of the specified number of consecutive parameter areawords starting from the specified word.</definition>
        <rdfs:comment>BACnet/IP: READ_PROPERTY
BACnet/IP: READ_PROPERTY_CONDITIONAL
BACnet/IP: READ_PROPERTY_MULTIPLE
BACnet/IP: READ_RANGE
BACnet/IP: REGISTER_FOREIGN_DEVICE </rdfs:comment>
        <rdfs:comment>DNP3: Number of Analog Input Points
DNP3: Number of Analog Outputs
DNP3: Number of Binary Input Points
DNP3: Number of Binary Outputs
DNP3: Number of Counter Points
DNP3: Number of Double-Bit Binary Input Points
DNP3: Number of Master-Defined Data Set Properties
DNP3: Number of Master-Defined Data Sets
DNP3: Number of Outstation-Defined Data Set Properties
DNP3: Number of Outstation-Defined Data Sets
DNP3: Number of Security Statistics per Association
DNP3: Maximum Analog Input Index
DNP3: Maximum Analog Output Index
DNP3: Maximum Binary Input Index
DNP3: Maximum Binary Output Index
DNP3: Maximum Counter Index
DNP3: Maximum Double-Bit Binary Index
DNP3: Maximum Number of Binary Output Objects per Request
DNP3: Maximum Receive Fragment Size
DNP3: Maximum Transmit Fragment Size</rdfs:comment>
        <rdfs:comment>GEMS: GetTargets</rdfs:comment>
        <rdfs:comment>Modbus/TCP: READ_COILS
Modbus/TCP: READ_DISCRETE_INPUTS
Modbus/TCP: READ_FIFO_QUEUE
Modbus/TCP: READ_HOLDING_REGISTERS
Modbus/TCP: READ_INPUT_REGISTERS
Modbus/TCP: READ_WRITE_MULTIPLE_REGISTERS</rdfs:comment>
        <rdfs:label>OT Read Set Value</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#OTReadSetValueEvent -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#OTReadSetValueEvent">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#OTCommandEvent"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#has-participant"/>
                <owl:someValuesFrom rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#OTReadSetValue"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>OT Read Set Value Event</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#OTRemoteService -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#OTRemoteService">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#OTModifyDeviceProgramState"/>
        <definition>Command that places the controller in a mode capable of receiving read/write communication from a networked entity.</definition>
        <rdfs:label>OT Remote Service</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#OTRemoteServiceEvent -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#OTRemoteServiceEvent">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#OTCommandEvent"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#has-participant"/>
                <owl:someValuesFrom rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#OTRemoteService"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>OT Remote Service Event</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#OTRestartDevice -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#OTRestartDevice">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#OTModifyDevicePower"/>
        <definition>Modifies the power state of a device causing to to shut down and then reboot.</definition>
        <rdfs:comment>BACnet/IP: REINITIALIZE_DEVICE</rdfs:comment>
        <rdfs:comment>DNP3: COLD_RESTART
DNP3: WARM_RESTART </rdfs:comment>
        <rdfs:label>OT Restart Device</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#OTRestartDeviceEvent -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#OTRestartDeviceEvent">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#OTCommandEvent"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#has-participant"/>
                <owl:someValuesFrom rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#OTRestartDevice"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>OT Restart Device Event</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#OTSensor -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#OTSensor">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#Sensor"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#may-contain"/>
                <owl:someValuesFrom rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#ClientComputer"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#may-contain"/>
                <owl:someValuesFrom rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#RFTransmitter"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#writes"/>
                <owl:someValuesFrom rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#OTProcessVariable"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#OTServiceStatus -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#OTServiceStatus">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#OTReadDeviceStatus"/>
        <definition>OT command that requests the state or service status of a remote device.</definition>
        <rdfs:comment>Modbus/TCP: GET_COMM_EVENT_COUNTER
Modbus/TCP: GET_COMM_EVENT_LOG </rdfs:comment>
        <rdfs:label>OT Service Status</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#OTServiceStatusEvent -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#OTServiceStatusEvent">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#OTCommandEvent"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#has-participant"/>
                <owl:someValuesFrom rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#OTServiceStatus"/>
