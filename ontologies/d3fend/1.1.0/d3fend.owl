        <published rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2009-05-19T00:00:00</published>
        <contributor rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#DISA_FSO"/>
        <definition>The information system conceals, via the session lock, information previously visible on the display with a publicly viewable image.</definition>
        <rdfs:label>CCI-000060</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CCI-000066_v2022-04-05 -->

    <owl:NamedIndividual rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CCI-000066_v2022-04-05">
