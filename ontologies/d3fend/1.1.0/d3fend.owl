    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#SlowSymbolicLink -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#SlowSymbolicLink">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#SymbolicLink"/>
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#UnixLink"/>
        <definition>A slow symbolic link is any symbolic link on a Unix filesystem that is not a fast symbolic link; slow symlink is thus retroactively termed from fast symlink.  Slow symbolic links stored the symbolic link information as data in regular files.</definition>
        <rdfs:label>Slow Symbolic Link</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dbpedia.org/resource/Symbolic_link#Storage_of_symbolic_links"/>
        <skos:altLabel>Slow Symlink</skos:altLabel>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#Software -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#Software">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#DigitalInformation"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#contains"/>
                <owl:someValuesFrom rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#ExecutableFile"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#implements"/>
                <owl:someValuesFrom rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#Subroutine"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#instructs"/>
                <owl:someValuesFrom rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#Process"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#SoftwareArtifactServer -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#SoftwareArtifactServer">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#ArtifactServer"/>
        <definition>A software artifact server provides access to the software artifacts in a software repository. A software repository, or &quot;repo&quot; for short, is a storage location for software packages. Often a table of contents is stored, as well as metadata. Repositories group packages. Sometimes the grouping is for a programming language, such as CPAN for the Perl programming language, sometimes for an entire operating system, sometimes the license of the contents is the criteria. At client side, a package manager helps installing from and updating the repositories.</definition>
        <rdfs:label>Software Artifact Server</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dbpedia.org/resource/Software_repository"/>
        <rdfs:seeAlso rdf:resource="http://dbpedia.org/resource/Artifact_(software_development)"/>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#SoftwareDeploymentTool -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#SoftwareDeploymentTool">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#ServiceApplication"/>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#SoftwareInventory -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#SoftwareInventory">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#AssetInventory"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#inventories"/>
                <owl:someValuesFrom rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#Software"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#SoftwareLibrary -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#SoftwareLibrary">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#Software"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#contains"/>
                <owl:someValuesFrom rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#SoftwareLibraryFile"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#SoftwareLibraryFile -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#SoftwareLibraryFile">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#File"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#contains"/>
                <owl:someValuesFrom rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#Subroutine"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#may-contain"/>
                <owl:someValuesFrom rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#ExecutableBinary"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#may-contain"/>
                <owl:someValuesFrom rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#ExecutableScript"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#SoftwarePackage -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#SoftwarePackage">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#DigitalInformationBearer"/>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#SoftwarePackagingTool -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#SoftwarePackagingTool">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#BuildTool"/>
        <definition>A tool that automates the process of packaging either or both binary code  and source code for use on one or more target platforms.</definition>
        <rdfs:label>Software Packaging Tool</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dbpedia.org/resource/Build_automation"/>
        <rdfs:seeAlso rdf:resource="http://dbpedia.org/resource/Package_manager"/>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#SoftwarePatch -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#SoftwarePatch">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#Software"/>
        <definition>A patch is a piece of software designed to update a computer program or its supporting data, to fix or improve it. This includes fixing security vulnerabilities and other bugs, with such patches usually called bugfixes or bug fixes, and improving the usability or performance. Although meant to fix problems, poorly designed patches can sometimes introduce new problems (see software regressions). In some special cases updates may knowingly break the functionality, for instance, by removing components for which the update provider is no longer licensed or disabling a device.</definition>
        <rdfs:isDefinedBy rdf:resource="http://dbpedia.org/resource/Patch_(computing)"/>
        <rdfs:label>Software Patch</rdfs:label>
        <skos:altLabel>Patch</skos:altLabel>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#SoftwareRepository -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#SoftwareRepository">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#Repository"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#contains"/>
                <owl:someValuesFrom rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#SoftwarePackage"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#SoftwareUpdate -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#SoftwareUpdate">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#PlatformHardening"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#updates"/>
                <owl:someValuesFrom rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#Software"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#SomersD -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#SomersD">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#RankCorrelationCoefficient"/>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#SoundexMatching -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#SoundexMatching">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#PartialMatching"/>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#SourceCodeAnalyzerTool -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#SourceCodeAnalyzerTool">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#StaticAnalysisTool"/>
        <definition>A source code analyzer tool is a static analysis tool that operates specifically on source code, but not object code.</definition>
        <rdfs:label>Source Code Analyzer Tool</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dbpedia.org/resource/Static_program_analysis"/>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#SourceCodeHardening -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#SourceCodeHardening">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#DefensiveTechnique"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#enables"/>
                <owl:someValuesFrom rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#Harden"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#SourceCodeReference -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#SourceCodeReference">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#TechniqueReference"/>
        <pref-label>Source Code</pref-label>
        <rdfs:label>Source Code Reference</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#SpearmansRankCorrelationCoefficient -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#SpearmansRankCorrelationCoefficient">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#RankCorrelationCoefficient"/>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#SpecificationReference -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#SpecificationReference">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#TechniqueReference"/>
        <pref-label>Specification</pref-label>
        <rdfs:label>Specification Reference</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#SpectralClustering -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#SpectralClustering">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#Graph-basedClustering"/>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#StackComponent -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#StackComponent">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#DigitalInformationBearer"/>
        <definition>A stack component is any component of a call stack used for stack-based memory allocation in a running process.  Examples include saved instruction pointers, stack frames, and stack frame canaries.</definition>
        <rdfs:label>Stack Component</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dbpedia.org/resource/Call_stack"/>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#StackFrame -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#StackFrame">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#StackComponent"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#may-contain"/>
                <owl:someValuesFrom rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#Pointer"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#may-contain"/>
                <owl:someValuesFrom rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#StackFrameCanary"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#StackFrameCanary -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#StackFrameCanary">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#StackComponent"/>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#StackFrameCanaryValidation -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#StackFrameCanaryValidation">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#ApplicationHardening"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#validates"/>
                <owl:someValuesFrom rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#StackFrame"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#StackSegment -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#StackSegment">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#ProcessSegment"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#contains"/>
                <owl:someValuesFrom rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#StackFrame"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#Stacking -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#Stacking">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#EnsembleLearning"/>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#StandaloneHoneynet -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#StandaloneHoneynet">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#DecoyEnvironment"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#spoofs"/>
                <owl:someValuesFrom rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#IntranetNetwork"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#StandardDeviation -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#StandardDeviation">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#Variability"/>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#StartupDirectory -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#StartupDirectory">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#Directory"/>
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#LocalResource"/>
        <definition>A startup directory is a directory containing executable files or links to executable files which are run when a user logs in or when a system component or service is started.</definition>
        <rdfs:label>Startup Directory</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#StaticAnalysisTool -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#StaticAnalysisTool">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CodeAnalyzer"/>
        <definition>A static [program] analysis tool performs an automated analysis of computer software without actually executing programs, in contrast with dynamic analysis, which is analysis performed on programs while they are executing. In most cases the analysis is performed on some version of the source code, and in the other cases, some form of the object code.</definition>
        <rdfs:isDefinedBy rdf:resource="http://dbpedia.org/resource/Static_program_analysis"/>
        <rdfs:label>Static Analysis Tool</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dbpedia.org/resource/Program_analysis"/>
        <rdfs:seeAlso rdf:resource="http://dbpedia.org/resource/Category:Program_analysis"/>
        <skos:altLabel>Static Program Analysis Tool</skos:altLabel>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#StatisticalMethod -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#StatisticalMethod">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#AnalyticTechnique"/>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#Step -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#Step">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#Plan"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#end"/>
                <owl:someValuesFrom rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#Step"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#fork"/>
                <owl:someValuesFrom rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#Step"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#may-be-associated-with"/>
                <owl:someValuesFrom rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#Artifact"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#next"/>
                <owl:someValuesFrom rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#Step"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>Step</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#Storage -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#Storage">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#DigitalInformationBearer"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#may-contain"/>
                <owl:someValuesFrom rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#FileSystem"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#StorageDeviceEvent -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#StorageDeviceEvent">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#HardwareDeviceEvent"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#has-participant"/>
                <owl:someValuesFrom rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#SecondaryStorage"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <definition>An event describing the activity, configuration, or errors of storage devices, including physical disks, SSDs, or logical partitions. These events often pertain to data availability, integrity, and storage health.</definition>
        <rdfs:label>Storage Device Event</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#StorageImage -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#StorageImage">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#ComputingImage"/>
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#File"/>
        <definition>A storage image is a complete, encapsulated representation of a storage medium or system environment. It contains all the data, files, and configurations necessary to replicate or deploy a specific system state or software setup.</definition>
        <rdfs:label>Storage Image</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#StorageSnapshot -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#StorageSnapshot">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#ComputingSnapshot"/>
        <definition>A storage snapshot is a copy of a storage medium or system environment at a point in time.</definition>
        <rdfs:label>Storage Snapshot</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#StoredProcedure -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#StoredProcedure">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#Subroutine"/>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#StringEquivalenceMatching -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#StringEquivalenceMatching">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#EquivalenceMatching"/>
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#StringPatternMatching"/>
    </owl:Class>
    


