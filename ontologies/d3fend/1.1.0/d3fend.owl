                <owl:someValuesFrom rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#OTProgramService"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>OT Program Service Event</rdfs:label>
    </owl:Class>
    


