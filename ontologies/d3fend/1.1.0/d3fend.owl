        <rdfs:comment>The digital artifact mapping for this data source is only applicable to the Scheduled Job Metadata component</rdfs:comment>
        <rdfs:label>Scheduled Job (ATT&amp;CK DS)</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#DS0004 -->

