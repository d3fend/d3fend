        <contributor rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#DISA_FSO"/>
        <definition>The information system, at organization-defined information system components, loads and executes the operating environment from hardware-enforced, read-only media.</definition>
        <rdfs:label>CCI-001210</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CCI-001211_v2022-04-05 -->

    <owl:NamedIndividual rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CCI-001211_v2022-04-05">
