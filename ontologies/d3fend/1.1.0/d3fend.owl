    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#may-create -->

    <owl:ObjectProperty rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#may-create">
        <rdfs:subPropertyOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#may-be-associated-with"/>
        <definition>x may-create y: They entity x may create the entity y; that is, &apos;x creates y&apos; may be true.</definition>
        <rdfs:label>may-create</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#may-deceive -->

    <owl:ObjectProperty rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#may-deceive">
        <rdfs:subPropertyOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#may-counter-attack"/>
        <pref-label>may deceive</pref-label>
        <rdfs:label>may-deceive</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#may-detect -->

    <owl:ObjectProperty rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#may-detect">
        <rdfs:subPropertyOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#may-counter-attack"/>
        <pref-label>may detect</pref-label>
        <rdfs:label>may-detect</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#may-disable -->

    <owl:ObjectProperty rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#may-disable">
        <rdfs:subPropertyOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#may-evict"/>
        <rdfs:label>may-disable</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#may-evaluate -->

    <owl:ObjectProperty rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#may-evaluate">
        <rdfs:subPropertyOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#may-be-associated-with"/>
        <rdfs:label>may-evaluate</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#may-evict -->

    <owl:ObjectProperty rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#may-evict">
