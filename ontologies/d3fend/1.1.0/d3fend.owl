        <kb-reference-of rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#DataExchangeMapping"/>
        <kb-reference-of rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#OperationalActivityMapping"/>
        <kb-reference-of rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#OperationalDependencyMapping"/>
