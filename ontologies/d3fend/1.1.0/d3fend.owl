    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#IOModule -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#IOModule">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#HardwareDevice"/>
        <definition>An I/O Module is a hardware device that translates signals between external sensors or actuators and control systems. It typically handles analog-to-digital (and vice versa) conversion, serving as the data interface that allows physical processes to be monitored and controlled by digital controllers.</definition>
        <rdfs:label>I/O Module</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#IOPortRestriction -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#IOPortRestriction">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#AccessMediation"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#filters"/>
                <owl:someValuesFrom rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#InputDevice"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#filters"/>
                <owl:someValuesFrom rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#RemovableMediaDevice"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#IPAddress -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#IPAddress">
