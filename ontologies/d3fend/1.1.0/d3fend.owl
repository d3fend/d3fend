    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#IntranetDNSLookup -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#IntranetDNSLookup">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#DNSLookup"/>
        <definition>An Intranet Domain Name System (DNS) lookup is a DNS lookup made from a host on a network that is resolved after querying a DNS name server hosted on a that same network.</definition>
        <rdfs:label>Intranet DNS Lookup</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dbpedia.org/resource/Intranet"/>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#IntranetFileTransferTraffic -->

