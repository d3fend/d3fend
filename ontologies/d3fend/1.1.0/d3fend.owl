        <owl:members rdf:parseType="Collection">
            <rdf:Description rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CoefficientOfVariation"/>
            <rdf:Description rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#InterquartileRange"/>
            <rdf:Description rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#MeanAbsoluteDeviation"/>
