    </owl:NamedIndividual>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#DS0022 -->

    <owl:NamedIndividual rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#DS0022">
        <rdf:type rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#ATTACKEnterpriseDataSource"/>
        <narrower rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#FileSystemMetadata"/>
        <definition>A computer resource object, managed by the I/O system, for storing data (such as images, text, videos, computer programs, or any wide variety of other media)</definition>
        <rdfs:comment>The digital artifact mapping for this data source is only applicable to the File Metadata component</rdfs:comment>
        <rdfs:label>File (ATT&amp;CK DS)</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#DS0023 -->

    <owl:NamedIndividual rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#DS0023">
        <rdf:type rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#ATTACKEnterpriseDataSource"/>
        <exactly rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#NamedPipe"/>
        <definition>Mechanisms that allow inter-process communication locally or over the network. A named pipe is usually found as a file and processes attach to it</definition>
        <rdfs:label>Named Pipe (ATT&amp;CK DS)</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#DS0024 -->

    <owl:NamedIndividual rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#DS0024">
        <rdf:type rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#ATTACKEnterpriseDataSource"/>
        <definition>A Windows OS hierarchical database that stores much of the information and settings for software programs, hardware devices, user preferences, and operating-system configurations</definition>
        <rdfs:comment>This data source captures events relating to Windows registry keys and values and therefore has no direct mappings to digital artifacts.</rdfs:comment>
        <rdfs:label>Windows Registry (ATT&amp;CK DS)</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#DS0025 -->

    <owl:NamedIndividual rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#DS0025">
        <rdf:type rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#ATTACKEnterpriseDataSource"/>
        <definition>Infrastructure, platforms, or software that are hosted on-premise or by third-party providers, made available to users through network connections and/or APIs</definition>
        <rdfs:comment>This data source currently has no mappings to digital artifacts.</rdfs:comment>
        <rdfs:label>Cloud Service (ATT&amp;CK DS)</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#DS0026 -->

    <owl:NamedIndividual rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#DS0026">
        <rdf:type rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#ATTACKEnterpriseDataSource"/>
        <definition>A database and set of services that allows administrators to manage permissions, access to network resources, and stored data objects (user, group, application, or devices)</definition>
        <rdfs:comment>This data source captures events relating to Active Directory objects and therefore has no direct mappings to digital artifacts.</rdfs:comment>
        <rdfs:label>Active Directory (ATT&amp;CK DS)</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#DS0027 -->

    <owl:NamedIndividual rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#DS0027">
        <rdf:type rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#ATTACKEnterpriseDataSource"/>
        <definition>A computer program that operates or controls a particular type of device that is attached to a computer. Provides a software interface to hardware devices, enabling operating systems and other computer programs to access hardware functions without needing to know precise details about the hardware being used</definition>
        <rdfs:comment>This data source captures events relating to hardware drivers and therefore has no direct mappings to digital artifacts.</rdfs:comment>
        <rdfs:label>Driver (ATT&amp;CK DS)</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#DS0028 -->

    <owl:NamedIndividual rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#DS0028">
        <rdf:type rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#ATTACKEnterpriseDataSource"/>
        <broader rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#LoginSession"/>
        <definition>Logon occurring on a system or resource (local, domain, or cloud) to which a user/device is gaining access after successful authentication and authorization</definition>
        <rdfs:comment>The digital artifact mapping for this data source is only applicable to the Login Session Metadata component</rdfs:comment>
        <rdfs:label>Logon Session (ATT&amp;CK DS)</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#DS0029 -->

    <owl:NamedIndividual rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#DS0029">
        <rdf:type rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#ATTACKEnterpriseDataSource"/>
        <exactly rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#NetworkTraffic"/>
        <definition>Data transmitted across a network (ex: Web, DNS, Mail, File, etc.), that is either summarized (ex: Netflow) and/or captured as raw data in an analyzable format (ex: PCAP)</definition>
        <rdfs:comment>The digital artifact mapping for this data source is only applicable to the Network Traffic Content component</rdfs:comment>
        <rdfs:label>Network Traffic (ATT&amp;CK DS)</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#DS0030 -->

    <owl:NamedIndividual rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#DS0030">
        <rdf:type rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#ATTACKEnterpriseDataSource"/>
        <definition>A virtual server environment which runs workloads, hosted on-premise or by third-party cloud providers</definition>
        <rdfs:comment>This data source currently has no mappings to digital artifacts.</rdfs:comment>
        <rdfs:label>Instance (ATT&amp;CK DS)</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#DS0032 -->

    <owl:NamedIndividual rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#DS0032">
        <rdf:type rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#ATTACKEnterpriseDataSource"/>
        <definition>A standard unit of virtualized software that packages up code and all its dependencies so the application runs quickly and reliably from one computing environment to another</definition>
        <rdfs:comment>This data source captures events relating to containers and therefore has no direct mappings to digital artifacts.</rdfs:comment>
        <rdfs:label>Container (ATT&amp;CK DS)</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#DS0033 -->

    <owl:NamedIndividual rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#DS0033">
        <rdf:type rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#ATTACKEnterpriseDataSource"/>
        <definition>A storage resource (typically a folder or drive) made available from one host to others using network protocols, such as Server Message Block (SMB) or Network File System (NFS)</definition>
        <rdfs:comment>This data source captures events relating to shared network resources and therefore has no direct mappings to digital artifacts.</rdfs:comment>
        <rdfs:label>Network Share (ATT&amp;CK DS)</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#DS0034 -->

    <owl:NamedIndividual rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#DS0034">
        <rdf:type rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#ATTACKEnterpriseDataSource"/>
        <definition>Block object storage hosted on-premise or by third-party providers, typically made available to resources as virtualized hard drives</definition>
        <rdfs:comment>This data source currently has no mappings to digital artifacts.</rdfs:comment>
        <rdfs:label>Volume (ATT&amp;CK DS)</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#DS0035 -->

    <owl:NamedIndividual rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#DS0035">
        <rdf:type rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#ATTACKEnterpriseDataSource"/>
        <definition>Information obtained (commonly via active network traffic probes or web crawling) regarding various types of resources and servers connected to the public Internet</definition>
        <rdfs:comment>This data source currently has no mappings to digital artifacts.</rdfs:comment>
        <rdfs:label>Internet Scan (ATT&amp;CK DS)</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#DS0036 -->

    <owl:NamedIndividual rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#DS0036">
        <rdf:type rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#ATTACKEnterpriseDataSource"/>
        <exactly rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#UserGroup"/>
        <definition>A collection of multiple user accounts that share the same access rights to the computer and/or network resources and have common security rights</definition>
        <rdfs:comment>The digital artifact mapping for this data source is only applicable to the Group Metadata component</rdfs:comment>
        <rdfs:label>Group (ATT&amp;CK DS)</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#DS0037 -->

    <owl:NamedIndividual rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#DS0037">
        <rdf:type rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#ATTACKEnterpriseDataSource"/>
        <definition>A digital document, which highlights information such as the owner&apos;s identity, used to instill trust in public keys used while encrypting network communications</definition>
        <rdfs:comment>This data source captures events relating to certificates and therefore has no direct mappings to digital artifacts.</rdfs:comment>
        <rdfs:label>Certificate (ATT&amp;CK DS)</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#DS0038 -->

