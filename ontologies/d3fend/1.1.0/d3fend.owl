        <narrower rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#InboundTrafficFiltering"/>
        <narrower rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#OutboundTrafficFiltering"/>
        <published rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2009-09-14T00:00:00</published>
        <contributor rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#DISA_FSO"/>
        <definition>The information system enforces information flow control using organization-defined security policy filters as a basis for flow control decisions for organization-defined information flows.</definition>
        <rdfs:label>CCI-000032</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CCI-000034_v2022-04-05 -->

