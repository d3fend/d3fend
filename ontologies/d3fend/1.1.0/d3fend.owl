            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#UserAccountUpdateEvent -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#UserAccountUpdateEvent">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#UserAccountEvent"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#preceded-by"/>
                <owl:someValuesFrom rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#UserAccountCreationEvent"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <definition>An event capturing updates to a user account, including changes to its attributes or configuration.</definition>
        <rdfs:label>User Account Update Event</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#UserAction -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#UserAction">
