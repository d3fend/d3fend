    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#Modem -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#Modem">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#ComputerNetworkNode"/>
        <definition>A modem -- a portmanteau of &quot;modulator-demodulator&quot; -- is a hardware device that converts data into a format suitable for a transmission medium so that it can be transmitted from one computer to another (historically along telephone wires). A modem modulates one or more carrier wave signals to encode digital information for transmission and demodulates signals to decode the transmitted information. The goal is to produce a signal that can be transmitted easily and decoded reliably to reproduce the original digital data. Modems can be used with almost any means of transmitting analog signals from light-emitting diodes to radio. A common type of modem is one that turns the digital data of a computer into modulated electrical signal for transmission over telephone lines and demodulated by another modem at the receiver side to recover the digital data.</definition>
        <rdfs:isDefinedBy rdf:resource="http://dbpedia.org/resource/Modem"/>
        <rdfs:label>Modem</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#Moments -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#Moments">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#DistributionProperties"/>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#MouseInputDevice -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#MouseInputDevice">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#InputDevice"/>
        <definition>A computer mouse (plural mice or mouses) is a hand-held pointing device that detects two-dimensional motion relative to a surface. This motion is typically translated into the motion of a pointer on a display, which allows a smooth control of the graphical user interface of a computer. In addition to moving a cursor, computer mice have one or more buttons to allow operations such as selection of a menu item on a display. Mice often also feature other elements, such as touch surfaces and scroll wheels, which enable additional control and dimensional input.</definition>
        <rdfs:isDefinedBy rdf:resource="http://dbpedia.org/resource/Computer_mouse"/>
        <rdfs:label>Mouse Input Device</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dbpedia.org/resource/Pointing_device"/>
        <skos:altLabel>Computer Mouse</skos:altLabel>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#MoveFile -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#MoveFile">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#SystemCall"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#modifies"/>
                <owl:someValuesFrom rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#FileSystemMetadata"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#MovingAverageModel -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#MovingAverageModel">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#TimeSeriesAnalysis"/>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#Multi-factorAuthentication -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#Multi-factorAuthentication">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#AgentAuthentication"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#uses"/>
                <owl:someValuesFrom rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#Credential"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#MulticlassClassification -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#MulticlassClassification">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#Classifying"/>
        <rdfs:label>Multiclass Classification</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#MultilayerPerceptronClassification -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#MultilayerPerceptronClassification">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#ArtificialNeuralNetClassification"/>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#MultimediaDocumentFile -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#MultimediaDocumentFile">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#DocumentFile"/>
        <definition>Digital video files which often contain audio.</definition>
        <rdfs:label>Multimedia Document File</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://dbpedia.org/page/Multimedia"/>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#MultimediaFile -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#MultimediaFile">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#File"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#contains"/>
                <owl:someValuesFrom rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#DigitalMultimedia"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#MultipleRegression -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#MultipleRegression">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#RegressionAnalysis"/>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#MultipleRegressionLearning -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#MultipleRegressionLearning">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#RegressionAnalysisLearning"/>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#MultivariateAnalysis -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#MultivariateAnalysis">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#StatisticalMethod"/>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#NISTControl -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#NISTControl">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#ExternalControl"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#member-of"/>
                <owl:someValuesFrom rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#NISTSP800-53ControlCatalog"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>NIST Control</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#NISTSP800-53ControlCatalog -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#NISTSP800-53ControlCatalog">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#ControlCatalog"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#has-member"/>
                <owl:someValuesFrom rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#NISTControl"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <definition>A NIST SP 800-53 control catalog provides the entire set of security and privacy controls for a version of NIST SP 800-53.</definition>
        <rdfs:label>NIST SP 800-53 Control Catalog</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://doi.org/10.6028/NIST.SP.800-53r5"/>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#NTFSHardLink -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#NTFSHardLink">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#HardLink"/>
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#NTFSLink"/>
        <definition>An NTFS hard link points to another file, and files share the same MFT entry (inode), in the same filesystem.</definition>
        <rdfs:isDefinedBy rdf:resource="http://dbpedia.org/resource/NTFS_links"/>
        <rdfs:label>NTFS Hard Link</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dbpedia.org/resource/Hard_link"/>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#NTFSJunctionPoint -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#NTFSJunctionPoint">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#NTFSLink"/>
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#SymbolicLink"/>
        <definition>NTFS junction points are are similar to NTFS symlinks but are defined only for directories. Only accepts local absolute paths.</definition>
        <rdfs:isDefinedBy rdf:resource="http://dbpedia.org/resource/NTFS_links"/>
        <rdfs:label>NTFS Junction Point</rdfs:label>
        <skos:altLabel>Junction Point</skos:altLabel>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#NTFSLink -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#NTFSLink">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#File"/>
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#FileSystemLink"/>
        <definition>The NTFS filesystem defines various ways to link files, i.e. to make a file point to another file or its contents. The object being pointed to is called the target. There are three classes of NTFS links: (a) Hard links, which have files share the same MFT entry (inode), in the same filesystem; (b) Symbolic links, which record the path of another file that the links contents should show and can accept relative paths; and (c) Junction points, which are similar to symlinks but defined only for directories and only accepts local absolute paths</definition>
        <rdfs:label>NTFS Link</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#NTFSSymbolicLink -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#NTFSSymbolicLink">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#NTFSLink"/>
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#SymbolicLink"/>
        <definition>An NTFS symbolic link records the path of another file that the links contents should show. Can accept relative paths. SMB networking (UNC path) and directory support added in NTFS 3.1.</definition>
        <rdfs:isDefinedBy rdf:resource="http://dbpedia.org/resource/NTFS_links"/>
        <rdfs:label>NTFS Symbolic Link</rdfs:label>
        <skos:altLabel>NTFS Symlink</skos:altLabel>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#NTPBroadcastEvent -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#NTPBroadcastEvent">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#NTPEvent"/>
        <definition>An event where an NTP server broadcasts time synchronization messages to multiple clients simultaneously, enabling synchronization without individual request-response cycles.</definition>
        <rdfs:label>NTP Broadcast Event</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#NTPClientSyncEvent -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#NTPClientSyncEvent">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#NTPEvent"/>
        <definition>An event where an NTP client requests and adjusts its clock based on time synchronization data provided by an NTP server, ensuring alignment with a standard time source.</definition>
        <rdfs:label>NTP Client Synchronization Event</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#NTPControlMessageEvent -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#NTPControlMessageEvent">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#NTPEvent"/>
        <definition>An event where an NTP client or server exchanges control messages used for diagnostic, monitoring, or administrative management of the NTP protocol, rather than time synchronization.</definition>
        <rdfs:label>NTP Control Message Event</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#NTPEvent -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#NTPEvent">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#ApplicationLayerEvent"/>
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#UDPEvent"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#has-participant"/>
                <owl:someValuesFrom rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#NetworkTimeServer"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <definition>An event involving the Network Time Protocol (NTP), a protocol designed to synchronize the clocks of computer systems over packet-switched, variable-latency data networks, UDP as its transport protocol.</definition>
        <rdfs:label>NTP Event</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://schema.ocsf.io/1.3.0/classes/ntp_activity"/>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#NTPServerResponseEvent -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#NTPServerResponseEvent">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#NTPEvent"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#preceded-by"/>
                <owl:someValuesFrom rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#NTPClientSyncEvent"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <definition>An event where an NTP server sends time synchronization data to a client, enabling the client to align its local clock with the server&apos;s reference time.</definition>
        <rdfs:label>NTP Server Response Event</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#NTPSymmetricActiveExchangeEvent -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#NTPSymmetricActiveExchangeEvent">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#NTPEvent"/>
        <definition>An event where an NTP peer operating in symmetric active mode initiates clock synchronization messages to a peer in symmetric passive mode, enabling time synchronization between equal-status systems.</definition>
        <rdfs:label>NTP Symmetric Active Exchange Event</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#NTPSymmetricPassiveExchangeEvent -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#NTPSymmetricPassiveExchangeEvent">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#NTPEvent"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#preceded-by"/>
                <owl:someValuesFrom rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#NTPSymmetricActiveExchangeEvent"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <definition>An event where an NTP peer operating in symmetric passive mode responds to clock synchronization messages initiated by a symmetric active peer, facilitating mutual timekeeping.</definition>
        <rdfs:label>NTP Symmetric Passive Exchange Event</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#NaiveBayesClassifier -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#NaiveBayesClassifier">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#Classification"/>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#NamedPipe -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#NamedPipe">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#Pipe"/>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#Network -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#Network">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#DigitalInformationBearer"/>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#NetworkAccessMediation -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#NetworkAccessMediation">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#AccessMediation"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#isolates"/>
                <owl:someValuesFrom rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#Network"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#NetworkAudioStreamingResource -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#NetworkAudioStreamingResource">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#NetworkMediaStreamingResource"/>
        <definition>A server that provides digital audio media content to users.</definition>
        <rdfs:label>Network Audio Streaming Resource</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#NetworkAudioVisualStreamingResource -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#NetworkAudioVisualStreamingResource">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#NetworkMultimediaStreamingResource"/>
        <definition>A server that provides digital audio-visual media content to users.</definition>
        <rdfs:label>Network Audio Visual Streaming Resource</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#NetworkCardFirmware -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#NetworkCardFirmware">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#PeripheralFirmware"/>
        <definition>Firmware that is installed on a network card (network interface controller).</definition>
        <rdfs:label>Network Card Firmware</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dbpedia.org/resource/Network_interface_controller"/>
        <skos:altLabel>Network Controller Firmware</skos:altLabel>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#NetworkConnectionCloseEvent -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#NetworkConnectionCloseEvent">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#NetworkConnectionEvent"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#preceded-by"/>
                <owl:someValuesFrom rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#NetworkConnectionOpenEvent"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <definition>An event where a network connection is closed.</definition>
        <rdfs:label>Network Connection Close Event</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#NetworkConnectionEvent -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#NetworkConnectionEvent">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#NetworkEvent"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#has-participant"/>
                <owl:someValuesFrom rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#NetworkSession"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <definition>An event related to the establishment, maintenance, or termination of a network connection.</definition>
        <rdfs:label>Network Connection Event</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://schema.ocsf.io/1.3.0/classes/network_activity"/>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#NetworkConnectionFailEvent -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#NetworkConnectionFailEvent">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#NetworkConnectionEvent"/>
        <definition>An event where a network connection attempt fails.</definition>
        <rdfs:label>Network Connection Fail Event</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#NetworkConnectionListenEvent -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#NetworkConnectionListenEvent">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#NetworkConnectionEvent"/>
        <definition>An event where a network endpoint begins listening for new network connections.</definition>
        <rdfs:label>Network Connection Listen Event</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#NetworkConnectionOpenEvent -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#NetworkConnectionOpenEvent">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#NetworkConnectionEvent"/>
        <definition>An event where a network connection is successfully opened.</definition>
        <rdfs:label>Network Connection Open Event</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#NetworkConnectionRefuseEvent -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#NetworkConnectionRefuseEvent">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#NetworkConnectionEvent"/>
        <definition>An event where a network connection is refused.</definition>
        <rdfs:label>Network Connection Refuse Event</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#NetworkConnectionResetEvent -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#NetworkConnectionResetEvent">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#NetworkConnectionEvent"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#preceded-by"/>
                <owl:someValuesFrom rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#NetworkConnectionOpenEvent"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <definition>An event where an attempt is made to establish a network connection.</definition>
        <rdfs:label>Network Connection Reset Event</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#NetworkDeviceEvent -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#NetworkDeviceEvent">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#HardwareDeviceEvent"/>
        <definition>An event capturing the activity or state of network devices, such as Ethernet adapters, Wi-Fi modules, or virtual interfaces. These events highlight connectivity, configuration, or performance changes.</definition>
        <rdfs:label>Network Device Event</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#NetworkDirectoryResource -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#NetworkDirectoryResource">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#NetworkFileShareResource"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#contains"/>
                <owl:someValuesFrom rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#Directory"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#NetworkEvent -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#NetworkEvent">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#DigitalEvent"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#has-participant"/>
                <owl:someValuesFrom rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#NetworkTraffic"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <definition>An event involving network communications within or between digital systems.</definition>
        <rdfs:label>Network Event</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://schema.ocsf.io/1.3.0/categories/network"/>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#NetworkFileResource -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#NetworkFileResource">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#NetworkFileShareResource"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#contains"/>
                <owl:someValuesFrom rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#File"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#NetworkFileShareResource -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#NetworkFileShareResource">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#NetworkResource"/>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#NetworkFlow -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#NetworkFlow">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#DigitalInformation"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#summarizes"/>
                <owl:someValuesFrom rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#NetworkTraffic"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#NetworkFlowSensor -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#NetworkFlowSensor">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#NetworkSensor"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#monitors"/>
                <owl:someValuesFrom rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#NetworkFlow"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#NetworkFrame -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#NetworkFrame">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#DigitalInformationBearer"/>
        <definition>A finite, self-delimited sequence of bits exchanged as one unit over a single data link. Formed by link-layer encapsulation, a frame typically begins with synchronization and control fields, carries a payload, ends with an integrity check, and is bounded from adjacent frames by explicit timing or delimiter symbols.</definition>
        <rdfs:isDefinedBy rdf:resource="http://dbpedia.org/resource/Frame_(networking)"/>
        <rdfs:label>Network Frame</rdfs:label>
        <skos:altLabel>Frame</skos:altLabel>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#NetworkInitScriptFileResource -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#NetworkInitScriptFileResource">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#InitScript"/>
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#NetworkFileResource"/>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#NetworkInterfaceCard -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#NetworkInterfaceCard">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#HardwareDevice"/>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#NetworkIsolation -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#NetworkIsolation">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#DefensiveTechnique"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#enables"/>
                <owl:someValuesFrom rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#Isolate"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#NetworkLink -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#NetworkLink">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#LogicalLink"/>
        <definition>A network link is a link within the network layer, which is responsible for packet forwarding including routing through intermediate routers.</definition>
        <synonym>Layer-3 Link</synonym>
        <synonym>Network Layer Link</synonym>
        <rdfs:label>Network Link</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://dbpedia.org/resource/Network_layer"/>
        <rdfs:seeAlso rdf:resource="https://www.techtarget.com/searchnetworking/definition/Network-layer"/>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#NetworkMapping -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#NetworkMapping">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#DefensiveTechnique"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#enables"/>
                <owl:someValuesFrom rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#Model"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#NetworkMediaStreamingResource -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#NetworkMediaStreamingResource">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#NetworkResource"/>
        <definition>A server that provides digital media content to users.</definition>
        <rdfs:label>Network Media Streaming Resource</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#NetworkMultimediaStreamingResource -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#NetworkMultimediaStreamingResource">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#NetworkMediaStreamingResource"/>
        <definition>A server that provides digital multimedia content to users.</definition>
        <rdfs:label>Network Multimedia Streaming Resource</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#NetworkNode -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#NetworkNode">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#DigitalInformationBearer"/>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#NetworkNodeInventory -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#NetworkNodeInventory">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#AssetInventory"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#inventories"/>
                <owl:someValuesFrom rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#NetworkNode"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#NetworkPacket -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#NetworkPacket">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#DigitalInformationBearer"/>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#NetworkPrinter -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#NetworkPrinter">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#SharedComputer"/>
        <definition>In computing, a network printer is a device that can be accessed over a network which makes a persistent representation of graphics or text, usually on paper. While most output is human-readable, bar code printers are an example of an expanded use for printers. The different types of printers include 3D printer, inkjet printer, laser printer, thermal printer, etc.  Note that not all printers are networked and the digital information to be printed must be passed either by removable media or as directly connecting the printer to a computer (e.g., by USB.)</definition>
        <rdfs:isDefinedBy rdf:resource="http://dbpedia.org/resource/Printer_(computing)"/>
        <rdfs:label>Network Printer</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#NetworkProtocolAnalyzer -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#NetworkProtocolAnalyzer">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#NetworkSensor"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#monitors"/>
                <owl:someValuesFrom rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#NetworkTraffic"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#NetworkResource -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#NetworkResource">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#RemoteResource"/>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#NetworkResourceAccess -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#NetworkResourceAccess">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#ResourceAccess"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#accesses"/>
                <owl:someValuesFrom rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#NetworkResource"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#accesses"/>
                <owl:someValuesFrom rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#Resource"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#NetworkResourceAccessMediation -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#NetworkResourceAccessMediation">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#AccessMediation"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#isolates"/>
                <owl:someValuesFrom rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#NetworkResource"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#NetworkScanner -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#NetworkScanner">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CyberSensor"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#monitors"/>
                <owl:someValuesFrom rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#Network"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#NetworkSensor -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#NetworkSensor">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CyberSensor"/>
        <rdfs:label>Network Sensor</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#NetworkService -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#NetworkService">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#ServiceApplicationProcess"/>
        <definition>In computer networking, a network service is an application running at the network application layer and above, that provides data storage, manipulation, presentation, communication or other capability which is often implemented using a client-server or peer-to-peer architecture based on application layer network protocols. Clients and servers will often have a user interface, and sometimes other hardware associated with it.</definition>
        <rdfs:isDefinedBy rdf:resource="http://dbpedia.org/resource/Network_service"/>
        <rdfs:label>Network Service</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#NetworkSession -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#NetworkSession">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#Session"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#produces"/>
                <owl:someValuesFrom rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#NetworkTraffic"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#NetworkTimeServer -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#NetworkTimeServer">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#Server"/>
        <definition>A network time server is a server computer that reads the actual time from a reference clock and distributes this information to its clients using a computer network. The time server may be a local network time server or an internet time server. The time server may also be a stand-alone hardware device. It can use NTP (RFC5905) or other protocols.</definition>
        <rdfs:label>Network Time Server</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dbpedia.org/resource/Time_server"/>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#NetworkTraffic -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#NetworkTraffic">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#DigitalInformationBearer"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#contains"/>
                <owl:someValuesFrom rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#NetworkPacket"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#may-contain"/>
                <owl:someValuesFrom rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#DomainName"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#originates-from"/>
                <owl:someValuesFrom rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#PhysicalLocation"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


