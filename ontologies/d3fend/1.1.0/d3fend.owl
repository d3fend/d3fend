        <contributor rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#DISA_FSO"/>
        <definition>The information system automatically removes or disables emergency accounts after an organization-defined time period for each type of account.</definition>
        <rdfs:label>CCI-001682</rdfs:label>
    </owl:NamedIndividual>
    


