                <owl:someValuesFrom rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#WindowsRegistryKeyCreationEvent"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <definition>An event representing the export of registry key data from the Windows Registry to an external file or format.</definition>
