                <owl:someValuesFrom rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#Process"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#AccessToken -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#AccessToken">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#Credential"/>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#AccountLocking -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#AccountLocking">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CredentialEviction"/>
