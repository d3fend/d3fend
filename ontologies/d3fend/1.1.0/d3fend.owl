                <owl:someValuesFrom rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CreateProcess"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#ProcessSuspension -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#ProcessSuspension">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#ProcessEviction"/>
