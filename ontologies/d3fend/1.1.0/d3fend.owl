    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#Metadata -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#Metadata">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#DigitalInformation"/>
