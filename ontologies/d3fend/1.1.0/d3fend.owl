        <published rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2009-09-22T00:00:00</published>
        <contributor rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#DISA_FSO"/>
        <definition>The organization employs automated patch management tools to facilitate flaw remediation to organization-defined information system components.</definition>
        <rdfs:label>CCI-001237</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CCI-001239_v2022-04-05 -->

    <owl:NamedIndividual rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CCI-001239_v2022-04-05">
        <rdf:type rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CCIControl"/>
        <broader rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#FileAnalysis"/>
        <broader rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#NetworkTrafficAnalysis"/>
        <broader rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#PlatformMonitoring"/>
        <broader rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#ProcessAnalysis"/>
        <member-of rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CCICatalog_v2022-04-05"/>
