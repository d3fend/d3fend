        <kb-reference-of rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CertificatePinning"/>
        <has-link rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://owasp.org/www-community/controls/Certificate_and_Public_Key_Pinning</has-link>
        <kb-reference-title>Certificate and Public Key Pinning</kb-reference-title>
        <kb-abstract>Certificate and Public Key Pinning technical guide to implementing certificate and public key pinning.</kb-abstract>
        <kb-author>OWASP</kb-author>
        <kb-organization>OWASP</kb-organization>
        <rdfs:label>Reference - Certificate and Public Key Pinning</rdfs:label>
