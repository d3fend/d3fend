    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#SystemVulnerabilityAssessment">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#SystemMapping"/>
        <rdfs:subClassOf>
