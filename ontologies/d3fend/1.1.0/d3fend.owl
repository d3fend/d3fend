    </owl:DatatypeProperty>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#process-command-line-arguments -->

    <owl:DatatypeProperty rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#process-command-line-arguments">
        <rdfs:subPropertyOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#process-data-property"/>
        <definition>x process-command-line-arguments y: The process x has the process command line arguments data y.</definition>
        <rdfs:label>process-command-line-arguments</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#process-data-property -->

