    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#Estimation">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#InferentialStatistics"/>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#EvalFunction -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#EvalFunction">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#Subroutine"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#invokes"/>
                <owl:someValuesFrom rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#Subroutine"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#Event -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#Event">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#D3FENDCore"/>
        <rdfs:label>Event</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#EventLog -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#EventLog">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#Log"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#contains"/>
                <owl:someValuesFrom rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#DigitalEventRecord"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#EventLogArchiveEvent -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#EventLogArchiveEvent">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#EventLogEvent"/>
        <definition>An event involving the archiving of event log data, typically to preserve historical records in a compressed or secure format.</definition>
        <rdfs:label>Event Log Archive Event</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#EventLogClearEvent -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#EventLogClearEvent">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#EventLogEvent"/>
        <definition>An event where the event log data is cleared from the system, often as part of log maintenance or potentially to cover tracks.</definition>
        <rdfs:label>Event Log Clear Event</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#EventLogDeleteEvent -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#EventLogDeleteEvent">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#EventLogEvent"/>
        <definition>An event where the event log database, file, or cache is deleted from the system, removing the log&apos;s historical records.</definition>
        <rdfs:label>Event Log Delete Event</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#EventLogDisableEvent -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#EventLogDisableEvent">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#EventLogEvent"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#preceded-by"/>
                <owl:someValuesFrom rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#EventLogEnableEvent"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <definition>An event indicating that the event logging service has been disabled, preventing it from collecting or recording logs.</definition>
        <rdfs:label>Event Log Disable Event</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#EventLogEnableEvent -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#EventLogEnableEvent">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#EventLogEvent"/>
        <definition>An event where the event logging service is enabled, allowing it to actively collect and record logs.</definition>
        <rdfs:label>Event Log Enable Event</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#EventLogEvent -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#EventLogEvent">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#DigitalEvent"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#has-participant"/>
                <owl:someValuesFrom rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#EventLog"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <definition>An event that captures actions or operations related to the management of system event logs, including modifications, access, and service state changes.</definition>
        <rdfs:label>Event Log Event</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://schema.ocsf.io/1.3.0/classes/event_log"/>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#EventLogExportEvent -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#EventLogExportEvent">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#EventLogEvent"/>
        <definition>An event representing the export of event log data to a file or external system for backup or analysis purposes.</definition>
        <rdfs:label>Event Log Export Event</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#EventLogRestartEvent -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#EventLogRestartEvent">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#EventLogEvent"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#preceded-by"/>
                <owl:someValuesFrom rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#EventLogStopEvent"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#precedes"/>
                <owl:someValuesFrom rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#EventLogStartEvent"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <definition>An event representing the restarting of the event logging service, often performed during system maintenance or troubleshooting.</definition>
        <rdfs:label>Event Log Restart Event</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#EventLogRotateEvent -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#EventLogRotateEvent">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#EventLogEvent"/>
        <definition>An event where the event log is rotated, often as part of log rotation policies to manage storage and ensure continuity.</definition>
        <rdfs:label>Event Log Rotate Event</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#EventLogStartEvent -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#EventLogStartEvent">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#EventLogEvent"/>
        <definition>An event where the event logging service is started, enabling the collection and recording of system events.</definition>
        <rdfs:label>Event Log Start Event</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#EventLogStopEvent -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#EventLogStopEvent">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#EventLogEvent"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#preceded-by"/>
                <owl:someValuesFrom rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#EventLogStartEvent"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <definition>An event indicating that the event logging service has been stopped, halting the recording of system events.</definition>
        <rdfs:label>Event Log Stop Event</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#Evict -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#Evict">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#DefensiveTactic"/>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#EvictionEvent -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#EvictionEvent">
