            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#InputDeviceEvent -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#InputDeviceEvent">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#HardwareDeviceEvent"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#has-participant"/>
                <owl:someValuesFrom rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#InputDevice"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <definition>An event involving human-machine interface devices, such as keyboards, mice, or touchscreens.</definition>
        <rdfs:label>Input Device Event</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#InputFunction -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#InputFunction">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#Subroutine"/>
        <definition>Generic function that receives input from an untrusted source.</definition>
        <rdfs:label>Input Function</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#Instance-basedTransferLearning -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#Instance-basedTransferLearning">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#HomogenousTransferLearning"/>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#InstantMessagingClient -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#InstantMessagingClient">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CollaborativeSoftware"/>
        <definition>Client software used to engage in Instant Messaging, a type of online chat that offers real-time text transmission over the Internet. A LAN messenger operates in a similar way over a local area network. Short messages are typically transmitted between two parties, when each user chooses to complete a thought and select &quot;send&quot;. Some IM applications can use push technology to provide real-time text, which transmits messages character by character, as they are composed. More advanced instant messaging can add file transfer, clickable hyperlinks, Voice over IP, or video chat.</definition>
        <rdfs:isDefinedBy rdf:resource="https://dbpedia.org/wiki/Instant_messaging"/>
        <rdfs:label>Instant Messaging Client</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#IntegerRangeValidation -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#IntegerRangeValidation">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#SourceCodeHardening"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#hardens"/>
                <owl:someValuesFrom rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#MathematicalFunction"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#IntegratedHoneynet -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#IntegratedHoneynet">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#DecoyEnvironment"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#spoofs"/>
                <owl:someValuesFrom rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#IntranetNetwork"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#IntegrationTestExecutionTool -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#IntegrationTestExecutionTool">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#TestExecutionTool"/>
        <definition>An integration test execution tool automatically performs integration testing.  Integration testing (sometimes called integration and testing, abbreviated I&amp;T) is the phase in software testing in which individual software modules are combined and tested as a group.</definition>
        <rdfs:label>Integration Test Execution Tool</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dbpedia.org/resource/Integration_testing"/>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#InternetArticleReference -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#InternetArticleReference">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#TechniqueReference"/>
        <pref-label>Internet Article</pref-label>
        <rdfs:label>Internet Article Reference</rdfs:label>
        <skos:altLabel>Internet Blog Reference</skos:altLabel>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#InternetBasedAttacker -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#InternetBasedAttacker">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#RemoteAttacker"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#accesses"/>
                <owl:someValuesFrom rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#WideAreaNetwork"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <definition>A remote attacker who leverages the internet to conduct attacks, such as through phishing, malware, or direct network attacks.</definition>
        <rdfs:label>Internet-based Attacker</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#InternetDNSLookup -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#InternetDNSLookup">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#DNSLookup"/>
        <definition>An internet Domain Name System (DNS) lookup is a DNS lookup made from a host on a network that is resolved after querying a DNS name server hosted on a different network.</definition>
        <rdfs:label>Internet DNS Lookup</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dbpedia.org/resource/Internetworking"/>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#InternetFileTransferTraffic -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#InternetFileTransferTraffic">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#FileTransferNetworkTraffic"/>
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#InternetNetworkTraffic"/>
        <definition>Internet file transfer network traffic is network traffic related to file transfers between network nodes that crosses a boundary between networks. This includes only network traffic conforming to standard file transfer protocols, not custom transfer protocols.</definition>
        <rdfs:label>Internet File Transfer Traffic</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#InternetNetwork -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#InternetNetwork">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#Network"/>
        <definition>A network of multiple, connected networks. Internetworking is the practice of connecting a computer network with other networks through the use of gateways that provide a common method of routing information packets between the networks. The resulting system of interconnected networks are called an internetwork, or simply an internet. Internetworking is a combination of the words inter (&quot;between&quot;) and networking; not internet-working or international-network.</definition>
        <rdfs:isDefinedBy rdf:resource="http://dbpedia.org/resource/Internetworking"/>
        <rdfs:label>Internet Network</rdfs:label>
        <skos:altLabel>Interconnected Network</skos:altLabel>
        <skos:altLabel>Internet</skos:altLabel>
        <skos:altLabel>Internetwork</skos:altLabel>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#InternetNetworkTraffic -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#InternetNetworkTraffic">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#NetworkTraffic"/>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#InternetPersona -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#InternetPersona">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#DigitalInformationBearer"/>
        <definition>A social identity that an Internet user establishes in online communities and websites. It may also be an actively constructed presentation of oneself.</definition>
        <rdfs:isDefinedBy rdf:resource="http://dbpedia.org/resource/Online_identity"/>
        <rdfs:label>Internet Persona</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://en.wikipedia.org/wiki/Online_identity"/>
        <skos:altLabel>Online Identity</skos:altLabel>
        <skos:altLabel>Online Persona</skos:altLabel>
        <skos:altLabel>Online Personality</skos:altLabel>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#InterprocessCommunication -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#InterprocessCommunication">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#DigitalInformationBearer"/>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#InterquartileRange -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#InterquartileRange">
