            </owl:Restriction>
        </rdfs:subClassOf>
        <definition>An event involving the application of cryptographic techniques to a file, ensuring its content is securely encoded and inaccessible without proper decryption keys.</definition>
        <rdfs:label>File Encryption Event</rdfs:label>
    </owl:Class>
    


