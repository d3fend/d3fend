        <contributor rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#DISA_FSO"/>
        <definition>The information system implements replay-resistant authentication mechanisms for network access to privileged accounts.</definition>
        <rdfs:label>CCI-001941</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CCI-001953_v2022-04-05 -->

