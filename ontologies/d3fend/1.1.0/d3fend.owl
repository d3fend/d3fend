        <kb-reference-title>Red Hat Enterprise Linux 8 Security Technical Implementation Guide</kb-reference-title>
        <kb-abstract>Red Hat Enterprise Linux 8 Security Guidelines</kb-abstract>
        <rdfs:label>Reference - Red Hat Enterprise Linux 8 Security Technical Implementation Guide</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#Reference-ReferenceNullification_SecureSoftwareInc -->

    <owl:NamedIndividual rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#Reference-ReferenceNullification_SecureSoftwareInc">
