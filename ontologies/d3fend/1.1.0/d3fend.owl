    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#Switch -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#Switch">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#ComputerNetworkNode"/>
        <definition>A network switch (also called switching hub, bridging hub, and by the IEEE MAC bridge) is networking hardware that connects devices on a computer network by using packet switching to receive and forward data to the destination device. A network switch is a multiport network bridge that uses MAC addresses to forward data at the data link layer (layer 2) of the OSI model. Some switches can also forward data at the network layer (layer 3) by additionally incorporating routing functionality. Such switches are commonly known as layer-3 switches or multilayer switches.</definition>
        <rdfs:isDefinedBy rdf:resource="http://dbpedia.org/resource/Network_switch"/>
        <rdfs:label>Switch</rdfs:label>
        <skos:altLabel>Bridging Hub</skos:altLabel>
        <skos:altLabel>MAC Bridge</skos:altLabel>
        <skos:altLabel>Network Switch</skos:altLabel>
        <skos:altLabel>Switching Hub</skos:altLabel>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#SymbolicAI -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#SymbolicAI">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#SymbolicLogic"/>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#SymbolicLink -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#SymbolicLink">
