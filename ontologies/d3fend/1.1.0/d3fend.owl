    <rdf:Description rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#OutboundInternetEncryptedRemoteTerminalTraffic">
        <definition>Outbound internet encrypted remote terminal traffic is encrypted network traffic for a standard remote terminal protocol on an outgoing connection initiated from a host within a network to a host outside the network.</definition>
        <rdfs:label>Outbound Internet Encrypted Remote Terminal Traffic</rdfs:label>
        <skos:altLabel>Outbound Internet Encrypted RDP Traffic</skos:altLabel>
        <skos:altLabel>Outbound Internet Encrypted SSH Traffic</skos:altLabel>
    </rdf:Description>
    <rdf:Description rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#OutboundInternetEncryptedTraffic">
        <definition>Outbound internet encrypted traffic is encrypted network traffic on an outgoing connection initiated from a host within a network to a host outside the network.</definition>
        <rdfs:label>Outbound Internet Encrypted Traffic</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dbpedia.org/resource/Internetworking"/>
    </rdf:Description>
    <rdf:Description rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#OutboundInternetEncryptedWebTraffic">
        <definition>Outbound internet encrypted web traffic is network traffic using a standard web protocol on an outgoing connection initiated from a host within a network to a host outside the network.</definition>
        <rdfs:label>Outbound Internet Encrypted Web Traffic</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dbpedia.org/resource/Internetworking"/>
    </rdf:Description>
    <rdf:Description rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#OutboundInternetFileTransferTraffic">
        <definition>Outbound internet file transfer traffic is file transfer traffic that is: (a) on an outgoing connection initiated from a host within a network to a host outside the network, and (b) using a standard file transfer protocol.</definition>
        <rdfs:label>Outbound Internet File Transfer Traffic</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dbpedia.org/resource/File_transfer"/>
        <rdfs:seeAlso rdf:resource="http://dbpedia.org/resource/Internetworking"/>
    </rdf:Description>
    <rdf:Description rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#OutboundInternetMailTraffic">
        <definition>Outbound internet DNS lookup traffic is network traffic using a standard email protocol on an outgoing connection initiated from a host within a network to a host outside the network.</definition>
        <rdfs:label>Outbound Internet Mail Traffic</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dbpedia.org/resource/Internetworking"/>
        <skos:altLabel>Outbound Internet Email Traffic</skos:altLabel>
