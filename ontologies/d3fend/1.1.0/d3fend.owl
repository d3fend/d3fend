        <rdfs:label>may-be-invoked-by</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#may-be-isolated-by -->

    <owl:ObjectProperty rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#may-be-isolated-by">
        <rdfs:subPropertyOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#attack-may-be-countered-by"/>
        <owl:inverseOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#may-isolate"/>
        <pref-label>may be isolated by</pref-label>
        <rdfs:label>may-be-isolated-by</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#may-be-modified-by -->

    <owl:ObjectProperty rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#may-be-modified-by">
        <rdfs:subPropertyOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#may-be-associated-with"/>
        <owl:inverseOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#may-modify"/>
        <rdfs:label>may-be-modified-by</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#may-be-tactically-associated-with -->

    <owl:ObjectProperty rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#may-be-tactically-associated-with">
        <rdfs:subPropertyOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#may-be-associated-with"/>
        <definition>x may-be-tactically-associated-with y: the defensive action x may be a tactic that counters offensive action y.</definition>
        <rdfs:label>may-be-tactically-associated-with</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#may-be-weakness-of -->

    <owl:ObjectProperty rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#may-be-weakness-of">
