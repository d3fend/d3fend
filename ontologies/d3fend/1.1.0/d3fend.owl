    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#T1547.010 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#T1547.010">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#T1547"/>
        <rdfs:subClassOf>
