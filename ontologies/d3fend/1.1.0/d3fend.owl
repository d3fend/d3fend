    </owl:ObjectProperty>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#may-execute -->

    <owl:ObjectProperty rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#may-execute">
        <rdfs:subPropertyOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#may-be-associated-with"/>
        <definition>x may execute y: The subject x might take the action of carrying out (executing) y, which is a single software module, function, or instruction.</definition>
        <rdfs:label>may-execute</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#may-harden -->

    <owl:ObjectProperty rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#may-harden">
        <rdfs:subPropertyOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#may-counter-attack"/>
        <pref-label>may harden</pref-label>
        <rdfs:label>may-harden</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#may-have-weakness -->

    <owl:ObjectProperty rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#may-have-weakness">
        <rdfs:subPropertyOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#may-be-associated-with"/>
        <rdfs:domain rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#Artifact"/>
        <rdfs:range rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#Weakness"/>
        <rdfs:label>may-have-weakness</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#may-interpret -->

    <owl:ObjectProperty rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#may-interpret">
        <rdfs:subPropertyOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#may-be-associated-with"/>
        <definition>x may-interpret y: They entity x may interpret the thing y; that is, &apos;x interprets y&apos; may be true.</definition>
        <rdfs:label>may-interpret</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#may-invoke -->

    <owl:ObjectProperty rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#may-invoke">
        <rdfs:subPropertyOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#may-be-associated-with"/>
        <definition>x may-invoke y: They entity x may invoke the thing y; that is, &apos;x invokes y&apos; may be true.</definition>
        <rdfs:label>may-invoke</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#may-isolate -->

    <owl:ObjectProperty rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#may-isolate">
        <rdfs:subPropertyOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#may-counter-attack"/>
        <pref-label>may isolate</pref-label>
        <rdfs:label>may-isolate</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#may-map -->

    <owl:ObjectProperty rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#may-map">
        <rdfs:subPropertyOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#may-be-associated-with"/>
        <rdfs:label>may-map</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#may-modify -->

    <owl:ObjectProperty rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#may-modify">
        <rdfs:subPropertyOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#may-be-associated-with"/>
        <definition>x may-modify y: They entity x may modify the thing y; that is, &apos;x modifies y&apos; may be true.</definition>
        <rdfs:label>may-modify</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#may-produce -->

    <owl:ObjectProperty rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#may-produce">
        <rdfs:subPropertyOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#may-be-associated-with"/>
        <definition>x may-produce y: They entity x may produce the thing y; that is, &apos;x produces y&apos; may be true.</definition>
        <rdfs:label>may-produce</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#may-query -->

    <owl:ObjectProperty rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#may-query">
        <rdfs:subPropertyOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#may-be-associated-with"/>
        <rdfs:label>may-query</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#may-run -->

    <owl:ObjectProperty rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#may-run">
        <rdfs:subPropertyOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#may-be-associated-with"/>
        <definition>x may-run y: They entity x may run the thing y; that is, &apos;x runs y&apos; may be true.</definition>
        <rdfs:label>may-run</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#may-transfer -->

    <owl:ObjectProperty rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#may-transfer">
        <rdfs:subPropertyOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#may-be-associated-with"/>
        <definition>x may-transfer y: They entity x might send the thing y; that is, &apos;x transfers y&apos; may be true.</definition>
        <rdfs:label>may-transfer</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#mediates-access-to -->

    <owl:ObjectProperty rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#mediates-access-to">
        <rdfs:subPropertyOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#associated-with"/>
        <rdfs:label>mediates-access-to</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#member-of -->

    <owl:ObjectProperty rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#member-of">
        <rdfs:subPropertyOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#d3fend-kb-object-property"/>
        <rdfs:label>member-of</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#modified-by -->

    <owl:ObjectProperty rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#modified-by">
        <rdfs:subPropertyOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#associated-with"/>
        <rdfs:subPropertyOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#may-be-modified-by"/>
        <owl:inverseOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#modifies"/>
        <rdfs:label>modified-by</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#modifies -->

    <owl:ObjectProperty rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#modifies">
        <rdfs:subPropertyOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#accesses"/>
        <rdfs:subPropertyOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#associated-with"/>
        <rdfs:subPropertyOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#may-modify"/>
        <definition>x modifies y: A technique or agent x causes a digital object y to change; become different; or undertake a transformation.  Afterwards, the data or state held by a digital object is changed.</definition>
        <rdfs:isDefinedBy rdf:resource="http://wordnet-rdf.princeton.edu/id/00126072-v"/>
        <rdfs:label>modifies</rdfs:label>
        <skos:altLabel>alters</skos:altLabel>
    </owl:ObjectProperty>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#modifies-part -->

    <owl:ObjectProperty rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#modifies-part">
        <rdfs:subPropertyOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#may-modify"/>
        <owl:propertyChainAxiom rdf:parseType="Collection">
            <rdf:Description rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#modifies"/>
            <rdf:Description rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#contains"/>
        </owl:propertyChainAxiom>
        <definition>x modifies-part y: The entity x modifies a part of y.  [Note: This is a rolification property for the rule &apos;if one modifies a part of a whole, they modify the whole.&apos;  Reasoning for this and similar semantics to come are under evaluation and not part of current d3fend inferences.]</definition>
        <rdfs:label>modifies-part</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#monitors -->

    <owl:ObjectProperty rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#monitors">
        <rdfs:subPropertyOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#associated-with"/>
        <rdfs:subPropertyOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#detects"/>
        <definition>x monitors y: The technique or agent x keep tabs on; keeps an eye on; or keep the digital artifact y under surveillance.</definition>
        <rdfs:isDefinedBy rdf:resource="http://wordnet-rdf.princeton.edu/id/02167732-v"/>
        <rdfs:label>monitors</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#narrower -->

    <owl:ObjectProperty rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#narrower">
        <rdfs:subPropertyOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#semantic-relation"/>
        <rdfs:label>narrower</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#narrower-transitive -->

    <owl:ObjectProperty rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#narrower-transitive">
        <rdfs:subPropertyOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#semantic-relation"/>
        <rdfs:label>narrower-transitive</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#neutralizes -->

    <owl:ObjectProperty rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#neutralizes">
        <rdfs:subPropertyOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#associated-with"/>
        <rdfs:subPropertyOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#hardens"/>
        <definition>x neutralizes y: The technique x makes the execution of actions of y ineffective by preventing or counterbalancing the effect of y.</definition>
        <rdfs:isDefinedBy rdf:resource="http://wordnet-rdf.princeton.edu/id/00471015-v"/>
        <rdfs:label>neutralizes</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#next -->

    <owl:ObjectProperty rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#next">
        <rdfs:subPropertyOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#d3fend-process-object-property"/>
        <rdfs:label>next</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#obfuscates -->

    <owl:ObjectProperty rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#obfuscates">
        <rdfs:subPropertyOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#evicts"/>
        <rdfs:subPropertyOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#modifies"/>
        <definition>x obfuscates y: The technique x makes the digital artifact y unclear or obscure.  Typically obfuscation is a way to hide a digital artifact from discovery, use, or both.</definition>
        <rdfs:isDefinedBy rdf:resource="http://wordnet-rdf.princeton.edu/id/00942245-v"/>
        <rdfs:label>obfuscates</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dbpedia.org/resource/Obfuscation_(software)"/>
    </owl:ObjectProperty>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#originates-from -->

    <owl:ObjectProperty rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#originates-from">
        <rdfs:subPropertyOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#associated-with"/>
        <definition>x originates-from y: The digital event or artifact x began its network transit from a physical location y.</definition>
        <rdfs:isDefinedBy rdf:resource="http://wordnet-rdf.princeton.edu/id/02749218-v"/>
        <rdfs:label>originates-from</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#owns -->

    <owl:ObjectProperty rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#owns">
        <rdfs:subPropertyOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#associated-with"/>
        <definition>x owns y: The subject x has ownership or possession of some object y.</definition>
        <rdfs:isDefinedBy rdf:resource="http://wordnet-rdf.princeton.edu/id/02209474-v"/>
        <rdfs:label>owns</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dbpedia.org/resource/Ownership"/>
        <skos:altLabel>possesses</skos:altLabel>
    </owl:ObjectProperty>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#participates-in -->

    <owl:ObjectProperty rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#participates-in">
        <rdfs:subPropertyOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#associated-with"/>
        <definition>x participates-in y: The object x takes part in the event y, signifying that x contributes to or is affected by the event’s occurrence in some way.</definition>
        <rdfs:isDefinedBy rdf:resource="http://purl.obolibrary.org/obo/BFO_0000056"/>
        <rdfs:label>participates-in</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#powered-by -->

    <owl:ObjectProperty rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#powered-by">
        <rdfs:subPropertyOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#depends-on"/>
        <owl:inverseOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#powers"/>
        <definition>x powered-by y: x obtains its essential energy or force from y to perform its function or remain active.</definition>
        <rdfs:label>powered-by</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#powers -->

    <owl:ObjectProperty rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#powers">
        <rdfs:subPropertyOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#has-dependent"/>
        <definition>x powers y: x furnishes y with the energy or force required for y&apos;s functionality or operation.</definition>
        <rdfs:label>powers</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#preceded-by -->

    <owl:ObjectProperty rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#preceded-by">
        <rdfs:subPropertyOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#associated-with"/>
        <owl:inverseOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#precedes"/>
        <definition>x preceded-by y: The event or action x occurs after event or action y in time.</definition>
        <rdfs:isDefinedBy rdf:resource="http://purl.obolibrary.org/obo/BFO_0000062"/>
        <rdfs:label>preceded-by</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#precedes -->

    <owl:ObjectProperty rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#precedes">
        <rdfs:subPropertyOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#associated-with"/>
        <definition>x precedes y: The event or action x occurs before event or action y in time.</definition>
        <rdfs:isDefinedBy rdf:resource="http://purl.obolibrary.org/obo/BFO_0000063"/>
        <rdfs:label>precedes</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#process-ancestor -->

    <owl:ObjectProperty rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#process-ancestor">
        <rdfs:subPropertyOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#process-property"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
        <definition>x process-ancestor y: The process y is a process ancestor of process x, indicating one or more process creation events were conducted were started at process y and subsequently created process x.</definition>
        <rdfs:label>process-ancestor</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#process-image-path -->

    <owl:ObjectProperty rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#process-image-path">
        <rdfs:subPropertyOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#process-property"/>
        <definition>x process-image-path y: The filepath y is the process image path for the process x, indicating the path to the resource from which the process&apos;s image was loaded.</definition>
        <rdfs:label>process-image-path</rdfs:label>
        <skos:altLabel>processImagePath</skos:altLabel>
    </owl:ObjectProperty>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#process-parent -->

    <owl:ObjectProperty rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#process-parent">
        <rdfs:subPropertyOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#process-ancestor"/>
        <definition>x process-parent y: The process y created the process x (directly) with a create process event.</definition>
        <rdfs:label>process-parent</rdfs:label>
        <skos:altLabel>processParent</skos:altLabel>
    </owl:ObjectProperty>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#process-property -->

    <owl:ObjectProperty rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#process-property">
        <rdfs:subPropertyOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#associated-with"/>
        <definition>x process-property y: Process x has the a process-property y.  This is generalization for specific process object properties.</definition>
        <rdfs:label>process-property</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#process-user -->

    <owl:ObjectProperty rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#process-user">
        <rdfs:subPropertyOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#process-property"/>
        <definition>x process-user y: The process x has been executed by the user y.</definition>
        <rdfs:label>process-user</rdfs:label>
        <skos:altLabel>processUser</skos:altLabel>
    </owl:ObjectProperty>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#produced-by -->

    <owl:ObjectProperty rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#produced-by">
        <rdfs:subPropertyOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#associated-with"/>
        <owl:inverseOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#produces"/>
        <rdfs:label>produced-by</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#produces -->

    <owl:ObjectProperty rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#produces">
        <rdfs:subPropertyOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#associated-with"/>
        <rdfs:subPropertyOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#may-produce"/>
        <definition>x produces y: The subject entity x or process produces a data object y, which may be discrete digital object or a stream (e.g., a stream such as network traffic.)</definition>
        <rdfs:isDefinedBy rdf:resource="http://wordnet-rdf.princeton.edu/id/01625832-v"/>
        <rdfs:label>produces</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#creates"/>
        <skos:altLabel>outputs</skos:altLabel>
    </owl:ObjectProperty>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#provider -->

    <owl:ObjectProperty rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#provider">
        <rdfs:subPropertyOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#associated-with"/>
        <definition>x provider y: A provider y is an entity that supplies a service, system, or data resources to a dependent entity x.</definition>
        <rdfs:isDefinedBy rdf:resource="http://wordnet-rdf.princeton.edu/id/05901034-n"/>
        <rdfs:label>provider</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://wordnet-rdf.princeton.edu/id/10696710-n"/>
    </owl:ObjectProperty>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#quarantines -->

    <owl:ObjectProperty rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#quarantines">
        <rdfs:subPropertyOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#associated-with"/>
        <definition>x quarantines y: Technique x moves entity y to a place of isolation.</definition>
        <rdfs:label>quarantines</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#queries -->

    <owl:ObjectProperty rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#queries">
        <rdfs:subPropertyOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#associated-with"/>
        <rdfs:subPropertyOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#may-query"/>
        <rdfs:label>queries</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#reads -->

    <owl:ObjectProperty rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#reads">
        <rdfs:subPropertyOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#accesses"/>
        <definition>x reads y: The subject x takes the action of reading from a digital source y to acquire data and placing it into volatile memory for processing.</definition>
        <rdfs:label>reads</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dbpedia.org/resource/Reading_(computer)"/>
        <rdfs:seeAlso rdf:resource="http://wordnet-rdf.princeton.edu/id/00629157-v"/>
    </owl:ObjectProperty>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#recorded-in -->

    <owl:ObjectProperty rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#recorded-in">
        <rdfs:subPropertyOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#associated-with"/>
        <owl:inverseOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#records"/>
        <definition>x recorded-in y: The event x is documented, logged, or otherwise preserved within the digital artifact y, which stores or encodes relevant data about the event.</definition>
        <rdfs:label>recorded-in</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#records -->

    <owl:ObjectProperty rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#records">
        <rdfs:subPropertyOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#associated-with"/>
        <definition>x records y: The digital artifact x makes a record of events y; set down in permanent form.</definition>
        <rdfs:isDefinedBy rdf:resource="http://wordnet-rdf.princeton.edu/id/01002259-v"/>
        <rdfs:label>records</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://wordnet-rdf.princeton.edu/id/01003181-v"/>
    </owl:ObjectProperty>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#regenerates -->

    <owl:ObjectProperty rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#regenerates">
        <rdfs:subPropertyOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#associated-with"/>
        <rdfs:subPropertyOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#hardens"/>
        <definition>x regenerates y: The entity x discards the current digital artifact y and creates a new version that serves the same function.</definition>
        <rdfs:isDefinedBy rdf:resource="http://wordnet-rdf.princeton.edu/id/00167632-v"/>
        <rdfs:label>regenerates</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#related -->

    <owl:ObjectProperty rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#related">
        <rdfs:subPropertyOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#semantic-relation"/>
        <definition>x related y: x has a symmetric associative relation to y.</definition>
        <rdfs:isDefinedBy rdf:resource="http://www.w3.org/2004/02/skos/core#related"/>
        <rdfs:label>related</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#restores -->

    <owl:ObjectProperty rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#restores">
        <rdfs:subPropertyOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#associated-with"/>
        <rdfs:label>restores</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#restricted-by -->

    <owl:ObjectProperty rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#restricted-by">
        <rdfs:subPropertyOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#associated-with"/>
        <owl:inverseOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#restricts"/>
        <rdfs:label>restricted-by</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#restricts -->

    <owl:ObjectProperty rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#restricts">
        <rdfs:subPropertyOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#associated-with"/>
        <definition>x restricts y: An entity x bounds the use of entity y.</definition>
        <rdfs:isDefinedBy rdf:resource="http://wordnet-rdf.princeton.edu/id/00234091-v"/>
        <rdfs:label>restricts</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#resume -->

    <owl:ObjectProperty rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#resume">
        <rdfs:subPropertyOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#d3fend-process-object-property"/>
        <definition>The agent or technique x continues a previous action on entity y. Usually occurs after suspension on y.</definition>
        <rdfs:isDefinedBy rdf:resource="http://wordnet-rdf.princeton.edu/id/00350758-v"/>
        <rdfs:label>resume</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#resumes -->

    <owl:ObjectProperty rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#resumes">
        <rdfs:subPropertyOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#associated-with"/>
        <definition>The agent or technique x continues a previous action on entity y. Usually occurs after suspension on y.</definition>
        <rdfs:isDefinedBy rdf:resource="http://wordnet-rdf.princeton.edu/id/00350758-v"/>
        <rdfs:label>resumes</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#runs -->

    <owl:ObjectProperty rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#runs">
        <rdfs:subPropertyOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#associated-with"/>
        <rdfs:subPropertyOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#may-run"/>
        <definition>x runs y: To carry out a process or program y, as on a computer or a machine x; where y may be a large software assembly or a specific module or instruction.  Examples: &quot;run a new program on the Mac&quot;; &quot;the computer runs the application software&quot;.</definition>
        <rdfs:label>runs</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://wordnet-rdf.princeton.edu/id/02569242-v"/>
    </owl:ObjectProperty>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#semantic-relation -->

    <owl:ObjectProperty rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#semantic-relation">
        <rdfs:subPropertyOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#associated-with"/>
        <rdfs:label>semantic-relation</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#signed-by -->

    <owl:ObjectProperty rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#signed-by">
        <rdfs:subPropertyOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#validated-by"/>
        <owl:inverseOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#signs"/>
        <definition>x signed-by y: The digital artifact x includes a signature generated by the entity y, certifying the authenticity and integrity of x. This relationship indicates that x has undergone a validation process by y, using cryptographic measures to ensure that x is trustworthy and unaltered since the signing by y.</definition>
    </owl:ObjectProperty>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#signs -->

    <owl:ObjectProperty rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#signs">
        <rdfs:subPropertyOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#validates"/>
        <definition>x signs y: The entity x applies a digital signature to the digital artifact y, thereby asserting its validity, integrity, and authenticity. Typically, this involves cryptographic techniques to securely bind the signature to y, ensuring that y&apos;s contents have not been altered and are authentic as endorsed by x.</definition>
    </owl:ObjectProperty>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#spoofs -->

    <owl:ObjectProperty rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#spoofs">
        <rdfs:subPropertyOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#associated-with"/>
        <rdfs:subPropertyOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#deceives-with"/>
        <definition>x spoofs y: The technique x creates a fake instance of a digital artifact y; that is, y is a decoy, fake, or counterfeit.</definition>
        <rdfs:label>spoofs</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dbpedia.org/resource/Spoof"/>
        <rdfs:seeAlso rdf:resource="http://wordnet-rdf.princeton.edu/id/03323383-n"/>
    </owl:ObjectProperty>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#start -->

    <owl:ObjectProperty rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#start">
        <rdfs:subPropertyOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#d3fend-process-object-property"/>
        <rdfs:label>start</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#strengthens -->

    <owl:ObjectProperty rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#strengthens">
        <rdfs:subPropertyOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#associated-with"/>
        <rdfs:subPropertyOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#hardens"/>
        <definition>x strengthens y: The technique x make digital artifact y resistant (to harm or misuse.)</definition>
        <rdfs:isDefinedBy rdf:resource="http://wordnet-rdf.princeton.edu/id/00165779-v"/>
        <rdfs:label>strengthens</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#summarizes -->

    <owl:ObjectProperty rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#summarizes">
        <rdfs:subPropertyOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#associated-with"/>
        <definition>x summarizes y: The sensor x summarizes a set y of events concerning digital artifacts over time</definition>
        <rdfs:isDefinedBy rdf:resource="http://wordnet-rdf.princeton.edu/id/02758570-v"/>
        <rdfs:label>summarizes</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#suspends -->

    <owl:ObjectProperty rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#suspends">
        <rdfs:subPropertyOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#evicts"/>
        <definition>x suspends y: The agent or technique x pauses entity y.</definition>
        <rdfs:isDefinedBy rdf:resource="http://wordnet-rdf.princeton.edu/id/00543748-v"/>
        <rdfs:label>suspends</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#terminates -->

    <owl:ObjectProperty rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#terminates">
        <rdfs:subPropertyOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#associated-with"/>
        <rdfs:subPropertyOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#evicts"/>
        <definition>x terminates y: The technique x brings to an end or halt to some activity y.</definition>
        <synonym>aborts</synonym>
        <rdfs:isDefinedBy rdf:resource="http://wordnet-rdf.princeton.edu/id/00353480-v"/>
        <rdfs:label>terminates</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://wordnet-rdf.princeton.edu/id/00354493-v"/>
    </owl:ObjectProperty>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#transmits -->

    <owl:ObjectProperty rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#transmits">
        <rdfs:subPropertyOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#associated-with"/>
        <definition>x transmits y: The subject x actively emits object y onto a communication medium, rendering y observable and available for reception on that medium.</definition>
        <rdfs:label>transmits</rdfs:label>
        <skos:altLabel>sends</skos:altLabel>
    </owl:ObjectProperty>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#unloads -->

    <owl:ObjectProperty rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#unloads">
        <rdfs:subPropertyOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#evicts"/>
        <definition>x unloads y: The technique or artifact performs the action of unloading some artifact (applications, kernel modules, or hardware drivers, etc.) from a computer&apos;s memory.</definition>
        <rdfs:label>unloads</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#unmounts -->

    <owl:ObjectProperty rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#unmounts">
        <rdfs:subPropertyOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#associated-with"/>
        <definition>x unmounts y: An operation x removes the access via computer system&apos;s file system the availability of files and directories on a storage artifact y.  Unmounts reverse or undo prior mount operations.</definition>
        <rdfs:label>unmounts</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dbpedia.org/resource/Mount_(computing)"/>
    </owl:ObjectProperty>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#updates -->

    <owl:ObjectProperty rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#updates">
        <rdfs:subPropertyOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#hardens"/>
        <rdfs:subPropertyOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#modifies"/>
        <definition>x updates y: The technique x updates the software for component y.</definition>
        <rdfs:label>updates</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#use-limits -->

    <owl:ObjectProperty rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#use-limits">
        <rdfs:subPropertyOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#limits"/>
        <definition>x use-limits y: An entity x specifies a designated number of uses beyond which some entity y cannot function or must be terminated.</definition>
        <rdfs:label>use-limits</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://wordnet-rdf.princeton.edu/id/13781154-n"/>
    </owl:ObjectProperty>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#used-by -->

    <owl:ObjectProperty rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#used-by">
        <rdfs:subPropertyOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#associated-with"/>
        <owl:inverseOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#uses"/>
        <definition>x used-by y: is inverse of y uses x.</definition>
        <rdfs:label>used-by</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#uses -->

    <owl:ObjectProperty rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#uses">
        <rdfs:subPropertyOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#associated-with"/>
        <definition>x uses y: An entity x puts into service a resource or implement y; makes y work or employ for a particular purpose or for its inherent or natural purpose.</definition>
        <rdfs:isDefinedBy rdf:resource="http://wordnet-rdf.princeton.edu/id/01161188-v"/>
        <rdfs:label>uses</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#validated-by -->

    <owl:ObjectProperty rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#validated-by">
        <rdfs:subPropertyOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#associated-with"/>
        <rdfs:subPropertyOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#hardens"/>
        <definition>x validated-by y: The digital artifact x has its authenticity and correctness confirmed or verified by the technique, operation, or agent y.</definition>
        <rdfs:label>validated-by</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#validates -->

    <owl:ObjectProperty rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#validates">
        <rdfs:subPropertyOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#associated-with"/>
        <rdfs:subPropertyOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#hardens"/>
        <definition>x validates y: The technique x proves the digital artifact y is valid; that is, x shows or confirms the validity of y.</definition>
        <rdfs:isDefinedBy rdf:resource="http://wordnet-rdf.princeton.edu/id/00669142-v"/>
        <rdfs:label>validates</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#verifies -->

    <owl:ObjectProperty rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#verifies">
        <rdfs:subPropertyOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#analyzes"/>
        <rdfs:subPropertyOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#associated-with"/>
        <definition>x verifies y: A technique x confirms the truth of a digital artifact y.</definition>
        <rdfs:isDefinedBy rdf:resource="http://wordnet-rdf.princeton.edu/id/00666401-v"/>
        <rdfs:label>verifies</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dbpedia.org/resource/Formal_verification"/>
        <rdfs:seeAlso rdf:resource="http://dbpedia.org/resource/Runtime_verification"/>
        <rdfs:seeAlso rdf:resource="http://wordnet-rdf.princeton.edu/id/00665271-v"/>
    </owl:ObjectProperty>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#weakness-of -->

    <owl:ObjectProperty rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#weakness-of">
        <rdfs:subPropertyOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#may-be-weakness-of"/>
        <rdfs:label>weakness-of</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#writes -->

    <owl:ObjectProperty rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#writes">
        <rdfs:subPropertyOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#accesses"/>
        <definition>x writes y: The subject x takes the action of writing to a digital artifact y to store data and placing it into persistent memory for later reference.</definition>
        <rdfs:label>writes</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://wordnet-rdf.princeton.edu/id/01000931-v"/>
    </owl:ObjectProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Data properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#archived-at -->

    <owl:DatatypeProperty rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#archived-at">
        <rdfs:subPropertyOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#d3fend-catalog-data-property"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#anyURI"/>
        <rdfs:label xml:lang="en">archived-at</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#attack-kb-data-property -->

    <owl:DatatypeProperty rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#attack-kb-data-property">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topDataProperty"/>
        <rdfs:label>attack-kb-data-property</rdfs:label>
        <skos:altLabel>attack-kb-property</skos:altLabel>
    </owl:DatatypeProperty>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#available -->

    <owl:DatatypeProperty rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#available">
        <rdfs:subPropertyOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#date"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
        <definition>Date that the resource became or will become available.</definition>
        <rdfs:label xml:lang="en">date available</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#capec-id -->

    <owl:DatatypeProperty rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#capec-id">
        <rdfs:subPropertyOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#d3fend-kb-data-property"/>
        <definition>Unique identifier for a CAPEC technique, i.e. a common attack pattern identified by the pattern CAPEC-[number].</definition>
        <rdfs:label>capec-id</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#comments -->

    <owl:DatatypeProperty rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#comments">
        <rdfs:subPropertyOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#d3fend-catalog-data-property"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <definition>x comments y: x claim has provider comments y.</definition>
        <rdfs:label>comments</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#confidence -->

    <owl:DatatypeProperty rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#confidence">
        <rdfs:subPropertyOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#d3fend-catalog-data-property"/>
        <rdfs:label>confidence</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#control-name -->

    <owl:DatatypeProperty rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#control-name">
        <rdfs:subPropertyOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#d3fend-external-control-data-property"/>
        <definition>The control (or control enhancement) name.</definition>
        <rdfs:label>control-name</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#created -->

    <owl:DatatypeProperty rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#created">
