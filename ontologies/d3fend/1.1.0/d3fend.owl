        <rdfs:subPropertyOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#d3fend-artifact-data-property"/>
        <definition>x process-data-property y: The process x has the data property y.</definition>
        <rdfs:label>process-data-property</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#process-environmental-variables -->

    <owl:DatatypeProperty rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#process-environmental-variables">
        <rdfs:subPropertyOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#process-data-property"/>
        <definition>x process-environment-variables y: The process x has the process environmental variables data y.</definition>
        <rdfs:label>process-environmental-variables</rdfs:label>
        <skos:altLabel>process-environmental-variable</skos:altLabel>
    </owl:DatatypeProperty>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#process-identifier -->

    <owl:DatatypeProperty rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#process-identifier">
        <rdfs:subPropertyOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#process-data-property"/>
        <definition>x process-identifier y: The process x has the process identifier y.</definition>
        <rdfs:label>process-identifier</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#process-security-context -->

