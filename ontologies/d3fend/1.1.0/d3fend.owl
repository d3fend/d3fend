    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#KerberosTicketGrantingTicketAccount -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#KerberosTicketGrantingTicketAccount">
