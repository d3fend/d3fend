    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#ExpectedErrorReduction -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#ExpectedErrorReduction">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#ActiveLearning"/>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#ExpectedModelChange -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#ExpectedModelChange">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#ActiveLearning"/>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#ExternalContentInclusionFunction -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#ExternalContentInclusionFunction">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#Subroutine"/>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#ExternalControl -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#ExternalControl">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#ExternalControlThing"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#member-of"/>
                <owl:someValuesFrom rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#ControlCatalog"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#semantic-relation"/>
                <owl:someValuesFrom rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#DefensiveTechnique"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>External Control</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#ExternalControlThing -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#ExternalControlThing">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#ExternalThing"/>
        <rdfs:label>External Control Thing</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#ExternalKnowledgeBase -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#ExternalKnowledgeBase">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#TechniqueReference"/>
        <pref-label>External Knowledge Base</pref-label>
        <rdfs:label>External Knowledge Base</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#ExternalThing -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#ExternalThing">
        <rdfs:label>External Thing</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#ExternalThreatModelThing -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#ExternalThreatModelThing">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#ExternalThing"/>
        <rdfs:label>External Threat Model Thing</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#FTPDeleteEvent -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#FTPDeleteEvent">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#FTPEvent"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#preceded-by"/>
                <owl:someValuesFrom rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#FTPPutEvent"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <definition>An event where files or directories are removed from an FTP server, resulting in their permanent deletion from the remote system.</definition>
        <rdfs:label>FTP Delete Event</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#FTPEvent -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#FTPEvent">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#ApplicationLayerEvent"/>
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#TCPEvent"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#has-participant"/>
                <owl:someValuesFrom rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#FileTransferNetworkTraffic"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <definition>An event involving the File Transfer Protocol (FTP), a standard network protocol used to transfer files between a client and server over a TCP/IP network. FTP facilitates operations such as file uploads, downloads, directory listing, and remote file management.</definition>
        <rdfs:label>FTP Event</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://schema.ocsf.io/1.3.0/classes/ftp_activity"/>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#FTPGetEvent -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#FTPGetEvent">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#FTPEvent"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#preceded-by"/>
                <owl:someValuesFrom rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#FTPPutEvent"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <definition>An event where a file is downloaded from an FTP server to a client, retrieving data from the remote system to the local destination.</definition>
        <rdfs:label>FTP Get Event</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#FTPListEvent -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#FTPListEvent">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#FTPEvent"/>
        <definition>An event where the contents of a directory on an FTP server are listed, providing metadata such as file names, sizes, and timestamps.</definition>
        <rdfs:label>FTP List Event</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#FTPPollEvent -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#FTPPollEvent">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#FTPEvent"/>
        <definition>An event where a client queries an FTP server to check for the presence of specific files or directories without initiating a transfer.</definition>
        <rdfs:label>FTP Poll Event</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#FTPPutEvent -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#FTPPutEvent">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#FTPEvent"/>
        <definition>An event where a file is uploaded from a client to an FTP server, transferring data from the local system to the remote destination.</definition>
        <rdfs:label>FTP Put Event</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#FTPRenameEvent -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#FTPRenameEvent">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#FTPEvent"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#preceded-by"/>
                <owl:someValuesFrom rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#FTPPutEvent"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <definition>An event where files or directories on an FTP server are renamed, modifying their identifiers without altering their content or location.</definition>
        <rdfs:label>FTP Rename Event</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#FastSymbolicLink -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#FastSymbolicLink">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#SymbolicLink"/>
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#UnixLink"/>
        <owl:disjointWith rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#SlowSymbolicLink"/>
        <definition>Fast symbolic links, allow storage of the target path within the data structures used for storing file information on disk (e.g., within the inodes). This space normally stores a list of disk block addresses allocated to a file. Thus, symlinks with short target paths are accessed quickly. Systems with fast symlinks often fall back to using the original method if the target path exceeds the available inode space.</definition>
        <rdfs:isDefinedBy rdf:resource="http://dbpedia.org/resource/Symbolic_link#Storage_of_symbolic_links"/>
        <rdfs:label>Fast Symbolic Link</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dbpedia.org/resource/Symbolic_link#Storage_of_symbolic_links"/>
        <skos:altLabel>Fast Symlink</skos:altLabel>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#File -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#File">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#Resource"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#contains"/>
                <owl:someValuesFrom rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#FileSection"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
