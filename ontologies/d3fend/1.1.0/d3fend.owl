        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#has-participant"/>
                <owl:someValuesFrom rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#OTAbortService"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>OT Abort Service Event</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#OTActuator -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#OTActuator">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#Actuator"/>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#OTChangeData -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#OTChangeData">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#OTModifyDeviceData"/>
        <definition>OT command that changes existing data on a remote device.</definition>
        <rdfs:comment>BACnet/IP: ATOMIC_WRITE_FILE
BACnet/IP: WRITE_BROADCAST_TABLE
BACnet/IP: WRITE_GROUP  </rdfs:comment>
        <rdfs:comment>DNP3: WRITE
DNP3: SAVE_CONFIG
DNP3: ASSIGN_CLASS
DNP3: RECORD_CURRENT_TIME </rdfs:comment>
        <rdfs:comment>GEMS: SaveConfig</rdfs:comment>
        <rdfs:comment>Modbus/TCP: WRITE_FILE_RECORD</rdfs:comment>
        <rdfs:label>OT Change Data</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#OTChangeDataEvent -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#OTChangeDataEvent">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#OTCommandEvent"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#has-participant"/>
                <owl:someValuesFrom rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#OTChangeData"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>OT Change Data Event</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#OTChangeDeviceProcessData -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#OTChangeDeviceProcessData">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#OTModifyDeviceProcessData"/>
        <definition>OT command that changes existing process data on a remote device.</definition>
        <rdfs:comment>BACnet/IP: WRITE_PROPERTY
BACnet/IP: WRITE_PROPERTY_MULTIPLE
BACnet/IP: ATOMIC_WRITE_FILE </rdfs:comment>
        <rdfs:comment>DNP3: INITIALIZE_DATA
DNP3: ACTIVATE_CONFIG</rdfs:comment>
        <rdfs:comment>GEMS: LoadConfig
GEMS: SetConfig</rdfs:comment>
        <rdfs:comment>Modbus/TCP: WRITE_MULTIPLE_COILS
Modbus/TCP: MASK_WRITE_REGISTER
Modbus/TCP: WRITE_MULTIPLE_REGISTERS
Modbus/TCP: WRITE_SINGLE_COIL
Modbus/TCP: WRITE_SINGLE_REGISTER
Modbus/TCP: WRITE_FILE_RECORD </rdfs:comment>
        <rdfs:label>OT Change Device Process Data</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#OTChangeDeviceProcessDataEvent -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#OTChangeDeviceProcessDataEvent">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#OTCommandEvent"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#has-participant"/>
                <owl:someValuesFrom rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#OTChangeDeviceProcessData"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>OT Change Device Process Data Event</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#OTCommand -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#OTCommand">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#OTProtocolMessage"/>
        <definition>An operational technology event that captures the occurrence of an OT command being issued, executed, or acknowledged, thereby linking a specific command action to its observable impact within a control system.</definition>
        <rdfs:label>OT Command</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#OTCommandEvent -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#OTCommandEvent">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#OTEvent"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#has-participant"/>
                <owl:someValuesFrom rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#OTCommand"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>OT Command Event</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#OTControlLogicProcess -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#OTControlLogicProcess">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#Process"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#contains"/>
                <owl:someValuesFrom rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#OTLogicVariable"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#OTControlProgram -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#OTControlProgram">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#Application"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#instructs"/>
                <owl:someValuesFrom rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#OTControlLogicProcess"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#OTControlVariable -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#OTControlVariable">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#OTLogicVariable"/>
        <definition>A control variable is the measurement of the physical condition of the device that influences the Process Variables. For example, if the Set Point of a temperature control system for a residential dwelling is 72 degrees, and the Process Variable is 82 degrees, the Control Variable for the air conditioner should be &apos;on.&apos;</definition>
        <rdfs:isDefinedBy>https://isagca.org/hubfs/2023%20ISA%20Website%20Redesigns/ISAGCA/PDFs/Industrial%20Cybersecurity%20Knowledge%20FINAL.pdf?hsLang=en</rdfs:isDefinedBy>
        <rdfs:label>OT Control Variable</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#OTController -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#OTController">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#OTEmbeddedComputer"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#communicates-with"/>
                <owl:someValuesFrom rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#OTIOModule"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#controls"/>
                <owl:someValuesFrom rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#OTActuator"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#monitors"/>
                <owl:someValuesFrom rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#OTSensor"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#powered-by"/>
                <owl:someValuesFrom rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#OTPowerSupply"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#runs"/>
                <owl:someValuesFrom rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#OTControlProgram"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#OTCreateData -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#OTCreateData">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#OTModifyDeviceData"/>
        <definition>OT command that creates data on a remote device.</definition>
        <rdfs:comment>BACnet/IP: ADD_LIST_ELEMENT</rdfs:comment>
        <rdfs:comment>DNP3: FREEZE_AT_TIME
DNP3: FREEZE_CLEAR
DNP3: IMMED_FREEZE</rdfs:comment>
        <rdfs:label>OT Create Data</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#OTCreateDataEvent -->

