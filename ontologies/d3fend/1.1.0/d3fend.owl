    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#IntervalEstimation -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#IntervalEstimation">
