    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#Reference-FileEncryption101SafeguardingYourSensitiveData -->

    <owl:NamedIndividual rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#Reference-FileEncryption101SafeguardingYourSensitiveData">
        <rdf:type rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#InternetArticleReference"/>
        <kb-reference-of rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#FileEncryption"/>
        <has-link rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://www.veritas.com/information-center/file-encryption</has-link>
        <kb-reference-title>File Encryption 101: Safeguarding Your Sensitive Data</kb-reference-title>
        <kb-abstract>File encryption is a security method that converts your files into ciphertext or unreadable data. By using this method, you may be sure that even if unauthorized people access your files, they won&apos;t be able to understand the contents without the decryption key.</kb-abstract>
        <kb-author>Veritas</kb-author>
        <rdfs:label>Reference -  File Encryption 101: Safeguarding Your Sensitive Data</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#Reference-FileIntegrityMonitoringinMicrosoftDefenderforCloud-Microsoft -->

    <owl:NamedIndividual rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#Reference-FileIntegrityMonitoringinMicrosoftDefenderforCloud-Microsoft">
