    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#OTDeleteDeviceProcessData">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#OTModifyDeviceProcessData"/>
        <definition>OT command that removes existing process data on a remote device.</definition>
        <rdfs:comment>BACnet/IP: DELETE_OBJECT</rdfs:comment>
        <rdfs:label>OT Delete Device Process Data</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#OTDeleteDeviceProcessDataEvent -->

