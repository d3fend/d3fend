            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#WriteProtectSwitch -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#WriteProtectSwitch">
