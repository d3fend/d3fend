        <rdfs:label>Privilege Escalation Technique</rdfs:label>
    </rdf:Description>
    <rdf:Description rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#ProbabilisticLogic">
        <definition>Probabilistic logic extends traditional logic truth tables with probabilistic expressions.</definition>
