    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#OTDeleteData -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#OTDeleteData">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#OTModifyDeviceData"/>
        <definition>OT command that removes existing data on a remote device.</definition>
        <rdfs:comment>BACnet/IP: REMOVE_LIST_ELEMENT
BACnet/IP: DELETE_FOREIGN_DEVICE_TABLE_ENTRY </rdfs:comment>
        <rdfs:comment>DNP3: DELETE_FILE</rdfs:comment>
        <rdfs:label>OT Delete Data</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#OTDeleteDataEvent -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#OTDeleteDataEvent">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#OTCommandEvent"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#has-participant"/>
                <owl:someValuesFrom rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#OTDeleteData"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>OT Delete Data Event</rdfs:label>
    </owl:Class>
    


