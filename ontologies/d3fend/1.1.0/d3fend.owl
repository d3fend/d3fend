    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#ANN-basedClustering -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#ANN-basedClustering">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#ClusterAnalysis"/>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#ARIMAModel -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#ARIMAModel">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#TimeSeriesAnalysis"/>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#ARMA_Model -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#ARMA_Model">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#TimeSeriesAnalysis"/>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#ATTACKEnterpriseDataSource -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#ATTACKEnterpriseDataSource">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#ATTACKEnterpriseThing"/>
        <rdfs:label>ATTACK Enterprise Data Source</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#ATTACKEnterpriseMitigation -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#ATTACKEnterpriseMitigation">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#ATTACKEnterpriseThing"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#semantic-relation"/>
                <owl:someValuesFrom rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#DefensiveTechnique"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#d3fend-comment"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>ATTACK Enterprise Mitigation</rdfs:label>
    </owl:Class>
    


