            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#UserApplication -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#UserApplication">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#Application"/>
        <definition>A user application is executed for that an individual user on a user&apos;s personal computer or remotely by means of virtualization.  This is in contrast to service applications or enterprise software.</definition>
        <rdfs:label>User Application</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dbpedia.org/resource/Enterprise_software"/>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#UserBehavior -->

