    <rdf:Description rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#RestoreFile">
        <definition>Restoring a file for an entity to access.</definition>
        <rdfs:label>Restore File</rdfs:label>
    </rdf:Description>
