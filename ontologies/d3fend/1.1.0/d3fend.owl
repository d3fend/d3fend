        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#preceded-by"/>
                <owl:someValuesFrom rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#FileMountEvent"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <definition>An event where a file system or storage volume is unmounted, disconnecting its files and directories from the operating system or applications.</definition>
        <rdfs:label>File Unmount Event</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#FileUpdateEvent -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#FileUpdateEvent">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#FileEvent"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#preceded-by"/>
                <owl:someValuesFrom rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#FileAccessEvent"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#preceded-by"/>
                <owl:someValuesFrom rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#FileCreationEvent"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <definition>An event involving changes to the content or metadata of an existing file, reflecting updates that alter its state or properties.</definition>
        <rdfs:label>File Update Event</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#FingerPrintScannerInputDevice -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#FingerPrintScannerInputDevice">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#ImageScannerInputDevice"/>
        <definition>A fingerprint sensor is an electronic device used to capture a digital image of the fingerprint pattern. The captured image is called a live scan. This live scan is digitally processed to create a biometric template (a collection of extracted features) which is stored and used for matching. Many technologies have been used including optical, capacitive, RF, thermal, piezoresistive, ultrasonic, piezoelectric, and MEMS.</definition>
        <rdfs:isDefinedBy rdf:resource="http://dbpedia.org/resource/Fingerprint#Fingerprint_sensors"/>
        <rdfs:label>Finger Print Scanner Input Device</rdfs:label>
        <skos:altLabel>Fingerprint Sensor</skos:altLabel>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#Firewall -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#Firewall">
