            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#contains"/>
                <owl:someValuesFrom rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#HardwareDevice"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#contains"/>
                <owl:someValuesFrom rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#OperatingSystem"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#ComputingImage -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#ComputingImage">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#DigitalInformationBearer"/>
        <definition>A computing image captures the full state or contents of a computing entity, such as a process or volume.</definition>
        <rdfs:isDefinedBy rdf:resource="http://dbpedia.org/resource/System_image#Process_images"/>
        <rdfs:label>Computing Image</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#ComputingServer -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#ComputingServer">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#Server"/>
        <definition>A compute server is a system specifically designed to undertake large amounts of computation, usually but not necessarily in a client/server environment.</definition>
        <rdfs:isDefinedBy rdf:resource="https://www.encyclopedia.com/computing/dictionaries-thesauruses-pictures-and-press-releases/compute-server"/>
        <rdfs:label>Computing Server</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#ComputingSnapshot -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#ComputingSnapshot">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#DigitalInformationBearer"/>
        <definition>In computer systems, a snapshot is the state of a system at a particular point in time.</definition>
        <rdfs:isDefinedBy rdf:resource="https://dbpedia.org/resource/Snapshot_(computer_storage)"/>
        <rdfs:label>Computing Snapshot</rdfs:label>
        <skos:altLabel>Snapshot</skos:altLabel>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#Condition -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#Condition">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#D3FENDCore"/>
        <definition>An assumption on which rests the validity or effect of something else.</definition>
        <rdfs:comment>Less common usage versus state, meant to superclass precondition, postcondition, and effect.</rdfs:comment>
        <rdfs:isDefinedBy>n-06768279</rdfs:isDefinedBy>
        <rdfs:label>Condition</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#ConfigurationDatabase -->

