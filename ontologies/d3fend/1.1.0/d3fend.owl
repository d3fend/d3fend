    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#ScheduledJobAnalysis">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#OperatingSystemMonitoring"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#analyzes"/>
                <owl:someValuesFrom rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#JobSchedule"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#ScheduledJobCreationEvent -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#ScheduledJobCreationEvent">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#ScheduledJobEvent"/>
        <definition>An event representing the addition of a new task to the system&apos;s scheduler, defining its execution criteria and associated actions.</definition>
        <rdfs:label>Scheduled Job Creation Event</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#ScheduledJobDeletionEvent -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#ScheduledJobDeletionEvent">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#ScheduledJobEvent"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#preceded-by"/>
                <owl:someValuesFrom rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#ScheduledJobCreationEvent"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <definition>An event marking the removal of a scheduled task from the system, terminating its execution schedule.</definition>
        <rdfs:label>Scheduled Job Deletion Event</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#ScheduledJobDisableEvent -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#ScheduledJobDisableEvent">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#ScheduledJobEvent"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#preceded-by"/>
                <owl:someValuesFrom rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#ScheduledJobEnableEvent"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <definition>An event where a scheduled task is deactivated, preventing further execution until re-enabled.</definition>
        <rdfs:label>Scheduled Job Disable Event</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#ScheduledJobEnableEvent -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#ScheduledJobEnableEvent">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#ScheduledJobEvent"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#preceded-by"/>
                <owl:someValuesFrom rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#ScheduledJobCreationEvent"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <definition>An event where a scheduled task is activated, allowing it to execute according to its defined parameters.</definition>
        <rdfs:label>Scheduled Job Enable Event</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#ScheduledJobEvent -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#ScheduledJobEvent">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#DigitalEvent"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#has-participant"/>
                <owl:someValuesFrom rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#ScheduledJob"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <definition>An event capturing the lifecycle or management of scheduled tasks within a system, including creation, modification, execution, or removal.</definition>
        <rdfs:label>Scheduled Job Event</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://schema.ocsf.io/1.3.0/classes/scheduled_job_activity"/>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#ScheduledJobStartEvent -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#ScheduledJobStartEvent">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#ScheduledJobEvent"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#preceded-by"/>
                <owl:someValuesFrom rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#ScheduledJobCreationEvent"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <definition>An event indicating the execution of a scheduled task, triggered either automatically by the scheduler or manually by a user.</definition>
        <rdfs:label>Scheduled Job Start Event</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#ScheduledJobUpdateEvent -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#ScheduledJobUpdateEvent">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#ScheduledJobEvent"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#preceded-by"/>
                <owl:someValuesFrom rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#ScheduledJobCreationEvent"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <definition>An event where an existing scheduled task is updated, altering parameters such as timing, conditions, or actions.</definition>
        <rdfs:label>Scheduled Job Update Event</rdfs:label>
    </owl:Class>
    


