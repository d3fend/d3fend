                <owl:someValuesFrom rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#WindowsRegistryValue"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <definition>Events representing actions performed on Windows Registry values, which store configuration data within registry keys.</definition>
        <rdfs:label>Windows Registry Value Event</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://schema.ocsf.io/1.3.0/classes/win/registry_value_activity"/>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#WindowsRegistryValueGetEvent -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#WindowsRegistryValueGetEvent">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#WindowsRegistryValueEvent"/>
