    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#t-SNEClustering">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#Projection-basedClustering"/>
    </owl:Class>
    


