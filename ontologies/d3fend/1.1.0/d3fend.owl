        <definition>The information system allows the use of a temporary password for system logons with an immediate change to a permanent password.</definition>
        <rdfs:label>CCI-002041</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CCI-002145_v2022-04-05 -->

    <owl:NamedIndividual rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CCI-002145_v2022-04-05">
