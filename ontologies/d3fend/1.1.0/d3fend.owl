    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#UserManualReference -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#UserManualReference">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#TechniqueReference"/>
        <pref-label>User Manual</pref-label>
        <rdfs:label>User Manual Reference</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#UserProcess -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#UserProcess">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#Process"/>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#UserProfile -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#UserProfile">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#DigitalInformationBearer"/>
        <definition>A user profile is a collection of settings and information associated with a user. It contains critical information that is used to identify an individual, such as their name, age, portrait photograph and individual characteristics such as knowledge or expertise.</definition>
        <rdfs:isDefinedBy rdf:resource="http://dbpedia.org/resource/User_profile"/>
        <rdfs:label>User Profile</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://en.wikipedia.org/wiki/User_profile"/>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#UserSessionInitConfigAnalysis -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#UserSessionInitConfigAnalysis">
