    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#DeveloperApplication -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#DeveloperApplication">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#UserApplication"/>
        <definition>An application used to develop computer software including applications used for software construction, analysis, testing, packaging, or management.</definition>
        <rdfs:label>Developer Application</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dbpedia.org/resource/Application_development"/>
        <rdfs:seeAlso rdf:resource="http://dbpedia.org/resource/Application_software"/>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#DialUpModem -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#DialUpModem">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#Modem"/>
        <definition>A dial-up modem transmits computer data over an ordinary switched telephone line that has not been designed for data use. This contrasts with leased line modems, which also operate over lines provided by a telephone company, but ones which are intended for data use and do not impose the same signaling constraints. The modulated data must fit the frequency constraints of a normal voice audio signal, and the modem must be able to perform the actions needed to connect a call through a telephone exchange, namely: picking up the line, dialing, understanding signals sent back by phone company equipment (dial tone, ringing, busy signal,) and on the far end of the call, the second modem in the connection must be able to recognize the incoming ring signal and answer the line.</definition>
        <rdfs:isDefinedBy rdf:resource="http://dbpedia.org/resource/Modem#Dial-up"/>
        <rdfs:label>Dial Up Modem</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#DifferentialVolumeSnapshot -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#DifferentialVolumeSnapshot">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#VolumeSnapshot"/>
        <definition>A differential volume snapshot is a point-in-time capture of the files and directories that were changed since the last full snapshot.</definition>
        <rdfs:label>Differential Volume Snapshot</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://aws.amazon.com/compare/the-difference-between-incremental-differential-and-other-backups/"/>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#DigitalArtifact -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#DigitalArtifact">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#Artifact"/>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#DigitalAudio -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#DigitalAudio">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#DigitalMedia"/>
        <definition>Digital audio is a representation of sound recorded in, or converted into, digital form.</definition>
        <rdfs:isDefinedBy>https://dbpedia.org/page/Digital_audio</rdfs:isDefinedBy>
        <rdfs:label>Digital Audio</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#DigitalAudioVisualMedia -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#DigitalAudioVisualMedia">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#DigitalMultimedia"/>
        <definition>Audiovisual (AV) is electronic media possessing both a sound and a visual component.</definition>
        <rdfs:isDefinedBy>https://dbpedia.org/page/Audiovisual</rdfs:isDefinedBy>
        <rdfs:label>Digital Audio Visual Media</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#DigitalDocument -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#DigitalDocument">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#DigitalMedia"/>
        <definition>An digital document is any electronic media content (other than computer programs or system files) that is intended to be used in either an electronic form or as printed output.</definition>
        <rdfs:isDefinedBy>https://dbpedia.org/page/Electronic_document</rdfs:isDefinedBy>
        <rdfs:label>Digital Document</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#DigitalEvent -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#DigitalEvent">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#Event"/>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#DigitalEventRecord -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#DigitalEventRecord">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#Record"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#records"/>
                <owl:someValuesFrom rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#DigitalEvent"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#DigitalFingerprint -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#DigitalFingerprint">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#Identifier"/>
        <definition>A digital signature uniquely identifies data and has the property that changing a single bit in the data will cause a completely different message digest to be generated.</definition>
        <rdfs:isDefinedBy rdf:resource="https://csrc.nist.gov/glossary/term/digital_fingerprint"/>
        <rdfs:label>Digital Fingerprint</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://schema.ocsf.io/objects/fingerprint"/>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#DigitalIdentity -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#DigitalIdentity">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#DigitalInformation"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#identified-by"/>
                <owl:someValuesFrom rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#Identifier"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#DigitalImage -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#DigitalImage">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#DigitalMedia"/>
        <definition>A digital image is a pixel-based visual representation stored in formats like JPEG or PNG, used for various digital applications.</definition>
        <rdfs:isDefinedBy>https://dbpedia.org/page/Digital_image</rdfs:isDefinedBy>
        <rdfs:label>Digital Image</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#DigitalInformation -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#DigitalInformation">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#DigitalArtifact"/>
        <rdfs:label>Digital Information</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#DigitalInformationBearer -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#DigitalInformationBearer">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#DigitalArtifact"/>
        <rdfs:label>Digital Information Bearer</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#DigitalMedia -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#DigitalMedia">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#DigitalInformation"/>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#DigitalMessage -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#DigitalMessage">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#DigitalInformationBearer"/>
        <definition>A discrete unit of digital communication created by a sender for one or more intended recipients. Encoded in an application-layer format, a digital message conveys semantics such as commands, data, or status and is transported inside lower-layer containers like network frames or packets.</definition>
        <rdfs:isDefinedBy rdf:resource="http://dbpedia.org/resource/Message_(computing)"/>
        <rdfs:label>Digital Message</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#DigitalMultimedia -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#DigitalMultimedia">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#DigitalMedia"/>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#DigitalSystem -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#DigitalSystem">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#DigitalInformationBearer"/>
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#System"/>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#DigitalText -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#DigitalText">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#DigitalMedia"/>
        <definition>Digital text is written content encoded in a digital format, allowing for storage, retrieval, and manipulation by electronic devices.</definition>
