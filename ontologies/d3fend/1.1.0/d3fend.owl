    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#risk-impact -->

    <owl:DatatypeProperty rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#risk-impact">
        <rdfs:subPropertyOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#d3fend-data-property"/>
        <rdfs:range>
            <rdfs:Datatype>
                <owl:onDatatype rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
                <owl:withRestrictions rdf:parseType="Collection">
                    <rdf:Description>
                        <xsd:minInclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</xsd:minInclusive>
                    </rdf:Description>
                    <rdf:Description>
                        <xsd:maxInclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</xsd:maxInclusive>
                    </rdf:Description>
                </owl:withRestrictions>
            </rdfs:Datatype>
        </rdfs:range>
        <definition>Risk impact rating, expressed on a numeric scale from 1 (lowest impact) to 5 (highest impact) in the context of a 5x5 risk matrix. Impact is used here as a synonym for consequence, another popular term used in risk analysis.</definition>
        <rdfs:isDefinedBy rdf:resource="https://www.cto.mil/wp-content/uploads/2024/05/RIO-2023-2-2.pdf"/>
        <rdfs:label>risk-impact</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#risk-likelihood -->

    <owl:DatatypeProperty rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#risk-likelihood">
        <rdfs:subPropertyOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#d3fend-data-property"/>
        <rdfs:range>
            <rdfs:Datatype>
                <owl:onDatatype rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
                <owl:withRestrictions rdf:parseType="Collection">
                    <rdf:Description>
                        <xsd:minInclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</xsd:minInclusive>
                    </rdf:Description>
                    <rdf:Description>
                        <xsd:maxInclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</xsd:maxInclusive>
                    </rdf:Description>
                </owl:withRestrictions>
            </rdfs:Datatype>
        </rdfs:range>
        <definition>Risk likelihood rating, expressed on a numeric scale from 1 (lowest likelihood) to 5 (highest likelihood) in the context of a 5x5 risk matrix.</definition>
        <rdfs:isDefinedBy rdf:resource="https://www.cto.mil/wp-content/uploads/2024/05/RIO-2023-2-2.pdf"/>
        <rdfs:label>risk-likelihood</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#stage -->

    <owl:DatatypeProperty rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#stage">
        <rdfs:subPropertyOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#d3fend-catalog-data-property"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:label>stage</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#text -->

    <owl:DatatypeProperty rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#text">
        <rdfs:subPropertyOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#d3fend-catalog-data-property"/>
        <definition>The text of the document (i.e., terms of license.)</definition>
        <rdfs:label xml:lang="en">text</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#title -->

    <owl:DatatypeProperty rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#title">
        <rdfs:subPropertyOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#d3fend-catalog-data-property"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <definition>A name given to the resource.</definition>
        <rdfs:label xml:lang="en">title</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#valid -->

    <owl:DatatypeProperty rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#valid">
        <rdfs:subPropertyOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#date"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
        <definition>Date (often a range) of validity of a resource.</definition>
        <rdfs:label xml:lang="en">date valid</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#version -->

    <owl:DatatypeProperty rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#version">
        <rdfs:subPropertyOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#d3fend-catalog-data-property"/>
        <rdfs:subPropertyOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#d3fend-external-control-data-property"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:range>
            <rdfs:Datatype>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.w3.org/2001/XMLSchema#integer"/>
                    <rdf:Description rdf:about="http://www.w3.org/2001/XMLSchema#string"/>
                </owl:unionOf>
            </rdfs:Datatype>
        </rdfs:range>
        <definition>x version y: The product or service x has the version y.</definition>
        <rdfs:label xml:lang="en">version</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#windows-registry-data-property -->

    <owl:DatatypeProperty rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#windows-registry-data-property">
        <rdfs:subPropertyOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#d3fend-artifact-data-property"/>
        <definition>x windows-registry-data-property y: The windows registry entry x has the property y.</definition>
        <rdfs:label>windows-registry-data-property</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#windows-registry-key -->

    <owl:DatatypeProperty rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#windows-registry-key">
        <rdfs:subPropertyOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#windows-registry-data-property"/>
        <definition>x value y: The key-value pair x has the key y.</definition>
        <rdfs:label>windows-registry-key</rdfs:label>
        <skos:altLabel>key</skos:altLabel>
    </owl:DatatypeProperty>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#windows-registry-value -->

    <owl:DatatypeProperty rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#windows-registry-value">
        <rdfs:subPropertyOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#windows-registry-data-property"/>
        <definition>x value y: The key-value pair x has the data value y.</definition>
        <rdfs:label>windows-registry-value</rdfs:label>
        <skos:altLabel>value</skos:altLabel>
    </owl:DatatypeProperty>
    


