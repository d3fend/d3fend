        <contributor rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#DISA_FSO"/>
        <definition>The organization employs cryptographic mechanisms to recognize changes to information during transmission unless otherwise protected by alternative physical measures.</definition>
        <rdfs:label>CCI-001128</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CCI-001133_v2022-04-05 -->

