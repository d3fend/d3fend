        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#analyzes"/>
                <owl:someValuesFrom rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#Firmware"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#FirmwareSensor -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#FirmwareSensor">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#EndpointSensor"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#monitors"/>
                <owl:someValuesFrom rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#Firmware"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#FirmwareVerification -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#FirmwareVerification">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#PlatformMonitoring"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#verifies"/>
                <owl:someValuesFrom rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#Firmware"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#First-orderLogic -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#First-orderLogic">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#PredicateLogic"/>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#First-stageBootLoader -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#First-stageBootLoader">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#BootLoader"/>
        <definition>The very first routine run in order to load the operating system.</definition>
        <rdfs:label>First-stage Boot Loader</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#FlashMemory -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#FlashMemory">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#SecondaryStorage"/>
        <definition>Flash memory is an electronic non-volatile computer memory storage medium that can be electrically erased and reprogrammed.</definition>
        <rdfs:isDefinedBy rdf:resource="https://dbpedia.org/page/Flash_memory"/>
        <rdfs:label>Flash Memory</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#Forecasting -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#Forecasting">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#AnalyticalPurpose"/>
        <rdfs:label>Forecasting</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#ForwardProxyServer -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#ForwardProxyServer">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#ProxyServer"/>
        <definition>An forward (or open) proxy is a proxy server that is accessible by any Internet user. Generally, a proxy server only allows users within a network group (i.e. a closed proxy) to store and forward Internet services such as DNS or web pages to reduce and control the bandwidth used by the group. With an open proxy, however, any user on the Internet is able to use this forwarding service.</definition>
        <rdfs:isDefinedBy rdf:resource="http://dbpedia.org/resource/Open_proxy"/>
        <rdfs:label>Forward Proxy Server</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#ForwardResolutionDomainDenylisting -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#ForwardResolutionDomainDenylisting">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#DNSDenylisting"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#blocks"/>
                <owl:someValuesFrom rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#OutboundInternetDNSLookupTraffic"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#ForwardResolutionIPDenylisting -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#ForwardResolutionIPDenylisting">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#DNSDenylisting"/>
