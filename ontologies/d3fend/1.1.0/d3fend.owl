    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#ATTACKEnterpriseTactic">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#ATTACKEnterpriseThing"/>
        <rdfs:label>ATTACK Enterprise Tactic</rdfs:label>
    </owl:Class>
    


