            <owl:Restriction>
                <owl:onProperty rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#has-participant"/>
                <owl:someValuesFrom rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#OTParameterStatus"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>OT Parameter Status Event</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#OTPauseService -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#OTPauseService">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#OTModifyDeviceProgramState"/>
        <definition>Command that tells the device to safely pause a service/program.</definition>
