    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#Artifact -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#Artifact">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#D3FENDCore"/>
