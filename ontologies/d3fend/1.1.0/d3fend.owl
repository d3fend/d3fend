            <owl:Restriction>
                <owl:onProperty rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#may-modify"/>
                <owl:someValuesFrom rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#UserInitScript"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
