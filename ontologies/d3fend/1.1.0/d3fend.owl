        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#ZeroClientComputer -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#ZeroClientComputer">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#ThinClientComputer"/>
        <definition>Zero client is also referred as ultra thin client, contains no moving parts but centralizes all processing and storage to just what is running on the server. As a result, it requires no local driver to install, no patch management, and no local operating system licensing fees or updates. The device consumes very little power and is tamper-resistant and completely incapable of storing any data locally, providing a more secure endpoint.</definition>
        <rdfs:isDefinedBy rdf:resource="http://dbpedia.org/resource/Thin_client#Zero_client"/>
        <rdfs:label>Zero Client Computer</rdfs:label>
    </owl:Class>
    


