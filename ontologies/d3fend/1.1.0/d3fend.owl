        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#ApplicationDeletionEvent"/>
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#ServiceEvent"/>
        <definition>An event capturing the uninstallation or deregistration of a service application, ensuring it is no longer operational or available to clients.</definition>
        <rdfs:label>Service Deletion Event</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#ServiceDependency -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#ServiceDependency">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#Dependency"/>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#ServiceDependencyMapping -->

