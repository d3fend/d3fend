    <rdf:Description rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#OutboundInternetNetworkTraffic">
        <definition>Outbound internet network traffic is network traffic on an outgoing connection initiated from a host within a network to a host outside the network.</definition>
        <rdfs:label>Outbound Internet Network Traffic</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dbpedia.org/resource/Internetworking"/>
    </rdf:Description>
    <rdf:Description rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#OutboundInternetWebTraffic">
        <definition>Outbound internet web traffic is network traffic that is: (a) on an outgoing connection initiated from a host within a network to a host outside the network, and (b) using a standard web protocol.</definition>
        <rdfs:label>Outbound Internet Web Traffic</rdfs:label>
