        <pref-label>Patent</pref-label>
        <rdfs:label>Patent Reference</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#PatternMatching -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#PatternMatching">
