    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#OTCreateNewDeviceProcessData">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#OTModifyDeviceProcessData"/>
        <definition>OT command that creates process data on a remote device.</definition>
        <rdfs:comment>BACnet/IP: CREATE_OBJECT</rdfs:comment>
        <rdfs:label>OT Create New Device Process Data</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#OTCreateNewDeviceProcessDataEvent -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#OTCreateNewDeviceProcessDataEvent">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#OTCommandEvent"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#has-participant"/>
                <owl:someValuesFrom rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#OTCreateNewDeviceProcessData"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>OT Create New Device Process Data Event</rdfs:label>
