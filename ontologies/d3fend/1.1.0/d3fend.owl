    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#ProxyBasedWebServerAccessMediation -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#ProxyBasedWebServerAccessMediation">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#WebSessionAccessMediation"/>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#ProxyServer -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#ProxyServer">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#ComputerNetworkNode"/>
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#Server"/>
        <definition>In computer networking, a proxy server is a server application or appliance that acts as an intermediary for requests from clients seeking resources from servers that provide those resources. A proxy server thus functions on behalf of the client when requesting service, potentially masking the true origin of the request to the resource server.</definition>
        <rdfs:isDefinedBy rdf:resource="http://dbpedia.org/resource/Proxy_server"/>
        <rdfs:label>Proxy Server</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://schema.ocsf.io/objects/network_proxy"/>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#PublicKey -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#PublicKey">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#AsymmetricKey"/>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#PythonPackage -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#PythonPackage">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#SoftwarePackage"/>
        <definition>A Python package is an aggregation of many Python files - either in source code or in bytecode - and associated metadata and resources (text, images, etc.). Python packages can be distributed in different file formats.</definition>
        <rdfs:label>Python Package</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://packaging.python.org/"/>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#PythonScriptFile -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#PythonScriptFile">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#ExecutableScript"/>
        <rdfs:label>Python Script File</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#Q-Learning -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#Q-Learning">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#Model-freeReinforcementLearning"/>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#QueryByCommittee -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#QueryByCommittee">
