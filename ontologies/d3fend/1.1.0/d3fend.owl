        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#NetworkNode"/>
        <definition>A network node running on a computer platform.</definition>
        <rdfs:label>Computer Network Node</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#ComputerPlatform -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#ComputerPlatform">
