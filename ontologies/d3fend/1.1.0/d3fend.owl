    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#ComputeDeviceEvent -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#ComputeDeviceEvent">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#HardwareDeviceEvent"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#has-participant"/>
                <owl:someValuesFrom rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#Processor"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <definition>An event capturing the operation, state, or performance of computational hardware, such as CPUs, GPUs, or accelerators. These events reflect processing capacity changes, utilization anomalies, or device health.</definition>
        <rdfs:label>Compute Device Event</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#ComputerNetworkNode -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#ComputerNetworkNode">
