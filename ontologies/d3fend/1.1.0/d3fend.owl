            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#T1114.003 -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#T1114.003">
