                <owl:someValuesFrom rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#OTCreateData"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>OT Create Data Event</rdfs:label>
    </owl:Class>
    


