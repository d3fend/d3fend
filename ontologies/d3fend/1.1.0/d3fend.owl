    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CyberAction -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CyberAction">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#Action"/>
        <rdfs:label>Cyber Action</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CyberSensor -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CyberSensor">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#Sensor"/>
        <rdfs:label>Cyber Sensor</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CyberTechnique -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CyberTechnique">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#Technique"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#implemented-by"/>
                <owl:someValuesFrom rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#Procedure"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>Cyber Technique</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CycleGAN -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CycleGAN">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#Image-to-ImageTranslationGAN"/>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#D3FENDCore -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#D3FENDCore"/>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#D3FENDKBThing -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#D3FENDKBThing">
        <rdfs:label>D3FEND KB Thing</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#DBSCAN -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#DBSCAN">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#Density-basedClustering"/>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#DHCPAckEvent -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#DHCPAckEvent">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#DHCPEvent"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#preceded-by"/>
                <owl:someValuesFrom rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#DHCPRequestEvent"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <definition>An event where a DHCP server sends an ACK message to acknowledge a client&apos;s REQUEST, confirming the allocation of an IP address and associated network settings.</definition>
        <rdfs:label>DHCP Ack Event</rdfs:label>
        <skos:altLabel>DHCPACK</skos:altLabel>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#DHCPDiscoverEvent -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#DHCPDiscoverEvent">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#DHCPEvent"/>
        <definition>An event where a DHCP client broadcasts a DISCOVER message to identify available DHCP servers capable of providing IP configuration.</definition>
        <rdfs:label>DHCP Discover Event</rdfs:label>
        <skos:altLabel>DHCPDISCOVER</skos:altLabel>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#DHCPEvent -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#DHCPEvent">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#ApplicationLayerEvent"/>
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#UDPEvent"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#has-participant"/>
                <owl:someValuesFrom rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#DHCPNetworkTraffic"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <definition>An event involving the Dynamic Host Configuration Protocol (DHCP), a UDP-based protocol used to dynamically assign IP addresses and configure network parameters, enabling devices to communicate efficiently on a network.</definition>
        <rdfs:label>DHCP Event</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://schema.ocsf.io/1.3.0/classes/dhcp_activity"/>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#DHCPInformEvent -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#DHCPInformEvent">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#DHCPEvent"/>
        <definition>An event where a DHCP client sends an INFORM message to request configuration parameters, such as DNS or gateway information, without requiring IP address assignment.</definition>
        <rdfs:label>DHCP Inform Event</rdfs:label>
        <skos:altLabel>DHCPINFORM</skos:altLabel>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#DHCPLeaseExpireEvent -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#DHCPLeaseExpireEvent">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#DHCPEvent"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#preceded-by"/>
                <owl:someValuesFrom rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#DHCPAckEvent"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <definition>An event indicating that a DHCP lease has expired, rendering the previously assigned IP address available for reassignment to other devices.</definition>
        <rdfs:label>DHCP Lease Expire Event</rdfs:label>
        <skos:altLabel>DHCPLEASEEXPIRE</skos:altLabel>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#DHCPNakEvent -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#DHCPNakEvent">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#DHCPEvent"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#preceded-by"/>
                <owl:someValuesFrom rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#DHCPRequestEvent"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <definition>An event where a DHCP server sends a NAK message to reject a client&apos;s REQUEST, indicating that the requested configuration cannot be granted.</definition>
        <rdfs:label>DHCP Nak Event</rdfs:label>
        <skos:altLabel>DHCPNAK</skos:altLabel>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#DHCPNetworkTraffic -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#DHCPNetworkTraffic">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#NetworkTraffic"/>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#DHCPOfferEvent -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#DHCPOfferEvent">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#DHCPEvent"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#preceded-by"/>
                <owl:someValuesFrom rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#DHCPDiscoverEvent"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <definition>An event where a DHCP server sends an OFFER message to a client in response to a DISCOVER request, proposing an IP address and associated configuration parameters.</definition>
        <rdfs:label>DHCP Offer Event</rdfs:label>
        <skos:altLabel>DHCPOFFER</skos:altLabel>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#DHCPReleaseEvent -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#DHCPReleaseEvent">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#DHCPEvent"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#preceded-by"/>
                <owl:someValuesFrom rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#DHCPAckEvent"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <definition>An event where a DHCP client sends a RELEASE message to relinquish its assigned IP address and cancel any remaining lease duration.</definition>
        <rdfs:label>DHCP Release Event</rdfs:label>
        <skos:altLabel>DHCPRELEASE</skos:altLabel>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#DHCPRequestEvent -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#DHCPRequestEvent">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#DHCPEvent"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#preceded-by"/>
                <owl:someValuesFrom rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#DHCPOfferEvent"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <definition>An event where a DHCP client sends a REQUEST message to confirm or renew its desired IP configuration with a specific DHCP server.</definition>
        <rdfs:label>DHCP Request Event</rdfs:label>
        <skos:altLabel>DHCPREQUEST</skos:altLabel>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#DHCPServer -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#DHCPServer">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#Server"/>
        <definition>A Dynamic Host Configuration Protocol (DHCP) server is a type of server that assigns IP addresses to computers.  DHCP servers are used to assign IP addresses to computers and other devices automatically.  The DHCP server is responsible for assigning the unique IP address to each device.</definition>
        <rdfs:isDefinedBy rdf:resource="http://dbpedia.org/resource/Dynamic_Host_Configuration_Protocol"/>
        <rdfs:label>DHCP Server</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#DNN-basedClustering -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#DNN-basedClustering">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#ANN-basedClustering"/>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#DNSAllowlisting -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#DNSAllowlisting">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#NetworkIsolation"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#blocks"/>
                <owl:someValuesFrom rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#OutboundInternetDNSLookupTraffic"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#DNSCacheEviction -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#DNSCacheEviction">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#ObjectEviction"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#deletes"/>
                <owl:someValuesFrom rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#DNSRecord"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#DNSDenylisting -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#DNSDenylisting">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#NetworkIsolation"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#blocks"/>
                <owl:someValuesFrom rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#DNSNetworkTraffic"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#DNSEvent -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#DNSEvent">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#ApplicationLayerEvent"/>
        <rdfs:subClassOf>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#TCPEvent"/>
                    <rdf:Description rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#UDPEvent"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#has-participant"/>
                <owl:someValuesFrom rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#DNSNetworkTraffic"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <definition>An event involving the Domain Name System (DNS), which translates domain names to IP addresses and operates over UDP and TCP.</definition>
        <rdfs:label>DNS Event</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://schema.ocsf.io/1.3.0/classes/dns_activity"/>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#DNSLookup -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#DNSLookup">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#DigitalInformationBearer"/>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#DNSNetworkTraffic -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#DNSNetworkTraffic">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#NetworkTraffic"/>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#DNSQueryEvent -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#DNSQueryEvent">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#DNSEvent"/>
        <definition>An event where a DNS query is made to resolve a domain name.</definition>
        <rdfs:label>DNS Query Event</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#DNSRecord -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#DNSRecord">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#Record"/>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#DNSResponseEvent -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#DNSResponseEvent">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#DNSEvent"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#preceded-by"/>
                <owl:someValuesFrom rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#DNSQueryEvent"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <definition>An event where a DNS server responds to a query with resolution data.</definition>
        <rdfs:label>DNS Response Event</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#DNSServer -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#DNSServer">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#Server"/>
        <definition>A Domain Name System (DNS) name server is a kind of name server.  Domain names are one of the two principal namespaces of the Internet. The most important function of DNS servers is the translation (resolution) of human-memorable domain names and hostnames into the corresponding numeric Internet Protocol (IP) addresses, the second principal name space of the Internet which is used to identify and locate computer systems and resources on the Internet. (en).

More generally, a name server is a computer application that implements a network service for providing responses to queries against a directory service. It translates an often humanly meaningful, text-based identifier to a system-internal, often numeric identification or addressing component. This service is performed by the server in response to a service protocol request.</definition>
        <rdfs:isDefinedBy rdf:resource="http://dbpedia.org/resource/Name_server"/>
        <rdfs:label>DNS Server</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#DNSTrafficAnalysis -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#DNSTrafficAnalysis">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#NetworkTrafficAnalysis"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#analyzes"/>
                <owl:someValuesFrom rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#OutboundInternetDNSLookupTraffic"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#may-contain"/>
                <owl:someValuesFrom rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#DNSLookup"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#DataArtifactServer -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#DataArtifactServer">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#ArtifactServer"/>
        <definition>A data artifact server provides access services to content in a content repository.  The content repository or content store is a database of digital content with an associated set of data management, search and access methods allowing application-independent access to the content, rather like a digital library, but with the ability to store and modify content in addition to searching and retrieving. The content repository acts as the storage engine for a larger application such as a content management system or a document management system, which adds a user interface on top of the repository&apos;s application programming interface.</definition>
        <rdfs:label>Data Artifact Server</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dbpedia.org/resource/Content_repository"/>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#DataDependency -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#DataDependency">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#Dependency"/>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#DataExchangeMapping -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#DataExchangeMapping">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#SystemMapping"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#maps"/>
                <owl:someValuesFrom rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#DataDependency"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#DataInventory -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#DataInventory">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#AssetInventory"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#inventories"/>
                <owl:someValuesFrom rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#Database"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#inventories"/>
                <owl:someValuesFrom rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#DocumentFile"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#DataLinkLink -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#DataLinkLink">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#LogicalLink"/>
        <definition>A communication link between two network devices connected directly at the physical layer and on the same network segment; i.e., an OSI Layer 2 link.</definition>
        <synonym>Data Link Layer Link</synonym>
        <synonym>Layer-2 Link</synonym>
        <synonym>Link Layer Link</synonym>
        <rdfs:label>Data Link Link</rdfs:label>
