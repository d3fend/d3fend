            <owl:Restriction>
                <owl:onProperty rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#has-participant"/>
                <owl:someValuesFrom rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#OTDeleteDeviceProcessData"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>OT Delete Device Process Data Event</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#OTDeviceAcknowledge -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#OTDeviceAcknowledge">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#OTInformationalMessage"/>
        <definition>A device&apos;s acknowledgment of a message, not being a response.</definition>
        <rdfs:comment>BACnet/IP: ACKNOWLEDGE_ALARM
DNP3: ACK
DNP3: RESPONSE</rdfs:comment>
        <rdfs:label>OT Device Acknowledge</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#OTDeviceAcknowledgeEvent -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#OTDeviceAcknowledgeEvent">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#OTInformationalMessageEvent"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#has-participant"/>
                <owl:someValuesFrom rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#OTDeviceAcknowledge"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>OT Device Acknowledge Event</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#OTDeviceException -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#OTDeviceException">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#OTInformationalMessage"/>
        <definition>Response to a message when the incoming message cannot be parsed correctly, or another exception is raised in the message’s execution or request.</definition>
        <rdfs:comment>BACnet/IP: UNCONFIRMED_EVENT_NOTIFICATION
BACnet/IP: CONFIRMED_EVENT_NOTIFICATION </rdfs:comment>
        <rdfs:comment>DNP3: Support for Analog Input Events
DNP3: Support for Analog Output Events
DNP3: Support for Binary Input Events
DNP3: Support for Binary Output Events
DNP3: Support for Counter Events
DNP3: Support for Double-Bit Binary Events
DNP3: Support for Frozen Analog Inputs
DNP3: Support for Frozen Counter Events
DNP3: Support for Frozen Counters
DNP3: Identification of Support for User-Specific Attributes</rdfs:comment>
        <rdfs:comment>GEMS: ErrorResponse</rdfs:comment>
        <rdfs:comment>Modbus/TCP: MASK_WRITE_REGISTER_EXCEPTION
Modbus/TCP: READ_COILS_EXCEPTION
Modbus/TCP: READ_DISCRETE_INPUTS_EXCEPTION
Modbus/TCP: READ_EXCEPTION_STATUS_EXCEPTION
Modbus/TCP: READ_FIFO_QUEUE_EXCEPTION
Modbus/TCP: READ_FILE_RECORD_EXCEPTION
Modbus/TCP: READ_HOLDING_REGISTERS_EXCEPTION
Modbus/TCP: READ_INPUT_REGISTERS_EXCEPTION
Modbus/TCP: READ_WRITE_MULTIPLE_REGISTERS_EXCEPTION
Modbus/TCP: WRITE_FILE_RECORD_EXCEPTION
Modbus/TCP: WRITE_MULTIPLE_COILS_EXCEPTION
Modbus/TCP: WRITE_MULTIPLE_REGISTERS_EXCEPTION
Modbus/TCP: WRITE_SINGLE_COIL_EXCEPTION
Modbus/TCP: WRITE_SINGLE_REGISTER_EXCEPTION </rdfs:comment>
        <rdfs:label>OT Device Exception</rdfs:label>
    </owl:Class>
    


