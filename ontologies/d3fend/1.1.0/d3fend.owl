        <contributor rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#DISA_FSO"/>
        <definition>The organization employs malicious code protection mechanisms at information system entry and exit points to detect and eradicate malicious code transported by electronic mail, electronic mail attachments, web accesses, removable media, or other common means or inserted through the exploitation of information system vulnerabilities.</definition>
        <rdfs:label>CCI-001239</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CCI-001242_v2022-04-05 -->

    <owl:NamedIndividual rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CCI-001242_v2022-04-05">
        <rdf:type rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#CCIControl"/>
        <broader rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#DynamicAnalysis"/>
        <broader rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#EmulatedFileAnalysis"/>
        <broader rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#FileContentRules"/>
