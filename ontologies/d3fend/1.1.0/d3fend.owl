    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#RAM -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#RAM">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#PrimaryStorage"/>
        <definition>Random-access memory (RAM) is a form of computer memory that can be read and changed in any order, typically used to store working data and machine code.</definition>
        <synonym>Random-access Memory</synonym>
        <rdfs:isDefinedBy rdf:resource="https://dbpedia.org/page/Random-access_memory"/>
        <rdfs:label>RAM</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#RDPConnectRequestEvent -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#RDPConnectRequestEvent">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#RDPEvent"/>
        <definition>An event where an RDP client sends a connection request specifying session parameters, such as display settings, compression preferences, and security requirements, to prepare for an interactive session.</definition>
        <rdfs:label>RDP Connect Request Event</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#RDPConnectResponseEvent -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#RDPConnectResponseEvent">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#RDPEvent"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#preceded-by"/>
                <owl:someValuesFrom rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#RDPConnectRequestEvent"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <definition>An event where an RDP server acknowledges a connection request, finalizing session parameters and confirming the transition to an interactive remote session.</definition>
        <rdfs:label>RDP Connect Response Event</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#RDPEvent -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#RDPEvent">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#ApplicationLayerEvent"/>
        <rdfs:subClassOf>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#TCPEvent"/>
                    <rdf:Description rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#UDPEvent"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#has-participant"/>
                <owl:someValuesFrom rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#RDPSession"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <definition>An event involving the Remote Desktop Protocol (RDP), a communication protocol developed by Microsoft that facilitates secure remote access to graphical interfaces on desktops or applications hosted on remote servers. RDP supports multi-channel communication for transferring input, output, and management commands.</definition>
        <rdfs:label>RDP Event</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://schema.ocsf.io/1.3.0/classes/rdp_activity"/>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#RDPInitialRequestEvent -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#RDPInitialRequestEvent">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#RDPEvent"/>
        <definition>An event where an RDP client initiates communication with a server by sending a request to establish a session and negotiate protocol capabilities for remote interaction.</definition>
        <rdfs:label>RDP Initial Request Event</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#RDPInitialResponseEvent -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#RDPInitialResponseEvent">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#RDPEvent"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#preceded-by"/>
                <owl:someValuesFrom rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#RDPInitialRequestEvent"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <definition>An event where an RDP server responds to an initial request from a client, presenting its supported capabilities and agreeing to proceed with session negotiation.</definition>
        <rdfs:label>RDP Initial Response Event</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#RDPSession -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#RDPSession">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#RemoteSession"/>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#RDPTLSHandshakeEvent -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#RDPTLSHandshakeEvent">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#RDPEvent"/>
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#TCPEvent"/>
        <definition>An event representing the cryptographic exchange of keys and certificates between an RDP client and server to establish a secure communication channel. The handshake ensures encryption, integrity, and authentication for the session.</definition>
        <rdfs:label>RDP TLS Handshake Event</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#RFNode -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#RFNode">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#NetworkNode"/>
        <rdfs:label>RF Node</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#RFReceiver -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#RFReceiver">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#RFNode"/>
        <rdfs:label>RF Receiver</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#RFShielding -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#RFShielding">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#PlatformHardening"/>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#RFTransceiver -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#RFTransceiver">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#RFNode"/>
        <rdfs:label>RF Transceiver</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#RFTransmitter -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#RFTransmitter">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#RFNode"/>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#ROM -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#ROM">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#PrimaryStorage"/>
        <definition>Read-only memory (ROM) is a type of non-volatile memory used in computers and other electronic devices. Data stored in ROM cannot be electronically modified after the manufacture of the memory device. Read-only memory is useful for storing software that is rarely changed during the life of the system, also known as firmware.</definition>
        <synonym>Read-only Memory</synonym>
        <rdfs:isDefinedBy rdf:resource="https://dbpedia.org/page/Read-only_memory"/>
        <rdfs:label>ROM</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#RPCNetworkTraffic -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#RPCNetworkTraffic">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#NetworkTraffic"/>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#RPCTrafficAnalysis -->

