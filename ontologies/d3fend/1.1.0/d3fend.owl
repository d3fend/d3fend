    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#ConfigurationFile -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#ConfigurationFile">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#File"/>
        <definition>A file containing Information used to configure the parameters and initial settings for some computer programs. They are used for user applications, server processes and operating system settings.</definition>
        <rdfs:isDefinedBy rdf:resource="http://dbpedia.org/resource/Configuration_file"/>
        <rdfs:label>Configuration File</rdfs:label>
        <skos:altLabel>Settings File</skos:altLabel>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#ConfigurationInventory -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#ConfigurationInventory">
