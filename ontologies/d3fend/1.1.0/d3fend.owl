                <owl:someValuesFrom rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#MemoryExtent"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <definition>An event capturing operations on the memory resources of a system, encompassing allocation, modification, access, protection, or deallocation.</definition>
