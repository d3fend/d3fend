        <contributor rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#DISA_FSO"/>
        <definition>The information system enforces dynamic information flow control based on organization-defined policies.</definition>
        <rdfs:label>CCI-000027</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CCI-000029_v2022-04-05 -->

