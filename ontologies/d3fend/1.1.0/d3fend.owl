    </rdf:Description>
    <rdf:Description rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#Detect">
        <definition>The detect tactic is used to identify adversary access to or unauthorized activity on computer networks.</definition>
        <display-order rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</display-order>
