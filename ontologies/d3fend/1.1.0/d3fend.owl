    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#ServiceBinaryVerification -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#ServiceBinaryVerification">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#SystemFileAnalysis"/>
