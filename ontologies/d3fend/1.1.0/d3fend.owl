    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#Reference-PLCKeySwitchMonitoring -->

    <owl:NamedIndividual rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#Reference-PLCKeySwitchMonitoring">
        <rdf:type rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#InternetArticleReference"/>
        <kb-reference-of rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#OperatingModeMonitoring"/>
        <has-link rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://www.dragos.com/blog/industry-news/value-of-plc-key-switch-monitoring/</has-link>
        <kb-reference-title>Value of PLC Key Switch Monitoring to Keep Critical Systems More Secure</kb-reference-title>
        <kb-abstract>Programmable Logic Controllers (PLC) and Safety Instrumented Systems (SIS) Controllers have historically included an external switch, generally in the form of a key, to perform maintenance and troubleshooting. The key switch has become commonplace for automation engineers and technicians who maintain and support these systems and understand the importance of the little switch in overall device operation and affects the underlying process.</kb-abstract>
        <kb-author>DRAGOS</kb-author>
        <rdfs:label>Reference - Value of PLC Key Switch Monitoring to Keep Critical Systems More Secure</rdfs:label>
    </owl:NamedIndividual>
    


