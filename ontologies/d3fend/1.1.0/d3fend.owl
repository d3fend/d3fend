        <definition>An event occurring at the transport layer, responsible for end-to-end communication and data transfer management.</definition>
        <rdfs:label>Transport Layer Event</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#TransportLink -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#TransportLink">
