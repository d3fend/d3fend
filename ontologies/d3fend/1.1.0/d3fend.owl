    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#Non-PersonEntity">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#Agent"/>
        <definition>An entity related to information technology with a digital identity that acts in cyberspace, but is not a human actor. This can include organizations, hardware objects (physical entities/devices), software objects (virtual/logical entities), and information artifacts.</definition>
