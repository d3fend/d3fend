        <rdfs:domain rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#Weakness"/>
        <rdfs:range rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#Artifact"/>
        <rdfs:label>may-be-weakness-of</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#may-contain -->

    <owl:ObjectProperty rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#may-contain">
        <rdfs:subPropertyOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#may-be-associated-with"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
        <definition>to potentially have as contents or constituent parts; comprise; include.</definition>
        <rdfs:label>may-contain</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#may-counter -->

    <owl:ObjectProperty rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#may-counter">
        <rdfs:subPropertyOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#may-be-associated-with"/>
        <rdfs:label>may-counter</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#may-counter-attack -->

    <owl:ObjectProperty rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#may-counter-attack">
        <rdfs:subPropertyOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#may-be-tactically-associated-with"/>
