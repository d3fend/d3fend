                <owl:someValuesFrom rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#OperatingSystemConfiguration"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#HostGroup -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#HostGroup">
