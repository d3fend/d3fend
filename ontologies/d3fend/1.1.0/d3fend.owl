    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#RemoveUserFromGroupEvent -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#RemoveUserFromGroupEvent">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#GroupManagementEvent"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#preceded-by"/>
                <owl:someValuesFrom rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#AddUserToGroupEvent"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <definition>An event where a user is removed from a group, revoking the permissions and privileges associated with the group from the user.</definition>
        <rdfs:label>Remove User from Group Event</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#Repository -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#Repository">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#DigitalInformationBearer"/>
