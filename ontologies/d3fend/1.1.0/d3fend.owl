        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#FullVolumeSnapshot -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#FullVolumeSnapshot">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#VolumeSnapshot"/>
        <definition>A full volume snapshot is a point-in-time copy of the complete contents of a volume.</definition>
        <rdfs:label>Full Volume Snapshot</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://aws.amazon.com/compare/the-difference-between-incremental-differential-and-other-backups/"/>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#FuzzyLogic -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#FuzzyLogic">
