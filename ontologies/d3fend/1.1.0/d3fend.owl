        <rdfs:comment>BACnet/IP: GET_ALARM_SUMMARY</rdfs:comment>
        <rdfs:comment>Modbus/TCP: READ_EXCEPTION_STATUS</rdfs:comment>
        <rdfs:label>OT Parameter Status</rdfs:label>
    </owl:Class>
    


