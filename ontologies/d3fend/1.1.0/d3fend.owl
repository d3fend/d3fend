        <definition>Dynamic program analysis is the analysis of computer software that is performed by executing programs on a real or virtual processor.</definition>
        <rdfs:isDefinedBy rdf:resource="http://dbpedia.org/resource/Dynamic_program_analysis"/>
        <rdfs:label>Dynamic Analysis Tool</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#Email -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#Email">
