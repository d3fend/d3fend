    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#TrustStore -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#TrustStore">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#DigitalInformationBearer"/>
        <definition>Stores public information necessary to determine if another party can be trusted.</definition>
        <rdfs:label>Trust Store</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dbpedia.org/resource/Public_key_certificate"/>
        <rdfs:seeAlso rdf:resource="https://www.educative.io/edpresso/keystore-vs-truststore"/>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#TrustedAdministratorAttacker -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#TrustedAdministratorAttacker">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#TrustedAttacker"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#accesses"/>
                <owl:someValuesFrom rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#PrivilegedUserAccount"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <definition>A trusted attacker who misuses administrative access to execute attacks, often with elevated privileges.</definition>
        <rdfs:label>Trusted Administrator Attacker</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#TrustedAttacker -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#TrustedAttacker">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#Attacker"/>
        <definition>An individual who exploits their authorized access to conduct unauthorized actions, either intentionally or through negligence.</definition>
        <rdfs:label>Trusted Attacker</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#TrustedLibrary -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#TrustedLibrary">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#SourceCodeHardening"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#hardens"/>
                <owl:someValuesFrom rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#Subroutine"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#TrustedUserAttacker -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#TrustedUserAttacker">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#TrustedAttacker"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#accesses"/>
                <owl:someValuesFrom rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#DefaultUserAccount"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#accesses"/>
                <owl:someValuesFrom rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#DomainUserAccount"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#accesses"/>
                <owl:someValuesFrom rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#LocalUserAccount"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <definition>A trusted attacker who abuses regular user-level access privileges to compromise systems or data.</definition>
        <rdfs:label>Trusted User Attacker</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#TunnelCloseEvent -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#TunnelCloseEvent">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#TunnelEvent"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#preceded-by"/>
                <owl:someValuesFrom rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#TunnelOpenEvent"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <definition>An event where a network tunnel is terminated, ending encapsulated communication and releasing the associated resources.</definition>
        <rdfs:label>Tunnel Close Event</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#TunnelEvent -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#TunnelEvent">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#NetworkEvent"/>
        <definition>An event involving the establishment, usage, or termination of a network tunnel. Tunnels provide encapsulated communication pathways across various layers, enabling secure, isolated, or virtualized transport of data.</definition>
        <rdfs:label>Tunnel Event</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#TunnelOpenEvent -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#TunnelOpenEvent">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#TunnelEvent"/>
        <definition>An event where a network tunnel is established, enabling encapsulated communication between endpoints. This marks the initiation of secure or isolated data transport through the tunnel.</definition>
        <rdfs:label>Tunnel Open Event</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#TunnelRenewEvent -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#TunnelRenewEvent">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#TunnelEvent"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#preceded-by"/>
                <owl:someValuesFrom rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#TunnelOpenEvent"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <definition>An event where the lifecycle of a network tunnel is extended, ensuring continued encapsulated communication and avoiding session expiration.</definition>
        <rdfs:label>Tunnel Renew Event</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#UDPEvent -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#UDPEvent">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#TransportLayerEvent"/>
        <definition>An event involving the User Datagram Protocol (UDP), providing a connectionless datagram service with minimal protocol mechanisms.</definition>
        <rdfs:label>UDP Event</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#URL -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#URL">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#Identifier"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#addresses"/>
                <owl:someValuesFrom rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#Resource"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#URLAnalysis -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#URLAnalysis">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#IdentifierAnalysis"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#analyzes"/>
                <owl:someValuesFrom rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#URL"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#URLReputationAnalysis -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#URLReputationAnalysis">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#IdentifierReputationAnalysis"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#analyzes"/>
                <owl:someValuesFrom rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#URL"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#UncertaintySampling -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#UncertaintySampling">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#ActiveLearning"/>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#UnitTestExecutionTool -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#UnitTestExecutionTool">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#TestExecutionTool"/>
        <definition>An unit test execution tool automatically performs unit testing.  Unit testing is a software testing method by which individual units of source code are tested to determine whether they are fit for use.  Unit test execution tools work with sets of one or more computer program modules together with associated control data, usage procedures, and operating procedures. This contrasts with integration testing, which tests inter-unit dependencies and the modules as a group.</definition>
        <rdfs:label>Unit Test Execution Tool</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dbpedia.org/resource/Unit_testing"/>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#UnixHardLink -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#UnixHardLink">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#HardLink"/>
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#UnixLink"/>
        <definition>A Unix hard link is a hard link on a Unix file system.</definition>
        <rdfs:isDefinedBy rdf:resource="http://dbpedia.org/resource/Hard_link"/>
        <rdfs:label>Unix Hard Link</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#UnixLink -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#UnixLink">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#FileSystemLink"/>
        <definition>A Unix link is a file link in a Unix file system.</definition>
        <rdfs:label>Unix Link</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#UnloadLibraryEvent -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#UnloadLibraryEvent">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#ProcessEvent"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#has-participant"/>
                <owl:someValuesFrom rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#SharedLibraryFile"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#preceded-by"/>
                <owl:someValuesFrom rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#LoadLibraryEvent"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <definition>An event where a process unloads a dynamically linked library or module, reducing its memory footprint or functionality.</definition>
        <rdfs:label>Unload Library Event</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#UnloadModule -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#UnloadModule">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#SystemCall"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#unloads"/>
                <owl:someValuesFrom rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#HardwareDriver"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#unloads"/>
                <owl:someValuesFrom rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#KernelModule"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#UnlockAccount -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#UnlockAccount">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#RestoreUserAccountAccess"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#restores"/>
                <owl:someValuesFrom rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#UserAccount"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#UnsupervisedLearning -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#UnsupervisedLearning">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#MachineLearning"/>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#UnsupervisedPreprocessing -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#UnsupervisedPreprocessing">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#Semi-SupervisedLearning"/>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#UseCaseGoal -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#UseCaseGoal">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#Goal"/>
        <rdfs:label>Use Case Goal</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#UseCasePrerequisite -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#UseCasePrerequisite">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#Condition"/>
        <rdfs:label>Use Case Prerequisite</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#UseCaseProcedure -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#UseCaseProcedure">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#Procedure"/>
        <rdfs:label>Use Case Procedure</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#UseCaseStep -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#UseCaseStep">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#Step"/>
        <rdfs:label>Use Case Step</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#User -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#User">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#Agent"/>
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#DigitalInformationBearer"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#has-account"/>
                <owl:someValuesFrom rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#UserAccount"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#restricted-by"/>
                <owl:someValuesFrom rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#AccessControlList"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#UserAccount -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#UserAccount">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#DigitalInformationBearer"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#identified-by"/>
                <owl:someValuesFrom rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#DigitalIdentity"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#used-by"/>
                <owl:someValuesFrom rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#Agent"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#UserAccountAttachPolicyEvent -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#UserAccountAttachPolicyEvent">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#UserAccountEvent"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#preceded-by"/>
                <owl:someValuesFrom rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#UserAccountCreationEvent"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <definition>An event where an IAM policy is attached to a user account.</definition>
        <rdfs:label>User Account Attach Policy Event</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#UserAccountCreationEvent -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#UserAccountCreationEvent">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#UserAccountEvent"/>
        <definition>An event representing the creation of a new user account within a system or domain.</definition>
        <rdfs:label>User Account Creation Event</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#UserAccountDeletionEvent -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#UserAccountDeletionEvent">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#UserAccountEvent"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#preceded-by"/>
                <owl:someValuesFrom rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#UserAccountCreationEvent"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <definition>An event representing the permanent deletion of a user account from a system or domain.</definition>
        <rdfs:label>User Account Deletion Event</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#UserAccountDetachPolicyEvent -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#UserAccountDetachPolicyEvent">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#UserAccountEvent"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#preceded-by"/>
                <owl:someValuesFrom rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#UserAccountAttachPolicyEvent"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <definition>An event where an IAM policy is detached from a user account.</definition>
        <rdfs:label>User Account Detach Policy Event</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#UserAccountDisableEvent -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#UserAccountDisableEvent">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#UserAccountEvent"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#preceded-by"/>
                <owl:someValuesFrom rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#UserAccountEnableEvent"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <definition>An event where a user account is disabled, preventing its active use within the system.</definition>
        <rdfs:label>User Account Disable Event</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#UserAccountEnableEvent -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#UserAccountEnableEvent">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#UserAccountEvent"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#preceded-by"/>
                <owl:someValuesFrom rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#UserAccountCreationEvent"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <definition>An event where a user account is enabled, granting it active use within the system.</definition>
        <rdfs:label>User Account Enable Event</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#UserAccountEvent -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#UserAccountEvent">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#DigitalEvent"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#has-participant"/>
                <owl:someValuesFrom rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#UserAccount"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <definition>An event capturing operations or state changes performed on user accounts, including lifecycle management, access control modifications, and policy assignments.</definition>
        <rdfs:label>User Account Event</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://schema.ocsf.io/1.3.0/classes/account_change"/>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#UserAccountLockEvent -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#UserAccountLockEvent">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#UserAccountEvent"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#preceded-by"/>
                <owl:someValuesFrom rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#UserAccountCreationEvent"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <definition>An event where a user account is locked out due to failed authentication attempts or administrative action.</definition>
        <rdfs:label>User Account Lock Event</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#UserAccountMFADisableEvent -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#UserAccountMFADisableEvent">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#UserAccountEvent"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#preceded-by"/>
                <owl:someValuesFrom rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#UserAccountMFAEnableEvent"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <definition>An event where multi-factor authentication (MFA) is disabled for a user account.</definition>
        <rdfs:label>User Account MFA Disable Event</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#UserAccountMFAEnableEvent -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#UserAccountMFAEnableEvent">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#UserAccountEvent"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#preceded-by"/>
                <owl:someValuesFrom rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#UserAccountCreationEvent"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <definition>An event where multi-factor authentication (MFA) is enabled for a user account.</definition>
        <rdfs:label>User Account MFA Enable Event</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#UserAccountPasswordChangeEvent -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#UserAccountPasswordChangeEvent">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#UserAccountEvent"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#preceded-by"/>
                <owl:someValuesFrom rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#UserAccountCreationEvent"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <definition>An event where a user account&apos;s password is modified, typically by the user or an administrator.</definition>
        <rdfs:label>User Account Password Change Event</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#UserAccountPasswordResetEvent -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#UserAccountPasswordResetEvent">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#UserAccountEvent"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#preceded-by"/>
                <owl:someValuesFrom rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#UserAccountCreationEvent"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <definition>An event where a user account&apos;s password is reset, typically due to a forgotten password or administrative action.</definition>
        <rdfs:label>User Account Password Reset Event</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#UserAccountPermissions -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#UserAccountPermissions">
