    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#PhiCoefficient">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#Correlation"/>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#PhysicalAccessMediation -->

