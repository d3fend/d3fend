        <published rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2009-09-14T00:00:00</published>
        <contributor rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#DISA_FSO"/>
        <definition>The information system provides the capability for privileged administrators to configure the organization-defined security policy filters to support different security policies.</definition>
        <rdfs:label>CCI-000035</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CCI-000037_v2022-04-05 -->

    <owl:NamedIndividual rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CCI-000037_v2022-04-05">
