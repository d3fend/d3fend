        <narrower rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#AccountLocking"/>
        <published rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2009-05-19T00:00:00</published>
        <contributor rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#DISA_FSO"/>
        <definition>The information system initiates a session lock after the organization-defined time period of inactivity.</definition>
        <rdfs:label>CCI-000057</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CCI-000058_v2022-04-05 -->

    <owl:NamedIndividual rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#CCI-000058_v2022-04-05">
