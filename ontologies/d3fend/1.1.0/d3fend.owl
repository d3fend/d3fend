    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#IntranetAdministrativeNetworkTraffic -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#IntranetAdministrativeNetworkTraffic">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#AdministrativeNetworkTraffic"/>
