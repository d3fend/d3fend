            </owl:Restriction>
        </rdfs:subClassOf>
        <definition>An event where a file is permanently removed from the file system or storage medium, potentially triggering actions related to data retention or recovery.</definition>
        <rdfs:label>File Deletion Event</rdfs:label>
    </owl:Class>
    


