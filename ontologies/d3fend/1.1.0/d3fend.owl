        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#LocalAreaNetworkAttacker -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#LocalAreaNetworkAttacker">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#LocalAttacker"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#accesses"/>
                <owl:someValuesFrom rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#LocalAreaNetwork"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <definition>An attacker who exploits vulnerabilities within the same local area network.</definition>
        <synonym>LAN Attacker</synonym>
        <rdfs:label>Local Area Network Attacker</rdfs:label>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#LocalAreaNetworkTraffic -->

