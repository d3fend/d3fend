        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#PasswordDatabase"/>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#SystemPlatformVariable -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#SystemPlatformVariable">
        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#RuntimeVariable"/>
        <definition>Runtime variables  which may consist of memory usage, internal temperature, operating mode, clock time, scan time, hardware status, etc.</definition>
        <synonym>Configuration Resource</synonym>
        <synonym>System Data</synonym>
        <synonym>System Properties</synonym>
        <rdfs:label>System Platform Variable</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://literature.rockwellautomation.com/idc/groups/literature/documents/pm/1756-pm015_-en-p.pdf"/>
        <rdfs:seeAlso rdf:resource="https://www.nrc.gov/docs/ml0932/ml093290422.pdf"/>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#SystemServiceSoftware -->

    <owl:Class rdf:about="http://d3fend.mitre.org/ontologies/d3fend.owl#SystemServiceSoftware">
