        <contributor rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#DISA_FSO"/>
        <definition>The organization employs a deny-all, permit-by-exception policy to allow the execution of authorized software programs on the information system.</definition>
        <rdfs:label>CCI-001774</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#CCI-001811_v2022-04-05 -->

