        <rdfs:label>Exception Handler</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://dbpedia.org/resource/Exception_handling"/>
    </owl:Class>
    


    <!-- http://d3fend.mitre.org/ontologies/d3fend.owl#ExceptionHandlerPointerValidation -->

