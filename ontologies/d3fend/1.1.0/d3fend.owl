        <rdfs:subClassOf rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#OTInformationalMessage"/>
        <definition>A subscribed device status update message containing configuration, or I/O data.</definition>
        <rdfs:comment>BACnet/IP: SUBSCRIBE_COV
BACnet/IP: SUBSCRIBE_COV_PROPERTY
BACnet/IP: UNCONFIRMED_COV_NOTIFICATION
BACnet/IP: UNCONFIRMED_COV_NOTIFICATION_MULTIPLE
BACnet/IP: CONFIRMED_COV_NOTIFICATION
BACnet/IP: VT_DATA
BACnet/IP: CONFIRMED_TEXT_MESSAGE
BACnet/IP: UNCONFIRMED_TEXT_MESSAGE
BACnet/IP: CONFIRMED_PRIVATE_TRANSFER
BACnet/IP: UNCONFIRMED_PRIVATE_TRANSFER
BACnet/IP: UTC_TIME_SYNCHRONIZATION </rdfs:comment>
        <rdfs:comment>DNP3: DISABLE_UNSOLICITED
DNP3: ENABLE_UNSOLICITED
DNP3: DELAY_MEASURE
DNP3: Local Timing Accuracy
DNP3: DNP3 Subset and Conformance
DNP3: Duration of Time Accuracy
DNP3: CONFIRM
DNP3: CONFIRMED_USER_DATA</rdfs:comment>
        <rdfs:comment>GEMS: PingMessage
GEMS: AsyncStatus</rdfs:comment>
        <rdfs:label>OT Device Status</rdfs:label>
    </owl:Class>
    


