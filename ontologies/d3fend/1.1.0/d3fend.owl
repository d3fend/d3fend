                <owl:someValuesFrom rdf:resource="http://d3fend.mitre.org/ontologies/d3fend.owl#OTPauseService"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>OT Pause Service Event</rdfs:label>
    </owl:Class>
    


