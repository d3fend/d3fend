ry energy source (electric, hydraulic, or pneumatic) into targeted mechanical motion or adjustment. It typically works in conjunction with a control device (like a valve or logic driver) and is central to automation, enabling machines or systems to move, open, close, or otherwise manipulate their components or environment. By amplifying or redirecting energy from one form to another, the actuator executes control commands, thereby automating processes in industrial, automotive, aerospace, and other domains where precise mechanical action is essential.","rdfs:label":"Actuator","rdfs:seeAlso":{"@id":"http://dbpedia.org/resource/Actuator"},"rdfs:subClassOf":{"@id":"d3f:OutputDevice"}},{"@id":"d3f:OutputDevice"},{"@id":"http://dbpedia.org/resource/Actuator"}]},"da_graph":{"@context":{"rdfs":"http://www.w3.org/2000/01/rdf-schema#","owl":"http://www.w3.org/2002/07/owl#","d3f":"http://d3fend.mitre.org/ontologies/d3fend.owl#","skos":"http://www.w3.org/2004/02/skos/core#"},"@graph":[{"@id":"d3f:Actuator","rdfs:hasSubClass":{"@id":"d3f:OTActuator"},"rdfs:label":"Actuator"},{"@id":"d3f:Artifact","rdfs:hasSubClass":[{"@id":"d3f:PhysicalArtifact"},{"@id":"d3f:DigitalArtifact"}],"rdfs:label":"Artifact"},{"@id":"d3f:DigitalArtifact","rdfs:hasSubClass":{"@id":"d3f:DigitalInformationBearer"},"rdfs:label":"Digital Artifact"},{"@id":"d3f:DigitalInformationBearer","rdfs:hasSubClass":{"@id":"d3f:HardwareDevice"},"rdfs:label":"Digital Information Bearer"},{"@id":"d3f:HardwareDevice","rdfs:hasSubClass":{"@id":"d3f:OutputDevice"},"rdfs:label":"Hardware Device"},{"@id":"d3f:OTActuator","rdfs:label":"OT Actuator"},{"@id":"d3f:OutputDevice","rdfs:hasSubClass":{"@id":"d3f:Actuator"},"rdfs:label":"Output Device"},{"@id":"d3f:PhysicalArtifact","rdfs:hasSubClass":{"@id":"d3f:HardwareDevice"},"rdfs:label":"Physical Artifact"}]},"description":{"@context":{"rdfs":"http://www.w3.org/2000/01/rdf-schema#","owl":"http://www.w3.org/2002/07/owl#","d3f":"http://d3fend.mitre.org/ontologies/d3fend.owl#","sko