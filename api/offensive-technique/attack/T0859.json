 and may even be used for persistent access to remote systems. Compromised and default credentials may also grant an adversary increased privilege to specific systems and devices or access to restricted areas of the network. Adversaries may choose not to use malware or tools, in conjunction with the legitimate access those credentials provide, to make it harder to detect their presence or to control devices and send legitimate commands in an unintended way.","d3f:produces":[{"@id":"d3f:Authorization"},{"@id":"d3f:Authentication"}],"d3f:uses":{"@id":"d3f:UserAccount"},"rdfs:label":"Valid Accounts - ATTACK ICS","rdfs:subClassOf":[{"@id":"d3f:ATTACKICSLateralMovementTechnique"},{"@id":"d3f:ATTACKICSPersistenceTechnique"}],"skos:prefLabel":"Valid Accounts"}]},"subtechniques":{"@context":{"rdfs":"http://www.w3.org/2000/01/rdf-schema#","owl":"http://www.w3.org/2002/07/owl#","d3f":"http://d3fend.mitre.org/ontologies/d3fend.owl#","skos":"http://www.w3.org/2004/02/skos/core#"},"@graph":[]},"framework":{"framework_key":"ics","framework_label":"ICS","framework_root":"d3f:ATTACKICSTechnique","label_key":"skos:prefLabel"}}