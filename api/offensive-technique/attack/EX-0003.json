audit. Once resident, the modified process becomes the new trust oracle, enabling recurring execution for the attacker and, in some cases, denying legitimate control by causing authentic inputs to fail verification or to be deprioritized.","d3f:may-modify":{"@id":"d3f:FlightSoftware"},"rdfs:label":"Modify Authentication Process - SPARTA","rdfs:seeAlso":{"@id":"https://sparta.aerospace.org/technique/EX-0003/"},"rdfs:subClassOf":{"@id":"d3f:SPARTAExecutionTechnique"},"skos:prefLabel":"Modify Authentication Process"}]},"subtechniques":{"@context":{"rdfs":"http://www.w3.org/2000/01/rdf-schema#","owl":"http://www.w3.org/2002/07/owl#","d3f":"http://d3fend.mitre.org/ontologies/d3fend.owl#","skos":"http://www.w3.org/2004/02/skos/core#"},"@graph":[]},"framework":{"framework_key":"sparta","framework_label":"SPARTA","framework_root":"d3f:SPARTATechnique","label_key":"skos:prefLabel"}}