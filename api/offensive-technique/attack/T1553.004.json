ype":["owl:NamedIndividual","owl:Class"],"d3f:attack-id":"T1553.004","d3f:definition":"Adversaries may install a root certificate on a compromised system to avoid warnings when connecting to adversary controlled web servers. Root certificates are used in public key cryptography to identify a root certificate authority (CA). When a root certificate is installed, the system or application will trust certificates in the root's chain of trust that have been signed by the root certificate.(Citation: Wikipedia Root Certificate) Certificates are commonly used for establishing secure TLS/SSL communications within a web browser. When a user attempts to browse a website that presents a certificate that is not trusted an error message will be displayed to warn the user of the security risk. Depending on the security settings, the browser may not allow the user to establish a connection to the website.","d3f:modifies":{"@id":"d3f:CertificateTrustStore"},"rdfs:label":"Install Root Certificate","rdfs:subClassOf":{"@id":"d3f:T1553"}}]},"subtechniques":{"@context":{"rdfs":"http://www.w3.org/2000/01/rdf-schema#","owl":"http://www.w3.org/2002/07/owl#","d3f":"http://d3fend.mitre.org/ontologies/d3fend.owl#","skos":"http://www.w3.org/2004/02/skos/core#"},"@graph":[{"@id":"d3f:T1553","d3f:attack-id":["T1553"],"d3f:top-level":["true"],"rdfs:hasSubClass":[{"@id":"d3f:T1553.004"},{"@id":"d3f:T1553.002"},{"@id":"d3f:T1553.006"},{"@id":"d3f:T1553.003"},{"@id":"d3f:T1553.001"},{"@id":"d3f:T1553.005"}],"rdfs:label":["Subvert Trust Controls"]},{"@id":"d3f:T1553.001","d3f:attack-id":["T1553.001"],"rdfs:label":["Gatekeeper Bypass"],"rdfs:subClassOf":[{"@id":"d3f:T1553"}]},{"@id":"d3f:T1553.002","d3f:attack-id":["T1553.002"],"rdfs:label":["Code Signing"],"rdfs:subClassOf":[{"@id":"d3f:T1553"}]},{"@id":"d3f:T1553.003","d3f:attack-id":["T1553.003"],"rdfs:label":["SIP and Trust Provider Hijacking"],"rdfs:subClassOf":[{"@id":"d3f:T1553"}]},{"@id":"d3f:T1553.004","d3f:attack-id":["T1553.004"],"rdfs:labe