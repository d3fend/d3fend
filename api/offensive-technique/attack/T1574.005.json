y an installer. These processes may automatically execute specific binaries as part of their functionality or to perform other actions. If the permissions on the file system directory containing a target binary, or permissions on the binary itself, are improperly set, then the target binary may be overwritten with another binary using user-level permissions and executed by the original process. If the original process and thread are running under a higher permissions level, then the replaced binary will also execute under higher-level permissions, which could include SYSTEM.","d3f:modifies":{"@id":"d3f:ServiceApplication"},"rdfs:label":"Executable Installer File Permissions Weakness","rdfs:subClassOf":{"@id":"d3f:T1574"}}]},"subtechniques":{"@context":{"rdfs":"http://www.w3.org/2000/01/rdf-schema#","owl":"http://www.w3.org/2002/07/owl#","d3f":"http://d3fend.mitre.org/ontologies/d3fend.owl#","skos":"http://www.w3.org/2004/02/skos/core#"},"@graph":[{"@id":"d3f:T1574","d3f:attack-id":["T1574"],"d3f:top-level":["true"],"rdfs:hasSubClass":[{"@id":"d3f:T1574.014"},{"@id":"d3f:T1574.002"},{"@id":"d3f:T1574.004"},{"@id":"d3f:T1574.013"},{"@id":"d3f:T1574.012"},{"@id":"d3f:T1574.011"},{"@id":"d3f:T1574.009"},{"@id":"d3f:T1574.001"},{"@id":"d3f:T1574.007"},{"@id":"d3f:T1574.010"},{"@id":"d3f:T1574.006"},{"@id":"d3f:T1574.005"},{"@id":"d3f:T1574.008"}],"rdfs:label":["Hijack Execution Flow"]},{"@id":"d3f:T1574.001","d3f:attack-id":["T1574.001"],"rdfs:label":["DLL"],"rdfs:subClassOf":[{"@id":"d3f:T1574"}]},{"@id":"d3f:T1574.002","d3f:attack-id":["T1574.002"],"rdfs:label":["DLL Side-Loading"],"rdfs:subClassOf":[{"@id":"d3f:T1574"}]},{"@id":"d3f:T1574.004","d3f:attack-id":["T1574.004"],"rdfs:label":["Dylib Hijacking"],"rdfs:subClassOf":[{"@id":"d3f:T1574"}]},{"@id":"d3f:T1574.005","d3f:attack-id":["T1574.005"],"rdfs:label":["Executable Installer File Permissions Weakness"],"rdfs:subClassOf":[{"@id":"d3f:T1574"}]},{"@id":"d3f:T1574.006","d3f:attack-id":["T1574.006"],"rdfs:label":["