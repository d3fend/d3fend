vidual","owl:Class"],"d3f:attack-id":"T1578.001","d3f:creates":{"@id":"d3f:ComputingSnapshot"},"d3f:definition":"An adversary may create a snapshot or data backup within a cloud account to evade defenses. A snapshot is a point-in-time copy of an existing cloud compute component such as a virtual machine (VM), virtual hard drive, or volume. An adversary may leverage permissions to create a snapshot in order to bypass restrictions that prevent access to existing compute service infrastructure, unlike in [Revert Cloud Instance](https://attack.mitre.org/techniques/T1578/004) where an adversary may revert to a snapshot to evade detection and remove evidence of their presence.","rdfs:label":"Create Snapshot","rdfs:subClassOf":{"@id":"d3f:T1578"}}]},"subtechniques":{"@context":{"rdfs":"http://www.w3.org/2000/01/rdf-schema#","owl":"http://www.w3.org/2002/07/owl#","d3f":"http://d3fend.mitre.org/ontologies/d3fend.owl#","skos":"http://www.w3.org/2004/02/skos/core#"},"@graph":[{"@id":"d3f:T1578","d3f:attack-id":["T1578"],"d3f:top-level":["true"],"rdfs:hasSubClass":[{"@id":"d3f:T1578.002"},{"@id":"d3f:T1578.003"},{"@id":"d3f:T1578.004"},{"@id":"d3f:T1578.005"},{"@id":"d3f:T1578.001"}],"rdfs:label":["Modify Cloud Compute Infrastructure"]},{"@id":"d3f:T1578.001","d3f:attack-id":["T1578.001"],"rdfs:label":["Create Snapshot"],"rdfs:subClassOf":[{"@id":"d3f:T1578"}]},{"@id":"d3f:T1578.002","d3f:attack-id":["T1578.002"],"rdfs:label":["Create Cloud Instance"],"rdfs:subClassOf":[{"@id":"d3f:T1578"}]},{"@id":"d3f:T1578.003","d3f:attack-id":["T1578.003"],"rdfs:label":["Delete Cloud Instance"],"rdfs:subClassOf":[{"@id":"d3f:T1578"}]},{"@id":"d3f:T1578.004","d3f:attack-id":["T1578.004"],"rdfs:label":["Revert Cloud Instance"],"rdfs:subClassOf":[{"@id":"d3f:T1578"}]},{"@id":"d3f:T1578.005","d3f:attack-id":["T1578.005"],"rdfs:label":["Modify Cloud Compute Configurations"],"rdfs:subClassOf":[{"@id":"d3f:T1578"}]}]},"framework":{"framework_key":"enterprise","framework_label":"Enterprise","framew