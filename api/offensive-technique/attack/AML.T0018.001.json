002"}],"rdfs:label":["Manipulate AI Model - ATLAS"],"skos:prefLabel":["Manipulate AI Model"]},{"@id":"d3f:AML.T0018.000","d3f:attack-id":["AML.T0018.000"],"rdfs:label":["Poison AI Model - ATLAS"],"rdfs:subClassOf":[{"@id":"d3f:AML.T0018"}],"skos:prefLabel":["Poison AI Model"]},{"@id":"d3f:AML.T0018.001","d3f:attack-id":["AML.T0018.001"],"rdfs:label":["Modify AI Model Architecture - ATLAS"],"rdfs:subClassOf":[{"@id":"d3f:AML.T0018"}],"skos:prefLabel":["Modify AI Model Architecture"]},{"@id":"d3f:AML.T0018.002","d3f:attack-id":["AML.T0018.002"],"rdfs:label":["Embed Malware - ATLAS"],"rdfs:subClassOf":[{"@id":"d3f:AML.T0018"}],"skos:prefLabel":["Embed Malware"]}]},"framework":{"framework_key":"atlas","framework_label":"ATLAS","framework_root":"d3f:ATLASTechnique","label_key":"skos:prefLabel"}}