medIndividual","owl:Class"],"d3f:attack-id":"T1564.001","d3f:definition":"Adversaries may set files and directories to be hidden to evade detection mechanisms. To prevent normal users from accidentally changing special files on a system, most operating systems have the concept of a ‘hidden’ file. These files don’t show up when a user browses the file system with a GUI or when using normal commands on the command line. Users must explicitly ask to show the hidden files either via a series of Graphical User Interface (GUI) prompts or with command line switches (<code>dir /a</code> for Windows and <code>ls –a</code> for Linux and macOS).","d3f:modifies":{"@id":"d3f:FileSystemMetadata"},"rdfs:label":"Hidden Files and Directories","rdfs:subClassOf":{"@id":"d3f:T1564"}}]},"subtechniques":{"@context":{"rdfs":"http://www.w3.org/2000/01/rdf-schema#","owl":"http://www.w3.org/2002/07/owl#","d3f":"http://d3fend.mitre.org/ontologies/d3fend.owl#","skos":"http://www.w3.org/2004/02/skos/core#"},"@graph":[{"@id":"d3f:T1564","d3f:attack-id":["T1564"],"d3f:top-level":["true"],"rdfs:hasSubClass":[{"@id":"d3f:T1564.012"},{"@id":"d3f:T1564.013"},{"@id":"d3f:T1564.006"},{"@id":"d3f:T1564.014"},{"@id":"d3f:T1564.004"},{"@id":"d3f:T1564.003"},{"@id":"d3f:T1564.001"},{"@id":"d3f:T1564.005"},{"@id":"d3f:T1564.008"},{"@id":"d3f:T1564.010"},{"@id":"d3f:T1564.011"},{"@id":"d3f:T1564.009"},{"@id":"d3f:T1564.007"},{"@id":"d3f:T1564.002"}],"rdfs:label":["Hide Artifacts"]},{"@id":"d3f:T1564.001","d3f:attack-id":["T1564.001"],"rdfs:label":["Hidden Files and Directories"],"rdfs:subClassOf":[{"@id":"d3f:T1564"}]},{"@id":"d3f:T1564.002","d3f:attack-id":["T1564.002"],"rdfs:label":["Hidden Users"],"rdfs:subClassOf":[{"@id":"d3f:T1564"}]},{"@id":"d3f:T1564.003","d3f:attack-id":["T1564.003"],"rdfs:label":["Hidden Window"],"rdfs:subClassOf":[{"@id":"d3f:T1564"}]},{"@id":"d3f:T1564.004","d3f:attack-id":["T1564.004"],"rdfs:label":["NTFS File Attributes"],"rdfs:subClassOf":[{"@id":"d3f:T1564"}]},{"@id":"d3f:T15