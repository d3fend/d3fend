s. False pressure or temperature readings can cause autonomous venting or lockouts; tweaked alignment matrices or misapplied gimbal limits can yield off-axis thrust and attitude excursions; altered desaturation rules can induce frequent wheel unloads that sap resources. Because consumables are finite and margins tight, even modest parameter drift can shorten mission life or violate keep-out and conjunction constraints while presenting as “normal” control activity.","d3f:modifies":{"@id":"d3f:OTControlVariable"},"rdfs:label":"Propulsion Subsystem - SPARTA","rdfs:seeAlso":{"@id":"https://sparta.aerospace.org/technique/EX-0012/07/"},"rdfs:subClassOf":{"@id":"d3f:EX-0012"},"skos:prefLabel":"Propulsion Subsystem"}]},"subtechniques":{"@context":{"rdfs":"http://www.w3.org/2000/01/rdf-schema#","owl":"http://www.w3.org/2002/07/owl#","d3f":"http://d3fend.mitre.org/ontologies/d3fend.owl#","skos":"http://www.w3.org/2004/02/skos/core#"},"@graph":[{"@id":"d3f:EX-0012","d3f:attack-id":["EX-0012"],"d3f:top-level":["true"],"rdfs:hasSubClass":[{"@id":"d3f:EX-0012.08"},{"@id":"d3f:EX-0012.04"},{"@id":"d3f:EX-0012.05"},{"@id":"d3f:EX-0012.06"},{"@id":"d3f:EX-0012.12"},{"@id":"d3f:EX-0012.03"},{"@id":"d3f:EX-0012.13"},{"@id":"d3f:EX-0012.07"},{"@id":"d3f:EX-0012.01"},{"@id":"d3f:EX-0012.10"},{"@id":"d3f:EX-0012.09"},{"@id":"d3f:EX-0012.11"},{"@id":"d3f:EX-0012.02"}],"rdfs:label":["Modify On-Board Values - SPARTA"],"skos:prefLabel":["Modify On-Board Values"]},{"@id":"d3f:EX-0012.01","d3f:attack-id":["EX-0012.01"],"rdfs:label":["Registers - SPARTA"],"rdfs:subClassOf":[{"@id":"d3f:EX-0012"}],"skos:prefLabel":["Registers"]},{"@id":"d3f:EX-0012.02","d3f:attack-id":["EX-0012.02"],"rdfs:label":["Internal Routing Tables - SPARTA"],"rdfs:subClassOf":[{"@id":"d3f:EX-0012"}],"skos:prefLabel":["Internal Routing Tables"]},{"@id":"d3f:EX-0012.03","d3f:attack-id":["EX-0012.03"],"rdfs:label":["Memory Write/Loads - SPARTA"],"rdfs:subClassOf":[{"@id":"d3f:EX-0012"}],"skos:prefLabel":["Memory Write/Loads"