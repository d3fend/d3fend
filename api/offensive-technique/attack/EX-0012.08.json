tar-tracker mask can force frequent dropouts; an inflated gyro bias drives the filter away from truth; softened actuator limits or mis-set gains let disturbances accumulate; altered sun-point entry criteria cause unnecessary mode switches. Secondary impacts propagate to power, thermal, and communications because pointing and geometry underpin array generation, radiator view factors, and antenna gain. The technique turns the spacecraft against itself by nudging the parameters that close the loop between what the vehicle believes and how it responds.","d3f:modifies":{"@id":"d3f:OTControlVariable"},"rdfs:label":"Attitude Determination & Control Subsystem - SPARTA","rdfs:seeAlso":{"@id":"https://sparta.aerospace.org/technique/EX-0012/08/"},"rdfs:subClassOf":{"@id":"d3f:EX-0012"},"skos:prefLabel":"Attitude Determination & Control Subsystem"}]},"subtechniques":{"@context":{"rdfs":"http://www.w3.org/2000/01/rdf-schema#","owl":"http://www.w3.org/2002/07/owl#","d3f":"http://d3fend.mitre.org/ontologies/d3fend.owl#","skos":"http://www.w3.org/2004/02/skos/core#"},"@graph":[{"@id":"d3f:EX-0012","d3f:attack-id":["EX-0012"],"d3f:top-level":["true"],"rdfs:hasSubClass":[{"@id":"d3f:EX-0012.08"},{"@id":"d3f:EX-0012.04"},{"@id":"d3f:EX-0012.05"},{"@id":"d3f:EX-0012.06"},{"@id":"d3f:EX-0012.12"},{"@id":"d3f:EX-0012.03"},{"@id":"d3f:EX-0012.13"},{"@id":"d3f:EX-0012.07"},{"@id":"d3f:EX-0012.01"},{"@id":"d3f:EX-0012.10"},{"@id":"d3f:EX-0012.09"},{"@id":"d3f:EX-0012.11"},{"@id":"d3f:EX-0012.02"}],"rdfs:label":["Modify On-Board Values - SPARTA"],"skos:prefLabel":["Modify On-Board Values"]},{"@id":"d3f:EX-0012.01","d3f:attack-id":["EX-0012.01"],"rdfs:label":["Registers - SPARTA"],"rdfs:subClassOf":[{"@id":"d3f:EX-0012"}],"skos:prefLabel":["Registers"]},{"@id":"d3f:EX-0012.02","d3f:attack-id":["EX-0012.02"],"rdfs:label":["Internal Routing Tables - SPARTA"],"rdfs:subClassOf":[{"@id":"d3f:EX-0012"}],"skos:prefLabel":["Internal Routing Tables"]},{"@id":"d3f:EX-0012.03","d3f:attack-id":["EX-0012.