ry that may be signed by Microsoft and is used in several ways in either its GUI or in a command prompt.(Citation: win_mmc)(Citation: what_is_mmc) MMC can be used to create, open, and save custom consoles that contain administrative tools created by Microsoft, called snap-ins. These snap-ins may be used to manage Windows systems locally or remotely. MMC can also be used to open Microsoft created .msc files to manage system configuration.(Citation: win_msc_files_overview)","d3f:executes":{"@id":"d3f:ShellCommand"},"d3f:may-add":{"@id":"d3f:Software"},"d3f:may-modify":{"@id":"d3f:SystemConfigurationDatabase"},"rdfs:label":"MMC","rdfs:subClassOf":{"@id":"d3f:T1218"}}]},"subtechniques":{"@context":{"rdfs":"http://www.w3.org/2000/01/rdf-schema#","owl":"http://www.w3.org/2002/07/owl#","d3f":"http://d3fend.mitre.org/ontologies/d3fend.owl#","skos":"http://www.w3.org/2004/02/skos/core#"},"@graph":[{"@id":"d3f:T1218","d3f:attack-id":["T1218"],"d3f:top-level":["true"],"rdfs:hasSubClass":[{"@id":"d3f:T1218.013"},{"@id":"d3f:T1218.002"},{"@id":"d3f:T1218.001"},{"@id":"d3f:T1218.005"},{"@id":"d3f:T1218.014"},{"@id":"d3f:T1218.004"},{"@id":"d3f:T1218.007"},{"@id":"d3f:T1218.015"},{"@id":"d3f:T1218.011"},{"@id":"d3f:T1218.010"},{"@id":"d3f:T1218.009"},{"@id":"d3f:T1218.008"},{"@id":"d3f:T1218.003"},{"@id":"d3f:T1218.012"}],"rdfs:label":["System Binary Proxy Execution"]},{"@id":"d3f:T1218.001","d3f:attack-id":["T1218.001"],"rdfs:label":["Compiled HTML File"],"rdfs:subClassOf":[{"@id":"d3f:T1218"}]},{"@id":"d3f:T1218.002","d3f:attack-id":["T1218.002"],"rdfs:label":["Control Panel"],"rdfs:subClassOf":[{"@id":"d3f:T1218"}]},{"@id":"d3f:T1218.003","d3f:attack-id":["T1218.003"],"rdfs:label":["CMSTP"],"rdfs:subClassOf":[{"@id":"d3f:T1218"}]},{"@id":"d3f:T1218.004","d3f:attack-id":["T1218.004"],"rdfs:label":["InstallUtil"],"rdfs:subClassOf":[{"@id":"d3f:T1218"}]},{"@id":"d3f:T1218.005","d3f:attack-id":["T1218.005"],"rdfs:label":["Mshta"],"rdfs:subClassOf":[{"@id":"d3f:T1218"}]},{"@id":"d3f